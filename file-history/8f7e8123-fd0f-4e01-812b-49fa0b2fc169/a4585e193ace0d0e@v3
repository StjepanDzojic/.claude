import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { AuthService } from "modules/auth/service/AuthService";
import { NavigationContainerRef } from "modules/navigation/const";
import { useState } from "react";
import { Modal, Switch } from "react-native";
import {
  Button,
  GoBackHeader,
  Input,
  Loading,
  ScreenLayout,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

const INFO_ITEMS = [
  "You will not be able to reactivate this account.",
  "You will be removed from all rooms you are a member of.",
  "Your display name and avatar will be removed.",
  "Your account will be deactivated on the server.",
];

export const DeactivateAccount: React.FC<
  NativeStackScreenProps<Routes, "deactivateAccount">
> = () => {
  const [password, setPassword] = useState("");
  const [eraseData, setEraseData] = useState(false);
  const [isConfirmVisible, setIsConfirmVisible] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  const handleDeactivate = async () => {
    setIsConfirmVisible(false);
    setIsLoading(true);
    try {
      await AuthService.deactivateAccount(password, eraseData);
      NavigationContainerRef.reset({
        index: 0,
        routes: [{ name: "splash" }],
      });
    } catch (error) {
      console.error("Failed to deactivate account:", error);
      offlineToastHelper(
        "Failed to deactivate account",
        "Please check your password and try again.",
      );
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <ScreenLayout>
      {isLoading && <Loading text="Deactivating account..." />}
      <Block flex={1} justify="space-between">
        <GoBackHeader
          title="Deactivate Account"
          margins={{ marginBottom: 40 }}
        />
        <Block gap={32}>
          <Block
            background={Colors.white5}
            border={{ borderRadius: 16 }}
            paddings={20}
            gap={12}
          >
            <Text size={TextSize.base} color={Colors.white}>
              This action is permanent and cannot be undone:
            </Text>
            <Block gap={8}>
              {INFO_ITEMS.map((item) => (
                <Block
                  key={item}
                  flexDirection="row"
                  gap={8}
                  align="flex-start"
                >
                  <Text color={Colors.white50}>•</Text>
                  <Text
                    size={TextSize.small}
                    color={Colors.white50}
                    font="InstrumentSans-Regular"
                  >
                    {item}
                  </Text>
                </Block>
              ))}
            </Block>
          </Block>
          <Block
            background={Colors.white5}
            border={{ borderRadius: 16 }}
            paddings={[16, 20]}
            flexDirection="row"
            justify="space-between"
            align="center"
          >
            <Block gap={4}>
              <Text size={TextSize.base} color={Colors.white}>
                Delete all messages
              </Text>
              <Text
                size={TextSize.small}
                color={Colors.white50}
                font="InstrumentSans-Regular"
              >
                Permanently delete all your messages
              </Text>
            </Block>
            <Switch
              value={eraseData}
              onValueChange={setEraseData}
              trackColor={{ false: Colors.white20, true: Colors.primary }}
              thumbColor={Colors.white}
            />
          </Block>
          <Block gap={8}>
            <Text
              size={TextSize.small}
              color={Colors.white50}
              paddings={[0, 16]}
            >
              Password
            </Text>
            <Input
              placeholder="Enter your password"
              secureTextEntry
              value={password}
              onChangeText={setPassword}
              autoCapitalize="none"
              autoCorrect={false}
            />
          </Block>
        </Block>
        <Block paddings={[0, 52]} margins={{ marginTop: "auto" }}>
          <Button.Warning
            onPress={() => setIsConfirmVisible(true)}
            disabled={!password}
          >
            Deactivate Account
          </Button.Warning>
        </Block>
      </Block>
      <Modal visible={isConfirmVisible} transparent animationType="fade">
        <Block
          width="100%"
          height="100%"
          justify="center"
          align="center"
          background={Colors.black70}
          paddings={[40, 20]}
        >
          <Block
            width="100%"
            background={Colors.blackMinus2}
            paddings={20}
            border={{ borderRadius: 36 }}
            gap={20}
          >
            <Block gap={8}>
              <Text size={TextSize.large} color={Colors.white}>
                Are you sure?
              </Text>
              <Text
                size={TextSize.small}
                color={Colors.white50}
                font="InstrumentSans-Regular"
              >
                This will permanently deactivate your account. This action
                cannot be reversed.
              </Text>
            </Block>
            <Block gap={8} flexDirection="row" width="100%">
              <Block flex={1}>
                <Button.Ghost
                  onPress={() => setIsConfirmVisible(false)}
                  width="100%"
                >
                  Cancel
                </Button.Ghost>
              </Block>
              <Block flex={1}>
                <Button.Warning onPress={handleDeactivate} width="100%">
                  Deactivate
                </Button.Warning>
              </Block>
            </Block>
          </Block>
        </Block>
      </Modal>
    </ScreenLayout>
  );
};
