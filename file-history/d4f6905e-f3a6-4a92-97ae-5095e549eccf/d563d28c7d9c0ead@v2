import { Block, Text } from "@prototyp/skeletor";
import { useIsFocused } from "@react-navigation/native";
import {
  type AudioMessageContent,
  type EventTimelineItem,
  MessageType_Tags,
  MsgLikeKind_Tags,
  TimelineItemContent_Tags,
} from "@unomed/react-native-matrix-sdk";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { getEventId, getEventTextContent } from "modules/matrix-client/utils";
import {
  useAudioPlayback,
  useOggAudioPlayback,
} from "modules/recorder-player/hooks";
import { TimelineService } from "modules/timeline/service/TimelineService";
import type { FC } from "react";
import { useEffect, useState } from "react";
import { Dimensions, Image, StyleSheet } from "react-native";
import {
  Button,
  Loading,
  MessageTimestamp,
  PinIndicator,
  SeenBy,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

import { MessageLongPressWrapper } from "../message-long-press-wrapper";
import { MessageSender } from "../message-sender";

interface Props {
  event: EventTimelineItem;
  isPreviousSameSender: boolean;
  onMemberPress?: (member: MemberDetailsPayload) => void;
}

function formatDuration(milliseconds: number) {
  const totalSeconds = Math.max(0, Math.ceil(milliseconds / 1000));
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return `${minutes}:${seconds.toString().padStart(2, "0")}`;
}

const getAudioContent = (
  event: EventTimelineItem,
): AudioMessageContent | null => {
  if (event.content.tag === TimelineItemContent_Tags.MsgLike) {
    const kind = event.content.inner.content.kind;
    if (kind?.tag === MsgLikeKind_Tags.Message) {
      const msgType = kind.inner.content.msgType;
      if (msgType?.tag === MessageType_Tags.Audio) {
        return msgType.inner.content;
      }
    }
  }
  return null;
};

const { width } = Dimensions.get("window");

export const VoiceMessage: FC<Props> = ({
  event,
  isPreviousSameSender,
  onMemberPress,
}) => {
  const content = getAudioContent(event);
  const eventId = getEventId(event);
  const playbackId =
    "inner" in event.eventOrTransactionId
      ? "eventId" in event.eventOrTransactionId.inner
        ? event.eventOrTransactionId.inner.eventId
        : event.eventOrTransactionId.inner.transactionId
      : String(event.timestamp);
  const [messageWidth, setMessageWidth] = useState(40);
  const [isLoading, setIsLoading] = useState(false);
  const isUser = event.isOwn;
  const sender = event.senderProfile;
  const senderId = event.sender;
  const duration = content?.info?.duration ?? 0;
  const maxWidth = width - 60; // Minus horizontal paddings and 20 extra to prevent to be too wide
  const seenByUserIds = TimelineService.getReadReceiptUserIds(event);
  const isFocused = useIsFocused();
  const isOgg = ["audio/ogg", "audio/opus"].includes(
    content?.info?.mimetype ?? "",
  );
  const standardPlayer = useAudioPlayback(playbackId);
  const oggPlayer = useOggAudioPlayback(playbackId);
  const { isPlaying, currentMs, play, pause, resume, stop } = isOgg
    ? oggPlayer
    : standardPlayer;

  useEffect(() => {
    if (!isFocused && isPlaying) stop();
  }, [isFocused]);

  const onTogglePlay = async () => {
    try {
      setIsLoading(true);

      if (isPlaying) {
        await pause();
        return;
      }

      // If paused mid-track and not at the end, resume instead of restarting
      if (currentMs > 0 && currentMs < duration) {
        await resume();
        return;
      }

      // Re-fetch the playback URL to ensure it's valid (temp files may be cleaned up)
      if (!content?.source || !MatrixCore.instance) {
        offlineToastHelper("Failed to fetch voice message.");
        return;
      }

      const mediaHandle = await MatrixCore.instance.getMediaFile(
        content?.source,
        `voice-${eventId}.${content.info?.mimetype?.split("/")[1] ?? "m4a"}`,
        content.info?.mimetype || "audio/m4a",
        true, // useCache
        undefined,
      );

      const filePath = mediaHandle.path();
      const freshUrl = filePath.startsWith("file://")
        ? filePath
        : `file://${filePath}`;

      await play(freshUrl, duration);
    } catch (e) {
      offlineToastHelper("Failed to play voice message.");
      console.log(e);
    } finally {
      setIsLoading(false);
    }
  };

  if (!content) return null;

  return (
    <Block
      align={isUser ? "flex-end" : "flex-start"}
      margins={{ marginTop: isPreviousSameSender ? 6 : 16 }}
    >
      <MessageSender
        sender={sender}
        isUser={isUser}
        senderId={senderId}
        isPreviousSameSender={isPreviousSameSender}
        onMemberPress={onMemberPress}
      />
      <MessageLongPressWrapper
        event={event}
        content={getEventTextContent(event)}
      >
        <Block flexDirection={isUser ? "row-reverse" : "row"}>
          <Block
            paddings={12}
            background={isUser ? Colors.primary : Colors.message}
            border={{
              borderRadius: 24,
            }}
            flexDirection={isUser ? "row-reverse" : "row"}
            gap={{
              row: 8,
              col: 16,
            }}
            align="center"
            width="100%"
            maxWidth={maxWidth}
            onLayout={(e) => setMessageWidth(e.nativeEvent.layout.width)}
          >
            <Button.Wrapper
              disabled={isLoading}
              onPress={onTogglePlay}
              style={styles.playButton}
            >
              {isLoading ? (
                <Loading isFullScreen={false} />
              ) : (
                <Image
                  source={
                    isPlaying
                      ? require("assets/icons/pause-big.png")
                      : require("assets/icons/play.png")
                  }
                  tintColor={Colors.white}
                />
              )}
            </Button.Wrapper>
            <Block flex={1} gap={4}>
              <Block
                height={4}
                background={Colors.white20}
                border={{ borderRadius: 2 }}
              >
                <Block
                  height={4}
                  width={`${Math.min(100, Math.round((currentMs / duration) * 100))}%`}
                  background={Colors.white50}
                  border={{ borderRadius: 2 }}
                />
              </Block>
              <Block flexDirection="row" justify="space-between">
                <Text size={TextSize.tiny} color={Colors.white80}>
                  {formatDuration(currentMs)}
                </Text>
                <Text size={TextSize.tiny} color={Colors.white50}>
                  {formatDuration(duration)}
                </Text>
              </Block>
            </Block>
            <MessageTimestamp event={event} isUser={isUser} />
          </Block>
          <PinIndicator event={event} />
        </Block>
      </MessageLongPressWrapper>
      <SeenBy userIds={seenByUserIds} messageWidth={messageWidth} />
    </Block>
  );
};

const styles = StyleSheet.create({
  playButton: {
    width: 40,
    height: 40,
    alignItems: "center",
    justifyContent: "center",
    backgroundColor: Colors.white20,
    borderRadius: 20,
  },
});
