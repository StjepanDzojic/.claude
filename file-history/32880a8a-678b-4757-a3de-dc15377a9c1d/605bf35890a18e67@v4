import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { useAtomValue } from "jotai";
import { MatrixAtoms } from "modules/matrix-client/jotai";
import { VerificationService } from "modules/verification/service/VerificationService";
import { type FC, useEffect, useState } from "react";
import { Image } from "react-native";
import { Button, GoBackHeader, Loading, ScreenLayout } from "shared/components";
import { useNavigateToCorrectScreenHelper } from "shared/hooks";
import { Colors, TextSize } from "shared/styles";
import { EmojiVerification } from "../verify-user/fragments";

export const VerifyWithDevice: FC<
  NativeStackScreenProps<Routes, "verifyWithDevice">
> = ({ navigation }) => {
  const verificationStatus = useAtomValue(MatrixAtoms.verificationStatus);
  const [deviceId, setDeviceId] = useState<string | null>(null);
  const [requestSent, setRequestSent] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const navigateToCorrectScreen = useNavigateToCorrectScreenHelper();

  const isWaiting =
    requestSent &&
    verificationStatus !== "emojis" &&
    verificationStatus !== "success" &&
    verificationStatus !== "failed" &&
    verificationStatus !== "cancelled";
  const isEmojis = verificationStatus === "emojis";

  useEffect(() => {
    setDeviceId(VerificationService.getDeviceId());
  }, []);

  // Initiate device verification on mount
  useEffect(() => {
    const requestVerification = async () => {
      try {
        await VerificationService.whenReady();
        await VerificationService.requestDeviceVerification();
        setRequestSent(true);
      } catch (err) {
        console.error("Failed to request device verification:", err);
        setError("Failed to send verification request. Please try again.");
      }
    };
    requestVerification();
  }, []);

  // Watchdog: if the other device hasn't acknowledged within 45s, surface an error
  // so the user can retry or fall back to the recovery key instead of waiting forever.
  useEffect(() => {
    if (!requestSent) return;
    if (
      verificationStatus === "accepted" ||
      verificationStatus === "sasStarted" ||
      verificationStatus === "emojis" ||
      verificationStatus === "success"
    ) {
      return;
    }

    const timer = setTimeout(() => {
      VerificationService.cancelVerification().catch((err) =>
        console.error("Failed to cancel stalled verification:", err),
      );
      setRequestSent(false);
      setError(
        "No response from your other device. Make sure it's online and try again, or use your recovery key.",
      );
    }, 45000);

    return () => clearTimeout(timer);
  }, [requestSent, verificationStatus]);

  // When the other device accepts our request, start SAS to generate emojis
  useEffect(() => {
    if (verificationStatus === "accepted") {
      VerificationService.startVerification().catch((err) => {
        console.error("Failed to start SAS verification:", err);
        setError("Failed to start emoji verification. Please try again.");
        setRequestSent(false);
      });
    }
  }, [verificationStatus]);

  // Handle terminal states
  useEffect(() => {
    if (verificationStatus === "success") {
      navigateToCorrectScreen();
    } else if (verificationStatus === "failed") {
      setError("Verification failed. Please try again.");
      setRequestSent(false);
    } else if (verificationStatus === "cancelled") {
      setError("Verification was cancelled. Please try again.");
      setRequestSent(false);
    }
  }, [verificationStatus]);

  const handleRetry = async () => {
    try {
      setError(null);
      await VerificationService.whenReady();
      await VerificationService.requestDeviceVerification();
      setRequestSent(true);
    } catch (err) {
      console.error("Failed to request device verification:", err);
      setError("Failed to send verification request. Please try again.");
    }
  };

  const handleCancel = async () => {
    try {
      await VerificationService.cancelVerification();
    } catch (err) {
      console.error("Failed to cancel verification:", err);
    }
    setRequestSent(false);
    setError("Verification was cancelled. Please try again.");
  };

  const handleGoBack = async () => {
    if (error) await handleCancel();
    navigation.goBack();
  };

  if (isEmojis) {
    return (
      <ScreenLayout>
        <GoBackHeader />
        <EmojiVerification />
      </ScreenLayout>
    );
  }

  return (
    <ScreenLayout>
      <GoBackHeader onGoBack={handleGoBack} />
      <Block flex={1} justify="space-between">
        <Block flex={1} justify="center" align="center" gap={32}>
          <Block gap={12}>
            <Text
              size={TextSize.large}
              textAlign="center"
              font="InstrumentSans-Medium"
            >
              Verify with another device
            </Text>
            <Text
              textAlign="center"
              font="InstrumentSans-Regular"
              color={Colors.white50}
            >
              A verification request has been sent to your other devices. Accept
              it on a verified device to compare emojis.
            </Text>
          </Block>

          {deviceId && (
            <Block
              border={{ borderRadius: 12 }}
              background={Colors.white5}
              paddings={[16, 16]}
              width="100%"
            >
              <Text color={Colors.white50} size={TextSize.small}>
                This device ID: {deviceId}
              </Text>
            </Block>
          )}

          {isWaiting && (
            <Block align="center" gap={16} width="100%">
              <Block flexDirection="row" align="center" gap={12}>
                <Block>
                  <Loading isFullScreen={false} width={20} height={20} />
                </Block>
                <Text color={Colors.white50}>
                  Waiting for the other device...
                </Text>
              </Block>
              <Block width="100%" paddings={[0, 52]}>
                <Button.Outline onPress={handleCancel}>Cancel</Button.Outline>
              </Block>
            </Block>
          )}

          {error && (
            <Block
              border={{ borderRadius: 12 }}
              background={Colors.white5}
              paddings={[16, 0]}
              gap={12}
              width="100%"
            >
              <Text color="red" textAlign="center">
                {error}
              </Text>
              <Block paddings={[0, 52]}>
                <Button.Primary onPress={handleRetry}>Try Again</Button.Primary>
              </Block>
            </Block>
          )}

          <Block
            border={{ borderRadius: 12 }}
            background={Colors.blackMinus3}
            paddings={[12, 16]}
            flexDirection="row"
            align="center"
            gap={12}
          >
            <Image
              source={require("assets/icons/info.png")}
              tintColor={Colors.primary}
              width={20}
              height={20}
            />
            <Text color={Colors.white80} size={TextSize.small} flex={1}>
              Don't have access to another verified device? Go back and use your
              recovery key instead.
            </Text>
          </Block>
        </Block>
      </Block>
    </ScreenLayout>
  );
};
