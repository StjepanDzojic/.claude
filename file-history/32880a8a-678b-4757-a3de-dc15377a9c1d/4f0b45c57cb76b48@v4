import { VerificationState } from "@unomed/react-native-matrix-sdk";
import { useAtomValue, useSetAtom } from "jotai";
import { NavigationContainerRef } from "modules/navigation/const";
import { VerificationService } from "modules/verification/service/VerificationService";
import { type FC, useEffect } from "react";
import Toast from "react-native-toast-message";
import { offlineToastHelper } from "shared/utils";
import { MatrixAtoms } from "../jotai";

const VERIFICATION_SCREENS: (keyof Routes)[] = [
  "splash",
  "confirmIdentity",
  "cantConfirm",
  "oidcResetWebView",
  "verifyWithDevice",
  "enterRecoveryKey",
  "setUpRecoveryKey",
];

export const VerificationProvider: FC = () => {
  const client = useAtomValue(MatrixAtoms.matrixClient);
  const syncService = useAtomValue(MatrixAtoms.syncService);
  const setVerificationStatus = useSetAtom(MatrixAtoms.verificationStatus);
  const setVerificationEmojis = useSetAtom(MatrixAtoms.verificationEmojis);
  const setVerificationSenderName = useSetAtom(
    MatrixAtoms.verificationSenderName,
  );

  useEffect(() => {
    if (!client || !syncService) return;

    let cancelled = false;

    const setup = async () => {
      try {
        await VerificationService.setupVerification(
          // On verification request received
          (details) => {
            const senderName =
              details.senderProfile.displayName || details.senderProfile.userId;
            setVerificationSenderName(senderName);
            setVerificationStatus("incomingRequest");
            VerificationService.acknowledgeVerification(
              details.senderProfile.userId,
              details.flowId,
            ).catch((err) =>
              console.error("Failed to acknowledge verification:", err),
            );
            NavigationContainerRef.navigate("verifyUser", {
              userId: details.senderProfile.userId,
              flowId: details.flowId,
            });
          },
          // On emojis received
          (emojis) => {
            setVerificationEmojis(emojis);
            setVerificationStatus("emojis");
          },
          // On state change
          (state) => {
            console.log("Verification state changed:", state);

            if (state === "success") {
              setVerificationStatus("success");
              setVerificationEmojis(null);
              setVerificationSenderName(null);
              Toast.show({
                type: "success",
                text1: "Device verified successfully!",
              });
            } else if (state === "failed") {
              setVerificationStatus("failed");
              setVerificationEmojis(null);
              setVerificationSenderName(null);
              offlineToastHelper("Verification failed");
            } else if (state === "cancelled") {
              setVerificationStatus("cancelled");
              setVerificationEmojis(null);
              setVerificationSenderName(null);
              offlineToastHelper("Verification cancelled");
            } else if (state === "emojis") {
              setVerificationStatus("emojis");
            } else if (state === "accepted") {
              setVerificationStatus("accepted");
            } else if (state === "sasStarted") {
              setVerificationStatus("sasStarted");
            }
          },
        );
        if (!cancelled) setVerificationStatus("idle");
      } catch (error) {
        if (!cancelled) console.error("Failed to set up verification:", error);
      }
    };

    setup();

    return () => {
      cancelled = true;
    };
  }, [client, syncService]);

  useEffect(() => {
    if (!client) return;

    let debounceTimer: ReturnType<typeof setTimeout> | null = null;

    // After user resets identity, we need to wait 2 seconds to ensure the verification state is updated
    const handle = VerificationService.subscribeToVerificationState((state) => {
      if (
        state === VerificationState.Unknown ||
        state === VerificationState.Verified
      ) {
        return;
      }

      if (debounceTimer) {
        clearTimeout(debounceTimer);
        debounceTimer = null;
      }

      debounceTimer = setTimeout(() => {
        if (VerificationService.isDeviceVerified()) return;

        const currentRoute = NavigationContainerRef.getCurrentRoute();

        if (currentRoute && VERIFICATION_SCREENS.includes(currentRoute.name)) {
          return;
        }

        NavigationContainerRef.reset({
          index: 0,
          routes: [{ name: "confirmIdentity" }],
        });
      }, 2000);
    });

    return () => {
      if (debounceTimer) clearTimeout(debounceTimer);
      handle.cancel();
    };
  }, [client]);

  return <></>;
};
