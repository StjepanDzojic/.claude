import {
  type SessionVerificationControllerDelegate,
  type SessionVerificationControllerInterface,
  type SessionVerificationData,
  SessionVerificationData_Tags,
  type SessionVerificationRequestDetails,
  type TaskHandleInterface,
  VerificationState,
} from "@unomed/react-native-matrix-sdk";
import { MatrixCore } from "../../matrix-client/services/MatrixCore";

type VerificationRequestCallback = (
  details: SessionVerificationRequestDetails,
) => void;

type VerificationEmojisCallback = (
  emojis: Array<{ symbol: string; description: string }>,
) => void;

type VerificationStateChangeCallback = (
  state:
    | "request"
    | "accepted"
    | "emojis"
    | "success"
    | "failed"
    | "cancelled"
    | "sasStarted",
) => void;

export type {
  VerificationEmojisCallback,
  VerificationRequestCallback,
  VerificationStateChangeCallback,
};

export class VerificationService {
  private static verificationController: SessionVerificationControllerInterface | null =
    null;

  private static onVerificationRequest: VerificationRequestCallback | null =
    null;
  private static onVerificationEmojis: VerificationEmojisCallback | null = null;
  private static onVerificationStateChange: VerificationStateChangeCallback | null =
    null;

  public static getVerificationState = () => {
    return MatrixCore.getClient().encryption().verificationState();
  };

  public static isDeviceVerified = () => {
    if (!MatrixCore.instance) return false;
    return (
      MatrixCore.instance.encryption().verificationState() ===
      VerificationState.Verified
    );
  };

  public static getDeviceId = () => {
    if (!MatrixCore.instance) return null;
    return MatrixCore.instance.session()?.deviceId || null;
  };

  public static getVerificationDetails = async () => {
    const client = MatrixCore.getClient();
    const userId = client.userId();
    if (!userId) throw new Error("User ID not found");

    const encryption = client.encryption();
    const userIdentity = await encryption.userIdentity(userId, true);

    return {
      verificationState: encryption.verificationState(),
      isVerified: this.isDeviceVerified(),
      deviceId: this.getDeviceId(),
      userIdentity: userIdentity
        ? {
            isVerified: userIdentity.isVerified(),
            hasVerificationViolation: userIdentity.hasVerificationViolation(),
            masterKey: userIdentity.masterKey(),
          }
        : null,
    };
  };

  public static setupVerification = async (
    onRequest: VerificationRequestCallback,
    onEmojis: VerificationEmojisCallback,
    onStateChange: VerificationStateChangeCallback,
  ) => {
    const client = MatrixCore.getClient();

    this.onVerificationRequest = onRequest;
    this.onVerificationEmojis = onEmojis;
    this.onVerificationStateChange = onStateChange;

    this.verificationController =
      await client.getSessionVerificationController();

    const delegate: SessionVerificationControllerDelegate = {
      didReceiveVerificationRequest: (
        details: SessionVerificationRequestDetails,
      ) => {
        console.log("Verification request received:", details);
        this.onVerificationStateChange?.("request");
        this.onVerificationRequest?.(details);
      },

      didAcceptVerificationRequest: () => {
        console.log("Verification request accepted");
        this.onVerificationStateChange?.("accepted");
      },

      didStartSasVerification: () => {
        console.log("SAS verification started");
        this.onVerificationStateChange?.("sasStarted");
      },

      didReceiveVerificationData: (data: SessionVerificationData) => {
        console.log("Verification data received:", data);

        if (data.tag === SessionVerificationData_Tags.Emojis) {
          const emojis = data.inner.emojis.map((emoji) => ({
            symbol: emoji.symbol(),
            description: emoji.description(),
          }));
          console.log("Emojis:", emojis);
          this.onVerificationStateChange?.("emojis");
          this.onVerificationEmojis?.(emojis);
        } else if (data.tag === SessionVerificationData_Tags.Decimals) {
          console.log("Decimals:", data.inner.values);
        }
      },

      didFail: () => {
        console.log("Verification failed");
        this.onVerificationStateChange?.("failed");
      },

      didCancel: () => {
        console.log("Verification cancelled");
        this.onVerificationStateChange?.("cancelled");
      },

      didFinish: () => {
        console.log("Verification finished successfully!");
        this.onVerificationStateChange?.("success");
      },
    };

    this.verificationController.setDelegate(delegate);
    console.log("Verification controller set up successfully");
  };

  public static acknowledgeVerification = async (
    senderId: string,
    flowId: string,
  ) => {
    if (!this.verificationController) {
      throw new Error("Verification controller not initialized");
    }
    await this.verificationController.acknowledgeVerificationRequest(
      senderId,
      flowId,
    );
    console.log("Verification request acknowledged");
  };

  public static acceptVerification = async () => {
    if (!this.verificationController) {
      throw new Error("Verification controller not initialized");
    }
    await this.verificationController.acceptVerificationRequest();
    await this.verificationController.startSasVerification();
    console.log("Verification accepted and SAS started");
  };

  public static acceptVerificationRequest = async () => {
    if (!this.verificationController) {
      throw new Error("Verification controller not initialized");
    }
    await this.verificationController.acceptVerificationRequest();
    console.log("Verification request accepted");
  };

  public static approveVerification = async () => {
    if (!this.verificationController) {
      throw new Error("Verification controller not initialized");
    }
    await this.verificationController.approveVerification();
    console.log("Verification approved");
  };

  public static declineVerification = async () => {
    if (!this.verificationController) {
      throw new Error("Verification controller not initialized");
    }
    await this.verificationController.declineVerification();
    console.log("Verification declined");
  };

  public static cancelVerification = async () => {
    if (!this.verificationController) {
      throw new Error("Verification controller not initialized");
    }
    await this.verificationController.cancelVerification();
    console.log("Verification cancelled");
  };

  public static startVerification = async () => {
    if (!this.verificationController) {
      throw new Error("Verification controller not initialized");
    }
    await this.verificationController.startSasVerification();
    console.log("Verification started");
  };

  public static subscribeToVerificationState = (
    callback: (state: VerificationState) => void,
  ): TaskHandleInterface => {
    return MatrixCore.getClient()
      .encryption()
      .verificationStateListener({ onUpdate: callback });
  };

  public static hasDevicesToVerifyAgainst = async () => {
    return MatrixCore.getClient().encryption().hasDevicesToVerifyAgainst();
  };

  public static requestDeviceVerification = async () => {
    if (!this.verificationController) {
      throw new Error("Verification controller not initialized");
    }
    await this.verificationController.requestDeviceVerification();
    console.log("Device verification requested");
  };

  public static verifyOtherUser = async (userId: string) => {
    if (!this.verificationController) {
      throw new Error("Verification controller not initialized");
    }
    await this.verificationController.requestUserVerification(
      userId,
    );
    console.log("Verification requested");
  };

  public static isUserVerified = async (userId: string) => {
    try {
      const encryption = MatrixCore.getClient().encryption();
      const userIdentity = await encryption.userIdentity(userId, true);
      return !!userIdentity?.isVerified();
    } catch (error) {
      console.error("Failed to check user verification status:", error);
      return false;
    }
  };
}
