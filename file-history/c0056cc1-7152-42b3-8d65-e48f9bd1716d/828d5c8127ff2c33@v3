import { z } from 'zod';
import { buildUrl, isWriteMethod, parseResponse } from './http-internal';

/**
 * Server-only HTTP client. Sends the SECRET key.
 *
 * Safe to call from:
 *   - Server Components
 *   - Route Handlers (app/api/*)
 *   - Server Actions
 *   - Any file marked `"use server"` or running at build/request time on the server
 *
 * NEVER import this from a Client Component. The secret key is read from
 * `API_SECRET_KEY` (no `NEXT_PUBLIC_` prefix) so Next.js will not bundle the
 * value, and this module throws at import time if loaded in a browser.
 *
 * Env:
 *   API_BASE_URL       — server-side base URL (falls back to NEXT_PUBLIC_API_BASE_URL)
 *   API_SECRET_KEY     — REQUIRED. Must never be exposed to the client.
 */

if (typeof window !== 'undefined') {
  throw new Error(
    '[http-server] This module is server-only and was loaded in the browser. ' +
      'Import from "modules/shared/services/http-client" (the `http` export) instead.',
  );
}

export { ApiError, envelope } from './http-internal';

class HttpServerClient {
  constructor(
    private readonly baseUrl: string,
    private readonly secretKey: string,
  ) {}

  private getAuthHeaders(): HeadersInit {
    return {
      Authorization: `Bearer ${this.secretKey}`,
      'x-api-key': this.secretKey,
      'api-key': this.secretKey,
    };
  }

  private async request<TBody = unknown>(
    options: RequestOptions<TBody>,
  ): Promise<unknown> {
    if (!this.secretKey) {
      throw new Error(
        '[http-server] Missing API_SECRET_KEY. Set it in the server environment.',
      );
    }

    const { path, method = 'GET', query, body, headers, idempotencyKey, signal, cache, next } = options;

    const hasBody = body !== undefined && method !== 'GET' && method !== 'DELETE';

    const response = await fetch(buildUrl(this.baseUrl, path, query), {
      method,
      signal,
      cache,
      next,
      headers: {
        Accept: 'application/json',
        ...(hasBody ? { 'Content-Type': 'application/json' } : {}),
        ...this.getAuthHeaders(),
        ...(idempotencyKey && isWriteMethod(method) ? { 'Idempotency-Key': idempotencyKey } : {}),
        ...headers,
      },
      body: hasBody ? JSON.stringify(body) : undefined,
    });

    return parseResponse(response);
  }

  private async send<TSchema extends z.ZodTypeAny, TBody = unknown>(
    schema: TSchema,
    options: RequestOptions<TBody>,
  ): Promise<z.infer<TSchema>> {
    const raw = await this.request<TBody>(options);
    return schema.parse(raw) as z.infer<TSchema>;
  }

  get<TSchema extends z.ZodTypeAny>(
    schema: TSchema,
    options: Omit<RequestOptions, 'method' | 'body'>,
  ) {
    return this.send(schema, { ...options, method: 'GET' });
  }

  post<TSchema extends z.ZodTypeAny, TBody = unknown>(
    schema: TSchema,
    options: Omit<RequestOptions<TBody>, 'method'>,
  ) {
    return this.send<TSchema, TBody>(schema, { ...options, method: 'POST' });
  }

  put<TSchema extends z.ZodTypeAny, TBody = unknown>(
    schema: TSchema,
    options: Omit<RequestOptions<TBody>, 'method'>,
  ) {
    return this.send<TSchema, TBody>(schema, { ...options, method: 'PUT' });
  }

  patch<TSchema extends z.ZodTypeAny, TBody = unknown>(
    schema: TSchema,
    options: Omit<RequestOptions<TBody>, 'method'>,
  ) {
    return this.send<TSchema, TBody>(schema, { ...options, method: 'PATCH' });
  }

  delete<TSchema extends z.ZodTypeAny>(
    schema: TSchema,
    options: Omit<RequestOptions, 'method' | 'body'>,
  ) {
    return this.send(schema, { ...options, method: 'DELETE' });
  }
}

export const httpServer = new HttpServerClient(
  process.env.API_BASE_URL ?? process.env.NEXT_PUBLIC_API_BASE_URL ?? '',
  process.env.API_SECRET_KEY ?? '',
);
