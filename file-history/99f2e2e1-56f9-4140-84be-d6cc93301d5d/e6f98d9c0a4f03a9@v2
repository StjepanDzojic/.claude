import type { EventTimelineItem } from "@unomed/react-native-matrix-sdk";

const formatTimelineDate = (timestamp: bigint): string => {
  const date = new Date(Number(timestamp));
  const today = new Date();
  const yesterday = new Date(today);
  yesterday.setDate(yesterday.getDate() - 1);

  const dateOnly = new Date(
    date.getFullYear(),
    date.getMonth(),
    date.getDate(),
  );
  const todayOnly = new Date(
    today.getFullYear(),
    today.getMonth(),
    today.getDate(),
  );
  const yesterdayOnly = new Date(
    yesterday.getFullYear(),
    yesterday.getMonth(),
    yesterday.getDate(),
  );

  if (dateOnly.getTime() === todayOnly.getTime()) return "Today";

  if (dateOnly.getTime() === yesterdayOnly.getTime()) return "Yesterday";

  return date.toLocaleDateString("en-US", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

/** Helper function to group events by date and add dividers */
export const addDateDividers = (
  events: EventTimelineItem[],
): TimelineListItem[] => {
  const result: TimelineListItem[] = [];
  let lastDate: string | null = null;

  for (const event of events) {
    const eventDate = formatTimelineDate(event.timestamp);

    if (eventDate !== lastDate) {
      result.push({
        type: "divider",
        date: eventDate,
        id: `divider-${event.timestamp}`,
      });
      lastDate = eventDate;
    }

    result.push({ type: "event", data: event, isPreviousSameSender: false });
  }

  return result;
};
