import { Block, Text } from "@prototyp/skeletor";
import { FlashList, type FlashListRef } from "@shopify/flash-list";
import type { RoomInterface } from "@unomed/react-native-matrix-sdk";
import { TimelineItemContent_Tags } from "@unomed/react-native-matrix-sdk";
import { useAtom } from "jotai";
import {
  addDateDividers,
  getEventId,
  getItemUniqueKey,
  groupInfoEvents,
} from "modules/matrix-client/utils";
import { useRoomIdentityViolations } from "modules/room/hooks";
import { useRoomTimeline } from "modules/timeline/hooks";
import { TimelineAtoms } from "modules/timeline/jotai";
import { filterSameStateKey } from "modules/timeline/utils";
import {
  type FC,
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import {
  Image,
  KeyboardAvoidingView,
  type NativeScrollEvent,
  type NativeSyntheticEvent,
  StyleSheet,
} from "react-native";
import {
  Button,
  MemberDetailsBottomSheet,
  SeenByBottomSheet,
} from "shared/components";
import { useMemberDetails } from "shared/hooks";
import { DateDivider } from "../date-divider";
import { GroupedInfoMessages } from "../grouped-info-messages";
import { MessageContentBottomSheet } from "../message-content-bottom-sheet";
import { RoomIdentityBanner } from "../room-identity-banner";
import { RoomInput } from "../room-input";
import { SingleMessageType } from "../single-message-type";

interface Props {
  room: RoomInterface;
  roomId: string;
}

export const RoomTimeline: FC<Props> = ({ room, roomId }) => {
  const flashListRef = useRef<FlashListRef<TimelineListItem>>(null);
  const isAtBottomRef = useRef(true);
  const listHeightRef = useRef(0);
  const lastEventKeyRef = useRef<string | undefined>(undefined);
  const lastBottomEventKeyRef = useRef<string | undefined>(undefined);
  const [showScrollDown, setShowScrollDown] = useState(false);
  const {
    events,
    isPaginatingRef,
    isDirect,
    loadMoreMessages,
    markAsRead,
  } = useRoomTimeline({
    room,
    roomId,
  });
  const [scrollToEventId, setScrollToEventId] = useAtom(
    TimelineAtoms.scrollToEventId,
  );
  const [seenByUserIds, setSeenByUserIds] = useAtom(
    TimelineAtoms.seenByUserIds,
  );
  const { isPinViolatingUsersLoading, violatingUsers, pinViolatingUsers } =
    useRoomIdentityViolations(room);
  const {
    selectedMember,
    isBottomSheetOpen,
    openMemberDetails,
    closeMemberDetails,
  } = useMemberDetails();

  const sortedEvents = useMemo(() => {
    const sorted = [...events].sort(
      (a, b) => Number(a.timestamp) - Number(b.timestamp),
    );

    return filterSameStateKey(sorted);
  }, [events]);

  const eventsWithDividers = useMemo(() => {
    const items = groupInfoEvents(addDateDividers(sortedEvents));

    // Pre-compute isPreviousSameSender so it's not recalculated per-item during render
    let prevSender: string | null = null;
    for (const item of items) {
      if (item.type !== "event") {
        prevSender = null;
        continue;
      }
      const isMsgLike =
        item.data.content.tag === TimelineItemContent_Tags.MsgLike;
      if (!isMsgLike) {
        prevSender = null;
        continue;
      }
      item.isPreviousSameSender =
        isDirect || (prevSender !== null && prevSender === item.data.sender);
      prevSender = item.data.sender;
    }

    return items;
  }, [sortedEvents, isDirect]);

  const handleScrollToEvent = useCallback(
    (eventId: string) => {
      const index = eventsWithDividers.findIndex(
        (item) => item.type === "event" && getEventId(item.data) === eventId,
      );
      if (index === -1) return;

      flashListRef.current?.scrollToIndex({
        index,
        animated: true,
        viewPosition: 0.5,
      });
    },
    [eventsWithDividers],
  );

  useEffect(() => {
    if (!scrollToEventId) return;
    handleScrollToEvent(scrollToEventId);
    setScrollToEventId(null);
  }, [scrollToEventId, handleScrollToEvent, setScrollToEventId]);

  const handleScrollDown = () => {
    flashListRef.current?.scrollToEnd({ animated: true });
    setShowScrollDown(false);
  };

  const handleOnScroll = ({
    nativeEvent,
  }: NativeSyntheticEvent<NativeScrollEvent>) => {
    const { layoutMeasurement, contentOffset, contentSize } = nativeEvent;
    const paddingToBottom = 100;
    const atBottom =
      layoutMeasurement.height + contentOffset.y >=
      contentSize.height - paddingToBottom;
    isAtBottomRef.current = atBottom;

    // Prefetch when within 2x visible height from the top (Element X approach)
    if (contentOffset.y < layoutMeasurement.height * 2) {
      loadMoreMessages();
    }

    if (!atBottom) return;
    setShowScrollDown(false);
    markAsRead();
  };

  const handleContentSizeChange = (_w: number, contentHeight: number) => {
    // Auto-paginate if content doesn't fill the viewport yet
    if (contentHeight < listHeightRef.current) {
      loadMoreMessages();
      return;
    }

    if (isPaginatingRef.current) return;

    const lastEvent = sortedEvents[sortedEvents.length - 1];
    const lastEventKey = lastEvent
      ? (getItemUniqueKey(lastEvent) ?? undefined)
      : undefined;
    const isNewEvent = lastEventKey !== lastEventKeyRef.current;
    lastEventKeyRef.current = lastEventKey;
    const shouldScrollToEnd =
      (isNewEvent && !!lastEvent?.isOwn) || isAtBottomRef.current;
    if (!shouldScrollToEnd) return;
    setTimeout(() => {
      flashListRef.current?.scrollToEnd({ animated: true });
    }, 100);
  };

  useEffect(() => {
    const lastEvent = sortedEvents[sortedEvents.length - 1];
    const lastEventKey = lastEvent
      ? (getItemUniqueKey(lastEvent) ?? undefined)
      : undefined;
    const isNewMessageAtBottom = lastEventKey !== lastBottomEventKeyRef.current;
    lastBottomEventKeyRef.current = lastEventKey;
    if (!isNewMessageAtBottom || isAtBottomRef.current || lastEvent?.isOwn) {
      return;
    }
    setShowScrollDown(true);
  }, [sortedEvents]);

  const renderItem = useCallback(
    ({ item }: { item: TimelineListItem }) => {
      if (item.type === "divider") {
        return <DateDivider date={item.date} />;
      }

      if (item.type === "group") {
        return <GroupedInfoMessages events={item.events} roomId={roomId} />;
      }

      return (
        <SingleMessageType
          roomId={roomId}
          event={item.data}
          isPreviousSameSender={item.isPreviousSameSender}
          onMemberPress={openMemberDetails}
        />
      );
    },
    [roomId, openMemberDetails],
  );

  return (
    <>
      <KeyboardAvoidingView style={styles.flex} behavior="padding">
        {!!violatingUsers.length && (
          <RoomIdentityBanner
            users={violatingUsers}
            isLoading={isPinViolatingUsersLoading}
            onDismiss={pinViolatingUsers}
          />
        )}
        <FlashList
          ref={flashListRef}
          data={eventsWithDividers}
          keyExtractor={(item) => {
            if (item.type === "divider") return item.id;
            if (item.type === "group") return item.id;

            return getItemUniqueKey(item.data) ?? "";
          }}
          maintainVisibleContentPosition={{
            startRenderingFromBottom: true,
          }}
          contentContainerStyle={styles.listContent}
          onLayout={(e) => {
            listHeightRef.current = e.nativeEvent.layout.height;
          }}
          onContentSizeChange={handleContentSizeChange}
          onScroll={handleOnScroll}
          scrollEventThrottle={100}
          renderItem={renderItem}
        />

        <RoomInput roomId={roomId} />
      </KeyboardAvoidingView>

      <MessageContentBottomSheet roomId={roomId} />

      <MemberDetailsBottomSheet
        isBottomSheetOpen={isBottomSheetOpen}
        selectedMember={selectedMember}
        roomId={roomId}
        onClose={closeMemberDetails}
      />

      {showScrollDown && (
        <Block
          absolute
          offsets={{ right: 0, bottom: 100 }}
          align="center"
          justify="center"
          width="100%"
        >
          <Button.Outline size="medium" onPress={handleScrollDown}>
            <Text>New messages</Text>
            <Image source={require("assets/icons/arrow-down.png")} />
          </Button.Outline>
        </Block>
      )}

      <SeenByBottomSheet
        isOpen={!!seenByUserIds}
        userIds={seenByUserIds ?? []}
        onClose={() => setSeenByUserIds(null)}
      />
    </>
  );
};

const styles = StyleSheet.create({
  flex: {
    flex: 1,
  },
  listContent: {
    paddingHorizontal: 20,
    paddingTop: 12,
    paddingBottom: 20,
  },
});
