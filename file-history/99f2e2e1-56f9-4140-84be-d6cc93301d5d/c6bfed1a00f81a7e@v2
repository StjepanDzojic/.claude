import type { EventTimelineItem } from "@unomed/react-native-matrix-sdk";
import {
  MessageType_Tags,
  MsgLikeKind_Tags,
  TimelineItemContent_Tags,
} from "@unomed/react-native-matrix-sdk";

const isInfoEvent = (event: EventTimelineItem): boolean => {
  const tag = event.content.tag;

  if (tag === TimelineItemContent_Tags.RoomMembership) return true;
  if (tag === TimelineItemContent_Tags.ProfileChange) return true;

  if (tag === TimelineItemContent_Tags.State) {
    const stateContent = event.content.inner.content;
    if (stateContent.tag.includes("Room")) return true;
  }

  if (tag === TimelineItemContent_Tags.MsgLike) {
    const kind = event.content.inner.content.kind;
    if (kind?.tag === MsgLikeKind_Tags.Message) {
      const msgType = kind.inner.content.msgType;
      if (msgType?.tag === MessageType_Tags.Other) return true;
    }
  }

  return false;
};

export const groupInfoEvents = (
  items: TimelineListItem[],
): TimelineListItem[] => {
  const result: TimelineListItem[] = [];
  let currentGroup: EventTimelineItem[] = [];

  const flushGroup = () => {
    if (currentGroup.length === 0) return;
    if (currentGroup.length === 1) {
      result.push({ type: "event", data: currentGroup[0], isPreviousSameSender: false });
    } else {
      result.push({
        type: "group",
        events: [...currentGroup],
        id: `group-${currentGroup[0].timestamp}`,
      });
    }
    currentGroup = [];
  };

  for (const item of items) {
    if (item.type === "divider") {
      flushGroup();
      result.push(item);
      continue;
    }

    if (item.type !== "event") {
      flushGroup();
      result.push(item);
      continue;
    }

    if (isInfoEvent(item.data)) {
      currentGroup.push(item.data);
    } else {
      flushGroup();
      result.push(item);
    }
  }

  flushGroup();
  return result;
};
