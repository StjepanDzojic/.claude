    scaleX: vBounds.sizeVec.x > 0 ? uBounds.sizeVec.x / vBounds.sizeVec.x : 1,
    scaleY: vBounds.sizeVec.y > 0 ? uBounds.sizeVec.y / vBounds.sizeVec.y : 1,
