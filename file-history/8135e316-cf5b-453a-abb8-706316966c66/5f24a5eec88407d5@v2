import {
  BackupDownloadStrategy,
  ClientBuilder,
  type ClientInterface,
  SlidingSyncVersion,
  SlidingSyncVersionBuilder,
  type SyncServiceInterface,
} from "@unomed/react-native-matrix-sdk";
import RNFS from "react-native-fs";
import { SecondaryMatrixStorage } from "../const/secondary-matrix-storage";

const secondaryDataPath = `${RNFS.DocumentDirectoryPath}/matrix/secondary/data`;
const secondaryCachePath = `${RNFS.CachesDirectoryPath}/matrix/secondary/cache`;

let secondaryClient: ClientInterface | null = null;
let secondarySyncService: SyncServiceInterface | null = null;

async function clearSecondaryStore() {
  try {
    if (await RNFS.exists(secondaryDataPath))
      await RNFS.unlink(secondaryDataPath);
    if (await RNFS.exists(secondaryCachePath))
      await RNFS.unlink(secondaryCachePath);
  } catch (error) {
    console.warn("[Secondary] Failed to clear crypto store:", error);
  }
}

async function initializeFresh(serverUrl: string) {
  secondaryClient = await new ClientBuilder()
    .serverNameOrHomeserverUrl(serverUrl)
    .sessionPaths(secondaryDataPath, secondaryCachePath)
    .autoEnableCrossSigning(false)
    .autoEnableBackups(false)
    .backupDownloadStrategy(BackupDownloadStrategy.AfterDecryptionFailure)
    .build();
}

async function initializeForRestore(homeserverUrl: string, userId: string) {
  secondaryClient = await new ClientBuilder()
    .homeserverUrl(homeserverUrl)
    .username(userId)
    .slidingSyncVersionBuilder(SlidingSyncVersionBuilder.Native)
    .sessionPaths(secondaryDataPath, secondaryCachePath)
    .autoEnableCrossSigning(false)
    .autoEnableBackups(false)
    .backupDownloadStrategy(BackupDownloadStrategy.AfterDecryptionFailure)
    .build();
}

export const SecondaryMatrixService = {
  getSyncService: (): SyncServiceInterface | null => secondarySyncService,

  isSessionActive: (): boolean => !!secondaryClient && !!secondarySyncService,

  /**
   * Full login flow: initialize → login → save credentials → rebuild client → restore session → create sync service.
   * Mirrors the AuthService.login + AuthService.setup pattern.
   */
  loginAndSetup: async (
    serverUrl: string,
    username: string,
    password: string,
  ) => {
    await initializeFresh(serverUrl);

    if (!secondaryClient)
      throw new Error("Failed to initialize secondary client");

    await secondaryClient.login(username, password, undefined, undefined);
    const session = secondaryClient.session();

    secondaryClient = null;
    await clearSecondaryStore();

    SecondaryMatrixStorage.save({
      accessToken: session.accessToken,
      refreshToken: session.refreshToken,
      userId: session.userId,
      deviceId: session.deviceId,
      baseUrl: session.homeserverUrl,
    });

    await initializeForRestore(session.homeserverUrl, session.userId);

    if (!secondaryClient) throw new Error("Failed to rebuild secondary client");

    await secondaryClient.restoreSession({
      accessToken: session.accessToken,
      refreshToken: session.refreshToken,
      userId: session.userId,
      deviceId: session.deviceId,
      homeserverUrl: session.homeserverUrl,
      oidcData: undefined,
      slidingSyncVersion: SlidingSyncVersion.Native,
    });

    secondarySyncService = await secondaryClient.syncService().finish();
  },

  /**
   * Restore a previously saved secondary session from MMKV.
   */
  restoreSession: async (): Promise<boolean> => {
    try {
      const creds = SecondaryMatrixStorage.get();
      if (!creds) return false;

      if (!secondaryClient) {
        await initializeForRestore(creds.baseUrl, creds.userId);
      }

      if (!secondaryClient) return false;

      await secondaryClient.restoreSession({
        accessToken: creds.accessToken,
        refreshToken: creds.refreshToken,
        userId: creds.userId,
        deviceId: creds.deviceId,
        homeserverUrl: creds.baseUrl,
        oidcData: undefined,
        slidingSyncVersion: SlidingSyncVersion.Native,
      });

      secondarySyncService = await secondaryClient
        .syncService()
        .withOfflineMode()
        .finish();

      return true;
    } catch (error) {
      console.warn("[Secondary] Failed to restore session:", error);
      secondaryClient = null;
      secondarySyncService = null;
      return false;
    }
  },

  startSync: async () => {
    try {
      await secondarySyncService?.start();
    } catch (error) {
      console.warn("[Secondary] Failed to start sync:", error);
    }
  },

  stopSync: async () => {
    try {
      await secondarySyncService?.stop();
    } catch (error) {
      console.warn("[Secondary] Failed to stop sync:", error);
    }
  },

  logout: async () => {
    try {
      await secondarySyncService?.stop();
    } catch {}
    try {
      await secondaryClient?.logout();
    } catch {}

    await clearSecondaryStore();
    SecondaryMatrixStorage.clear();

    secondaryClient = null;
    secondarySyncService = null;
  },
};
