import { Block, Text } from "@prototyp/skeletor";
import { useAtomValue } from "jotai";
import { NavigationContainerRef } from "modules/navigation/const";
import { StorageAtoms } from "modules/storage/jotai/atoms";
import type { FC } from "react";
import { Image, StyleSheet } from "react-native";
import { Button, UserImage } from "shared/components";
import { TextSize } from "shared/styles";

export const Header: FC = () => {
  const user = useAtomValue(StorageAtoms.cachedProfile);

  return (
    <Block
      flexDirection="row"
      justify="space-between"
      align="center"
      margins={[40, 0]}
      paddings={[0, 20]}
    >
      <Text size={TextSize.large}>Chat</Text>
      <Block flexDirection="row" align="center" gap={16}>
        <Button.Wrapper
          onPress={() => NavigationContainerRef.navigate("secure")}
          hitSlop={8}
        >
          <Image source={require("assets/icons/lock-simple.png")} style={styles.icon} />
        </Button.Wrapper>
        {user ? (
          <Button.Wrapper
            onPress={() => NavigationContainerRef.navigate("settings")}
          >
            <UserImage
              avatarUrl={user.avatarUrl}
              displayName={user.displayName}
              width={32}
              height={32}
            />
          </Button.Wrapper>
        ) : (
          <Block />
        )}
      </Block>
    </Block>
  );
};

const styles = StyleSheet.create({
  icon: {
    width: 24,
    height: 24,
    tintColor: "white",
  },
});
