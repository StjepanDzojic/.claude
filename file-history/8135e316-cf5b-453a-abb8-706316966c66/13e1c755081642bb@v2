import {
  Block,
  InputFocusScrollView,
  Text,
  useForm,
} from "@prototyp/skeletor";
import type {
  RoomInterface,
  RoomListEntriesUpdate,
  TaskHandleInterface,
} from "@unomed/react-native-matrix-sdk";
import {
  Membership,
  RoomListEntriesUpdate_Tags,
} from "@unomed/react-native-matrix-sdk";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import type { FC } from "react";
import { useEffect, useRef, useState } from "react";
import { FlatList, Image, StyleSheet } from "react-native";
import Toast from "react-native-toast-message";
import { Button, GoBackHeader, Input, Loading, ScreenLayout } from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { SecondaryMatrixStorage } from "modules/matrix-client/const/secondary-matrix-storage";
import { SecondaryMatrixService } from "modules/matrix-client/services/SecondaryMatrixService";
import { SecureRoomItem } from "./fragments/SecureRoomItem";

type Mode = "loading" | "login" | "rooms";

type FormState = {
  serverUrl: string;
  username: string;
  password: string;
};

export const SecureScreen: FC<NativeStackScreenProps<Routes, "secure">> = () => {
  const [mode, setMode] = useState<Mode>("loading");
  const [rooms, setRooms] = useState<RoomInterface[]>([]);
  const [isLoggingIn, setIsLoggingIn] = useState(false);
  const [passwordVisible, setPasswordVisible] = useState(false);

  const roomsRef = useRef<RoomInterface[]>([]);
  const streamHandleRef = useRef<TaskHandleInterface | null>(null);
  const stateHandleRef = useRef<TaskHandleInterface | null>(null);

  const form = useForm<FormState>({
    serverUrl: "",
    username: "",
    password: "",
  });

  const applyDiffs = (updates: RoomListEntriesUpdate[]) => {
    const current = [...roomsRef.current];

    for (const update of updates) {
      switch (update.tag) {
        case RoomListEntriesUpdate_Tags.Reset:
          current.splice(0, current.length, ...update.inner.values);
          break;
        case RoomListEntriesUpdate_Tags.Append:
          current.push(...update.inner.values);
          break;
        case RoomListEntriesUpdate_Tags.Clear:
          current.splice(0, current.length);
          break;
        case RoomListEntriesUpdate_Tags.Insert:
          current.splice(update.inner.index, 0, update.inner.value);
          break;
        case RoomListEntriesUpdate_Tags.Set:
          current[update.inner.index] = update.inner.value;
          break;
        case RoomListEntriesUpdate_Tags.Remove:
          current.splice(update.inner.index, 1);
          break;
        case RoomListEntriesUpdate_Tags.PushFront:
          current.unshift(update.inner.value);
          break;
        case RoomListEntriesUpdate_Tags.PushBack:
          current.push(update.inner.value);
          break;
        case RoomListEntriesUpdate_Tags.PopFront:
          current.shift();
          break;
        case RoomListEntriesUpdate_Tags.PopBack:
          current.pop();
          break;
        case RoomListEntriesUpdate_Tags.Truncate:
          current.splice(update.inner.length);
          break;
      }
    }

    roomsRef.current = current;

    const filtered = current.filter((room) => {
      const m = room.membership();
      return (
        m !== Membership.Banned &&
        m !== Membership.Left &&
        m !== Membership.Knocked
      );
    });

    setRooms([...filtered]);
  };

  const subscribeToRoomList = async () => {
    const syncService = SecondaryMatrixService.getSyncService();
    if (!syncService) return;

    try {
      const roomListService = syncService.roomListService();
      if (!roomListService) return;

      const roomList = await roomListService.allRooms();

      const entriesResult = roomList.entriesWithDynamicAdaptersWith(500, true, {
        onUpdate: (updates) => {
          applyDiffs(updates);
        },
      });

      streamHandleRef.current = entriesResult.entriesStream();
    } catch (error) {
      console.warn("[SecureScreen] Failed to subscribe to room list:", error);
    }
  };

  const cancelSubscription = () => {
    streamHandleRef.current?.cancel?.();
    stateHandleRef.current?.cancel?.();
    streamHandleRef.current = null;
    stateHandleRef.current = null;
    roomsRef.current = [];
  };

  // On mount: restore session if credentials exist, otherwise show login form
  useEffect(() => {
    const init = async () => {
      if (!SecondaryMatrixStorage.has()) {
        setMode("login");
        return;
      }

      const restored = await SecondaryMatrixService.restoreSession();
      if (!restored) {
        setMode("login");
        return;
      }

      await SecondaryMatrixService.startSync();
      await subscribeToRoomList();
      setMode("rooms");
    };

    init();

    return () => {
      SecondaryMatrixService.stopSync();
      cancelSubscription();
    };
  }, []);

  const handleLogin = async () => {
    if (!form.validateForm()) return;

    setIsLoggingIn(true);
    try {
      await SecondaryMatrixService.loginAndSetup(
        form.state.serverUrl.trim(),
        form.state.username.trim(),
        form.state.password,
      );
      await SecondaryMatrixService.startSync();
      await subscribeToRoomList();
      setMode("rooms");
    } catch (error) {
      console.error("[SecureScreen] Login failed:", error);
      Toast.show({
        type: "error",
        text1: "Login failed",
        text2: "Check your server URL, username and password.",
      });
    } finally {
      setIsLoggingIn(false);
    }
  };

  const handleLogout = async () => {
    cancelSubscription();
    setRooms([]);
    await SecondaryMatrixService.logout();
    form.update("serverUrl", "");
    form.update("username", "");
    form.update("password", "");
    setMode("login");
  };

  if (mode === "loading") {
    return (
      <ScreenLayout>
        <GoBackHeader title="Secure" />
        <Loading text="Restoring session..." />
      </ScreenLayout>
    );
  }

  if (mode === "login") {
    return (
      <ScreenLayout>
        {isLoggingIn && <Loading text="Signing in..." />}
        <InputFocusScrollView>
          {(focus) => (
            <Block flex={1}>
              <GoBackHeader title="Secure" />
              <Block gap={8} margins={{ marginBottom: 32 }}>
                <Text font="InstrumentSans-Medium" size={TextSize.large}>
                  Second account
                </Text>
                <Text
                  color={Colors.white80}
                  font="InstrumentSans-Regular"
                  size={TextSize.base}
                >
                  Sign in with a secondary Matrix account.
                </Text>
              </Block>

              <Block gap={8} margins={{ marginBottom: 20 }}>
                <Text size={TextSize.tiny} color={Colors.white50} paddings={[0, 16]}>
                  Server URL
                </Text>
                <Input
                  placeholder="https://matrix.example.com"
                  value={form.state.serverUrl}
                  keyboardType="url"
                  autoCapitalize="none"
                  onFocus={focus}
                  onChangeText={(v) => form.update("serverUrl", v)}
                />
              </Block>

              <Block gap={8} margins={{ marginBottom: 20 }}>
                <Text size={TextSize.tiny} color={Colors.white50} paddings={[0, 16]}>
                  Username
                </Text>
                <Input
                  placeholder="@user:matrix.example.com"
                  value={form.state.username}
                  keyboardType="email-address"
                  autoCapitalize="none"
                  onFocus={focus}
                  onChangeText={(v) => form.update("username", v)}
                />
              </Block>

              <Block gap={8}>
                <Text size={TextSize.tiny} color={Colors.white50} paddings={[0, 16]}>
                  Password
                </Text>
                <Input
                  placeholder="Password"
                  secureTextEntry={!passwordVisible}
                  value={form.state.password}
                  onFocus={focus}
                  onChangeText={(v) => form.update("password", v)}
                  onSubmitEditing={handleLogin}
                  rightIcon={
                    <Button.Wrapper
                      onPress={() => setPasswordVisible((prev) => !prev)}
                      hitSlop={8}
                      style={styles.eyeIconContainer}
                    >
                      <Image
                        source={
                          passwordVisible
                            ? require("assets/icons/eye.png")
                            : require("assets/icons/eye-slash.png")
                        }
                        style={styles.eyeIcon}
                      />
                    </Button.Wrapper>
                  }
                />
              </Block>
            </Block>
          )}
        </InputFocusScrollView>
        <Block paddings={{ padding: 20 }} gap={12} justify="flex-end" minHeight={100}>
          <Button.Primary disabled={isLoggingIn} onPress={handleLogin}>
            Sign in
          </Button.Primary>
        </Block>
      </ScreenLayout>
    );
  }

  return (
    <ScreenLayout paddings={{ paddingHorizontal: 0 }}>
      <GoBackHeader
        title="Secure"
        margins={[40, 20]}
        rightComp={
          <Button.Wrapper onPress={handleLogout} hitSlop={8}>
            <Text size={TextSize.tiny} color={Colors.white50}>
              Sign out
            </Text>
          </Button.Wrapper>
        }
      />
      <FlatList
        data={rooms}
        keyExtractor={(item) => item.id()}
        renderItem={({ item }) => <SecureRoomItem room={item} />}
        ListEmptyComponent={
          <Block align="center" margins={{ marginTop: 40 }}>
            <Text color={Colors.white50} size={TextSize.base}>
              No rooms yet. Syncing...
            </Text>
          </Block>
        }
        style={styles.list}
      />
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  list: {
    flex: 1,
  },
  eyeIcon: {
    width: 20,
    height: 20,
    tintColor: "white",
  },
  eyeIconContainer: {
    paddingRight: 16,
  },
});
