import {
  BackupDownloadStrategy,
  ClientBuilder,
  type ClientInterface,
  SlidingSyncVersion,
  SlidingSyncVersionBuilder,
  type SyncServiceInterface,
} from "@unomed/react-native-matrix-sdk";
import RNFS from "react-native-fs";
import { SecondaryMatrixStorage } from "../const/secondary-matrix-storage";

const secondaryDataPath = `${RNFS.DocumentDirectoryPath}/matrix/secondary/data`;
const secondaryCachePath = `${RNFS.CachesDirectoryPath}/matrix/secondary/cache`;

export class SecondaryMatrixService {
  public static instance: ClientInterface | null = null;
  public static syncService: SyncServiceInterface | null = null;

  private static async clearStore() {
    try {
      if (await RNFS.exists(secondaryDataPath))
        await RNFS.unlink(secondaryDataPath);
      if (await RNFS.exists(secondaryCachePath))
        await RNFS.unlink(secondaryCachePath);
    } catch (error) {
      console.warn("[Secondary] Failed to clear crypto store:", error);
    }
  }

  private static async initializeFresh(serverUrl: string) {
    SecondaryMatrixService.instance = await new ClientBuilder()
      .serverNameOrHomeserverUrl(serverUrl)
      .sessionPaths(secondaryDataPath, secondaryCachePath)
      .autoEnableCrossSigning(false)
      .autoEnableBackups(false)
      .backupDownloadStrategy(BackupDownloadStrategy.AfterDecryptionFailure)
      .build();
  }

  private static async initializeForRestore(
    homeserverUrl: string,
    userId: string,
  ) {
    SecondaryMatrixService.instance = await new ClientBuilder()
      .homeserverUrl(homeserverUrl)
      .username(userId)
      .slidingSyncVersionBuilder(SlidingSyncVersionBuilder.Native)
      .sessionPaths(secondaryDataPath, secondaryCachePath)
      .autoEnableCrossSigning(false)
      .autoEnableBackups(false)
      .backupDownloadStrategy(BackupDownloadStrategy.AfterDecryptionFailure)
      .build();
  }

  public static getClient(): ClientInterface {
    if (!SecondaryMatrixService.instance) {
      throw new Error("Secondary Matrix client is not initialized");
    }
    return SecondaryMatrixService.instance;
  }

  /**
   * Full login flow: initialize → login → save credentials → rebuild client → restore session → create sync service.
   * Mirrors the AuthService.login + AuthService.setup pattern.
   */
  public static loginAndSetup = async (
    serverUrl: string,
    username: string,
    password: string,
  ) => {
    await SecondaryMatrixService.initializeFresh(serverUrl);

    if (!SecondaryMatrixService.instance)
      throw new Error("Failed to initialize secondary client");

    await SecondaryMatrixService.instance.login(
      username,
      password,
      undefined,
      undefined,
    );
    const session = SecondaryMatrixService.instance.session();

    SecondaryMatrixService.instance = null;
    await SecondaryMatrixService.clearStore();

    SecondaryMatrixStorage.save({
      accessToken: session.accessToken,
      refreshToken: session.refreshToken,
      userId: session.userId,
      deviceId: session.deviceId,
      baseUrl: session.homeserverUrl,
    });

    await SecondaryMatrixService.initializeForRestore(
      session.homeserverUrl,
      session.userId,
    );

    const client = SecondaryMatrixService.getClient();

    await client.restoreSession({
      accessToken: session.accessToken,
      refreshToken: session.refreshToken,
      userId: session.userId,
      deviceId: session.deviceId,
      homeserverUrl: session.homeserverUrl,
      oidcData: undefined,
      slidingSyncVersion: SlidingSyncVersion.Native,
    });

    console.log(client.userId());

    SecondaryMatrixService.syncService = await client.syncService().finish();
  };

  public static restoreSession = async (): Promise<boolean> => {
    try {
      const creds = SecondaryMatrixStorage.get();
      if (!creds) return false;

      if (!SecondaryMatrixService.instance) {
        await SecondaryMatrixService.initializeForRestore(
          creds.baseUrl,
          creds.userId,
        );
      }

      const client = SecondaryMatrixService.getClient();

      await client.restoreSession({
        accessToken: creds.accessToken,
        refreshToken: creds.refreshToken,
        userId: creds.userId,
        deviceId: creds.deviceId,
        homeserverUrl: creds.baseUrl,
        oidcData: undefined,
        slidingSyncVersion: SlidingSyncVersion.Native,
      });

      SecondaryMatrixService.syncService = await client
        .syncService()
        .withOfflineMode()
        .finish();

      return true;
    } catch (error) {
      console.warn("[Secondary] Failed to restore session:", error);
      SecondaryMatrixService.instance = null;
      SecondaryMatrixService.syncService = null;
      return false;
    }
  };

  public static startSync = async () => {
    try {
      await SecondaryMatrixService.syncService?.start();
    } catch (error) {
      console.warn("[Secondary] Failed to start sync:", error);
    }
  };

  public static stopSync = async () => {
    try {
      await SecondaryMatrixService.syncService?.stop();
    } catch (error) {
      console.warn("[Secondary] Failed to stop sync:", error);
    }
  };

  public static logout = async () => {
    try {
      await SecondaryMatrixService.syncService?.stop();
    } catch {}
    try {
      await SecondaryMatrixService.instance?.logout();
    } catch {}

    await SecondaryMatrixService.clearStore();
    SecondaryMatrixStorage.clear();

    SecondaryMatrixService.instance = null;
    SecondaryMatrixService.syncService = null;
  };
}
