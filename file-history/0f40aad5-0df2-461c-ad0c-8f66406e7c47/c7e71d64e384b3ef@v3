import { getAuth } from 'firebase/auth';
import { getFirestore } from 'firebase/firestore';
import { getFunctions } from 'firebase/functions';
import { getStorage } from 'firebase/storage';
import { firebaseApp } from './initFirebaseAuth';

export class FirebaseService {
  public static Auth = getAuth(firebaseApp);
  public static Firestore = getFirestore(firebaseApp);
  public static Functions = getFunctions(firebaseApp, 'europe-west1');
  public static Storage = getStorage(firebaseApp);
}

