'use client';
import { FirebaseError } from 'firebase/app';
import { useSetAtom } from 'jotai';
import { useEffect } from 'react';
import { toast } from 'react-toastify';
import { FirebaseAuth } from '../../firebase/initFirebaseAuth';
import { getLoginErrorMessage } from '../../firebase/utils';
import { authAtoms } from '../store';

const isRoleTypeGuard = (role: string): role is Role => {
  return role === 'admin' || role === 'vendor' || role === 'super-admin';
};

export const useFirebaseAuthListener = () => {
  const setLoading = useSetAtom(authAtoms.loading);
  const setUid = useSetAtom(authAtoms.uid);
  const setUserEmail = useSetAtom(authAtoms.userEmail);
  const setUserRole = useSetAtom(authAtoms.userRole);

  useEffect(() => {
    setLoading(true);

    const unsubscribe = FirebaseAuth.onAuthStateChanged(
      async (user) => {
        try {
          if (!user?.uid) setUserRole(null);
          setUid(user?.uid || null);
          setUserEmail(user?.email || null);

          const token = await user?.getIdTokenResult();

          if (
            token?.claims?.roles &&
            Array.isArray(token.claims.roles) &&
            token.claims.roles.length > 0 &&
            isRoleTypeGuard(token.claims.roles[0].role)
          ) {
            setUserRole(token.claims.roles[0].role);
          }
        } catch (error) {
          if (error instanceof FirebaseError) {
            const errorCode = error.code;
            toast.error(getLoginErrorMessage(errorCode));
          }
        } finally {
          setLoading(false);
        }
      },
    );

    return () => {
      unsubscribe();
    };
  }, [setLoading, setUid, setUserEmail, setUserRole]);
};
