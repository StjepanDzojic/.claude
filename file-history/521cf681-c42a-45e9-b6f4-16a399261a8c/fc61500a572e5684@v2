type EventTimelineItem =
  import("@unomed/react-native-matrix-sdk").EventTimelineItem;

type ForwardMessageType = "text" | "image" | "video" | "audio" | "file";

type MembershipTag =
  import("@unomed/react-native-matrix-sdk").MembershipState_Tags;

type TimelineLongPressPayload = {
  event: EventTimelineItem;
  content: string;
  messageType: ForwardMessageType;
};

type MediaSourceInterface =
  import("@unomed/react-native-matrix-sdk").MediaSourceInterface;

type TimelineReplyPayload = {
  eventId: string;
  senderName: string;
  content: string;
  mediaSource?: {
    source: MediaSourceInterface;
    mimetype: string;
  } | null;
  isUnavailable?: boolean;
};

type TimelineEditPayload = {
  event: EventTimelineItem;
  senderName: string;
  content: string;
};

type TimelineReportPayload = {
  event: EventTimelineItem;
  senderId: string;
  content: string;
};

interface MemberDetailsPayload {
  userId: string;
  displayName: string;
  avatarUrl: string | null;
  membershipTag?: MembershipTag;
}

type TimelineListItem =
  | { type: "event"; data: EventTimelineItem; isPreviousSameSender: boolean }
  | { type: "divider"; date: string; id: string }
  | { type: "group"; events: EventTimelineItem[]; id: string };

type ViolatingUser = {
  userId: string;
  displayName: string;
  avatarUrl: string | null;
  violationType: "pin" | "verification";
};

interface TimelineReactionSender {
  userId: string;
  timestamp: number;
}

interface TimelineSeenByUser {
  userId: string;
  timestamp: number | null;
}

interface TimelineReaction {
  key: string;
  displayKey: string;
  count: number;
  latestTimestamp: number;
  isHighlighted: boolean;
  senders: TimelineReactionSender[];
}

interface TimelineShieldPayload {
  isRed: boolean;
  message: string;
}
