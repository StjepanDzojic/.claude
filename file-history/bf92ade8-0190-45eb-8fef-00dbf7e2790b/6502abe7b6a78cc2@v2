import type { RoomInterface } from "@unomed/react-native-matrix-sdk";
import { MatrixJotaiStore } from "../const/matrx-jotai-store";
import { MatrixAtoms } from "../jotai";

const lastEventTimestampMap = new Map<string, bigint>();

export const updateRoomTimestampAndSort = (
  roomId: string,
  timestamp: bigint,
) => {
  lastEventTimestampMap.set(roomId, timestamp);

  const currentRooms = MatrixJotaiStore.get(MatrixAtoms.roomList);
  const sorted = [...currentRooms].sort(
    (a: RoomInterface, b: RoomInterface) => {
      const tsA = lastEventTimestampMap.get(a.id()) ?? 0n;
      const tsB = lastEventTimestampMap.get(b.id()) ?? 0n;
      return tsB > tsA ? 1 : tsB < tsA ? -1 : 0;
    },
  );
  MatrixJotaiStore.set(MatrixAtoms.roomList, sorted);
};
