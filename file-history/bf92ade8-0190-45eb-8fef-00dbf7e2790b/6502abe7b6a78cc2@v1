import type { Room } from "matrix-js-sdk";

export function getSortedRoomsByLastMessage(rooms: Room[]): Room[] {
  return rooms
    .filter((room) => room.getLiveTimeline().getEvents().length > 0)
    .sort((a, b) => {
      const aEvents = a.getLiveTimeline().getEvents();
      const bEvents = b.getLiveTimeline().getEvents();

      const aLast = aEvents[aEvents.length - 1]?.getTs() || 0;
      const bLast = bEvents[bEvents.length - 1]?.getTs() || 0;

      return bLast - aLast;
    });
}
