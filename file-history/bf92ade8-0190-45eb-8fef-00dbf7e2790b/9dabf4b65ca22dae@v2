import { Block, Text } from "@prototyp/skeletor";
import {
  type EventTimelineItem,
  Membership,
  type RoomInfo,
  type RoomInterface,
  RoomNotificationMode,
} from "@unomed/react-native-matrix-sdk";

import { format, isThisWeek, isToday, isYesterday } from "date-fns";
import { useAtomValue } from "jotai";
import { MatrixJotaiStore } from "modules/matrix-client/const/matrx-jotai-store";
import { MatrixAtoms } from "modules/matrix-client/jotai";
import { getLastMessageType } from "modules/matrix-client/utils";
import { NavigationContainerRef } from "modules/navigation/const";
import { MatrixNotificationService } from "modules/push-notifications/service/MatrixNotificationService";
import { useRoomMembers } from "modules/room/hooks";
import {
  type FC,
  memo,
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import { Image, StyleSheet, Vibration, type View } from "react-native";
import { Gesture, GestureDetector } from "react-native-gesture-handler";
import { runOnJS } from "react-native-reanimated";
import { Button, Loading, RoomImage } from "shared/components";
import { useLeaveRoom } from "shared/hooks";
import { Colors, TextSize } from "shared/styles";
import { RoomContextMenu, RoomInviteActions } from "./fragments";

const lastMessageCache = new Map<string, EventTimelineItem | null>();
const isMutedCache = new Map<string, boolean>();

interface Props {
  room: RoomInterface;
}

const formatTimestamp = (timestamp: bigint | undefined) => {
  if (!timestamp) return "";

  const date = new Date(Number(Number(timestamp)));

  if (isToday(date)) return format(date, "HH:mm");

  if (isYesterday(date)) return "Yesterday";

  if (isThisWeek(date)) return format(date, "EEEE");

  return format(date, "d. M. yyyy.");
};

const RoomsListItemComponent: FC<Props> = ({ room }) => {
  const { members, fetchMembers } = useRoomMembers(room);
  const { isLeavingRoom, leaveRoom } = useLeaveRoom(room, members);

  const roomInfoMap = useAtomValue(MatrixAtoms.roomInfoMap);
  const roomInfo = roomInfoMap.get(room.id());

  const [lastMessage, setLastMessage] = useState<EventTimelineItem | undefined>(
    undefined,
  );
  const hasUnread = useMemo(
    () =>
      !!Number(roomInfo?.numUnreadNotifications) || !!roomInfo?.isMarkedUnread,
    [roomInfo],
  );
  const isFavorite = useMemo(() => !!roomInfo?.isFavourite, [roomInfo]);
  const isSecure = false;
  const isRoomInvite = useMemo(
    () => roomInfo?.membership === Membership.Invited,
    [roomInfo],
  );
  const roomInviter = useMemo(
    () => roomInfo?.inviter?.displayName ?? roomInfo?.inviter?.userId,
    [roomInfo],
  );
  const [isMuted, setIsMuted] = useState(false);
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const itemRef = useRef<View>(null);

  const handlePress = useCallback(() => {
    NavigationContainerRef.navigate("room", { roomId: room.id() });
  }, [room]);

  useEffect(() => {
    const abortController = new AbortController();
    const roomId = room.id();

    // Populate state from cache immediately so FlashList recycles show data
    // instantly without waiting for async fetches
    if (lastMessageCache.has(roomId)) {
      setLastMessage(lastMessageCache.get(roomId) ?? undefined);
    }
    if (isMutedCache.has(roomId)) {
      setIsMuted(isMutedCache.get(roomId) ?? false);
    }

    const fetchLastMessage = async () => {
      if (lastMessageCache.has(roomId)) return;
      try {
        const latest = await room.latestEvent();
        if (latest !== undefined) {
          lastMessageCache.set(roomId, latest);
          setLastMessage(latest);
          return;
        }
        const timeline = await room.timeline({
          signal: abortController.signal,
        });
        const latestEventId = await timeline.latestEventId({
          signal: abortController.signal,
        });
        if (latestEventId) {
          const event = await timeline.getEventTimelineItemByEventId(
            latestEventId,
            { signal: abortController.signal },
          );
          lastMessageCache.set(roomId, event ?? null);
          setLastMessage(event);
        }
      } catch (error) {
        if (!abortController.signal.aborted) {
          console.error(error);
        }
      }
    };

    const fetchIsMuted = async () => {
      if (isMutedCache.has(roomId)) return;
      try {
        const ns = await MatrixNotificationService.getNotificationSettings();
        const mode = await ns.getUserDefinedRoomNotificationMode(roomId);
        const muted = mode === RoomNotificationMode.Mute;
        isMutedCache.set(roomId, muted);
        setIsMuted(muted);
      } catch (error) {
        console.error(error);
      }
    };

    fetchLastMessage();
    fetchIsMuted();

    return () => abortController.abort();
  }, [room]);

  const handleRoomInfoUpdated = useCallback(
    (info: RoomInfo) => {
      const currentMap = MatrixJotaiStore.get(MatrixAtoms.roomInfoMap);
      const newMap = new Map(currentMap);
      newMap.set(room.id(), info);
      MatrixJotaiStore.set(MatrixAtoms.roomInfoMap, newMap);
    },
    [room],
  );

  const openContextMenu = () => {
    setIsMenuOpen(true);
  };

  const closeContextMenu = () => {
    setIsMenuOpen(false);
  };

  const longPress = useMemo(
    () =>
      Gesture.LongPress()
        .minDuration(500)
        .onStart(() => {
          if (isRoomInvite) return;
          runOnJS(Vibration.vibrate)(1);
          runOnJS(openContextMenu)();
        }),
    [isRoomInvite, openContextMenu],
  );

  return (
    <Block border={{ borderBottomWidth: 1, borderColor: Colors.white10 }}>
      {isLeavingRoom && (
        <Block
          absolute
          offsets={[0, 0, 0, 0]}
          zIndex={9999}
          background={Colors.black70}
        >
          <Loading isFullScreen={false} />
        </Block>
      )}
      <GestureDetector gesture={longPress}>
        <Button.Wrapper
          ref={itemRef}
          key={room.id()}
          style={styles.wrapper}
          onPress={handlePress}
        >
          <Block margins={{ marginRight: 8 }}>
            <RoomImage room={room} width={32} height={32} />
            {hasUnread && (
              <Block
                width={10}
                height={10}
                background={Colors.primary}
                border={{ borderRadius: 48 }}
                absolute
                offsets={{ left: -18, top: 12 }}
              />
            )}
          </Block>
          <Block flex={1}>
            <Block flexDirection="row" gap={12} flex={1}>
              <Block flex={1}>
                <Block flexDirection="row" align="center" gap={8}>
                  <Image
                    source={
                      isSecure
                        ? require("assets/icons/lock.png")
                        : require("assets/icons/lock-open.png")
                    }
                    width={12}
                    height={12}
                    tintColor={isSecure ? Colors.success : Colors.white}
                  />
                  <Text
                    size={TextSize.base}
                    color={isSecure ? Colors.success : "white"}
                  >
                    {room.displayName()}
                  </Text>
                </Block>
                <Text
                  size={TextSize.tiny}
                  color={hasUnread ? Colors.white : Colors.white50}
                  numberOfLines={3}
                >
                  {isRoomInvite
                    ? `${roomInviter ?? "Someone"} invited you to join this room`
                    : getLastMessageType(lastMessage)}
                </Text>
              </Block>
              <Block>
                <Block flexDirection="row" gap={12}>
                  <Block align="flex-end" gap={4} margins={{ marginTop: 4 }}>
                    {lastMessage?.timestamp && (
                      <Text
                        size={TextSize.tiny}
                        color={hasUnread ? Colors.white : Colors.white50}
                      >
                        {formatTimestamp(lastMessage?.timestamp)}
                      </Text>
                    )}
                    {isMuted && (
                      <Image
                        source={require("assets/icons/bell-slash.png")}
                        width={16}
                        height={16}
                        tintColor={Colors.white50}
                        style={styles.bellSlash}
                      />
                    )}
                  </Block>
                  <Image
                    source={require("assets/icons/caret-left.png")}
                    style={styles.caret}
                    tintColor={Colors.white10}
                  />
                </Block>
              </Block>
            </Block>
          </Block>
        </Button.Wrapper>
      </GestureDetector>
      {isRoomInvite && <RoomInviteActions roomId={room.id()} />}
      {isMenuOpen && (
        <RoomContextMenu
          room={room}
          roomInfo={roomInfo}
          hasUnread={hasUnread}
          isFavorite={isFavorite}
          isVisible={isMenuOpen}
          leaveRoom={leaveRoom}
          fetchMembers={fetchMembers}
          onClose={closeContextMenu}
          onRoomInfoUpdated={handleRoomInfoUpdated}
        />
      )}
    </Block>
  );
};

export const RoomsListItem = memo(RoomsListItemComponent);

const styles = StyleSheet.create({
  wrapper: {
    minHeight: 76,
    gap: 8,
    padding: 20,
    flexDirection: "row",
  },
  caret: {
    transform: [{ rotate: "180deg" }],
    width: 24,
    height: 24,
  },
  bellSlash: {
    width: 16,
    height: 16,
  },
});
