import { z } from 'zod';
import { buildUrl, isWriteMethod, parseResponse } from './http-internal';

/**
 * Browser-safe HTTP client. Sends the PUBLISHABLE key.
 *
 * Use this from:
 *   - Client components
 *   - Hooks / event handlers
 *   - ANY code that might run in the browser bundle
 *
 * For endpoints that require the secret key, use `httpServer` from
 * `./http-server` instead — importing that module from client code throws.
 *
 * Env:
 *   NEXT_PUBLIC_API_BASE_URL         — e.g. https://api.example.com/v1
 *   NEXT_PUBLIC_API_PUBLISHABLE_KEY  — safe to expose to browsers
 *
 * `RequestOptions` / `HttpMethod` are global (see `types/http-service.d.ts`).
 */

export { ApiError, envelope } from './http-internal';

class HttpClient {
  constructor(
    private readonly baseUrl: string,
    private readonly apiKey: string,
  ) {}

  private buildHeaders(args: {
    method: HttpMethod;
    hasBody: boolean;
    idempotencyKey?: string;
    extra?: HeadersInit;
  }): HeadersInit {
    const headers: Record<string, string> = { Accept: 'application/json' };

    if (args.hasBody) {
      headers['Content-Type'] = 'application/json';
    }

    if (this.apiKey) {
      headers['x-easy-api-key'] = this.apiKey;
    }

    if (args.idempotencyKey && isWriteMethod(args.method)) {
      headers['Idempotency-Key'] = args.idempotencyKey;
    }

    return { ...headers, ...args.extra };
  }

  private async request<TBody = unknown>(
    options: RequestOptions<TBody>,
  ): Promise<unknown> {
    const { path, method = 'GET', query, body, headers, idempotencyKey, signal, cache, next } = options;
    const hasBody = body !== undefined && method !== 'GET' && method !== 'DELETE';

    const response = await fetch(buildUrl(this.baseUrl, path, query), {
      method,
      signal,
      cache,
      next,
      headers: this.buildHeaders({ method, hasBody, idempotencyKey, extra: headers }),
      body: hasBody ? JSON.stringify(body) : undefined,
    });

    return parseResponse(response);
  }

  private async send<TSchema extends z.ZodTypeAny, TBody = unknown>(
    schema: TSchema,
    options: RequestOptions<TBody>,
  ): Promise<z.infer<TSchema>> {
    const raw = await this.request<TBody>(options);
    return schema.parse(raw) as z.infer<TSchema>;
  }

  get<TSchema extends z.ZodTypeAny>(
    schema: TSchema,
    options: Omit<RequestOptions, 'method' | 'body'>,
  ) {
    return this.send(schema, { ...options, method: 'GET' });
  }

  post<TSchema extends z.ZodTypeAny, TBody = unknown>(
    schema: TSchema,
    options: Omit<RequestOptions<TBody>, 'method'>,
  ) {
    return this.send<TSchema, TBody>(schema, { ...options, method: 'POST' });
  }

  put<TSchema extends z.ZodTypeAny, TBody = unknown>(
    schema: TSchema,
    options: Omit<RequestOptions<TBody>, 'method'>,
  ) {
    return this.send<TSchema, TBody>(schema, { ...options, method: 'PUT' });
  }

  patch<TSchema extends z.ZodTypeAny, TBody = unknown>(
    schema: TSchema,
    options: Omit<RequestOptions<TBody>, 'method'>,
  ) {
    return this.send<TSchema, TBody>(schema, { ...options, method: 'PATCH' });
  }

  delete<TSchema extends z.ZodTypeAny>(
    schema: TSchema,
    options: Omit<RequestOptions, 'method' | 'body'>,
  ) {
    return this.send(schema, { ...options, method: 'DELETE' });
  }
}

export const http = new HttpClient(
  process.env.NEXT_PUBLIC_API_BASE_URL ?? '',
  process.env.NEXT_PUBLIC_API_PUBLISHABLE_KEY ?? '',
);
