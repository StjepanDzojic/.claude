/**
 * Types for our own Route Handler at `/api/embedded-checkout`.
 *
 * These describe the INTERNAL contract between the browser and our backend,
 * not the external 3rd-party checkout API (see `services/` for that).
 *
 * Kept in a plain `.ts` file so Zod schemas can be derived from the same
 * source of truth; the sibling `.d.ts` re-declares each inferred type as
 * a global name so consumers never need to `import` them.
 */

import * as z from 'zod';

const MAX_AMOUNT = 10_000_000;

export const CreateEmbeddedCheckoutRequestSchema = z.object({
  projectId: z.string().min(1),
  amount: z.number().int().positive().max(MAX_AMOUNT),
  /**
   * Stable per-attempt key the client can send so retries don't create duplicate
   * sessions. Optional — if omitted, the server generates a fresh UUID and
   * retries are NOT idempotent.
   */
  idempotencyKey: z.string().min(1).max(255).optional(),
});

export const CreateEmbeddedCheckoutSessionDataSchema = z.object({
  id: z.string(),
  url: z.string(),
  client_secret: z.string(),
  amount_total: z.number().int().nonnegative(),
  currency: z.string(),
  status: z.string(),
  expires_at: z.string(),
});

export const CreateEmbeddedCheckoutResponseSchema = z.object({
  success: z.literal(true),
  timestamp: z.string(),
  message: z.string().optional(),
  data: CreateEmbeddedCheckoutSessionDataSchema,
});

export const CreateEmbeddedCheckoutErrorSchema = z.object({
  error: z.object({
    code: z.string(),
    message: z.string(),
    details: z.unknown().optional(),
  }),
});

export type CreateEmbeddedCheckoutRequest = z.infer<
  typeof CreateEmbeddedCheckoutRequestSchema
>;
export type CreateEmbeddedCheckoutSessionData = z.infer<
  typeof CreateEmbeddedCheckoutSessionDataSchema
>;
export type CreateEmbeddedCheckoutResponse = z.infer<
  typeof CreateEmbeddedCheckoutResponseSchema
>;
export type CreateEmbeddedCheckoutErrorResponse = z.infer<
  typeof CreateEmbeddedCheckoutErrorSchema
>;

export const EMBEDDED_CHECKOUT_MAX_AMOUNT = MAX_AMOUNT;
