import { Block, Text } from "@prototyp/skeletor";
import { FlashList } from "@shopify/flash-list";
import type { EventTimelineItem } from "@unomed/react-native-matrix-sdk";
import { type FC, useCallback } from "react";
import { StyleSheet } from "react-native";
import { Loading } from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { MediaThumbnail } from "../media-thumbnail";

const NUM_COLUMNS = 4;
const SPACING = 2;

const keyExtractor = (item: EventTimelineItem) => {
  const eventId = item.eventOrTransactionId;
  if (eventId?.tag === "EventId") return eventId.inner.eventId;
  if (eventId?.tag === "TransactionId") return eventId.inner.transactionId;
  return String(item.timestamp);
};

interface Props {
  items: EventTimelineItem[];
  loading: boolean;
  isEmpty: boolean;
  onPressItem: (uri: string | null, type?: "image" | "video") => void;
}

export const MediaList: FC<Props> = ({
  items,
  loading,
  isEmpty,
  onPressItem,
}) => {
  const ListEmpty = useCallback(() => {
    if (loading) {
      return (
        <Block align="center" justify="center" flex={1} paddings={40}>
          <Loading isFullScreen={false} />
        </Block>
      );
    }

    return (
      <Block align="center" justify="center" flex={1} paddings={40}>
        <Text size={TextSize.medium} color={Colors.white50}>
          No media found
        </Text>
      </Block>
    );
  }, [loading]);

  return (
    <FlashList
      data={items}
      renderItem={({ item, index }) => (
        <Block
          margins={{
            marginRight: (index + 1) % NUM_COLUMNS === 0 ? 0 : SPACING,
            marginBottom: SPACING,
          }}
        >
          <MediaThumbnail item={item} onPress={onPressItem} />
        </Block>
      )}
      keyExtractor={keyExtractor}
      numColumns={NUM_COLUMNS}
      contentContainerStyle={styles.listContent}
      ListEmptyComponent={ListEmpty}
      ListFooterComponent={
        loading && !isEmpty ? (
          <Block align="center" justify="center" flex={1} paddings={40}>
            <Loading isFullScreen={false} />
          </Block>
        ) : null
      }
      showsVerticalScrollIndicator={false}
    />
  );
};

const styles = StyleSheet.create({
  listContent: {
    padding: SPACING,
    flexGrow: 1,
  },
});
