import ReactNativeBlobUtil from "react-native-blob-util";

//TODO: Add encryption for cached images

const CacheDir = `${ReactNativeBlobUtil.fs.dirs.CacheDir}/images`;
const PrefixlessCacheDir = CacheDir.replace("file://", "");
const CurrentBatch = new Map<string, Promise<void>>();
let CacheDirReady = false;

function getFilenameByURL(url: string) {
  let hash = 0;
  for (let i = 0; i < url.length; i++) {
    hash = (hash << 5) - hash + url.charCodeAt(i);
    hash |= 0; // Convert to 32bit integer
  }
  return (hash >>> 0).toString(36);
}

/** Returns storage filename associated with provided URL, including the file:// prefix */
export function getCachedImagePathByURL(url: string) {
  const fileName = getFilenameByURL(url);
  // Ensure the base CacheDir is just a path, not prefixed, before joining.
  // Then add the file:// prefix at the end.
  return `file://${PrefixlessCacheDir}/${fileName}`;
}

function getStoragePathByUrl(url: string) {
  const fileName = getFilenameByURL(url);
  return `${PrefixlessCacheDir}/${fileName}`;
}

// TODO: if encrypted media thumbnails ever break, use fs.cp() for file:// urls
// like video-caching.ts does, since fetchMedia returns a local temp path for encrypted sources
async function downloadToPath(url: string, localFilePath: string) {
  const responseRaw = await ReactNativeBlobUtil.config({
    path: localFilePath,
  }).fetch("GET", url);

  const response = responseRaw.info();
  const status = response.status;

  if (status < 200 || status >= 300) {
    // Remove invalid cached file
    await ReactNativeBlobUtil.fs.unlink(localFilePath);
    throw new Error(`Unable to cache ${url}, http ${status}`);
  }
}

async function ensureCached(
  cacheKey: string,
  downloadUrl: string,
): Promise<void> {
  if (CurrentBatch.has(cacheKey)) {
    return CurrentBatch.get(cacheKey);
  }

  const localFilePath = getStoragePathByUrl(cacheKey);
  const cachingPromise = (async () => {
    try {
      if (!CacheDirReady) {
        const dirExists = await ReactNativeBlobUtil.fs.exists(CacheDir);
        if (!dirExists) await ReactNativeBlobUtil.fs.mkdir(CacheDir);
        CacheDirReady = true;
      }

      const fileExists = await ReactNativeBlobUtil.fs.exists(localFilePath);
      if (!fileExists) {
        await downloadToPath(downloadUrl, localFilePath);
      } else {
        const stat = await ReactNativeBlobUtil.fs.stat(localFilePath);
        if (!stat || stat.size === 0) {
          await ReactNativeBlobUtil.fs.unlink(localFilePath);
          await downloadToPath(downloadUrl, localFilePath);
        }
      }
    } catch (error) {
      console.warn(
        `Failed to cache image ${downloadUrl} to ${localFilePath}:`,
        error,
      );
    } finally {
      CurrentBatch.delete(cacheKey);
    }
  })();

  CurrentBatch.set(cacheKey, cachingPromise);
  return cachingPromise;
}

/** Returns true if the image for the given URL is already cached on disk. */
export async function isCached(url: string): Promise<boolean> {
  const localFilePath = getStoragePathByUrl(url);
  try {
    const fileExists = await ReactNativeBlobUtil.fs.exists(localFilePath);
    if (!fileExists) return false;
    const stat = await ReactNativeBlobUtil.fs.stat(localFilePath);
    return !!stat && stat.size > 0;
  } catch {
    return false;
  }
}

/**
 * Caches downloaded image and returns a Promise that resolves when the image is fully written.
 * Handles concurrent requests for the same URL.
 */
export async function cacheImage(url: string): Promise<void> {
  return ensureCached(url, url);
}

/**
 * Caches an image using `cacheKey` as the cache identifier (e.g. MXC URL)
 * but downloads from `downloadUrl` (e.g. authenticated HTTP URL).
 */
export async function cacheImageWithKey(
  cacheKey: string,
  downloadUrl: string,
): Promise<void> {
  return ensureCached(cacheKey, downloadUrl);
}

/** Removes all cached images from disk. Call on logout. */
export async function clearImageCache(): Promise<void> {
  try {
    const dirExists = await ReactNativeBlobUtil.fs.exists(CacheDir);
    if (dirExists) {
      await ReactNativeBlobUtil.fs.unlink(CacheDir);
    }
  } catch (error) {
    console.warn("Failed to clear image cache:", error);
  } finally {
    CacheDirReady = false;
    CurrentBatch.clear();
  }
}
