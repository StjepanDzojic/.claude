import { Block } from "@prototyp/skeletor";
import {
  type EventTimelineItem,
  type ImageMessageContent,
  MessageType_Tags,
  MsgLikeKind_Tags,
  TimelineItemContent_Tags,
  type VideoMessageContent,
} from "@unomed/react-native-matrix-sdk";
import { MatrixBaseURL } from "modules/matrix-client/const";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { fetchMedia } from "modules/matrix-client/utils";
import { type FC, useEffect, useState } from "react";
import { Dimensions, Image } from "react-native";
import Video from "react-native-video";
import { Button, Loading } from "shared/components";
import { Colors } from "shared/styles";
import {
  cacheImageWithKey,
  getCachedImagePathByURL,
  isCached,
} from "shared/utils/image-caching";

const NUM_COLUMNS = 4;
const SPACING = 2;
const HORIZONTAL_SPACING = 40; // Each padding is 20px
const { width: SCREEN_WIDTH } = Dimensions.get("window");
const ITEM_SIZE =
  (SCREEN_WIDTH - SPACING * (NUM_COLUMNS + 1) - HORIZONTAL_SPACING) /
  NUM_COLUMNS;

interface MediaThumbnailProps {
  item: EventTimelineItem;
  onPress: (uri: string | null, type?: "image" | "video") => void;
}

function getMediaInfo(item: EventTimelineItem): {
  type: "image" | "video";
  content: ImageMessageContent | VideoMessageContent;
} | null {
  if (item.content.tag === TimelineItemContent_Tags.MsgLike) {
    const content = item.content.inner.content;
    if (content.kind.tag === MsgLikeKind_Tags.Message) {
      const msgType = content.kind.inner.content.msgType;
      if (msgType?.tag === MessageType_Tags.Image) {
        return { type: "image", content: msgType.inner.content };
      }
      if (msgType?.tag === MessageType_Tags.Video) {
        return { type: "video", content: msgType.inner.content };
      }
    }
  }
  return null;
}

export const MediaThumbnail: FC<MediaThumbnailProps> = ({ item, onPress }) => {
  const [uri, setUri] = useState<string | null>(null);
  const [info, setInfo] = useState<{
    type: "image" | "video";
    content: ImageMessageContent | VideoMessageContent;
  } | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const loadMedia = async () => {
      try {
        setLoading(true);
        const info = getMediaInfo(item);
        setInfo(info);

        if (!info) return;

        const mxcUrl = info?.content.source.url();
        if (!mxcUrl) return;

        if (await isCached(mxcUrl)) {
          setUri(getCachedImagePathByURL(mxcUrl));
          return;
        }

        const url = await fetchMedia({
          serverUrl:
            MatrixCore.instance?.session().homeserverUrl || MatrixBaseURL,
          mediaSource: info.content.source,
          mimeType:
            info.type === "image"
              ? info.content.info?.mimetype || "image/jpeg"
              : info.content.info?.mimetype || "video/mp4",
        });

        if (!url) return;

        await cacheImageWithKey(mxcUrl, url);
        setUri(getCachedImagePathByURL(mxcUrl));
      } catch (e) {
        console.error("Failed to load media thumbnail:", e);
      } finally {
        setLoading(false);
      }
    };

    loadMedia();
  }, [item]);

  return (
    <Button.Wrapper onPress={() => onPress(uri, info?.type)}>
      {uri ? (
        <Block
          width={ITEM_SIZE}
          height={ITEM_SIZE}
          background={Colors.white20}
          border={{
            borderRadius: 4,
          }}
          overflow="hidden"
        >
          {info?.type === "image" ? (
            <Image
              source={{ uri }}
              width={ITEM_SIZE}
              height={ITEM_SIZE}
              resizeMode="cover"
            />
          ) : (
            <Video
              source={{ uri }}
              style={{
                width: ITEM_SIZE,
                height: ITEM_SIZE,
              }}
              resizeMode="contain"
              controls
              paused
            />
          )}
        </Block>
      ) : (
        <Block
          width={ITEM_SIZE}
          height={ITEM_SIZE}
          background={Colors.white20}
          border={{ borderRadius: 4 }}
          overflow="hidden"
          align="center"
          justify="center"
        >
          {loading && <Loading isFullScreen={false} />}
        </Block>
      )}
    </Button.Wrapper>
  );
};
