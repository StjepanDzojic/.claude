  const vIntMesh = nodes[vIntKey] ?? null;
  const uIntMesh = nodes[uIntKey] ?? null;

  const [vStakloKey, uStakloKey] = stakloMeshKeys(designId, size);
  const vStakloMesh = nodes[vStakloKey] ?? findStakloNode(nodes, size, 'V');
  const uStakloMesh = nodes[uStakloKey] ?? findStakloNode(nodes, size, 'U');
