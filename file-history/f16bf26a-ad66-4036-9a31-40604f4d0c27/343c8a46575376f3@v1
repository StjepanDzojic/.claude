    const stakloNode = vStakloMesh ?? uStakloMesh;
    if (!stakloNode) return null;
    const base = Array.isArray(stakloNode.material)
      ? stakloNode.material[0]
      : stakloNode.material;
    const material = (base as THREE.MeshStandardMaterial).clone();
    material.clippingPlanes = clippingPlanes;
