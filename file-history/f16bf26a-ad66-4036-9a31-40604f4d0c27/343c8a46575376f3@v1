    return computeBoundsForSize(nodes, size, designId);
  }, [nodes, size, designId]);

  const centerOffset = panelBounds.center;
  const sourceWidth = panelBounds.sizeVec.x || 1;
  const sourceHeight = panelBounds.sizeVec.y || 1;
