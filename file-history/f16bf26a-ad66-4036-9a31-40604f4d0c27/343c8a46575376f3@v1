  const halfTargetHeight = resolvedHeight / 2;

  const clippingPlanes = useMemo(() => {
    // Keep panel clipped to requested width/height around its own center.
    const left = panelX - halfTargetWidth;
    const right = panelX + halfTargetWidth;
    const bottom = panelY - halfTargetHeight;
    const top = panelY + halfTargetHeight;

    const wallHalfDepth = WALL_THICKNESS / 2;
    const wallFrontZ = WALL_CENTER_Z + wallHalfDepth;
    const wallBackZ = WALL_CENTER_Z - wallHalfDepth;

    return [
      new THREE.Plane(new THREE.Vector3(1, 0, 0), -left),
      new THREE.Plane(new THREE.Vector3(-1, 0, 0), right),
      new THREE.Plane(new THREE.Vector3(0, 1, 0), -bottom),
      new THREE.Plane(new THREE.Vector3(0, -1, 0), top),
      new THREE.Plane(new THREE.Vector3(0, 0, 1), -wallBackZ),
