import { FC } from 'react';
import { lights } from '../../const';
import type { DoorSceneControls } from './useDoorSceneControls';

interface Props {
  isFront: boolean;
  isNightMode: boolean;
  controls: DoorSceneControls;
}

export const DoorSceneLights: FC<Props> = ({
  isFront,
  isNightMode,
  controls,
}) => {
  const {
    dayKeyX,
    dayKeyY,
    dayKeyZ,
    dayKeyIntensity,
    dayDetailX,
    dayDetailY,
    dayDetailZ,
    dayDetailIntensity,
    dayAmbIntensity,
    dayHemiIntensity,
    nightDirIntensity,
    nightAmbIntensity,
    nightHemiIntensity,
  } = controls;

  if (isFront) {
    return (
      <>
        {/* Key light — raking from the side to reveal engraved details */}
        <directionalLight
          {...lights.front}
          position={[dayKeyX, dayKeyY, dayKeyZ] as [number, number, number]}
          castShadow
          intensity={isNightMode ? nightDirIntensity : dayKeyIntensity}
          color={isNightMode ? '#a9bce0' : '#ffffff'}
          shadow-bias={-0.0001}
          shadow-radius={3}
          shadow-mapSize-width={4096}
          shadow-mapSize-height={4096}
          shadow-camera-left={-3}
          shadow-camera-right={3}
          shadow-camera-top={4}
          shadow-camera-bottom={-2}
          shadow-camera-near={0.5}
          shadow-camera-far={25}
        />
        {/* Detail fill — from the opposite side, softer, prevents full black shadows */}
        {!isNightMode && (
          <directionalLight
            position={
              [dayDetailX, dayDetailY, dayDetailZ] as [number, number, number]
            }
            intensity={dayDetailIntensity}
            color="#e8eeff"
          />
        )}
        <ambientLight
          intensity={isNightMode ? nightAmbIntensity : dayAmbIntensity}
          color={isNightMode ? '#8d9ab0' : '#ffffff'}
        />
        <hemisphereLight
          color={isNightMode ? '#94a7c6' : '#ffffff'}
          groundColor={isNightMode ? '#1b2028' : '#888888'}
          intensity={isNightMode ? nightHemiIntensity : dayHemiIntensity}
        />
        <directionalLight
          position={[2, 2, -3]}
          intensity={isNightMode ? 0.22 : 0.35}
          color={isNightMode ? '#b0c1dd' : '#ffffff'}
        />
        <pointLight
          position={[-2, 2, -2]}
          intensity={isNightMode ? 0 : 0.3}
          distance={7}
        />
        <pointLight
          position={[2, 2, -2]}
          intensity={isNightMode ? 0 : 0.3}
          distance={7}
        />
      </>
    );
  }

  return (
    <>
      <ambientLight
        intensity={isNightMode ? nightAmbIntensity * 0.75 : 0.35}
        color={isNightMode ? '#7d8ca3' : '#ffffff'}
      />
      <hemisphereLight
        color={isNightMode ? '#7183a0' : '#ffffff'}
        groundColor={isNightMode ? '#16181f' : '#888888'}
        intensity={isNightMode ? nightHemiIntensity * 0.52 : 0.2}
      />
    </>
  );
};
