/* ============================================================
   HIDROING — design system
   ============================================================ */

:root {
  --ink: #0D0F0E;
  --ink-2: #2B2F2D;
  --ink-3: #5C635F;
  --ink-4: #9BA19D;
  --rule: #D9DCD8;
  --rule-2: #E8EAE6;
  --paper: #F6F7F5;
  --paper-2: #EDEFEA;
  --white: #FFFFFF;

  --green: oklch(0.62 0.17 155);
  --green-ink: oklch(0.38 0.12 155);
  --blue: oklch(0.45 0.16 235);
  --blue-ink: oklch(0.28 0.12 235);

  --sans: var(--font-inter-tight, "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif);
  --mono: var(--font-jetbrains-mono, "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace);

  --pad-x: clamp(20px, 4vw, 64px);
  --pad-y: clamp(56px, 9vw, 140px);
  --max: 1440px;
}

/* Reset Tailwind base conflicts */
html, body {
  margin: 0;
  padding: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-feature-settings: "ss01", "cv11", "tnum";
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  font-size: 16px;
  line-height: 1.5;
}

img { display: block; max-width: 100%; }

a {
  color: inherit;
  text-decoration: none;
}

/* Typography scale */
.display {
  font-family: var(--sans);
  font-weight: 500;
  letter-spacing: -0.03em;
  line-height: 0.98;
  font-size: clamp(48px, 8vw, 132px);
  text-wrap: balance;
}
.h1 {
  font-weight: 500;
  letter-spacing: -0.025em;
  line-height: 1.02;
  font-size: clamp(40px, 5.4vw, 88px);
  text-wrap: balance;
  margin: 0;
}
.h2 {
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.05;
  font-size: clamp(28px, 3.2vw, 48px);
  text-wrap: balance;
  margin: 0;
}
.h3 {
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.15;
  font-size: clamp(20px, 1.8vw, 26px);
  margin: 0;
}
.body-lg {
  font-size: clamp(18px, 1.4vw, 22px);
  line-height: 1.5;
  letter-spacing: -0.005em;
  color: var(--ink-2);
  text-wrap: pretty;
}
.body {
  font-size: 16px;
  line-height: 1.6;
  color: var(--ink-2);
  text-wrap: pretty;
}
.small {
  font-size: 13px;
  line-height: 1.5;
  color: var(--ink-3);
}

.eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-3);
  font-weight: 500;
}
.eyebrow .dot {
  display: inline-block;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--green);
  margin-right: 10px;
  transform: translateY(-1px);
}
.eyebrow.blue .dot { background: var(--blue); }

.num {
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

/* Layout primitives */
.wrap {
  max-width: var(--max);
  margin: 0 auto;
  padding-left: var(--pad-x);
  padding-right: var(--pad-x);
}
.section { padding-top: var(--pad-y); padding-bottom: var(--pad-y); }
.section--tight { padding-top: calc(var(--pad-y) * 0.6); padding-bottom: calc(var(--pad-y) * 0.6); }
.rule {
  height: 1px; background: var(--rule);
  width: 100%;
}

/* Nav */
.nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: color-mix(in oklab, var(--paper) 85%, transparent);
  backdrop-filter: saturate(140%) blur(8px);
  -webkit-backdrop-filter: saturate(140%) blur(8px);
  border-bottom: 1px solid var(--rule);
}
.nav__inner {
  max-width: var(--max);
  margin: 0 auto;
  padding: 18px var(--pad-x);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}
.nav__logo { display: flex; align-items: center; gap: 10px; }
.nav__logo img { height: 34px; width: auto; }
.nav__links {
  display: flex;
  align-items: center;
  gap: 32px;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: -0.01em;
}
.nav__links a {
  color: var(--ink-2);
  position: relative;
  padding: 6px 0;
  transition: color .15s ease;
}
.nav__links a:hover { color: var(--ink); }
.nav__links a.active { color: var(--ink); }
.nav__links a.active::after {
  content: "";
  position: absolute; left: 0; right: 0; bottom: -2px;
  height: 1px; background: var(--green);
}
.nav__right {
  display: flex;
  align-items: center;
  gap: 18px;
}
.lang-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  border: 1px solid var(--rule);
  border-radius: 999px;
  padding: 3px;
  background: var(--white);
}
.lang-toggle button {
  border: 0; background: transparent;
  padding: 5px 10px;
  border-radius: 999px;
  font: inherit;
  letter-spacing: inherit;
  color: var(--ink-3);
  cursor: pointer;
}
.lang-toggle button.active {
  background: var(--ink);
  color: var(--paper);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 22px;
  border-radius: 999px;
  font-weight: 500;
  font-size: 14px;
  letter-spacing: -0.01em;
  border: 1px solid var(--ink);
  background: var(--ink);
  color: var(--paper);
  cursor: pointer;
  transition: transform .15s ease, background .15s ease, color .15s ease;
  font-family: var(--sans);
}
.btn:hover { background: var(--green-ink); border-color: var(--green-ink); }
.btn--ghost { background: transparent; color: var(--ink); }
.btn--ghost:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.btn .arrow {
  display: inline-block;
  width: 14px; height: 1px; background: currentColor; position: relative;
}
.btn .arrow::after {
  content: ""; position: absolute; right: 0; top: -3px;
  width: 7px; height: 7px;
  border-right: 1px solid currentColor;
  border-top: 1px solid currentColor;
  transform: rotate(45deg);
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--white);
  border: 1px solid var(--rule);
  font-size: 12px;
  color: var(--ink-2);
  font-weight: 500;
}

/* Placeholder imagery */
.ph {
  position: relative;
  background:
    repeating-linear-gradient(
      135deg,
      rgba(13,15,14,0.035) 0 1px,
      transparent 1px 9px
    ),
    linear-gradient(180deg, #E4E7E1 0%, #D4D8D1 100%);
  overflow: hidden;
  border-radius: 2px;
}
.ph--blue {
  background:
    repeating-linear-gradient(
      135deg,
      rgba(13,15,14,0.045) 0 1px,
      transparent 1px 9px
    ),
    linear-gradient(180deg, oklch(0.78 0.05 235) 0%, oklch(0.55 0.11 235) 100%);
}
.ph--green {
  background:
    repeating-linear-gradient(
      135deg,
      rgba(13,15,14,0.045) 0 1px,
      transparent 1px 9px
    ),
    linear-gradient(180deg, oklch(0.78 0.07 155) 0%, oklch(0.5 0.12 155) 100%);
}
.ph--dark {
  background:
    repeating-linear-gradient(
      135deg,
      rgba(255,255,255,0.04) 0 1px,
      transparent 1px 9px
    ),
    linear-gradient(180deg, #2A2E2C 0%, #14171A 100%);
}
.ph__label {
  position: absolute;
  left: 14px;
  bottom: 14px;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.06em;
  color: rgba(13,15,14,0.6);
  text-transform: uppercase;
  padding: 4px 8px;
  background: rgba(246,247,245,0.7);
  backdrop-filter: blur(4px);
  border-radius: 2px;
}
.ph--blue .ph__label,
.ph--green .ph__label,
.ph--dark .ph__label {
  color: rgba(255,255,255,0.88);
  background: rgba(0,0,0,0.28);
}
.ph__corner {
  position: absolute;
  top: 12px; right: 12px;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.05em;
  color: rgba(13,15,14,0.55);
}
.ph--blue .ph__corner,
.ph--green .ph__corner,
.ph--dark .ph__corner { color: rgba(255,255,255,0.7); }

/* Footer */
.footer {
  background: #0D0F0E;
  color: #C9CDC9;
}
.footer a { color: #C9CDC9; }
.footer a:hover { color: #fff; }
.footer__top {
  max-width: var(--max);
  margin: 0 auto;
  padding: 80px var(--pad-x) 48px;
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr;
  gap: 48px;
}
.footer__bottom {
  border-top: 1px solid #222523;
  max-width: var(--max);
  margin: 0 auto;
  padding: 24px var(--pad-x);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: #7A807C;
  font-family: var(--mono);
  letter-spacing: 0.04em;
}
.footer h4 {
  font-size: 11px;
  font-family: var(--mono);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #7A807C;
  font-weight: 500;
  margin: 0 0 18px;
}
.footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; font-size: 14px; }
.footer__brand p {
  margin: 18px 0 0;
  max-width: 34ch;
  color: #9BA19D;
  font-size: 14px;
  line-height: 1.55;
}
.footer__wordmark {
  font-weight: 500;
  letter-spacing: -0.02em;
  font-size: 28px;
  color: #fff;
}
.footer__wordmark .dot { color: var(--green); }

/* Page chrome */
.page-hero {
  padding-top: clamp(80px, 10vw, 140px);
  padding-bottom: clamp(48px, 6vw, 80px);
  border-bottom: 1px solid var(--rule);
}
.page-hero .crumbs {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: 20px;
  display: flex;
  gap: 10px;
  align-items: center;
}
.page-hero .crumbs span.sep { opacity: .5; }

/* Grid helpers */
.col-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
.col-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
.col-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }

@media (max-width: 960px) {
  .col-2, .col-3, .col-4 { grid-template-columns: 1fr; }
  .footer__top { grid-template-columns: 1fr 1fr; }
  .nav__links { display: none; }
}

/* Marquee */
.marquee-rule {
  display: flex;
  gap: 24px;
  align-items: center;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  text-transform: uppercase;
  padding: 18px 0;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  overflow: hidden;
  white-space: nowrap;
}
.marquee-rule .item { display: inline-flex; align-items: center; gap: 12px; flex-shrink: 0; }
.marquee-rule .item::before {
  content: "";
  width: 4px; height: 4px;
  border-radius: 50%;
  background: var(--green);
  display: inline-block;
}

@keyframes marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
.marquee-track {
  display: flex;
  gap: 24px;
  animation: marquee 24s linear infinite;
  width: max-content;
}

/* Reveal on scroll */
.reveal { opacity: 0; transform: translateY(8px); transition: opacity .6s ease, transform .6s ease; }
.reveal.in { opacity: 1; transform: none; }

/* Section heading */
.sec-head {
  display: grid;
  grid-template-columns: 200px 1fr 1fr;
  gap: 40px;
  align-items: baseline;
  margin-bottom: 56px;
}
.sec-head .num {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--ink-3);
  letter-spacing: 0.08em;
}
.sec-head h2 { max-width: 18ch; }
.sec-head .lede { max-width: 42ch; color: var(--ink-2); font-size: 16px; line-height: 1.55; }
@media (max-width: 900px) {
  .sec-head { grid-template-columns: 1fr; gap: 16px; margin-bottom: 32px; }
}

/* ===== Home page ===== */
.hero {
  padding-top: clamp(60px, 8vw, 120px);
  padding-bottom: clamp(40px, 6vw, 80px);
}
.hero__meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  margin-bottom: 48px;
}
.hero__meta .meta-line {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.hero__title {
  font-weight: 500;
  letter-spacing: -0.035em;
  line-height: 0.95;
  font-size: clamp(56px, 10vw, 156px);
  margin: 0;
  text-wrap: balance;
}
.hero__title em {
  font-style: normal;
  color: var(--green-ink);
}
.hero__sub {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 80px;
  align-items: end;
  margin-top: 40px;
}
.hero__sub p { max-width: 56ch; font-size: clamp(17px, 1.3vw, 20px); line-height: 1.5; color: var(--ink-2); margin: 0; }
.hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }
.hero__image { margin-top: 64px; height: clamp(360px, 52vw, 640px); position: relative; }

/* Stats */
.stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
.stats .cell { padding: 36px 24px; border-right: 1px solid var(--rule); }
.stats .cell:last-child { border-right: 0; }
.stats .n { font-family: var(--sans); font-weight: 500; font-size: clamp(40px, 4vw, 64px); letter-spacing: -0.03em; line-height: 1; }
.stats .n sup { font-size: 0.5em; color: var(--green-ink); margin-left: 4px; }
.stats .lbl { margin-top: 14px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
@media (max-width: 780px) {
  .stats { grid-template-columns: 1fr 1fr; }
  .stats .cell:nth-child(2) { border-right: 0; }
  .stats .cell:nth-child(1), .stats .cell:nth-child(2) { border-bottom: 1px solid var(--rule); }
}

/* About split */
.about-split { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; align-items: start; }
.about-split .kicker { margin-bottom: 24px; }
.about-split h2 { margin-bottom: 28px; }
.about-split p + p { margin-top: 16px; }
.about-split__aside { border-left: 1px solid var(--rule); padding-left: 40px; display: grid; gap: 28px; }
.factoid { display: grid; gap: 4px; }
.factoid .k { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
.factoid .v { font-size: 18px; letter-spacing: -0.01em; color: var(--ink); font-weight: 500; }
@media (max-width: 900px) {
  .about-split { grid-template-columns: 1fr; gap: 40px; }
  .about-split__aside { border-left: 0; padding-left: 0; border-top: 1px solid var(--rule); padding-top: 28px; }
  .hero__sub { grid-template-columns: 1fr; gap: 32px; }
}

/* Services list */
.services-list { border-top: 1px solid var(--rule); }
.service-row {
  display: grid;
  grid-template-columns: 80px 1.6fr 2fr 180px;
  gap: 32px;
  padding: 32px 0;
  border-bottom: 1px solid var(--rule);
  align-items: start;
  position: relative;
  transition: background .2s ease;
}
.service-row:hover { background: rgba(0,0,0,0.02); }
.service-row .idx { font-family: var(--mono); font-size: 12px; color: var(--ink-4); letter-spacing: 0.06em; padding-top: 4px; }
.service-row .title { font-size: clamp(20px, 1.7vw, 26px); font-weight: 500; letter-spacing: -0.015em; line-height: 1.15; }
.service-row .desc { font-size: 15px; color: var(--ink-2); line-height: 1.55; max-width: 52ch; }
.service-row .tag { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); padding-top: 6px; }
.service-row .arrow-cell { display: flex; justify-content: flex-end; padding-top: 6px; }
@media (max-width: 900px) {
  .service-row { grid-template-columns: 40px 1fr; gap: 16px 20px; }
  .service-row .desc, .service-row .tag { grid-column: 2; }
}

/* Projects grid */
.projects-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 48px; }
.projects-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; }
.project-card { display: block; position: relative; }
.project-card .frame { position: relative; aspect-ratio: 16/11; }
.project-card.tall .frame { aspect-ratio: 4/5; }
.project-card .meta { display: flex; justify-content: space-between; align-items: baseline; margin-top: 16px; gap: 16px; }
.project-card .title { font-size: clamp(18px, 1.5vw, 22px); font-weight: 500; letter-spacing: -0.01em; }
.project-card .loc { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
.project-card .cat { margin-top: 8px; font-size: 13px; color: var(--ink-3); }
.projects-grid--second { grid-template-columns: 1fr 1fr 1fr; }
@media (max-width: 900px) {
  .projects-grid, .projects-grid--second { grid-template-columns: 1fr; }
}

/* Team preview */
.team-preview { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 24px; }
.member .portrait {
  aspect-ratio: 3/4;
  background: radial-gradient(circle at 50% 35%, rgba(255,255,255,0.5) 0%, transparent 50%), linear-gradient(180deg, #DDE1DB 0%, #B6BCB4 100%);
  position: relative; overflow: hidden; border-radius: 2px;
}
.member .portrait::after {
  content: ""; position: absolute; inset: auto 20% 0 20%; height: 55%;
  background: linear-gradient(180deg, rgba(13,15,14,0.12), rgba(13,15,14,0.35));
  border-radius: 50% 50% 0 0 / 40% 40% 0 0;
}
.member .portrait .initials { position: absolute; top: 16px; left: 16px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; color: rgba(13,15,14,0.55); }
.member .name { margin-top: 14px; font-size: 17px; font-weight: 500; letter-spacing: -0.01em; }
.member .role { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-top: 4px; }
@media (max-width: 900px) { .team-preview { grid-template-columns: 1fr 1fr; } }

/* Gallery */
.gallery { display: grid; grid-template-columns: repeat(12, 1fr); gap: 12px; grid-auto-rows: 120px; }
.gallery .tile { position: relative; }
.g-a { grid-column: span 5; grid-row: span 3; }
.g-b { grid-column: span 4; grid-row: span 2; }
.g-c { grid-column: span 3; grid-row: span 2; }
.g-d { grid-column: span 4; grid-row: span 2; }
.g-e { grid-column: span 3; grid-row: span 3; }
.g-f { grid-column: span 5; grid-row: span 2; }
@media (max-width: 900px) {
  .gallery { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 160px; }
  .g-a, .g-b, .g-c, .g-d, .g-e, .g-f { grid-column: span 1; grid-row: span 1; }
}

/* CTA strip */
.cta-strip {
  background: var(--ink); color: var(--paper); border-radius: 4px;
  padding: clamp(40px, 6vw, 80px);
  display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: end;
  position: relative; overflow: hidden;
}
.cta-strip::before {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(circle at 85% 20%, oklch(0.5 0.15 155 / 0.25), transparent 50%), radial-gradient(circle at 10% 100%, oklch(0.45 0.15 235 / 0.22), transparent 55%);
  pointer-events: none;
}
.cta-strip h2 { color: var(--paper); }
.cta-strip .sub { color: #C9CDC9; max-width: 48ch; margin-top: 20px; line-height: 1.5; }
.cta-strip .right { display: grid; gap: 16px; position: relative; z-index: 1; }
.cta-strip .row { display: flex; justify-content: space-between; border-top: 1px solid #2B2F2D; padding-top: 14px; }
.cta-strip .row:first-child { border-top: 0; padding-top: 0; }
.cta-strip .row .k { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #9BA19D; }
.cta-strip .row .v { color: #fff; font-size: 14px; font-weight: 500; }
@media (max-width: 900px) { .cta-strip { grid-template-columns: 1fr; } }

/* ===== Services page ===== */
.svc-block {
  border-top: 1px solid var(--rule);
  padding: 64px 0;
  display: grid; grid-template-columns: 80px 1.1fr 1.6fr; gap: 32px; align-items: start;
}
.svc-block:last-child { border-bottom: 1px solid var(--rule); }
.svc-block .idx { font-family: var(--mono); font-size: 12px; color: var(--ink-4); letter-spacing: 0.08em; padding-top: 6px; }
.svc-block h3 { font-size: clamp(28px, 3vw, 44px); font-weight: 500; letter-spacing: -0.02em; line-height: 1.05; margin: 0 0 18px; }
.svc-block .tag { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
.svc-block .lede { font-size: 17px; line-height: 1.55; color: var(--ink-2); max-width: 46ch; }
.svc-block .phases { display: grid; gap: 12px; margin-top: 8px; }
.svc-block .phase { display: grid; grid-template-columns: 36px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--rule-2); align-items: baseline; }
.svc-block .phase:last-child { border-bottom: 0; }
.svc-block .phase .p-idx { font-family: var(--mono); font-size: 11px; color: var(--ink-4); letter-spacing: 0.05em; }
.svc-block .phase .p-t { font-weight: 500; font-size: 15px; letter-spacing: -0.005em; }
.svc-block .phase .p-d { color: var(--ink-3); font-size: 13px; margin-top: 3px; line-height: 1.5; }
.svc-block .frame { aspect-ratio: 4/3; margin-top: 28px; position: relative; }
