.licenses { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 48px; }
.lic { padding: 24px; border: 1px solid var(--rule); border-radius: 4px; background: var(--white); }
.lic .k { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; color: var(--ink-3); text-transform: uppercase; }
.lic .v { margin-top: 10px; font-weight: 500; font-size: 17px; letter-spacing: -0.01em; }
.lic .s { margin-top: 8px; color: var(--ink-3); font-size: 13px; }
@media (max-width: 900px) { .licenses { grid-template-columns: 1fr 1fr; } }

/* ===== Projects page ===== */
.filters { display: flex; gap: 8px; flex-wrap: wrap; margin: 32px 0 48px; padding-top: 24px; border-top: 1px solid var(--rule); }
.filter { padding: 8px 14px; border: 1px solid var(--rule); border-radius: 999px; background: transparent; font: inherit; font-size: 13px; color: var(--ink-2); cursor: pointer; transition: all .15s ease; }
.filter:hover { border-color: var(--ink-3); }
.filter.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.filter .ct { font-family: var(--mono); font-size: 10px; margin-left: 8px; color: var(--ink-4); }
.filter.active .ct { color: #9BA19D; }

.proj-row { display: grid; grid-template-columns: 60px 1fr 2fr 1.2fr 140px; gap: 32px; padding: 28px 0; border-bottom: 1px solid var(--rule); align-items: center; transition: background .15s ease; }
.proj-row:first-child { border-top: 1px solid var(--rule); }
.proj-row:hover { background: rgba(0,0,0,0.02); }
.proj-row .pid { font-family: var(--mono); font-size: 11px; color: var(--ink-4); letter-spacing: 0.06em; }
.proj-row .pt { font-size: 17px; font-weight: 500; letter-spacing: -0.01em; }
.proj-row .pd { color: var(--ink-3); font-size: 14px; line-height: 1.4; }
.proj-row .pmeta { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; color: var(--ink-3); text-transform: uppercase; }
.proj-row .pyr { text-align: right; font-family: var(--mono); font-size: 13px; color: var(--ink); font-weight: 500; }
@media (max-width: 900px) { .proj-row { grid-template-columns: 1fr; gap: 6px; } }

.featured { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; margin-bottom: 48px; }
.featured a.card { display: block; }
.featured .frame { aspect-ratio: 16/10; }
.featured .title { font-size: 22px; font-weight: 500; letter-spacing: -0.01em; margin-top: 14px; }
.featured .loc { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-top: 6px; }
.featured .sub-grid { display: grid; gap: 24px; grid-template-rows: 1fr 1fr; }
.featured .sub-grid .frame { aspect-ratio: 16/9; }
@media (max-width: 900px) { .featured { grid-template-columns: 1fr; } }

/* ===== Project detail ===== */
.pd-hero { padding-top: clamp(60px, 7vw, 96px); padding-bottom: clamp(32px, 4vw, 56px); }
.pd-hero .meta-row { display: flex; justify-content: space-between; gap: 24px; margin-bottom: 32px; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); }
.pd-hero h1 { font-size: clamp(48px, 6.5vw, 112px); font-weight: 500; letter-spacing: -0.03em; line-height: 0.98; margin: 0; max-width: 18ch; }
.pd-hero .dek { margin-top: 32px; font-size: clamp(18px, 1.4vw, 22px); color: var(--ink-2); line-height: 1.5; max-width: 62ch; }
.big-frame { height: clamp(360px, 55vw, 680px); }
.spec { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
.spec .cell { padding: 24px 20px; border-right: 1px solid var(--rule); }
.spec .cell:last-child { border-right: 0; }
.spec .k { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
.spec .v { margin-top: 10px; font-size: 18px; font-weight: 500; letter-spacing: -0.01em; }
@media (max-width: 780px) { .spec { grid-template-columns: 1fr 1fr; } .spec .cell:nth-child(2) { border-right: 0; } .spec .cell:nth-child(1), .spec .cell:nth-child(2) { border-bottom: 1px solid var(--rule); } }
.copy-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: 80px; }
.copy-grid h2 { max-width: 14ch; }
.copy-grid p + p { margin-top: 16px; }
.copy-grid p { font-size: 17px; line-height: 1.55; color: var(--ink-2); max-width: 58ch; }
@media (max-width: 900px) { .copy-grid { grid-template-columns: 1fr; gap: 24px; } }
.docs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.doc { display: flex; align-items: center; gap: 16px; padding: 18px 20px; border: 1px solid var(--rule); border-radius: 3px; background: var(--white); transition: border-color .15s ease; }
.doc:hover { border-color: var(--ink-3); }
.doc .icon { width: 40px; height: 48px; background: var(--paper-2); position: relative; border: 1px solid var(--rule); }
.doc .icon::before { content: ""; position: absolute; top: 0; right: 0; width: 12px; height: 12px; background: var(--white); border-left: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
.doc .icon::after { content: "PDF"; position: absolute; bottom: 6px; left: 0; right: 0; text-align: center; font-family: var(--mono); font-size: 8px; letter-spacing: 0.08em; color: var(--ink-3); }
.doc .main { flex: 1; }
.doc .t { font-size: 15px; font-weight: 500; letter-spacing: -0.005em; }
.doc .s { font-family: var(--mono); font-size: 11px; color: var(--ink-3); letter-spacing: 0.05em; margin-top: 4px; }
.doc .arr { font-family: var(--mono); font-size: 14px; color: var(--ink-3); }
.gallery-detail { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 12px; grid-auto-rows: 220px; }
.gallery-detail .t1 { grid-row: span 2; }
.gallery-detail .t { position: relative; }
@media (max-width: 900px) { .gallery-detail { grid-template-columns: 1fr 1fr; } .gallery-detail .t1 { grid-column: span 2; grid-row: span 1; } }
.refs { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
.refs .block h3 { font-size: 13px; font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); font-weight: 500; margin: 0 0 20px; padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
.refs ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
.refs li { display: grid; grid-template-columns: 1fr auto; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--rule-2); }
.refs li:last-child { border-bottom: 0; }
.refs li .n { font-weight: 500; font-size: 15px; letter-spacing: -0.005em; }
.refs li .r { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
.next { display: flex; justify-content: space-between; align-items: center; padding: 40px 0; border-top: 1px solid var(--rule); }
.next a { font-size: 17px; font-weight: 500; letter-spacing: -0.01em; }
.next a .k { display: block; font-family: var(--mono); font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
@media (max-width: 900px) { .refs { grid-template-columns: 1fr; } }

/* ===== Team page ===== */
.lede-row { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; margin-top: 40px; align-items: end; }
.lede-row p { max-width: 52ch; }
@media (max-width: 900px) { .lede-row { grid-template-columns: 1fr; gap: 24px; } }
.team-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px 24px; }
@media (max-width: 1100px) { .team-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 780px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }
.person { display: grid; gap: 14px; }
.person .portrait { aspect-ratio: 3/4; position: relative; overflow: hidden; border-radius: 2px; background: linear-gradient(180deg, #DCE1DB 0%, #B6BCB4 100%); }
.person .portrait::before { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, rgba(0,0,0,0.03) 0 1px, transparent 1px 9px); }
.person .portrait::after { content: ""; position: absolute; inset: auto 20% 0 20%; height: 55%; background: linear-gradient(180deg, rgba(13,15,14,0.1), rgba(13,15,14,0.4)); border-radius: 50% 50% 0 0 / 40% 40% 0 0; }
.person.blue .portrait { background: linear-gradient(180deg, oklch(0.78 0.05 235), oklch(0.52 0.11 235)); }
.person.green .portrait { background: linear-gradient(180deg, oklch(0.78 0.07 155), oklch(0.5 0.12 155)); }
.person.dark .portrait { background: linear-gradient(180deg, #2B2F2D, #14171A); }
.person .corner { position: absolute; top: 14px; left: 14px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; color: rgba(13,15,14,0.6); }
.person.blue .corner, .person.green .corner, .person.dark .corner { color: rgba(255,255,255,0.8); }
.person .n { font-size: 18px; font-weight: 500; letter-spacing: -0.01em; }
.person .r { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
.person .bio { font-size: 13px; color: var(--ink-3); line-height: 1.5; border-top: 1px solid var(--rule); padding-top: 10px; margin-top: 4px; }
.dept { display: flex; gap: 24px; align-items: baseline; margin: 72px 0 28px; border-top: 1px solid var(--rule); padding-top: 28px; }
.dept .idx { font-family: var(--mono); font-size: 12px; color: var(--ink-4); letter-spacing: 0.08em; }
.dept h2 { font-size: clamp(24px, 2.6vw, 36px); font-weight: 500; letter-spacing: -0.02em; margin: 0; }
.dept .ct { margin-left: auto; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; color: var(--ink-3); text-transform: uppercase; }
.join-card { margin-top: 80px; padding: 48px; border: 1px solid var(--rule); border-radius: 4px; display: grid; grid-template-columns: 2fr 1fr; gap: 32px; align-items: center; background: var(--white); }
@media (max-width: 780px) { .join-card { grid-template-columns: 1fr; padding: 32px; } }

/* ===== About page ===== */
.manifesto { font-size: clamp(26px, 3.2vw, 48px); font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; max-width: 22ch; }
.manifesto em { font-style: normal; color: var(--green-ink); }
.timeline { border-top: 1px solid var(--rule); }
.tl-row { display: grid; grid-template-columns: 140px 160px 1fr; gap: 32px; padding: 36px 0; border-bottom: 1px solid var(--rule); align-items: start; }
.tl-row .yr { font-family: var(--mono); font-size: 13px; font-weight: 500; color: var(--ink); letter-spacing: 0.03em; }
.tl-row .tag { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); padding-top: 2px; }
.tl-row .body-block h3 { font-size: clamp(20px, 1.8vw, 26px); font-weight: 500; letter-spacing: -0.01em; line-height: 1.2; margin: 0 0 10px; }
.tl-row .body-block p { margin: 0; color: var(--ink-2); font-size: 15px; line-height: 1.55; max-width: 56ch; }
@media (max-width: 900px) { .tl-row { grid-template-columns: 1fr; gap: 10px; } }
.awards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; }
.award { padding: 28px 32px; border-top: 1px solid var(--rule); border-right: 1px solid var(--rule); display: grid; gap: 10px; }
.award:nth-child(2n) { border-right: 0; }
.award .yr { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
.award .t { font-size: 19px; font-weight: 500; letter-spacing: -0.01em; }
.award .b { color: var(--ink-3); font-size: 14px; line-height: 1.5; }
@media (max-width: 780px) { .awards { grid-template-columns: 1fr; } .award { border-right: 0; } }
.quality-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
.quality-card { padding: 32px; border: 1px solid var(--rule); border-radius: 4px; background: var(--white); }
.quality-card .badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); padding: 5px 10px; border-radius: 999px; border: 1px solid var(--rule); }
.quality-card h3 { font-size: 26px; font-weight: 500; letter-spacing: -0.01em; margin: 18px 0 12px; }
.quality-card p { color: var(--ink-2); font-size: 15px; line-height: 1.55; margin: 0; max-width: 48ch; }
.quality-card ul { margin: 20px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
.quality-card li { font-size: 14px; color: var(--ink-2); padding-left: 20px; position: relative; line-height: 1.4; }
.quality-card li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 8px; height: 1px; background: var(--green); }
@media (max-width: 900px) { .quality-grid { grid-template-columns: 1fr; } }
.big-quote { font-size: clamp(28px, 3.4vw, 48px); font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; max-width: 20ch; text-wrap: balance; }
.big-quote .mark { color: var(--green-ink); font-family: serif; }
.quote-attr { margin-top: 28px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }

/* ===== Contact page ===== */
.contact-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 80px; align-items: start; }
@media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; gap: 40px; } }
.contact-info { display: grid; gap: 36px; }
.info-block { border-top: 1px solid var(--rule); padding-top: 18px; display: grid; grid-template-columns: 140px 1fr; gap: 24px; align-items: baseline; }
.info-block:last-of-type { border-bottom: 1px solid var(--rule); padding-bottom: 18px; }
.info-block .k { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
.info-block .v { font-size: 18px; letter-spacing: -0.01em; font-weight: 500; line-height: 1.4; }
.info-block .v a:hover { color: var(--green-ink); }
.map-frame { margin-top: 48px; height: 400px; position: relative; }
.map-pin { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-100%); display: flex; flex-direction: column; align-items: center; gap: 0; }
.map-pin .dot { width: 14px; height: 14px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 6px rgba(255,255,255,0.9), 0 2px 8px rgba(0,0,0,0.3); }
.map-pin .tail { width: 1px; height: 24px; background: var(--ink); }
.map-pin .lbl { padding: 6px 10px; background: var(--ink); color: var(--paper); font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; position: absolute; top: -32px; left: 50%; transform: translateX(-50%); white-space: nowrap; }
form.enquiry { display: grid; gap: 18px; padding: 32px; border: 1px solid var(--rule); border-radius: 4px; background: var(--white); }
form.enquiry .row { display: grid; gap: 6px; }
form.enquiry label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
form.enquiry input, form.enquiry textarea, form.enquiry select { padding: 12px 14px; border: 1px solid var(--rule); border-radius: 3px; font: inherit; background: var(--paper); color: var(--ink); transition: border-color .15s ease; }
form.enquiry input:focus, form.enquiry textarea:focus, form.enquiry select:focus { outline: 0; border-color: var(--ink); }
form.enquiry textarea { min-height: 120px; resize: vertical; }
form.enquiry .two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
