import { cn } from '@app/lib/utils';
import { PrismicNextImage } from '@prismicio/next';
import clsx from 'clsx';
import { format } from 'date-fns';
import Link from 'next/link';
import { ProjectDocument } from 'prismicio-types';
import { FC } from 'react';

interface Props {
  project: ProjectDocument<string>;
  className?: string;
  imageClassName?: string;
  isMain?: boolean;
}

export const ProjectArticle: FC<Props> = ({
  project,
  className,
  isMain,
  imageClassName,
}) => {
  const { title, description, date, hero_image, category, status } =
    project?.data || {};

  if (!project) return null;

  return (
    <Link
      href={`/projekti/${project.uid}`}
      className={clsx(
        'group flex relative w-full h-auto hover:text-white overflow-hidden',
        className,
      )}>
      <div className="w-full h-full absolute top-0 left-0 z-[1] bg-[linear-gradient(180deg,_rgba(23,24,26,0)_0%,_rgba(23,24,26,0.6)_100%)] group-hover:opacity-0 transition-all duration-300 ease-out" />
      <div className="absolute top-0 left-0 px-12 py-12 w-full h-full flex flex-col justify-between z-[2]">
        <div className="flex items-center gap-8">
          {category ? (
            <p className="text-tiny font-medium text-white uppercase bg-[#21262899] max-w-max px-10 py-6 rounded-2xl group-hover:bg-primary group-hover:text-white transition-all duration-300 ease-out">
              {category}
            </p>
          ) : (
            <div />
          )}
          {status && (
            <p
              className={clsx(
                'text-tiny font-medium text-white uppercase max-w-max px-10 py-6 rounded-2xl',
                status === 'U tijeku' && 'bg-green-600/80',
                status === 'Planiran' && 'bg-blue-600/80',
                status === 'Završen' && 'bg-gray-600/80',
              )}>
              {status}
            </p>
          )}
        </div>
        <div className="flex flex-col justify-end gap-8">
          <h3
            className={clsx(
              'font-semibold transition-all duration-300 ease-out',
              isMain
                ? 'text-2xlarge-fluid line-clamp-4 xsm:line-clamp-3'
                : 'text-base line-clamp-3 xsm:line-clamp-1 lg:line-clamp-2',
            )}>
            {title}
          </h3>
          {description && isMain && (
            <p className="text-base text-white line-clamp-2 transition-all duration-300 ease-out">
              {description}
            </p>
          )}
          {date && (
            <p className="text-tiny text-white/80 transition-all duration-300 ease-out">
              {format(date, 'dd/MM/yyyy')}
            </p>
          )}
        </div>
      </div>
      <div className="overflow-hidden relative w-full h-full">
        {hero_image && (
          <PrismicNextImage
            field={hero_image}
            className={cn(
              'object-cover object-center h-full group-hover:scale-105 transition-all duration-300 ease-out',
              imageClassName,
            )}
          />
        )}
      </div>
    </Link>
  );
};
