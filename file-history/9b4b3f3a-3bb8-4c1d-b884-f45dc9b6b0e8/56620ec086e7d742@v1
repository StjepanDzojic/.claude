import { cn } from '@app/lib/utils';
import {
  DateField,
  ImageField,
  KeyTextField,
  TimestampField,
} from '@prismicio/client';
import { PrismicNextImage } from '@prismicio/next';
import clsx from 'clsx';
import { format } from 'date-fns';
import Link from 'next/link';
import { FC } from 'react';

interface Props {
  type: 'vijesti' | 'dogadaji' | 'price-osjeckih-sportasa';
  uid: string;
  title: KeyTextField;
  description?: string;
  date?: DateField | TimestampField;
  hero_image?: ImageField;
  sport: string;
  className?: string;
  imageClassName?: string;
  isMain?: boolean;
}

export const RelatedArticle: FC<Props> = ({
  type,
  uid,
  title,
  description,
  date,
  hero_image,
  sport,
  className,
  imageClassName,
  isMain = false,
}) => {
  const handleHref = () => {
    switch (type) {
      case 'vijesti':
        return `/vijesti/${uid}`;
      case 'dogadaji':
        return `/dogadaji?event=${uid}`;
      case 'price-osjeckih-sportasa':
        return `/price-osjeckih-sportasa/${uid}`;
    }
  };

  return (
    <Link
      href={handleHref()}
      className={clsx(
        'group flex relative w-full h-auto hover:text-white',
        className,
      )}>
      <div className="w-full h-full absolute top-0 left-0 z-[1] bg-[linear-gradient(180deg,_rgba(23,24,26,0)_0%,_rgba(23,24,26,0.6)_100%)]  group-hover:opacity-0 transition-all duration-300 ease-out" />
      <div className="absolute px-12 py-12 top-0 left-0 w-[calc(100%-24px)] h-full flex flex-col justify-between z-[2]">
        {sport ? (
          <p className="text-tiny font-medium text-white uppercase bg-[#21262899] max-w-max px-10 py-6 rounded-2xl group-hover:bg-primary group-hover:text-white transition-all duration-300 ease-out">
            {sport}
          </p>
        ) : (
          <div />
        )}
        <div className="flex flex-col justify-end gap-8">
          <h3
            className={clsx(
              'font-semibold',
              isMain
                ? 'text-2xlarge-fluid line-clamp-4 xsm:line-clamp-3'
                : 'text-base line-clamp-2',
            )}>
            {title}
          </h3>
          {description && isMain && (
            <p className="text-base text-white line-clamp-2">{description}</p>
          )}
          {date && (
            <p className="text-tiny text-white/80">
              {format(date, 'dd/MM/yyyy')}
            </p>
          )}
        </div>
      </div>
      <div className="overflow-hidden relative h-full">
        {hero_image && (
          <PrismicNextImage
            field={hero_image}
            className={cn(
              'object-cover h-full group-hover:scale-105 transition-all duration-300 ease-out',
              imageClassName,
            )}
            height={500}
            width={800}
          />
        )}
      </div>
    </Link>
  );
};
