{
  "format": "page",
  "id": "project",
  "label": "Project",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": "Naziv projekta"
        }
      },
      "description": {
        "type": "Text",
        "config": {
          "label": "Description",
          "placeholder": "Kratki opis vidljiv na kartici"
        }
      },
      "date": {
        "type": "Date",
        "config": {
          "label": "Start date",
          "placeholder": "Datum početka projekta"
        }
      },
      "end_date": {
        "type": "Date",
        "config": {
          "label": "End date",
          "placeholder": "Datum završetka projekta (nije obavezno)"
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Category",
          "placeholder": "Kategorija projekta",
          "options": [
            "EU projekt",
            "Infrastruktura",
            "Obrazovanje i edukacija",
            "Zdravlje i rekreacija",
            "Natjecanja i eventi",
            "Zajednica",
            "Partnerstvo"
          ]
        }
      },
      "status": {
        "type": "Select",
        "config": {
          "label": "Status",
          "placeholder": "Status projekta",
          "options": [
            "U tijeku",
            "Završen",
            "Planiran"
          ]
        }
      },
      "hero_image": {
        "type": "Image",
        "config": {
          "label": "Hero image (1600x720 best)",
          "constraint": {
            "width": null,
            "height": null
          },
          "thumbnails": []
        }
      },
      "opening_text": {
        "type": "Text",
        "config": {
          "label": "Opening text",
          "placeholder": "Početni tekst prije sadržaja"
        }
      },
      "content": {
        "type": "StructuredText",
        "config": {
          "label": "Content",
          "placeholder": "Sadržaj projekta",
          "allowTargetBlank": true,
          "multi": "paragraph,preformatted,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
        }
      },
      "related_articles": {
        "type": "Group",
        "config": {
          "label": "Related articles",
          "repeat": true,
          "fields": {
            "related_article": {
              "type": "Link",
              "config": {
                "label": "Related article",
                "select": "document",
                "repeat": false,
                "customtypes": ["news", "event", "project"]
              }
            }
          }
        }
      },
      "gallery": {
        "type": "Group",
        "config": {
          "label": "Gallery (4 images)",
          "repeat": true,
          "fields": {
            "cropped_image": {
              "type": "Image",
              "config": {
                "label": "Cropped image",
                "constraint": {
                  "width": 360,
                  "height": 232
                },
                "thumbnails": []
              }
            },
            "normal_image": {
              "type": "Image",
              "config": {
                "label": "Normal image",
                "constraint": {},
                "thumbnails": []
              }
            }
          }
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {}
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
