'use client';

import { Grid } from '@app/_shared/Grid';
import { ProjectArticle } from '@app/_shared/ProjectArticle';
import { SkeletonNewsArticle } from '@app/_shared/SkeletonNewsArticle';
import { getProjects } from '@app/_shared/utils/getProjects';
import { ProjectDocument } from 'prismicio-types';
import { FC, useEffect, useState } from 'react';

export const MainProjects: FC = () => {
  const [projects, setProjects] = useState<ProjectDocument<string>[]>([]);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    const fetchProjects = async () => {
      setIsLoading(true);
      getProjects({})
        .then((data) => setProjects(data.projects))
        .catch(() => setProjects([]))
        .finally(() => {
          setTimeout(() => {
            setIsLoading(false);
          }, 400);
        });
    };
    fetchProjects();
  }, []);

  return (
    <>
      {isLoading ? (
        <Grid Wrapper="ul" className="gap-12">
          <li
            key="skeleton-main"
            className="col-span-24 md:col-[1/13] aspect-[2/3] xsm:aspect-auto w-full h-full max-h-max">
            <SkeletonNewsArticle
              isMain
              className="aspect-[2/3] xsm:aspect-auto w-full h-full"
            />
          </li>
          <div className="col-span-24 md:col-[13/25] flex gap-12 flex-col w-full">
            <div className="flex flex-col xsm:flex-row gap-12">
              {[1, 2].map((i) => (
                <li
                  key={`skeleton-side-${i}`}
                  className="w-full xsm:w-[calc(50%-6px)] h-full">
                  <SkeletonNewsArticle className="aspect-[340/244]" />
                </li>
              ))}
            </div>
            <div className="flex flex-col xsm:flex-row gap-12">
              {[3, 4].map((i) => (
                <li
                  key={`skeleton-bottom-${i}`}
                  className="w-full xsm:w-[calc(50%-6px)] h-full">
                  <SkeletonNewsArticle className="aspect-[340/244]" />
                </li>
              ))}
            </div>
          </div>
          <div className="max-xsm:hidden col-span-24 w-full h-full flex gap-12">
            {[5, 6, 7, 8].map((i) => (
              <SkeletonNewsArticle
                key={`skeleton-row-${i}`}
                className="aspect-[340/244]"
              />
            ))}
          </div>
        </Grid>
      ) : (
        <>
          {projects.length > 0 ? (
            <Grid Wrapper="ul" className="gap-12">
              <li
                key={projects[0]?.id}
                className="col-span-24 md:col-[1/13] w-full h-full md:aspect-[3/2]">
                <ProjectArticle
                  isMain
                  project={projects[0]}
                  className="aspect-[2/3] xsm:aspect-auto w-full h-full"
                />
              </li>
              <div className="col-span-24 md:col-[13/25] flex gap-12 flex-col w-full">
                <div className="flex flex-col xsm:flex-row gap-12">
                  {projects.slice(1, 3).map((project, i) => (
                    <li key={i} className="w-full xsm:w-[calc(50%-6px)] h-full">
                      <ProjectArticle
                        project={project}
                        className="aspect-[340/244]"
                      />
                    </li>
                  ))}
                </div>
                <div className="flex flex-col xsm:flex-row gap-12">
                  {projects.slice(3, 5).map((project, i) => (
                    <li key={i} className="w-full xsm:w-[calc(50%-6px)] h-full">
                      <ProjectArticle
                        project={project}
                        className="aspect-[340/244]"
                      />
                    </li>
                  ))}
                </div>
              </div>
              <div className="max-xsm:hidden col-span-24 w-full h-full flex gap-12">
                {projects.slice(5, 9).map((project, i) => (
                  <ProjectArticle
                    key={i}
                    project={project}
                    className="aspect-[340/244]"
                  />
                ))}
              </div>
            </Grid>
          ) : (
            <div className="col-span-24 w-full h-full flex justify-center items-center py-40">
              <p className="text-2xl font-medium text-white">
                Nema projekata za prikaz
              </p>
            </div>
          )}
        </>
      )}
    </>
  );
};
