'use client';

import { PROJECT_CATEGORIES } from '@app/_const/project-categories';
import { ArchiveItem } from '@app/_shared/ArchiveItem';
import { FilterItem } from '@app/_shared/FilterItem';
import { Grid } from '@app/_shared/Grid';
import { Section } from '@app/_shared/Section';
import { SkeletonNewsArticle } from '@app/_shared/SkeletonNewsArticle';
import { getProjects } from '@app/_shared/utils/getProjects';
import { getProjectsSearch } from '@app/_shared/utils/getProjectsSearch';
import { Input } from '@app/components/ui/input';
import {
  Pagination,
  PaginationContent,
  PaginationEllipsis,
  PaginationItem,
  PaginationLink,
  PaginationNext,
  PaginationPrevious,
} from '@app/components/ui/pagination';
import { cn } from '@app/lib/utils';
import SearchIcon from 'assets/icons/search.svg';
import { motion } from 'framer-motion';
import { ProjectDocument } from 'prismicio-types';
import { FC, useEffect, useRef, useState } from 'react';

const getPaginationItems = (currentPage: number, totalPages: number) => {
  const items: Array<{ type: 'page' | 'ellipsis'; value: number }> = [];

  if (totalPages <= 7) {
    for (let i = 1; i <= totalPages; i++) {
      items.push({ type: 'page', value: i });
    }
  } else {
    items.push({ type: 'page', value: 1 });

    if (currentPage <= 4) {
      for (let i = 2; i <= 5; i++) {
        items.push({ type: 'page', value: i });
      }
      items.push({ type: 'ellipsis', value: 0 });
      items.push({ type: 'page', value: totalPages });
    } else if (currentPage >= totalPages - 3) {
      items.push({ type: 'ellipsis', value: 0 });
      for (let i = totalPages - 4; i <= totalPages; i++) {
        items.push({ type: 'page', value: i });
      }
    } else {
      items.push({ type: 'ellipsis', value: 0 });
      for (let i = currentPage - 1; i <= currentPage + 1; i++) {
        items.push({ type: 'page', value: i });
      }
      items.push({ type: 'ellipsis', value: 0 });
      items.push({ type: 'page', value: totalPages });
    }
  }

  return items;
};

interface ArchiveProps {
  initialFilter?: string;
}

export const Archive: FC<ArchiveProps> = ({ initialFilter }) => {
  const sectionRef = useRef<HTMLDivElement>(null);
  const validInitialFilter = PROJECT_CATEGORIES.find(
    (f) => f.value === initialFilter,
  )?.value;
  const [filter, setFilter] = useState<string>(
    validInitialFilter ?? PROJECT_CATEGORIES[0].value,
  );
  const [projects, setProjects] = useState<ProjectDocument<string>[]>([]);
  const [totalPages, setTotalPages] = useState(1);
  const [isLoading, setIsLoading] = useState(true);
  const [currentPage, setCurrentPage] = useState(1);
  const [search, setSearch] = useState('');
  const [searchInput, setSearchInput] = useState('');
  const timeout = useRef(0);

  useEffect(() => {
    if (validInitialFilter) {
      setTimeout(() => {
        sectionRef.current?.scrollIntoView({ behavior: 'smooth' });
      }, 500);
    }
  }, [validInitialFilter]);

  const debouncedSearch = (value: string) => {
    clearTimeout(timeout.current);
    timeout.current = window.setTimeout(() => {
      setSearch(value);
    }, 300);
  };

  useEffect(() => {
    if (search) return;
    const fetchProjects = async () => {
      setIsLoading(true);
      getProjects({ filter, page: 1 })
        .then((data) => {
          setProjects(data.projects);
          setTotalPages(data.totalPages);
        })
        .catch(() => setProjects([]))
        .finally(() => {
          setTimeout(() => {
            setIsLoading(false);
          }, 300);
        });
    };
    fetchProjects();
  }, [filter, search]);

  useEffect(() => {
    if (search) return;
    const fetchProjects = async () => {
      setIsLoading(true);
      getProjects({ filter, page: currentPage })
        .then((data) => {
          setProjects(data.projects);
          setTotalPages(data.totalPages);
        })
        .catch(() => setProjects([]))
        .finally(() => {
          setTimeout(() => {
            setIsLoading(false);
          }, 300);
        });
    };
    fetchProjects();
  }, [currentPage]);

  useEffect(() => {
    if (!search) return;
    setIsLoading(true);
    setFilter(PROJECT_CATEGORIES[0].value);
    getProjectsSearch({ search, limit: 9, page: 1 })
      .then((data) => {
        setProjects(data.projects);
        setTotalPages(data.totalPages);
      })
      .catch(() => setProjects([]))
      .finally(() => {
        setIsLoading(false);
      });
  }, [search]);

  useEffect(() => {
    if (!search) return;
    setIsLoading(true);
    setFilter(PROJECT_CATEGORIES[0].value);
    getProjectsSearch({ search, limit: 9, page: currentPage })
      .then((data) => {
        setProjects(data.projects);
        setTotalPages(data.totalPages);
      })
      .catch(() => setProjects([]))
      .finally(() => {
        setIsLoading(false);
      });
  }, [currentPage]);

  useEffect(() => {
    setSearchInput('');
    setSearch('');
    setCurrentPage(1);
  }, [filter]);

  return (
    <div ref={sectionRef}>
      <Section title="Arhiva projekata">
        <div className="mb-40 flex flex-col md:flex-row items-center gap-12 md:gap-40">
          <ul className="flex gap-20 mb-12 w-full overflow-x-auto pb-12">
            {PROJECT_CATEGORIES.map((f, i) => (
              <motion.li
                key={f.value}
                className="min-w-max"
                initial={{ opacity: 0 }}
                whileInView={{ opacity: 1 }}
                transition={{
                  duration: 0.3,
                  delay: 0.3 + 0.1 * i,
                  ease: 'easeOut',
                }}
                viewport={{ once: true }}>
                <FilterItem
                  label={f.label}
                  active={filter === f.value}
                  onClick={() => setFilter(f.value)}
                />
              </motion.li>
            ))}
          </ul>
          <div className="relative max-md:w-full mb-12">
            <SearchIcon
              viewBox="0 0 16 16"
              className="absolute left-16 top-1/2 transform -translate-y-1/2 w-16 h-16 text-gray-400"
            />
            <Input
              type="text"
              placeholder="Pretraži projekte..."
              value={searchInput}
              onChange={(e) => {
                setSearchInput(e.target.value);
                debouncedSearch(e.target.value);
              }}
              className={cn(
                'pl-48 pr-16 py-12 text-16 bg-white/10 border-white/20 text-white placeholder:text-gray-400 focus:border-white/40 focus:ring-white/20 md:focus:w-[360px] transition-[width,color,box-shadow] duration-200',
                search ? 'md:w-[360px]' : 'md:w-[240px]',
              )}
            />
          </div>
        </div>
        {isLoading ? (
          <Grid Wrapper="ul" className="gap-12 md:gap-24">
            {[...Array(9)].map((_, index) => {
              const col =
                index % 3 === 0
                  ? 'col-span-24 sm:col-span-12 md:col-[1/9]'
                  : index % 3 === 1
                    ? 'col-span-24 sm:col-span-12 md:col-[9/17]'
                    : 'col-span-24 sm:col-span-12 md:col-[17/25]';

              return (
                <li key={index} className={cn('w-full h-full max-h-max', col)}>
                  <SkeletonNewsArticle
                    key={`skeleton-row-${index}`}
                    className="aspect-[340/244]"
                  />
                </li>
              );
            })}
          </Grid>
        ) : (
          <>
            {projects.length > 0 ? (
              <Grid Wrapper="ul" className="gap-12 md:gap-24">
                {projects.map((project, index) => {
                  const col =
                    index % 3 === 0
                      ? 'col-span-24 sm:col-span-12 md:col-[1/9]'
                      : index % 3 === 1
                        ? 'col-span-24 sm:col-span-12 md:col-[9/17]'
                        : 'col-span-24 sm:col-span-12 md:col-[17/25]';

                  return (
                    <li
                      key={index}
                      className={cn('w-full h-full max-h-max', col)}>
                      <ArchiveItem
                        title={project.data.title}
                        date={project.data.date}
                        image={project.data.hero_image?.url}
                        uid={project.uid}
                        sport={project.data.category as string}
                        basePath="/projekti"
                      />
                    </li>
                  );
                })}
              </Grid>
            ) : (
              <div className="col-span-24 w-full h-full flex justify-center items-center py-40">
                <p className="text-2xl font-medium text-white">
                  {search
                    ? 'Nema rezultata za ovu pretragu'
                    : 'Nema projekata za ovu kategoriju'}
                </p>
              </div>
            )}
          </>
        )}
        {totalPages > 1 && (
          <div className="flex justify-center items-center w-full mt-80 overflow-hidden">
            <Pagination>
              <PaginationContent>
                <PaginationPrevious
                  className="gap-1 px-2.5 sm:pr-2.5"
                  size="default"
                  disabled={currentPage === 1}
                  onClick={() => setCurrentPage(currentPage - 1)}
                />
                {getPaginationItems(currentPage, totalPages).map(
                  (item, index) => (
                    <PaginationItem key={index}>
                      {item.type === 'ellipsis' ? (
                        <PaginationEllipsis />
                      ) : (
                        <PaginationLink
                          isActive={currentPage === item.value}
                          onClick={() => setCurrentPage(item.value)}>
                          {item.value}
                        </PaginationLink>
                      )}
                    </PaginationItem>
                  ),
                )}
                <PaginationNext
                  className="gap-1 px-2.5 sm:pr-2.5"
                  aria-label="Go to next page"
                  size="default"
                  disabled={currentPage === totalPages}
                  onClick={() => setCurrentPage(currentPage + 1)}
                />
              </PaginationContent>
            </Pagination>
          </div>
        )}
      </Section>
    </div>
  );
};
