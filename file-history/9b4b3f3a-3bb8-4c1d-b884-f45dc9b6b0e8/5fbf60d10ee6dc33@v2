import { generateSeoData } from '@app/lib/generateSeoMetadata';
import { Metadata } from 'next';
import { SingleProject } from '../_fragments/SingleProject';
import { getSingleProject } from '../utils/getSingleProject';

export async function generateMetadata({
  params,
}: {
  params: Promise<{ uid: string }>;
}): Promise<Metadata> {
  const { uid } = await params;
  const project = await getSingleProject(uid);

  return await generateSeoData({
    seoTitle: `${project.data.meta_title || project.data.title || 'Projekti'} | ZOS`,
    seoDescription:
      project.data.meta_description || project.data.opening_text || '',
    path: `/projekti/${uid}`,
    img:
      project.data.meta_image?.url || project.data.hero_image?.url || null,
  });
}

export default async function Page({
  params,
}: {
  params: Promise<{ uid: string }>;
}) {
  const { uid } = await params;
  const project = await getSingleProject(uid);

  return <SingleProject project={project} />;
}
