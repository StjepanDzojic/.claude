import { Block, Text } from "@prototyp/skeletor";
import type { EventTimelineItem } from "@unomed/react-native-matrix-sdk";
import { TimelineService } from "modules/timeline/service/TimelineService";
import { type FC, useCallback, useState } from "react";
import { Button } from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

interface Props {
  event: EventTimelineItem;
  roomId: string;
  isUser: boolean;
}

export const MessageReactionsOverlay: FC<Props> = ({
  event,
  roomId,
  isUser,
}) => {
  const reactions = TimelineService.getTopReactions(event, 10);
  const [activeKey, setActiveKey] = useState<string | null>(null);

  const handleToggle = useCallback(
    async (emoji: string) => {
      if (activeKey) return;
      try {
        setActiveKey(emoji);
        await TimelineService.toggleReaction(roomId, event, emoji);
      } catch (error) {
        console.error("Failed to toggle reaction:", error);
        offlineToastHelper("Failed to update reaction");
      } finally {
        setActiveKey(null);
      }
    },
    [activeKey, event, roomId],
  );

  if (!reactions.length) return null;

  return (
    <Block
      flexDirection="row"
      gap={4}
      zIndex={20}
      margins={{ marginTop: 4 }}
      flex={{ flexWrap: "wrap" }}
      justify={isUser ? "flex-end" : "flex-start"}
      maxWidth={380}
    >
      {reactions.map((reaction) => (
        <Button.Wrapper
          key={reaction.key}
          response="scale"
          disabled={activeKey === reaction.key}
          onPress={() => handleToggle(reaction.key)}
        >
          <Block
            background={Colors.message}
            border={{
              borderRadius: 12,
              borderWidth: 1,
              borderColor: reaction.isHighlighted
                ? Colors.primary
                : Colors.white10,
            }}
            paddings={{ paddingHorizontal: 8, paddingVertical: 4 }}
            justify="center"
            align="center"
          >
            <Text size={TextSize.small} textAlign="center">
              {reaction.displayKey}
              {reaction.count > 1 ? ` ${reaction.count}` : ""}
            </Text>
          </Block>
        </Button.Wrapper>
      ))}
    </Block>
  );
};
