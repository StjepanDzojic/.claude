import { Block, Text } from "@prototyp/skeletor";
import {
  type EventTimelineItem,
  type FileMessageContent,
  MessageType_Tags,
  MsgLikeKind_Tags,
  TimelineItemContent_Tags,
} from "@unomed/react-native-matrix-sdk";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { getEventId, getEventTextContent } from "modules/matrix-client/utils";
import { NavigationContainerRef } from "modules/navigation/const";
import { TimelineService } from "modules/timeline/service/TimelineService";
import type { FC } from "react";
import { useRef, useState } from "react";
import { findNodeHandle, Image, type View } from "react-native";
import Share, { type ShareOptions } from "react-native-share";
import {
  Button,
  Loading,
  MessageTimestamp,
  PinIndicator,
  SeenBy,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";
import {
  copyToStablePath,
  effectiveWindowWidth,
  formatBytes,
  isPdf,
  offlineToastHelper,
} from "shared/utils";
import { MessageLongPressWrapper } from "../message-long-press-wrapper";
import { MessageSender } from "../message-sender";

interface Props {
  event: EventTimelineItem;
  isPreviousSameSender: boolean;
  onMemberPress?: (member: MemberDetailsPayload) => void;
}

const getFileContent = (
  event: EventTimelineItem,
): FileMessageContent | null => {
  if (event.content.tag === TimelineItemContent_Tags.MsgLike) {
    const kind = event.content.inner.content.kind;
    if (kind?.tag === MsgLikeKind_Tags.Message) {
      const msgType = kind.inner.content.msgType;
      if (msgType?.tag === MessageType_Tags.File) return msgType.inner.content;
    }
  }
  return null;
};

const width = effectiveWindowWidth(true);

export const FileMessage: FC<Props> = ({
  event,
  isPreviousSameSender,
  onMemberPress,
}) => {
  const content = getFileContent(event);
  const eventId = getEventId(event);
  const [messageWidth, setMessageWidth] = useState(40);
  const [isDownloading, setIsDownloading] = useState(false);
  const shareButtonRef = useRef<View | null>(null);
  const isUser = event.isOwn;
  const sender = event.senderProfile;
  const senderId = event.sender;
  const maxWidth = width - 60;
  const seenByUsers = TimelineService.getReadReceiptUsers(event);

  const handleOpen = async () => {
    if (!content?.source || !MatrixCore.instance) return;

    try {
      setIsDownloading(true);

      const ext =
        content.info?.mimetype?.split("/")[1] ??
        content.filename?.split(".").pop() ??
        "bin";
      const filename = content.filename ?? `file-${eventId}.${ext}`;

      const mediaHandle = await MatrixCore.instance.getMediaFile(
        content.source,
        filename,
        content.info?.mimetype || "application/octet-stream",
        false,
        undefined,
      );

      const filePath = mediaHandle.path();

      if (isPdf(content)) {
        const stableUrl = await copyToStablePath(filePath, filename);
        NavigationContainerRef.navigate("pdfViewer", {
          fileUrl: stableUrl,
          filename,
        });
        return;
      }

      const fileUrl = filePath.startsWith("file://")
        ? filePath
        : `file://${filePath}`;
      await Share.open({
        url: fileUrl,
        failOnCancel: false,
        anchor: findNodeHandle(shareButtonRef.current) ?? undefined,
      } as ShareOptions & { anchor?: number });
    } catch {
      offlineToastHelper("Failed to open file");
    } finally {
      setIsDownloading(false);
    }
  };

  if (!content) return null;

  return (
    <Block
      align={isUser ? "flex-end" : "flex-start"}
      margins={{ marginTop: isPreviousSameSender ? 6 : 16 }}
    >
      <MessageSender
        sender={sender}
        isUser={isUser}
        senderId={senderId}
        isPreviousSameSender={isPreviousSameSender}
        onMemberPress={onMemberPress}
      />
      <MessageLongPressWrapper
        event={event}
        content={getEventTextContent(event)}
      >
        <Block flexDirection={isUser ? "row-reverse" : "row"}>
          <Block
            paddings={12}
            background={isUser ? Colors.primary : Colors.message}
            border={{ borderRadius: 16 }}
            flexDirection={isUser ? "row-reverse" : "row"}
            gap={12}
            align="center"
            maxWidth={maxWidth}
            onLayout={(e) => setMessageWidth(e.nativeEvent.layout.width)}
          >
            <Button.Wrapper
              ref={shareButtonRef}
              disabled={isDownloading}
              onPress={handleOpen}
            >
              <Block
                width={40}
                height={40}
                align="center"
                justify="center"
                background={Colors.white20}
                border={{ borderRadius: 20 }}
              >
                {isDownloading ? (
                  <Loading isFullScreen={false} />
                ) : (
                  <Image
                    source={require("assets/icons/download.png")}
                    style={{ width: 20, height: 20 }}
                    tintColor={Colors.white}
                  />
                )}
              </Block>
            </Button.Wrapper>
            <Block gap={2} flex={{ flexShrink: 1 }} minWidth={0}>
              <Text size={TextSize.small} color="white" numberOfLines={1}>
                {content.filename ?? "File"}
              </Text>
              {content.info?.size != null && (
                <Text
                  size={TextSize.tiny}
                  color={Colors.white50}
                  numberOfLines={1}
                >
                  {formatBytes(content.info.size)}
                </Text>
              )}
            </Block>
            <MessageTimestamp event={event} isUser={isUser} />
          </Block>
          <PinIndicator event={event} />
        </Block>
      </MessageLongPressWrapper>
      <SeenBy users={seenByUsers} messageWidth={messageWidth} isUser={isUser} />
    </Block>
  );
};
