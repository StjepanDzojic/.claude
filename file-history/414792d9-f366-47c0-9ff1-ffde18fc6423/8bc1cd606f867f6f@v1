import { Block, Text } from "@prototyp/skeletor";
import {
  type EventTimelineItem,
  MessageType_Tags,
  MsgLikeKind_Tags,
  ProfileDetails_Tags,
  TimelineItemContent_Tags,
  type VideoMessageContent,
} from "@unomed/react-native-matrix-sdk";
import { format } from "date-fns";
import { useAtom, useSetAtom } from "jotai";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { getEventId } from "modules/matrix-client/utils";
import { NavigationContainerRef } from "modules/navigation/const";
import { TimelineAtoms } from "modules/timeline/jotai";
import { TimelineService } from "modules/timeline/service/TimelineService";
import { type FC, useCallback, useMemo, useRef, useState } from "react";
import { Alert, Dimensions, Share } from "react-native";
import { Loading } from "shared/components";
import {
  AppBottomSheet,
  type AppBottomSheetRef,
  AppBottomSheetScrollView,
} from "shared/components/bottom-sheet";
import { UserImage } from "shared/components/user-image/UserImage";
import { Colors } from "shared/styles";
import {
  adaptSize,
  formatBytes,
  isIpad,
  offlineToastHelper,
} from "shared/utils";
import { InfoRow } from "../info-row";
import { MessageContentListItem } from "../message-content-item-list";

const getVideoContent = (
  event: EventTimelineItem,
): VideoMessageContent | null => {
  if (event.content.tag === TimelineItemContent_Tags.MsgLike) {
    const kind = event.content.inner.content.kind;
    if (kind?.tag === MsgLikeKind_Tags.Message) {
      const msgType = kind.inner.content.msgType;
      if (msgType?.tag === MessageType_Tags.Video) {
        return msgType.inner.content;
      }
    }
  }
  return null;
};

const { height: SCREEN_HEIGHT } = Dimensions.get("window");

const formatDurationMs = (ms?: number) => {
  if (!ms || ms <= 0) return "—";
  const totalSeconds = Math.round(ms / 1000);
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return `${minutes}:${seconds.toString().padStart(2, "0")}`;
};

export const VideoInfoBottomSheet: FC = () => {
  const sheetRef = useRef<AppBottomSheetRef>(null);
  const [payload, setPayload] = useAtom(TimelineAtoms.videoInfoPayload);
  const [preparingAction, setPreparingAction] = useState<
    "share" | "download" | null
  >(null);
  const event = payload?.event ?? null;
  const roomId = payload?.roomId ?? null;
  const localUri = payload?.localUri ?? null;
  const videoContent = useMemo(
    () => (event ? getVideoContent(event) : null),
    [event],
  );
  const avatarUrl =
    event?.senderProfile.tag === ProfileDetails_Tags.Ready
      ? event.senderProfile.inner.avatarUrl
      : null;
  const displayName =
    event?.senderProfile.tag === ProfileDetails_Tags.Ready
      ? event.senderProfile.inner.displayName
      : undefined;
  const senderName = displayName ?? event?.sender ?? "";
  const formattedDate = useMemo(
    () => (event ? format(Number(event.timestamp), "MMM d, yyyy HH:mm") : ""),
    [event],
  );
  const filename = videoContent?.filename ?? "Video";
  const mimetype = videoContent?.info?.mimetype ?? "video/mp4";
  const duration = formatDurationMs(videoContent?.info?.duration);
  const size = formatBytes(videoContent?.info?.size);
  const isOwn = !!event?.isOwn;
  const setMediaViewerPayload = useSetAtom(TimelineAtoms.mediaViewerPayload);
  const setReplyPayload = useSetAtom(TimelineAtoms.replyPayload);
  const setEditPayload = useSetAtom(TimelineAtoms.editPayload);
  const setForwardPayload = useSetAtom(TimelineAtoms.forwardPayload);

  const closeSheet = useCallback(() => {
    sheetRef.current?.close();
  }, []);

  const handleClose = useCallback(() => {
    setPayload(null);
  }, [setPayload]);

  const handleReply = useCallback(() => {
    if (!event || !videoContent) {
      closeSheet();
      return;
    }
    const eventId = getEventId(event);
    if (!eventId) {
      closeSheet();
      return;
    }

    setEditPayload(null);
    setReplyPayload({
      eventId,
      senderName,
      content: videoContent.caption ?? filename,
      mediaSource: {
        source: videoContent.source,
        mimetype,
      },
    });
    closeSheet();
    setMediaViewerPayload(null);
  }, [
    event,
    videoContent,
    senderName,
    filename,
    mimetype,
    setEditPayload,
    setReplyPayload,
    setMediaViewerPayload,
    closeSheet,
  ]);

  const handleForward = useCallback(() => {
    if (!event || !roomId) return;

    setForwardPayload({
      event,
      content: videoContent?.caption ?? filename,
      messageType: "video",
    });
    closeSheet();
    setMediaViewerPayload(null);
    NavigationContainerRef.navigate("forwardMessage", {
      currentRoomId: roomId,
    });
  }, [
    event,
    roomId,
    videoContent,
    filename,
    setForwardPayload,
    setMediaViewerPayload,
    closeSheet,
  ]);

  const shareNamedFile = useCallback(async () => {
    if (!videoContent || !MatrixCore.instance) {
      if (!localUri) {
        offlineToastHelper("Video not ready yet");
        return;
      }
      const fallbackUrl = localUri.startsWith("file://")
        ? localUri
        : `file://${localUri}`;
      await Share.share({ url: fallbackUrl });
      return;
    }
    const mediaHandle = await MatrixCore.instance.getMediaFile(
      videoContent.source,
      filename,
      mimetype,
      false,
      undefined,
    );
    const filePath = mediaHandle.path();
    const url = filePath.startsWith("file://")
      ? filePath
      : `file://${filePath}`;
    await Share.share({ url });
  }, [videoContent, filename, mimetype, localUri]);

  const handleShare = useCallback(async () => {
    setPreparingAction("share");
    try {
      await shareNamedFile();
    } catch {
      offlineToastHelper("Failed to share video");
    } finally {
      setPreparingAction(null);
      closeSheet();
    }
  }, [shareNamedFile, closeSheet]);

  const handleDownload = useCallback(async () => {
    setPreparingAction("download");
    try {
      await shareNamedFile();
    } catch {
      offlineToastHelper("Failed to download video");
    } finally {
      setPreparingAction(null);
      closeSheet();
    }
  }, [shareNamedFile, closeSheet]);

  const handleDelete = useCallback(() => {
    if (!event || !roomId) return;
    Alert.alert(
      "Delete message",
      "Are you sure you want to delete this video? This cannot be undone.",
      [
        { text: "Cancel", style: "cancel" },
        {
          text: "Delete",
          style: "destructive",
          onPress: async () => {
            try {
              await TimelineService.deleteMessage(roomId, event);
              closeSheet();
              setMediaViewerPayload(null);
            } catch (error) {
              console.error("Failed to delete message:", error);
              offlineToastHelper("Failed to delete message");
            }
          },
        },
      ],
    );
  }, [event, roomId, setMediaViewerPayload, closeSheet]);

  return (
    <AppBottomSheet
      ref={sheetRef}
      isOpen={!!payload}
      onClose={handleClose}
      enableContentPanningGesture={false}
      maxContentSize={SCREEN_HEIGHT - 100}
      hideBackdrop={!isIpad()}
    >
      <AppBottomSheetScrollView scrollEnabled={false}>
        <Block
          paddings={{
            paddingTop: adaptSize(0, 20),
            paddingHorizontal: 20,
            paddingBottom: adaptSize(40, 20),
          }}
          gap={20}
        >
          {preparingAction && (
            <Block
              absolute
              offsets={[0, 0, 0, 0]}
              background={Colors.black70}
              zIndex={1}
            >
              <Loading
                isFullScreen={false}
                text={
                  preparingAction === "download"
                    ? "Preparing download..."
                    : "Preparing share..."
                }
              />
            </Block>
          )}

          <Block flexDirection="row" gap={12} align="center">
            <UserImage
              avatarUrl={avatarUrl}
              displayName={displayName}
              width={48}
              height={48}
              borderRadius={999}
            />
            <Block flex={1} gap={2}>
              <Text
                color={Colors.white}
                font="InstrumentSans-Semibold"
                numberOfLines={1}
              >
                {senderName}
              </Text>
              <Text color={Colors.white50} numberOfLines={1}>
                {event?.sender}
              </Text>
            </Block>
          </Block>

          <Block gap={12}>
            <InfoRow label="Date" value={formattedDate} />
            <InfoRow label="Name" value={filename} />
            <InfoRow label="Type" value={mimetype} />
            <InfoRow label="Size" value={size} />
            <InfoRow label="Duration" value={duration} />
          </Block>

          <Block>
            <MessageContentListItem
              title="Reply"
              icon={require("assets/icons/reply.png")}
              onPress={handleReply}
            />
            <MessageContentListItem
              title="Forward"
              icon={require("assets/icons/forward.png")}
              onPress={handleForward}
            />
            <MessageContentListItem
              title="Share"
              icon={require("assets/icons/upload-simple-large.png")}
              onPress={handleShare}
            />
            <MessageContentListItem
              title="Download"
              icon={require("assets/icons/download.png")}
              onPress={handleDownload}
              hasSeparator={isOwn}
            />
            {isOwn && (
              <MessageContentListItem
                title="Delete message"
                icon={require("assets/icons/trash.png")}
                onPress={handleDelete}
                tintColor={Colors.error}
                textColor={Colors.error}
                hasSeparator={false}
              />
            )}
          </Block>
        </Block>
      </AppBottomSheetScrollView>
    </AppBottomSheet>
  );
};
