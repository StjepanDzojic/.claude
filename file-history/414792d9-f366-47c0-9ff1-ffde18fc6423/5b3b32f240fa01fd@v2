import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import type { FC } from "react";
import { useRef, useState } from "react";
import {
  ActivityIndicator,
  findNodeHandle,
  Image,
  StyleSheet,
  type View,
} from "react-native";
import Pdf from "react-native-pdf";
import Share, { type ShareOptions } from "react-native-share";
import { Button, GoBackHeader, ScreenLayout } from "shared/components";
import { Colors, TextSize } from "shared/styles";

export const PdfViewer: FC<NativeStackScreenProps<Routes, "pdfViewer">> = ({
  route,
}) => {
  const { fileUrl, filename } = route.params;
  const [currentPage, setCurrentPage] = useState(1);
  const [totalPages, setTotalPages] = useState(0);
  const [error, setError] = useState<string | null>(null);
  const shareButtonRef = useRef<View | null>(null);

  const handleShare = () => {
    Share.open({
      url: fileUrl,
      title: filename,
      failOnCancel: false,
      anchor: findNodeHandle(shareButtonRef.current) ?? undefined,
    } as ShareOptions & { anchor?: number });
  };

  return (
    <ScreenLayout background={Colors.blackMinus1}>
      <GoBackHeader
        isClose
        title={filename}
        rightComp={
          <Button.Wrapper ref={shareButtonRef} onPress={handleShare}>
            <Image
              source={require("assets/icons/upload-simple-large.png")}
              style={styles.shareIcon}
              tintColor={Colors.white}
              width={16}
              height={16}
            />
          </Button.Wrapper>
        }
      />
      {error ? (
        <Block flex={1} align="center" justify="center" paddings={24}>
          <Text size={TextSize.small} color={Colors.white50}>
            {error}
          </Text>
        </Block>
      ) : (
        <Block flex={1}>
          <Pdf
            source={{ uri: fileUrl, cache: false }}
            style={styles.pdf}
            onLoadComplete={(pages) => setTotalPages(pages)}
            onPageChanged={(page) => setCurrentPage(page)}
            onError={(err) =>
              setError(
                err instanceof Error ? err.message : "Failed to load PDF",
              )
            }
            renderActivityIndicator={() => (
              <ActivityIndicator color={Colors.white} />
            )}
            enablePaging
            fitPolicy={0}
          />
          {totalPages > 0 && (
            <Block
              absolute
              offsets={{ bottom: 12, right: 16 }}
              background={Colors.black70}
              border={{ borderRadius: 12 }}
              paddings={[4, 10]}
            >
              <Text size={TextSize.tiny} color={Colors.white80}>
                {currentPage} / {totalPages}
              </Text>
            </Block>
          )}
        </Block>
      )}
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  pdf: {
    flex: 1,
    width: "100%",
    height: "100%",
    backgroundColor: "transparent",
  },
  shareIcon: {
    width: 16,
    height: 16,
  },
});
