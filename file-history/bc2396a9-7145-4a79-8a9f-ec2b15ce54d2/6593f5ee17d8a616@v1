import { Block, useAnimateSequence } from "@prototyp/skeletor";
import {
  errorCodes,
  isErrorWithCode,
  pick,
} from "@react-native-documents/picker";
import { useAtom } from "jotai";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { NavigationContainerRef } from "modules/navigation/const";
import { TimelineAtoms } from "modules/timeline/jotai";
import { type FC, useEffect, useState } from "react";
import { Easing, Image, Modal, StyleSheet } from "react-native";
import { launchCamera, launchImageLibrary } from "react-native-image-picker";
import { Button, Loading } from "shared/components";
import { Colors } from "shared/styles";
import { offlineToastHelper } from "shared/utils";
import { SingleSendItem } from "../single-send-item";

const formatBytes = (bytes: bigint) => {
  if (bytes < 1024n) return `${bytes} B`;
  if (bytes < 1024n * 1024n) return `${(Number(bytes) / 1024).toFixed(1)} KB`;
  return `${(Number(bytes) / (1024 * 1024)).toFixed(1)} MB`;
};

const getMaxUploadSize = async () => {
  try {
    return await MatrixCore.getClient().getMaxMediaUploadSize();
  } catch {
    return null;
  }
};

interface Props {
  roomId: string;
}

export const SendItemsList: FC<Props> = ({ roomId }) => {
  const [isListOpen, setisListOpen] = useState(false);
  const [isSending, setIsSending] = useState(false);
  const [replyPayload, setReplyPayload] = useAtom(TimelineAtoms.replyPayload);

  const handleCloseList = () => {
    setisListOpen(false);
  };

  const handleOpenList = () => {
    setisListOpen(true);
    if (replyPayload) setReplyPayload(null);
  };

  const openImagePicker = async () => {
    try {
      setIsSending(true);
      const response = await launchImageLibrary({
        mediaType: "mixed",
        selectionLimit: 3,
        includeBase64: true,
      });

      if (!response.assets?.length) return;

      const maxSize = await getMaxUploadSize();
      if (maxSize !== null) {
        const oversized = response.assets.filter(
          (a) => a.fileSize != null && BigInt(a.fileSize) > maxSize,
        );
        if (oversized.length > 0) {
          offlineToastHelper(
            "File too large",
            `Maximum upload size is ${formatBytes(maxSize)}`,
          );
          return;
        }
      }

      handleCloseList();
      // Delay to ensure the list is closed
      setTimeout(() => {
        if (!response.assets?.length) return;
        NavigationContainerRef.navigate("sendImages", {
          roomId,
          images: response.assets,
        });
      }, 300);
    } catch {
      offlineToastHelper("Failed to upload images");
    } finally {
      setIsSending(false);
    }
  };

  const openCamera = async () => {
    try {
      setIsSending(true);
      const response = await launchCamera({
        mediaType: "photo",
        includeBase64: true,
      });

      if (!response.assets?.length) return;

      const maxSize = await getMaxUploadSize();
      if (maxSize !== null) {
        const oversized = response.assets.filter(
          (a) => a.fileSize != null && BigInt(a.fileSize) > maxSize,
        );
        if (oversized.length > 0) {
          offlineToastHelper(
            "File too large",
            `Maximum upload size is ${formatBytes(maxSize)}`,
          );
          return;
        }
      }

      handleCloseList();
      // Delay to ensure the list is closed
      setTimeout(() => {
        if (!response.assets?.length) return;
        NavigationContainerRef.navigate("sendImages", {
          roomId,
          images: response.assets,
        });
      }, 300);
    } catch {
      offlineToastHelper("Failed to take photo");
    } finally {
      setIsSending(false);
    }
  };

  const openAttachment = async () => {
    try {
      const result = await pick({
        mode: "import",
        allowMultiSelection: false,
      });

      if (!result || result.length === 0) return;

      const file = result[0];

      const maxSize = await getMaxUploadSize();

      if (
        maxSize !== null &&
        file.size != null &&
        BigInt(file.size) > maxSize
      ) {
        offlineToastHelper("File too large");
        return;
      }

      handleCloseList();

      setTimeout(() => {
        NavigationContainerRef.navigate("sendFile", { roomId, file });
      }, 300);
    } catch (error: unknown) {
      if (
        isErrorWithCode(error) &&
        error.code === errorCodes.OPERATION_CANCELED
      ) {
        return;
      }

      console.error("Failed to open file picker:", error);
      offlineToastHelper("Failed to open file");
    }
  };

  const list = useAnimateSequence(
    {
      opacity: [0, 1],
    },
    { duration: 200, easing: Easing.ease, native: false },
  );

  useEffect(() => {
    if (isListOpen) list.start();
    else list.reverse();
  }, [isListOpen]);

  return (
    <Block zIndex={2}>
      <Button.Outline
        style={styles.container}
        disabled={isSending}
        onPress={handleOpenList}
      >
        <Image
          source={require("assets/icons/plus.png")}
          style={styles.image}
          width={24}
          height={24}
        />
      </Button.Outline>
      <Modal visible={isListOpen} transparent={true} animationType="fade">
        <Block
          width="100%"
          height="100%"
          justify="flex-end"
          align="center"
          background={Colors.black70}
          paddings={[40, 20]}
        >
          {isSending && <Loading />}
          <Block width="100%" gap={8}>
            <Block
              width="100%"
              background={Colors.blackMinus3}
              border={{ borderRadius: 14 }}
            >
              <SingleSendItem
                title="Camera"
                image={require("assets/icons/camera.png")}
                onPress={openCamera}
                showSeparator
              />
              <SingleSendItem
                title="Photo & Video"
                image={require("assets/icons/image.png")}
                onPress={openImagePicker}
                showSeparator
              />
              <SingleSendItem
                title="Attachment"
                image={require("assets/icons/upload-simple-large.png")}
                onPress={openAttachment}
              />
            </Block>
            <Block
              width="100%"
              background={Colors.blackMinus3}
              border={{ borderRadius: 14 }}
            >
              <SingleSendItem title="Cancel" onPress={handleCloseList} />
            </Block>
          </Block>
        </Block>
      </Modal>
    </Block>
  );
};

const styles = StyleSheet.create({
  container: {
    width: 48,
    height: 48,
    alignItems: "center",
    justifyContent: "center",
  },
  image: {
    width: 24,
    height: 24,
  },
});
