import { Block, Text } from "@prototyp/skeletor";
import { useAtom } from "jotai";

import { type FC, useCallback, useState } from "react";
import { Dimensions, Image, Modal, Pressable, StyleSheet } from "react-native";
import { SingleSendItem } from "screens/room/fragments/single-send-item";
import { Button } from "shared/components";
import { SharedAtoms } from "shared/jotai";
import { Colors, TextSize } from "shared/styles";

const { width: SCREEN_WIDTH } = Dimensions.get("window");
const MENU_WIDTH = SCREEN_WIDTH - 40;

const OPTIONS: { label: string; value: SecurityFilterValue }[] = [
  { label: "All Chats", value: "all" },
  { label: "Secure Chats", value: "secure" },
  { label: "Unsecure Chats", value: "unsecure" },
];

export const SecurityFilter: FC = () => {
  const [securityFilter, setSecurityFilter] = useAtom(
    SharedAtoms.securityFilter,
  );
  const [isOpen, setIsOpen] = useState(false);
  const activeLabel =
    OPTIONS.find((o) => o.value === securityFilter)?.label ?? "All Chats";

  const close = useCallback(() => setIsOpen(false), []);

  const select = useCallback(
    (option: SecurityFilterValue) => {
      setSecurityFilter(option);
      close();
    },
    [setSecurityFilter, close],
  );

  return (
    <>
      <Block paddings={[0, 20]} margins={{ marginBottom: 32 }}>
        <Button.Wrapper onPress={() => setIsOpen(true)}>
          <Block flexDirection="row" align="center" gap={4}>
            <Text color={Colors.white} size={TextSize.small}>
              Show {activeLabel.toLowerCase()}
            </Text>
            <Image
              source={require("assets/icons/caret-left.png")}
              style={styles.caret}
              tintColor={Colors.white}
            />
          </Block>
        </Button.Wrapper>
      </Block>
      <Modal visible={isOpen} transparent animationType="fade">
        <Pressable style={styles.overlay} onPress={close}>
          <Block
            absolute
            offsets={{ left: 20, bottom: 20 }}
            width={MENU_WIDTH}
            background={Colors.blackMinus3}
            border={{ borderRadius: 14 }}
          >
            {OPTIONS.map((option, index) => (
              <SingleSendItem
                key={option.value}
                title={option.label}
                showSeparator={index < OPTIONS.length - 1}
                textColor={
                  option.value === securityFilter
                    ? Colors.white
                    : Colors.white50
                }
                onPress={() => select(option.value)}
              />
            ))}
          </Block>
        </Pressable>
      </Modal>
    </>
  );
};

const styles = StyleSheet.create({
  caret: {
    width: 12,
    height: 12,
    transform: [{ rotate: "270deg" }],
  },
  overlay: {
    flex: 1,
    backgroundColor: Colors.black70,
  },
});
