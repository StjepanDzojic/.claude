import { animateParallel, Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { useAtomValue } from "jotai";
import { AuthService } from "modules/auth/service/AuthService";
import { CallKitService } from "modules/call/service/CallKitService";
import { CallOverlayService } from "modules/call/service/CallOverlayService";
import { MatrixBaseURL } from "modules/matrix-client/const";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { resetToRoom } from "modules/navigation/utils";
import { PushNotificationsAtoms } from "modules/push-notifications/jotai";
import { NotifeeService } from "modules/push-notifications/service";
import { StorageAtoms } from "modules/storage/jotai/atoms";
import { VerificationService } from "modules/verification/service/VerificationService";
import { useEffect, useRef } from "react";
import { Image, Platform, StyleSheet } from "react-native";
import { ScreenLayout } from "shared/components";
import { TextSize } from "shared/styles";

type SplashNavigation = NativeStackScreenProps<Routes, "splash">["navigation"];

type CheckAuthAndNavigateParams = {
  navigation: SplashNavigation;
  hasSeenOnboarding: boolean;
  hasSeenNotificationsIntro: boolean;
};

export const Splash: React.FC<NativeStackScreenProps<Routes, "splash">> = ({
  navigation,
}) => {
  const hasSeenOnboarding = useAtomValue(StorageAtoms.hasSeenOnboarding);
  const hasSeenNotificationsIntro = useAtomValue(
    PushNotificationsAtoms.hasSeenNotificationsIntro,
  );
  const transition = useRef(
    animateParallel(
      { opacity: [0, 1], translateY: [40, 0] },
      { duration: 200 },
    ),
  ).current;

  const checkAuthAndNavigate = async ({
    navigation,
    hasSeenOnboarding,
    hasSeenNotificationsIntro,
  }: CheckAuthAndNavigateParams) => {
    try {
      if (Platform.OS === "ios") {
        // Register CallKit listeners as early as possible so buffered
        // cold-start answer/end actions are captured before navigation.
        await CallKitService.setup();
      }

      // Check if we have stored credentials
      if (AuthService.hasStoredCredentials()) {
        const sessionRestored = await AuthService.restoreSession();
        const isVerified = VerificationService.isDeviceVerified();

        if (sessionRestored && !isVerified) {
          navigation.replace("confirmIdentity");
          return;
        }

        if (!hasSeenOnboarding) {
          navigation.replace("onboarding");
          return;
        }

        if (!hasSeenNotificationsIntro) {
          navigation.replace("notificationsIntro");
          return;
        }

        if (sessionRestored) {
          // Start sync — no-op if offline, rooms are served from local cache
          AuthService.startSync();

          // Check if app was launched by accepting a CallKit call (quit state)
          const pendingCall = CallKitService.consumePendingAnsweredCall();
          const hasPendingCall = !!pendingCall?.roomId;
          if (hasPendingCall && pendingCall) {
            await MatrixCore.refreshRoomList();
            await MatrixCore.getClient().awaitRoomRemoteEcho(
              pendingCall.roomId,
            );

            navigation.reset({
              index: 0,
              routes: [{ name: "home" }],
            });
            setTimeout(() => {
              CallOverlayService.openCall(
                pendingCall.roomId,
                pendingCall.roomName,
              );
            }, 250);

            return;
          }

          // Check if app was opened from a Notifee notification (quit state)
          await NotifeeService.checkInitialNotification();

          // Check if app was opened from a notification
          const pendingRoomId = NotifeeService.consumePendingRoomId();
          await MatrixCore.refreshRoomList();

          if (pendingRoomId) {
            await MatrixCore.getClient().awaitRoomRemoteEcho(pendingRoomId);

            resetToRoom(pendingRoomId);

            return;
          }

          navigation.replace("home");
          return;
        }
      }

      await AuthService.initialize(MatrixBaseURL);
      setTimeout(() => {
        navigation.replace("welcome");
      }, 1000);
    } catch (error) {
      console.warn("Error during auth check:", error);
      navigation.replace("welcome");
    }
  };

  useEffect(() => {
    transition.start(() =>
      checkAuthAndNavigate({
        navigation,
        hasSeenOnboarding,
        hasSeenNotificationsIntro,
      }),
    );
  }, [navigation, hasSeenOnboarding, hasSeenNotificationsIntro, transition]);

  return (
    <ScreenLayout>
      <Block
        animations={transition.animations}
        flex={1}
        align="center"
        justify="space-between"
      >
        <Image
          source={require("assets/images/logo.png")}
          width={120}
          height={120}
          style={styles.logo}
        />
        <Text font="Silkscreen-Regular" size={TextSize.medium}>
          CLOAK
        </Text>
      </Block>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  logo: {
    marginVertical: "auto",
  },
});
