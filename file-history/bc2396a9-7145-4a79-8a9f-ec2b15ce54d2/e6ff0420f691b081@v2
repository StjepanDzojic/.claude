import { Block } from "@prototyp/skeletor";
import {
  ReceiptType,
  type RoomInfo,
  type RoomInterface,
} from "@unomed/react-native-matrix-sdk";
import { NavigationContainerRef } from "modules/navigation/const";
import { type FC, useEffect } from "react";
import { Dimensions, Modal, Pressable, StyleSheet } from "react-native";
import { SingleSendItem } from "screens/room/fragments/single-send-item";
import { Colors } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

const { height: SCREEN_HEIGHT, width: SCREEN_WIDTH } = Dimensions.get("window");
const MENU_WIDTH = SCREEN_WIDTH - 40;

interface Props {
  room: RoomInterface;
  roomInfo: RoomInfo | undefined;
  hasUnread: boolean;
  isFavorite: boolean;
  isVisible: boolean;
  leaveRoom: () => void;
  fetchMembers: () => void;
  onClose: () => void;
  onRoomInfoUpdated: (info: RoomInfo) => void;
}

export { SCREEN_HEIGHT };

export const RoomContextMenu: FC<Props> = ({
  room,
  hasUnread,
  isFavorite,
  isVisible,
  leaveRoom,
  fetchMembers,
  onClose,
  onRoomInfoUpdated,
}) => {
  const handleMarkAsReadUnread = async () => {
    onClose();
    try {
      if (hasUnread) await room.markAsRead(ReceiptType.Read);
      else await room.setUnreadFlag(true);
      const updatedInfo = await room.roomInfo();
      onRoomInfoUpdated(updatedInfo);
    } catch (error) {
      console.error(error);
      offlineToastHelper(
        hasUnread
          ? "Failed to mark room as read"
          : "Failed to mark room as unread",
      );
    }
  };

  const handleToggleFavourite = async () => {
    onClose();
    try {
      await room.setIsFavourite(!isFavorite, undefined);
      const updatedInfo = await room.roomInfo();
      onRoomInfoUpdated(updatedInfo);
    } catch (error) {
      console.error(error);
      offlineToastHelper(
        isFavorite
          ? "Failed to remove from favorites"
          : "Failed to add to favorites",
      );
    }
  };

  const handleSettings = () => {
    onClose();
    NavigationContainerRef.navigate("roomDetails", { room });
  };

  const handleLeaveRoom = () => {
    onClose();
    leaveRoom();
  };

  useEffect(() => {
    if (!isVisible) return;
    fetchMembers();
  }, [isVisible, fetchMembers]);

  return (
    <Modal visible={isVisible} transparent presentationStyle="overFullScreen" animationType="fade">
      <Pressable style={styles.modalOverlay} onPress={onClose}>
        <Block
          absolute
          offsets={{
            left: 20,
            bottom: 20,
          }}
          width={MENU_WIDTH}
          background={Colors.blackMinus3}
          border={{ borderRadius: 14 }}
        >
          <SingleSendItem
            title={hasUnread ? "Mark as read" : "Mark as unread"}
            image={require("assets/icons/chat.png")}
            onPress={handleMarkAsReadUnread}
            showSeparator
          />
          <SingleSendItem
            title={isFavorite ? "Remove favorite" : "Add to favorites"}
            image={require("assets/icons/star.png")}
            onPress={handleToggleFavourite}
            showSeparator
          />
          <SingleSendItem
            title="Settings"
            image={require("assets/icons/wrench.png")}
            onPress={handleSettings}
            showSeparator
          />
          <SingleSendItem
            title="Leave room"
            image={require("assets/icons/sign-out.png")}
            textColor={Colors.error}
            tintColor={Colors.error}
            onPress={handleLeaveRoom}
          />
        </Block>
      </Pressable>
    </Modal>
  );
};

const styles = StyleSheet.create({
  modalOverlay: {
    flex: 1,
    backgroundColor: Colors.black70,
  },
});
