import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import type { UserProfile } from "@unomed/react-native-matrix-sdk";
import { RoomService } from "modules/room/service/RoomService";
import { useState } from "react";
import { Button, GoBackHeader, Loading, ScreenLayout } from "shared/components";
import { Colors } from "shared/styles";
import { offlineToastHelper } from "shared/utils";
import { PeopleSearch } from "./fragments";

export const InvitePeople: React.FC<
  NativeStackScreenProps<Routes, "invitePeople">
> = ({ navigation, route }) => {
  const { roomId, isCreateRoom, members } = route.params;
  const [loading, setLoading] = useState(false);
  const [invitedPeople, setInvitedPeople] = useState<UserProfile[]>([]);

  const handleNavigateToRoom = () => {
    navigation.reset({
      index: 1,
      routes: [{ name: "home" }, { name: "room", params: { roomId } }],
    });
  };

  const handleSkip = async () => {
    setLoading(true);
    try {
      handleNavigateToRoom();
    } catch (error) {
      console.error(error);
    } finally {
      setLoading(false);
    }
  };

  const handleNext = async () => {
    setLoading(true);
    try {
      await RoomService.invitePeopleToRoom(roomId, invitedPeople);
      if (isCreateRoom) handleNavigateToRoom();
      else navigation.goBack();
    } catch (error) {
      console.error(error);
      offlineToastHelper(
        "Failed to invite people. You don't have permission to invite people to this room.",
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <ScreenLayout background={Colors.blackMinus1} type="modal">
      {loading && <Loading text="Inviting people..." />}
      <GoBackHeader
        onGoBack={isCreateRoom ? handleSkip : undefined}
        title="Invite people"
        rightComp={
          isCreateRoom ? (
            <Button.Wrapper onPress={handleSkip}>
              <Text>Skip</Text>
            </Button.Wrapper>
          ) : null
        }
      />
      <PeopleSearch
        members={members}
        invitedPeople={invitedPeople}
        setInvitedPeople={setInvitedPeople}
      />
      <Block
        absolute
        offsets={{ bottom: 32, left: 20 }}
        paddings={[0, 52]}
        width="100%"
      >
        <Button.Primary
          onPress={handleNext}
          disabled={loading || !invitedPeople.length}
          width="100%"
        >
          Next
        </Button.Primary>
      </Block>
    </ScreenLayout>
  );
};
