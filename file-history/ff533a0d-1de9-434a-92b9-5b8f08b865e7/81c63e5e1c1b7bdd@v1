import { Block, Text } from "@prototyp/skeletor";
import { FlashList } from "@shopify/flash-list";
import {
  type EventTimelineItem,
  MessageType_Tags,
  MsgLikeKind_Tags,
  TimelineItemContent_Tags,
} from "@unomed/react-native-matrix-sdk";
import type { FC } from "react";
import { Loading } from "shared/components/loading";
import { Colors, TextSize } from "shared/styles";
import { AudioListItem } from "../audio-list-item";
import { FileListItem } from "../file-list-item";

function getItemType(event: EventTimelineItem): "file" | "audio" | null {
  if (event.content.tag === TimelineItemContent_Tags.MsgLike) {
    const kind = event.content.inner.content.kind;
    if (kind?.tag === MsgLikeKind_Tags.Message) {
      const tag = kind.inner.content.msgType?.tag;
      if (tag === MessageType_Tags.File) return "file";
      if (tag === MessageType_Tags.Audio) return "audio";
    }
  }
  return null;
}

const keyExtractor = (item: EventTimelineItem) => {
  const eventId = item.eventOrTransactionId;
  if (eventId?.tag === "EventId") return eventId.inner.eventId;
  if (eventId?.tag === "TransactionId") return eventId.inner.transactionId;
  return String(item.timestamp);
};

interface Props {
  items: EventTimelineItem[];
  loading: boolean;
  isEmpty: boolean;
  onEndReached?: () => void;
}

export const FilesList: FC<Props> = ({
  items,
  loading,
  isEmpty,
  onEndReached,
}) => {
  return (
    <FlashList
      data={items}
      renderItem={({ item }) => {
        const type = getItemType(item);
        if (type === "file") return <FileListItem event={item} />;
        if (type === "audio") return <AudioListItem event={item} />;
        return null;
      }}
      keyExtractor={keyExtractor}
      showsVerticalScrollIndicator={false}
      ListEmptyComponent={
        !loading ? (
          <Block align="center" justify="center" flex={1} paddings={40}>
            <Text size={TextSize.medium} color={Colors.white50}>
              No files found
            </Text>
          </Block>
        ) : null
      }
      ListFooterComponent={
        loading && !isEmpty ? (
          <Block align="center" justify="center" flex={1} paddings={40}>
            <Loading isFullScreen={false} />
          </Block>
        ) : null
      }
      onEndReached={onEndReached}
      onEndReachedThreshold={0.5}
    />
  );
};
