import CallKit
import UserNotifications

/// Notification Service Extension — runs in a separate process for EVERY incoming
/// APNs push (including those delivered by FCM) that has `mutable-content: 1`.
///
/// When a Matrix call event arrives we call CXProvider.reportNewIncomingVoIPPushPayload()
/// which tells iOS to wake the main app's PKPushRegistryDelegate even if the app is killed.
/// AppDelegate then calls RNCallKeep.reportNewIncomingCall() and CallKit UI appears.
///
/// For encrypted events (m.room.encrypted) we can't decrypt here, so we skip the
/// VoIP trigger — those are handled by the existing JS path when the app is alive.
class NotificationService: UNNotificationServiceExtension {
  var contentHandler: ((UNNotificationContent) -> Void)?
  var bestAttemptContent: UNMutableNotificationContent?

  override func didReceive(
    _ request: UNNotificationRequest,
    withContentHandler contentHandler: @escaping (UNNotificationContent) -> Void
  ) {
    self.contentHandler = contentHandler
    bestAttemptContent = request.content.mutableCopy() as? UNMutableNotificationContent

    let userInfo = request.content.userInfo
    let type = userInfo["type"] as? String

    let isCall = type == "m.call.invite" || type == "m.call.member"

    if isCall {
      // This wakes the main app (even if killed) and fires
      // AppDelegate.pushRegistry(_:didReceiveIncomingPushWith:) with userInfo as the payload.
      // AppDelegate then calls RNCallKeep.reportNewIncomingCall() → CallKit UI.
      CXProvider.reportNewIncomingVoIPPushPayload(userInfo) { error in
        if let error = error {
          print("[NSE] reportNewIncomingVoIPPushPayload error: \(error)")
        }
      }

      // Suppress the visible notification — CallKit UI takes over
      contentHandler(UNNotificationContent())
      return
    }

    // Non-call notification: deliver as-is (Notifee/JS handles display)
    contentHandler(bestAttemptContent ?? request.content)
  }

  override func serviceExtensionTimeWillExpire() {
    if let contentHandler = contentHandler, let best = bestAttemptContent {
      contentHandler(best)
    }
  }
}
