import { Block, Text } from "@prototyp/skeletor";
import type { FC } from "react";
import { Modal } from "react-native";
import { Button } from "shared/components";
import { Colors, TextSize } from "shared/styles";

interface Props {
  visible: boolean;
  isResetting: boolean;
  onConfirm: () => void;
  onClose: () => void;
}

export const ResetConfirmModal: FC<Props> = ({
  visible,
  isResetting,
  onConfirm,
  onClose,
}) => {
  return (
    <Modal
      visible={visible}
      transparent
      presentationStyle="overFullScreen"
      animationType="fade"
      onRequestClose={onClose}
    >
      <Block
        width="100%"
        height="100%"
        justify="center"
        align="center"
        background={Colors.black70}
        paddings={[40, 20]}
      >
        <Block
          width="100%"
          background={Colors.blackMinus2}
          paddings={20}
          border={{ borderRadius: 36 }}
          gap={12}
        >
          <Text size={TextSize.large}>Reset permissions</Text>
          <Text size={TextSize.small} color={Colors.white50}>
            Are you sure you want to reset room permissions to defaults?
          </Text>
          <Block gap={8} flexDirection="row" width="100%">
            <Block flex={1}>
              <Button.Ghost
                onPress={onClose}
                disabled={isResetting}
                width="100%"
              >
                Cancel
              </Button.Ghost>
            </Block>
            <Block flex={1}>
              <Button.Warning
                onPress={onConfirm}
                disabled={isResetting}
                width="100%"
              >
                Reset
              </Button.Warning>
            </Block>
          </Block>
        </Block>
      </Block>
    </Modal>
  );
};
