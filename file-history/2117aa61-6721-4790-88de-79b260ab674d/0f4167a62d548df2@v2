import {
  type FirebaseMessagingTypes,
  getInitialNotification,
  getMessaging,
  getToken,
  onMessage,
  onNotificationOpenedApp,
} from "@react-native-firebase/messaging";
import { AuthService } from "modules/auth/service/AuthService";
import { CallKitService } from "modules/call/service/CallKitService";
import { MatrixStorage } from "modules/matrix-client/const/matrix-storage";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { NavigationContainerRef } from "modules/navigation/const";
import { openRoom } from "modules/navigation/utils";
import { MatrixNotificationService } from "modules/push-notifications/service/MatrixNotificationService";
import { RoomService } from "modules/room/service/RoomService";
import { AppState, Platform } from "react-native";
import {
  checkNotifications,
  RESULTS,
  requestNotifications,
} from "react-native-permissions";
import {
  formatLocalPushNotificationMessage,
  getNotificationItemContent,
  isNotificationItemAnyCallEvent,
  isNotificationItemCallInvite,
  isNotificationItemVerificationStep,
} from "../util/formatLocalMessage";
import { NotifeeService } from "./NotifeeService";

/** Get the current user ID, works in both foreground and background */
const getCurrentUserId = (): string | null => {
  // Try to get from active instance first (foreground)
  const instanceUserId = MatrixCore.instance?.userId();
  if (instanceUserId) return instanceUserId;

  // Fall back to stored credentials (works in background)
  const credentials = MatrixStorage.getLoginCredentials();
  return credentials?.userId || null;
};

/**
 * Ensure MatrixService is initialized for background decryption
 * Uses lightweight initialization that doesn't start sync service
 */
const ensureServiceInitialized = async (): Promise<boolean> => {
  const notificationClient = MatrixNotificationService.getNotificationClient();
  if (notificationClient) return true;

  // Foreground: create notification client if possible
  if (MatrixCore.instance) {
    const client = await MatrixNotificationService.ensureNotificationClient();
    return !!client;
  }

  // Try to restore session with lightweight background method
  try {
    const restored = await AuthService.restoreSessionForBackground();
    return restored;
  } catch (error) {
    console.error("[Push] Failed to restore session:", error);
    return false;
  }
};

const isCurrentlyViewingRoom = (roomId: string): boolean => {
  if (AppState.currentState !== "active") return false;
  if (!NavigationContainerRef?.isReady()) return false;

  try {
    const route = NavigationContainerRef?.getCurrentRoute();
    return route?.name === "room" && route.params?.roomId === roomId;
  } catch {
    return false;
  }
};

const handleReceivedMessage = async (
  message: FirebaseMessagingTypes.RemoteMessage,
) => {
  const data = message.data as unknown as NotificationData;
  if (!data) return;

  // Skip notifications for own messages (works in both foreground and background)
  const currentUserId = getCurrentUserId();
  if (currentUserId && data.sender === currentUserId) return;

  const senderName = data.sender_display_name || data.sender || "Unknown";

  // Route unencrypted call events directly to CallKit on iOS (no local notification needed)
  const isCallOnIOS =
    Platform.OS === "ios" &&
    (data.type === "m.call.invite" ||
      data.type === "m.call.member" ||
      data.type === "m.rtc.notification");

  if (isCallOnIOS) {
    if (CallKitService.isRingingForRoom(data.room_id)) return;
    CallKitService.displayIncomingCall({
      roomId: data.room_id,
      roomName: data.room_name || senderName,
      senderDisplayName: senderName,
    });
    return;
  }

  const notificationId = message.messageId || `msg_${Date.now()}`;
  const formattedMessage = formatLocalPushNotificationMessage(data);
  if (!formattedMessage) return;

  // Decrypt encrypted messages, then check if it's a call or a regular message
  if (data.type === "m.room.encrypted" && data.room_id && data.event_id) {
    try {
      const initialized = await ensureServiceInitialized();
      if (!initialized) return;

      // Single SDK round-trip — all checks below are synchronous on the result
      const { item, filteredOut } =
        await MatrixNotificationService.getNotificationResult(
          data.room_id,
          data.event_id,
        );

      // Suppress events the SDK filtered out via push rules (e.g. m.call.hangup on call decline)
      if (filteredOut || !item) return;

      // Route decrypted call invites to CallKit on iOS
      if (Platform.OS === "ios" && isNotificationItemCallInvite(item)) {
        if (CallKitService.isRingingForRoom(data.room_id)) return;
        const roomName = RoomService.getRoomInfo(data.room_id)?.displayName();
        CallKitService.displayIncomingCall({
          roomId: data.room_id,
          roomName: roomName || data.room_name || senderName,
          senderDisplayName: senderName,
        });
        return;
      }

      // Suppress all other call-related events (Answer, Hangup, Candidates) on all platforms
      if (isNotificationItemAnyCallEvent(item)) return;

      // Suppress protocol-level verification steps (Start, Accept, Key, Mac, Cancel, Done)
      if (isNotificationItemVerificationStep(item)) return;

      if (isCurrentlyViewingRoom(data.room_id)) return;

      const roomName = RoomService.getRoomInfo(data.room_id)?.displayName();
      const decryptedContent = getNotificationItemContent(item);

      await NotifeeService.create({
        title: roomName || formattedMessage.title,
        message: decryptedContent
          ? `${senderName}: ${decryptedContent}`
          : formattedMessage.message,
        id: notificationId,
        data: { room_id: data.room_id },
      });
    } catch (error) {
      console.error("[Push] Failed to decrypt:", error);
    }
    return;
  }

  // Non-encrypted messages — show directly
  if (
    formattedMessage.room_id &&
    isCurrentlyViewingRoom(formattedMessage.room_id)
  ) {
    return;
  }

  await NotifeeService.create({
    title: formattedMessage.title,
    message: formattedMessage.message,
    id: notificationId,
    data: { room_id: formattedMessage.room_id },
  });
};

const handleNotificationPress = async (
  message: FirebaseMessagingTypes.RemoteMessage | null,
  isInitialNotification: boolean,
) => {
  const data = message?.data as unknown as NotificationData;
  const roomId = data?.room_id;

  if (!roomId || typeof roomId !== "string") return;

  // For initial notification (cold start), store the room_id
  // and let the Splash screen handle navigation after session restoration
  if (isInitialNotification) {
    NotifeeService.setPendingRoomId(roomId);
    return;
  }

  // No active session (user on welcome/login) — skip navigation.
  if (!AuthService.hasStoredCredentials()) return;

  try {
    // Refresh the room list before navigating to ensure it's up to date
    await MatrixCore.refreshRoomList();
    await MatrixCore.getClient().awaitRoomRemoteEcho(roomId);
  } catch {}

  // For background events (app already running), navigate directly to room
  openRoom(roomId);
};

export const PushNotificationsService = {
  getToken: async () => await getToken(getMessaging()),
  /** Register the device with Matrix homeserver for push notifications
   * This should be called after successful login and after push permissions */
  registerPusher: async () => {
    try {
      const fcmToken = await getToken(getMessaging());
      await MatrixNotificationService.setPusher(fcmToken);
      return true;
    } catch (error) {
      console.error("Failed to register push notifications:", error);
      throw error;
    }
  },
  /** Unregister the device from Matrix homeserver */
  unregisterPusher: async () => {
    try {
      const fcmToken = await getMessaging().getToken();
      await MatrixNotificationService.removePusher(fcmToken);
      return true;
    } catch (error) {
      console.error("Failed to unregister push notifications:", error);
      throw error;
    }
  },
  registerListeners: async () => {
    // Foreground message handler
    onMessage(getMessaging(), async (message) => {
      await handleReceivedMessage(message);
    });

    // When the application is opened from a quit state (cold start)
    getInitialNotification(getMessaging()).then((remoteMessage) => {
      handleNotificationPress(remoteMessage, true);
    });

    // When the application is running, but in the background
    onNotificationOpenedApp(getMessaging(), (remoteMessage) => {
      handleNotificationPress(remoteMessage, false);
    });
  },
  /** Handle background messages - called from index.js */
  handleBackgroundMessage: async (
    remoteMessage: FirebaseMessagingTypes.RemoteMessage,
  ) => {
    await handleReceivedMessage(remoteMessage);
  },
  checkPermissions: async () => {
    const result = await checkNotifications();
    return result.status === RESULTS.GRANTED;
  },
  requestPermissions: async () => {
    const result = await requestNotifications(["alert"]);
    return result.status === RESULTS.GRANTED;
  },
  subscribeToTopic: async (topic: string) => {
    await getMessaging().subscribeToTopic(topic);
  },
  unsubscribeFromTopic: async (topic: string) => {
    await getMessaging().unsubscribeFromTopic(topic);
  },
};
