import { useIsFocused } from "@react-navigation/native";
import {
  Membership,
  MembershipState_Tags,
  StateEventType,
} from "@unomed/react-native-matrix-sdk";
import { useAtomValue } from "jotai";
import { CallAtoms } from "modules/call/jotai";
import { CallOverlayService } from "modules/call/service";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { NavigationContainerRef } from "modules/navigation/const";
import { NetworkAtoms } from "modules/network/jotai";
import { useRoomInfo, useRoomMembers } from "modules/room/hooks";
import { type FC, useEffect, useMemo, useRef, useState } from "react";
import { useSafeAreaInsets } from "react-native-safe-area-context";
import { Loading } from "shared/components";
import { offlineToastHelper } from "shared/utils";
import { RoomBanned, RoomHeader, RoomInvite, RoomTimeline } from "./fragments";

interface Props {
  roomId: string;
  onClose: () => void;
  /** Override the top inset applied to the header. Defaults to the device's
   * top safe-area inset. Pass 0 when embedding inside a parent that already
   * applies the top inset (e.g. the iPad split-view inside ScreenLayout). */
  topInset?: number;
}

export const RoomBody: FC<Props> = ({ roomId, onClose, topInset }) => {
  const client = MatrixCore.instance;
  const room = useMemo(() => client?.getRoom(roomId), [client, roomId]);
  const insets = useSafeAreaInsets();
  const resolvedTopInset = topInset ?? insets.top;
  const roomInfo = useRoomInfo(room);
  const isFocused = useIsFocused();
  const [isInviteAccepted, setIsInviteAccepted] = useState(false);
  const initialMembershipRef = useRef<Membership | null>(null);
  const isOffline = useAtomValue(NetworkAtoms.isOffline);
  const isRoomInvite = useMemo(() => {
    return roomInfo?.membership === Membership.Invited && !isInviteAccepted;
  }, [roomInfo, isInviteAccepted]);
  const isBanned = roomInfo?.membership === Membership.Banned;
  const isKicked = roomInfo?.membership === Membership.Knocked;
  const hasOngoingRoomCall = roomInfo?.hasRoomCall ?? false;
  const hasActiveCall = useAtomValue(CallAtoms.hasActiveCall);
  const hasPowerLevelToCall =
    roomInfo?.powerLevels?.canOwnUserSendState(StateEventType.CallMember) ??
    false;

  const {
    members,
    isLoading: isMembersLoading,
    fetchMembers,
  } = useRoomMembers(room);
  const roomMembers = useMemo(
    () =>
      members.filter((m) => m.membership?.tag === MembershipState_Tags.Join)
        .length,
    [members],
  );

  useEffect(() => {
    if (!roomInfo) return;

    if (initialMembershipRef.current === null) {
      initialMembershipRef.current = roomInfo.membership;
      return;
    }

    if (
      roomInfo.membership === Membership.Left &&
      initialMembershipRef.current !== Membership.Left
    ) {
      onClose();
    }
  }, [roomInfo?.membership, onClose]);

  useEffect(() => {
    initialMembershipRef.current = null;
    setIsInviteAccepted(false);
  }, [roomId]);

  const handleStartCall = () => {
    if (!client || !room) {
      console.error("Client or room not available");
      return;
    }

    if (hasActiveCall) {
      offlineToastHelper("You are already in a call");
      return;
    }

    if (isOffline) {
      offlineToastHelper("No internet connection");
      return;
    }

    CallOverlayService.openCall(roomId, room.displayName());
  };

  const handleInviteAccepted = () => {
    setIsInviteAccepted(true);
  };

  const handleRoomDetails = () => {
    if (isRoomInvite || !room) return;
    NavigationContainerRef.navigate("roomDetails", { room });
  };

  useEffect(() => {
    if (!isFocused) return;
    fetchMembers();
  }, [isFocused, fetchMembers]);

  if (!room) return null;

  if (!roomInfo) {
    return (
      <>
        <RoomHeader
          room={room}
          isMembersLoading={isMembersLoading}
          roomMembers={roomMembers}
          hasCallOption
          topInset={resolvedTopInset}
          onBack={onClose}
        />
        <Loading isFullScreen={false} />
      </>
    );
  }

  return (
    <>
      <RoomHeader
        room={room}
        isDirect={!!roomInfo.isDirect}
        isMembersLoading={isMembersLoading}
        roomMembers={roomMembers}
        hasCallOption={!isRoomInvite && !isBanned && hasPowerLevelToCall}
        hasOngoingRoomCall={hasOngoingRoomCall}
        hasActiveCall={hasActiveCall}
        topInset={insets.top}
        onBack={onClose}
        onRoomDetails={handleRoomDetails}
        onStartCall={handleStartCall}
      />

      {isBanned || isKicked ? (
        <RoomBanned
          type={isBanned ? "banned" : "kicked"}
          room={room}
          onForgotten={onClose}
        />
      ) : isRoomInvite ? (
        <RoomInvite
          roomId={roomId}
          roomInfo={roomInfo}
          memberCount={roomMembers}
          onAccepted={handleInviteAccepted}
          onDeclined={onClose}
        />
      ) : (
        <RoomTimeline room={room} roomId={roomId} />
      )}
    </>
  );
};
