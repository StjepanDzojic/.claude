  const categoriesInColumns = [
    [
      categories.find((c) => c.id === 'zakoni-i-vazni-podzakonski-akti'),
      categories.find((c) => c.id === 'godisnja-financijska-izvjesca'),
      categories.find((c) => c.id === 'obrasci'),
      categories.find((c) => c.id === 'publikacije-i-povijest-osjeckog-sporta'),
    ].filter(Boolean),
    [
      categories.find((c) => c.id === 'opci-akti-zos'),
      categories.find((c) => c.id === 'odluke-tijela-zajednice'),
      categories.find((c) => c.id === 'kategorizacija-sportasa'),
      categories.find((c) => c.id === 'ostalo'),
    ].filter(Boolean),
    [
      categories.find((c) => c.id === 'javne-potrebe-u-sportu'),
      categories.find((c) => c.id === 'javna-jednostavna-nabava'),
      categories.find((c) => c.id === 'priznanja-i-nagrade'),
