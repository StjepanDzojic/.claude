import { Block, Text } from "@prototyp/skeletor";
import { useAtom } from "jotai";
import { TimelineAtoms } from "modules/timeline/jotai";
import { type FC, useCallback, useState } from "react";
import { Dimensions, Image, Modal, StyleSheet } from "react-native";
import Video from "react-native-video";
import { Colors } from "shared/styles";
import { Button } from "../button";
import { Loading } from "../loading";

const { width: SCREEN_WIDTH, height: SCREEN_HEIGHT } = Dimensions.get("window");

export const VideoViewerModal: FC = () => {
  const [videoViewerUri, setVideoViewerUri] = useAtom(
    TimelineAtoms.videoViewerUri,
  );
  const [isLoading, setIsLoading] = useState(false);
  const [hasError, setHasError] = useState(false);
  const visible = !!videoViewerUri;

  const onClose = useCallback(() => {
    setVideoViewerUri(null);
  }, [setVideoViewerUri]);

  const handleVideoLoad = useCallback(() => {
    setIsLoading(false);
    setHasError(false);
  }, []);

  const handleVideoError = useCallback(() => {
    setIsLoading(false);
    setHasError(true);
  }, []);

  const handleLoadStart = useCallback(() => {
    setIsLoading(true);
    setHasError(false);
  }, []);

  if (!visible) return null;

  return (
    <Modal
      visible={visible}
      animationType="fade"
      statusBarTranslucent
      transparent
      onRequestClose={onClose}
    >
      <Block background={Colors.black} flex={1} justify="center" align="center">
        <Block
          absolute
          offsets={{ top: 60, right: 20 }}
          zIndex={10}
          background={Colors.white20}
          border={{ borderRadius: 999 }}
          paddings={[12, 12]}
        >
          <Button.Wrapper onPress={onClose}>
            <Image source={require("assets/icons/close.png")} />
          </Button.Wrapper>
        </Block>

        {isLoading && !hasError && (
          <Block
            absolute
            width={SCREEN_WIDTH}
            height={SCREEN_HEIGHT}
            align="center"
            justify="center"
            zIndex={5}
          >
            <Loading isFullScreen={false} />
          </Block>
        )}

        {hasError ? (
          <Block
            width={SCREEN_WIDTH}
            height={SCREEN_HEIGHT * 0.7}
            align="center"
            justify="center"
          >
            <Text size={16} color={Colors.white}>
              Failed to load video
            </Text>
          </Block>
        ) : (
          <Video
            source={{ uri: videoViewerUri }}
            style={styles.video}
            resizeMode="contain"
            controls
            paused={false}
            onLoad={handleVideoLoad}
            onError={handleVideoError}
            onLoadStart={handleLoadStart}
          />
        )}
      </Block>
    </Modal>
  );
};

const styles = StyleSheet.create({
  video: {
    width: SCREEN_WIDTH,
    height: SCREEN_HEIGHT * 0.7,
  },
});
