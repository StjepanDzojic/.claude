import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { TimelineService } from "modules/timeline/service/TimelineService";
import { useMemo, useState } from "react";
import {
  Dimensions,
  FlatList,
  Image,
  KeyboardAvoidingView,
  StyleSheet,
} from "react-native";
import type { Asset } from "react-native-image-picker";
import Video from "react-native-video";
import {
  Button,
  GoBackHeader,
  Input,
  Loading,
  ScreenLayout,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

const MAX_DIMENSION = 400;

const DEVICE_HEIGHT = Dimensions.get("window").height;

const isVideo = (asset: Asset) => asset.type?.startsWith("video/");

const handleImageSize = (asset: Asset) => {
  const originalWidth = asset.width ?? 0;
  const originalHeight = asset.height ?? 0;
  const scaleRatio = Math.min(
    MAX_DIMENSION / originalWidth,
    MAX_DIMENSION / originalHeight,
    1,
  );
  const targetWidth = Math.round(originalWidth * scaleRatio);
  const targetHeight = Math.round(originalHeight * scaleRatio);

  return { width: targetWidth, height: targetHeight };
};

export const SendImages: React.FC<
  NativeStackScreenProps<Routes, "sendImages">
> = ({ route, navigation }) => {
  const { roomId, images } = route.params;
  const [currentMedia, setCurrentMedia] = useState(images);
  const [currentMediaIndex, setCurrentMediaIndex] = useState(0);
  const [isSending, setIsSending] = useState(false);
  // Store captions for each media item by index
  const [captions, setCaptions] = useState<Record<number, string>>({});
  const activeMedia = useMemo(() => {
    return currentMedia[currentMediaIndex];
  }, [currentMedia, currentMediaIndex]);
  const isVertical = useMemo(() => {
    if (!activeMedia) return false;
    return (
      handleImageSize(activeMedia).width < handleImageSize(activeMedia).height
    );
  }, [activeMedia]);

  const handleSendMedia = async () => {
    try {
      setIsSending(true);
      const tasks = currentMedia.map(async (asset, index) => {
        if (!asset?.uri) {
          return Promise.reject(new Error("No uri found"));
        }

        const caption = captions[index];
        await TimelineService.sendMedia(roomId, asset, caption);
      });

      const results = await Promise.allSettled(tasks);
      const failures = results.filter((r) => r.status === "rejected");
      if (failures.length) {
        failures.forEach((failure) => {
          console.error(failure.reason);
        });
        throw new Error("Failed to send some media");
      }
      navigation.goBack();
    } catch (error) {
      console.error(error);
      offlineToastHelper("Failed to send media");
    } finally {
      setIsSending(false);
    }
  };

  const handleImagePress = (index: number) => {
    if (index === currentMediaIndex) {
      const newImages = currentMedia.filter((_, i) => i !== index);
      setCurrentMedia(newImages);
      setCurrentMediaIndex(Math.min(currentMediaIndex, newImages.length - 1));
      // Remove caption for deleted media and reindex remaining captions
      const newCaptions: Record<number, string> = {};
      Object.keys(captions).forEach((key) => {
        const oldIndex = Number.parseInt(key, 10);
        if (oldIndex < index) {
          newCaptions[oldIndex] = captions[oldIndex];
        } else if (oldIndex > index) {
          newCaptions[oldIndex - 1] = captions[oldIndex];
        }
      });
      setCaptions(newCaptions);
      return;
    }

    setCurrentMediaIndex(index);
  };

  const handleCaptionChange = (text: string) => {
    setCaptions((prev) => ({
      ...prev,
      [currentMediaIndex]: text,
    }));
  };

  return (
    <ScreenLayout background={Colors.blackMinus1}>
      {isSending && <Loading text="Sending media..." />}
      <GoBackHeader isClose />
      <KeyboardAvoidingView
        style={{ flex: 1 }}
        behavior="padding"
        keyboardVerticalOffset={0}
      >
        <Block flex={1} align="center" justify="center">
          <Block
            height={DEVICE_HEIGHT - 400}
            overflow="hidden"
            margins={{ marginBottom: "auto" }}
            align="center"
            justify="center"
            background={Colors.white}
          >
            {isVideo(activeMedia) ? (
              <Video
                source={{ uri: activeMedia.uri }}
                style={{
                  height: !isVertical ? "100%" : "auto",
                  width: isVertical ? "auto" : "100%",
                  aspectRatio:
                    handleImageSize(activeMedia).width /
                    handleImageSize(activeMedia).height,
                }}
                resizeMode="contain"
                controls
                paused={false}
              />
            ) : (
              <Image
                source={{ uri: activeMedia.uri }}
                width={handleImageSize(activeMedia).width}
                height={handleImageSize(activeMedia).height}
                style={{
                  height: isVertical ? "100%" : "auto",
                  width: isVertical ? "auto" : "100%",
                  aspectRatio:
                    handleImageSize(activeMedia).width /
                    handleImageSize(activeMedia).height,
                }}
              />
            )}
          </Block>

          <Block
            flex={1}
            justify="flex-end"
            absolute
            width="100%"
            offsets={{ bottom: 0 }}
            gap={20}
          >
            <Block width="100%" gap={4} align="flex-start">
              {currentMedia.length > 1 && (
                <FlatList
                  contentContainerStyle={styles.container}
                  data={currentMedia}
                  horizontal
                  showsHorizontalScrollIndicator={false}
                  renderItem={({ item, index }) => (
                    <Button.Wrapper onPress={() => handleImagePress(index)}>
                      {isVideo(item) ? (
                        <Video
                          source={{ uri: item.uri }}
                          style={styles.media}
                          resizeMode="cover"
                          paused
                        />
                      ) : (
                        <Image
                          source={{ uri: item.uri }}
                          width={78}
                          height={78}
                          resizeMode="cover"
                          style={styles.media}
                        />
                      )}
                      {isVideo(item) && (
                        <Block
                          absolute
                          offsets={{ top: 0, left: 0 }}
                          width="100%"
                          height="100%"
                          align="center"
                          justify="center"
                          pointerEvents="none"
                        >
                          <Block
                            width={20}
                            height={20}
                            background={Colors.white50}
                            border={{ borderRadius: 10 }}
                            align="center"
                            justify="center"
                          >
                            <Image source={require("assets/icons/play.png")} />
                          </Block>
                        </Block>
                      )}
                      {index === currentMediaIndex && (
                        <Block
                          absolute
                          offsets={{ top: 0, left: 0 }}
                          width="100%"
                          height="100%"
                          background={Colors.white50}
                          border={{
                            borderRadius: 4,
                            borderWidth: 1,
                            borderColor: Colors.white,
                          }}
                          align="center"
                          justify="center"
                        >
                          <Block
                            height={48}
                            width={48}
                            align="center"
                            justify="center"
                            background={Colors.white50}
                            border={{ borderRadius: 999 }}
                          >
                            <Image
                              source={require("assets/icons/trash.png")}
                              width={24}
                              height={24}
                              tintColor={Colors.black}
                            />
                          </Block>
                        </Block>
                      )}
                    </Button.Wrapper>
                  )}
                />
              )}
            </Block>

            <Block
              width="100%"
              flexDirection="row"
              gap={8}
              background={Colors.blackMinus1}
              align="flex-end"
            >
              <Block flex={1}>
                <Input
                  placeholder="Caption"
                  value={captions[currentMediaIndex] || ""}
                  autoCapitalize="sentences"
                  onChangeText={handleCaptionChange}
                  multiline
                />
              </Block>
              <Button.Wrapper onPress={handleSendMedia}>
                {currentMedia.length > 1 && (
                  <Block
                    absolute
                    offsets={{ top: -6, right: -6 }}
                    zIndex={2}
                    height={24}
                    width={24}
                    align="center"
                    justify="center"
                    background={Colors.primary}
                    border={{
                      borderRadius: 999,
                      borderWidth: 1,
                      borderColor: Colors.white20,
                    }}
                  >
                    <Text size={TextSize.small}>{currentMedia.length}</Text>
                  </Block>
                )}
                <Block
                  height={48}
                  width={48}
                  align="center"
                  justify="center"
                  background={Colors.primary}
                  border={{
                    borderRadius: 999,
                    borderWidth: 1,
                    borderColor: Colors.white20,
                  }}
                >
                  <Image
                    source={require("assets/icons/paper-plane-right.png")}
                    width={24}
                    height={24}
                  />
                </Block>
              </Button.Wrapper>
            </Block>
          </Block>
        </Block>
      </KeyboardAvoidingView>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  container: {
    gap: 4,
  },
  media: {
    width: 78,
    height: 78,
    borderRadius: 4,
  },
  button: {
    marginTop: "auto",
  },
  size: {
    width: 78,
    height: 78,
  },
});
