import { Block, Text } from "@prototyp/skeletor";
import {
  type EventTimelineItem,
  MessageType_Tags,
  MsgLikeKind_Tags,
  TimelineItemContent_Tags,
  type VideoMessageContent,
} from "@unomed/react-native-matrix-sdk";
import { useSetAtom } from "jotai";
import { MatrixBaseURL } from "modules/matrix-client/const";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { fetchMedia, getEventTextContent } from "modules/matrix-client/utils";
import { TimelineAtoms } from "modules/timeline/jotai";
import { TimelineService } from "modules/timeline/service/TimelineService";
import { type FC, useCallback, useEffect, useMemo, useState } from "react";
import { Image } from "react-native";
import { Blurhash } from "react-native-blurhash";
import Video from "react-native-video";
import {
  Loading,
  MessageTimestamp,
  PinIndicator,
  SeenBy,
} from "shared/components";
import { MAX_MEDIA_WIDTH } from "shared/const";
import { Colors, TextSize } from "shared/styles";
import { MessageLongPressWrapper } from "../message-long-press-wrapper";
import { MessageReactionsOverlay } from "../message-reactions-overlay";
import { MessageSender } from "../message-sender";

interface Props {
  roomId: string;
  event: EventTimelineItem;
  isPreviousSameSender: boolean;
  onMemberPress?: (member: MemberDetailsPayload) => void;
}

const getVideoContent = (
  event: EventTimelineItem,
): VideoMessageContent | null => {
  if (event.content.tag === TimelineItemContent_Tags.MsgLike) {
    const kind = event.content.inner.content.kind;
    if (kind?.tag === MsgLikeKind_Tags.Message) {
      const msgType = kind.inner.content.msgType;
      if (msgType?.tag === MessageType_Tags.Video) {
        return msgType.inner.content;
      }
    }
  }
  return null;
};

export const VideoMessage: FC<Props> = ({
  roomId,
  event,
  isPreviousSameSender,
  onMemberPress,
}) => {
  const content = getVideoContent(event);
  const [messageWidth, setMessageWidth] = useState(40);
  const originalWidth = Number(content?.info?.width) || 0;
  const originalHeight = Number(content?.info?.height) || 0;
  const scaleRatio = Math.min(MAX_MEDIA_WIDTH / originalWidth, 1);
  const targetWidth = Math.round(originalWidth * scaleRatio);
  const targetHeight = Math.round(originalHeight * scaleRatio);
  const [thumbnailUri, setThumbnailUri] = useState<string | null>(null);
  const [videoUri, setVideoUri] = useState<string | null>(null);
  const [isThumbnailLoading, setIsThumbnailLoading] = useState(true);
  const [isVideoLoading, setIsVideoLoading] = useState(false);
  const [isPlaying, setIsPlaying] = useState(false);
  const isUser = event.isOwn;
  const sender = event.senderProfile;
  const senderId = event.sender;
  const caption = content?.caption;
  const blurhash = content?.info?.blurhash;
  const background = useMemo(() => {
    if (!caption) return "transparent";
    return isUser ? Colors.primary : Colors.message;
  }, [caption, isUser]);
  const seenByUsers = TimelineService.getReadReceiptUsers(event);
  const setVideoViewerUri = useSetAtom(TimelineAtoms.videoViewerUri);

  const openVideoViewer = useCallback(() => {
    if (!videoUri) return;
    setVideoViewerUri(videoUri);
  }, [videoUri, setVideoViewerUri]);

  const handlePlay = useCallback(async () => {
    if (videoUri) {
      setIsPlaying(true);
      return;
    }
    if (!content?.source.url()) return;
    setIsVideoLoading(true);
    try {
      const uri = await fetchMedia({
        serverUrl: MatrixCore.instance?.session().homeserverUrl || MatrixBaseURL,
        mediaSource: content.source,
        mimeType: content.info?.mimetype || "video/mp4",
      });
      setVideoUri(uri);
      setIsPlaying(true);
    } catch (e) {
      console.error(e);
    } finally {
      setIsVideoLoading(false);
    }
  }, [videoUri, content]);

  useEffect(() => {
    const thumbSource = content?.info?.thumbnailSource;
    if (thumbSource?.url()) {
      fetchMedia({
        serverUrl: MatrixCore.instance?.session().homeserverUrl || MatrixBaseURL,
        mediaSource: thumbSource,
        mimeType: "image/jpeg",
      })
        .then(setThumbnailUri)
        .catch(console.error)
        .finally(() => setIsThumbnailLoading(false));
    } else {
      setIsThumbnailLoading(false);
    }
  }, [content]);

  if (!content) return null;

  return (
    <Block
      align={isUser ? "flex-end" : "flex-start"}
      margins={{ marginTop: isPreviousSameSender ? 6 : 16 }}
    >
      <MessageSender
        sender={sender}
        senderId={senderId}
        isUser={isUser}
        isPreviousSameSender={isPreviousSameSender}
        onMemberPress={onMemberPress}
      />

      <Block flexDirection={isUser ? "row-reverse" : "row"}>
        <Block
          background={background}
          border={{ borderRadius: 12 }}
          paddings={caption ? [4, 4, 12] : 0}
          gap={8}
        >
          <Block
            background="transparent"
            border={{
              borderRadius: 12,
            }}
            align="center"
            overflow="hidden"
            width={targetWidth}
            height={targetHeight}
            onLayout={(e) => setMessageWidth(e.nativeEvent.layout.width)}
          >
            {/* Blurhash placeholder — shown until thumbnail loads */}
            {blurhash && !thumbnailUri && !isPlaying && (
              <Blurhash
                blurhash={blurhash}
                style={{ width: targetWidth, height: targetHeight }}
                resizeMode="cover"
              />
            )}

            {/* Thumbnail JPEG — shown once loaded, until user taps play */}
            {thumbnailUri && !isPlaying && (
              <Image
                source={{ uri: thumbnailUri }}
                style={{ width: targetWidth, height: targetHeight }}
                resizeMode="cover"
              />
            )}

            {/* Full video — only rendered after user taps play */}
            {isPlaying && videoUri && (
              <MessageLongPressWrapper
                event={event}
                content={getEventTextContent(event)}
                onFinalize={openVideoViewer}
              >
                <Video
                  source={{ uri: videoUri }}
                  style={{ width: targetWidth, height: targetHeight }}
                  resizeMode="contain"
                  paused={false}
                  controls
                  pointerEvents="none"
                />
              </MessageLongPressWrapper>
            )}

            {/* Loading spinner while fetching full video */}
            {isVideoLoading && (
              <Block
                absolute
                offsets={{ top: 0, left: 0, right: 0, bottom: 0 }}
                width="100%"
                height="100%"
                background={Colors.black70}
                align="center"
                justify="center"
                zIndex={1}
              >
                <Loading isFullScreen={false} />
              </Block>
            )}

            {/* Play button — shown when not yet playing */}
            {!isPlaying && !isThumbnailLoading && (
              <MessageLongPressWrapper
                event={event}
                content={getEventTextContent(event)}
                onFinalize={openVideoViewer}
              >
                <Block
                  absolute
                  offsets={{ top: 0, left: 0, right: 0, bottom: 0 }}
                  zIndex={10}
                  border={{ borderRadius: 12 }}
                  align="center"
                  justify="center"
                >
                  <Block
                    background={Colors.primary}
                    width={40}
                    height={40}
                    align="center"
                    justify="center"
                    border={{ borderRadius: 999 }}
                    onTouchEnd={handlePlay}
                  >
                    <Image
                      tintColor={Colors.white}
                      source={require("assets/icons/play.png")}
                    />
                  </Block>
                </Block>
              </MessageLongPressWrapper>
            )}
          </Block>

          {caption ? (
            <Block
              maxWidth={targetWidth}
              justify="space-between"
              flexDirection={isUser ? "row-reverse" : "row"}
              gap={{
                row: 4,
                col: 16,
              }}
              align="center"
              flex={{ flexWrap: "wrap" }}
              paddings={[0, 8]}
              onLayout={(e) => setMessageWidth(e.nativeEvent.layout.width)}
            >
              <Text size={TextSize.small} color="white">
                {caption}
              </Text>
              <MessageTimestamp event={event} isUser={isUser} />
            </Block>
          ) : (
            <Block
              flexDirection={isUser ? "row" : "row-reverse"}
              gap={4}
              align="center"
              margins={{ marginLeft: isUser ? 0 : "auto" }}
            >
              <MessageTimestamp event={event} isUser={isUser} />
            </Block>
          )}
        </Block>
        <PinIndicator event={event} />
      </Block>
      <MessageReactionsOverlay event={event} roomId={roomId} isUser={isUser} />
      <SeenBy users={seenByUsers} messageWidth={messageWidth} isUser={isUser} />
    </Block>
  );
};
