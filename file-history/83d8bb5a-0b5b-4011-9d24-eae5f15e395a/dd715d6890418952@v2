import { z } from 'zod';
import { envelope, httpServer } from '../../shared/services/http-server';
import {
  CreatePaymentLinkBodySchema,
  PaymentLinkSchema,
} from './payment-link.service';

export type {
  PaymentLinkAmountType,
  PaymentLinkProductPrice,
  PaymentLinkProduct,
  PaymentLinkPaymentMethod,
  PaymentLinkBuyerDetails,
  PaymentLinkAdditionalDetails,
  CreatePaymentLinkBody,
  PaymentLink,
} from './payment-link.service';

export const paymentLinkServerService = {
  /** POST /v1/api/payment-link — Create a hosted payment link. */
  create: async (
    body: CreatePaymentLinkBody,
    opts: { idempotencyKey?: string } = {},
  ) => {
    const parsedBody = CreatePaymentLinkBodySchema.parse(body);

    const raw = await httpServer.post<z.ZodUnknown, CreatePaymentLinkBody>(
      z.unknown(),
      {
        path: '/v1/api/payment-link',
        body: parsedBody,
        idempotencyKey: opts.idempotencyKey,
      },
    );

    const res = envelope(PaymentLinkSchema).parse(raw);
    return res.data;
  },
};
