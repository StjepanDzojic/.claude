'use client';

import { AuthAtoms } from '@modules/auth/jotai/atoms';
import { Button } from '@modules/shared/button';
import { Label } from '@modules/shared/label';
import { formatPrice } from '@modules/shared/utils/formatPrice';
import { Routes } from 'const/Routes';
import { useAtomValue } from 'jotai';
import { createPendingInvestmentTransaction } from 'lib/firebase/transaction-actions';
import { cn } from 'lib/utils';
import { ChevronLeft } from 'lucide-react';
import Link from 'next/link';
import { FC, FormEvent, useMemo, useState } from 'react';
import { toast } from 'sonner';

const PRESET_AMOUNTS = [5000, 10000, 25000, 50000, 100000, 250000];

const snapToMinimum = (value: number, min: number): number =>
  value < min ? min : value;

export const InvestFlow: FC<{
  project: Project;
  suggestedAmount?: number;
}> = ({ project, suggestedAmount }) => {
  const firestoreUser = useAtomValue(AuthAtoms.user);
  const minInvestment = project.financials.minInvestment ?? 0;

  const initialAmount = useMemo(() => {
    if (suggestedAmount) return snapToMinimum(suggestedAmount, minInvestment);
    return minInvestment;
  }, [suggestedAmount, minInvestment]);

  const [amount, setAmount] = useState<number>(initialAmount);
  const [loading, setLoading] = useState(false);
  const [checkoutUrl, setCheckoutUrl] = useState<string | null>(null);

  const invalid = amount < minInvestment;

  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    if (loading) return;

    if (!firestoreUser) {
      toast.error('You must be logged in to invest.');
      return;
    }
    if (invalid) {
      toast.error(`Minimum investment is ${formatPrice(minInvestment)}.`);
      return;
    }

    setLoading(true);
    try {
      const res = await fetch('/api/embedded-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ projectId: project.id, amount }),
      });

      const data = (await res.json()) as
        | CreateEmbeddedCheckoutResponse
        | CreateEmbeddedCheckoutErrorResponse;

      if (!res.ok || !('success' in data)) {
        const message =
          'error' in data && data.error?.message
            ? data.error.message
            : 'Could not start checkout. Please try again.';
        toast.error(message);
        return;
      }

      try {
        await createPendingInvestmentTransaction({
          projectId: project.id,
          projectName: project.name,
          projectType: project.type,
          amount,
          userId: firestoreUser.uid,
          userEmail: firestoreUser.email || '',
          checkoutSessionId: data.data.id,
        });
      } catch (recordError) {
        console.error(
          'Failed to record pending investment transaction',
          recordError,
        );
      }

      setCheckoutUrl(data.data.url);
    } catch (error) {
      console.error('Failed to create checkout session', error);
      toast.error('Could not start checkout. Please try again.');
    } finally {
      setLoading(false);
    }
  };

  if (checkoutUrl) {
    return (
      <main className="p-20 lg:p-40 bg-off-white w-full min-h-screen flex flex-col items-center">
        <div className="max-w-[960px] w-full flex flex-col gap-24">
          <header className="flex items-center justify-between gap-16">
            <div className="flex flex-col gap-4">
              <h1 className="font-family-tiempos text-[clamp(24px,32px)] leading-[140%] font-light">
                Invest in {project.name}
              </h1>
              <p className="text-small text-gray-700">
                Amount:{' '}
                <span className="font-semibold text-gray-900">
                  {formatPrice(amount)}
                </span>
              </p>
            </div>
            <Link
              href={`${Routes.DISCOVER_PROJECTS}/${project.id}`}
              className="text-small underline">
              Cancel
            </Link>
          </header>

          <div className="w-full bg-white rounded-[16px] overflow-hidden shadow-lg">
            <iframe
              src={checkoutUrl}
              title={`Checkout for ${project.name}`}
              className="w-full min-h-[720px] border-0"
              allow="payment *"
            />
          </div>

          <p className="text-tiny text-gray-600 text-center">
            Your payment is processed securely. Applicable taxes and fees will
            be added to your total at the time of processing.
          </p>
        </div>
      </main>
    );
  }

  return (
    <main className="p-20 lg:p-40 bg-off-white w-full min-h-screen flex flex-col items-center">
      <div className="max-w-[600px] w-full flex flex-col gap-24">
        <Link
          href={`${Routes.DISCOVER_PROJECTS}/${project.id}`}
          className="flex items-center gap-8 text-small">
          <ChevronLeft width={16} height={16} />
          Back to project
        </Link>

        <header className="flex flex-col gap-8">
          <h1 className="font-family-tiempos text-[clamp(24px,32px)] leading-[140%] font-light">
            Invest in {project.name}
          </h1>
          <p className="text-small text-gray-700">
            Minimum investment:{' '}
            <span className="font-semibold">{formatPrice(minInvestment)}</span>
          </p>
        </header>

        <form
          onSubmit={handleSubmit}
          className="flex flex-col gap-20 bg-white p-24 rounded-[16px] shadow-sm">
          <div className="grid gap-12">
            <Label htmlFor="amount" className="text-gray-900">
              Investment amount (USD)
            </Label>
            <input
              id="amount"
              type="number"
              min={minInvestment}
              step={1}
              inputMode="numeric"
              value={Number.isFinite(amount) ? amount : ''}
              onChange={(event) => setAmount(Number(event.target.value))}
              disabled={loading}
              required
              className={cn(
                'h-48 rounded-lg border border-gray-200 bg-white px-16 text-body text-gray-900 outline-none transition-all',
                'focus:border-primary focus:ring-2 focus:ring-primary/30',
                invalid && 'border-red-500 focus:ring-red-200',
                loading && 'opacity-50 cursor-not-allowed',
              )}
            />
            {invalid && (
              <p className="text-tiny text-red-600">
                Minimum is {formatPrice(minInvestment)}.
              </p>
            )}
          </div>

          <div className="grid gap-8">
            <p className="text-tiny text-gray-600">Quick select</p>
            <div className="grid grid-cols-2 xsm:grid-cols-3 gap-8">
              {PRESET_AMOUNTS.filter((p) => p >= minInvestment).map((preset) => (
                <button
                  key={preset}
                  type="button"
                  onClick={() => setAmount(preset)}
                  disabled={loading}
                  className={cn(
                    'cursor-pointer rounded-[12px] py-10 px-8 text-tiny font-medium border transition-all duration-200',
                    amount === preset
                      ? 'bg-primary border-primary text-white'
                      : 'bg-white border-gray-200 text-gray-900 hover:bg-gray-50',
                    loading && 'opacity-50 cursor-not-allowed',
                  )}>
                  {formatPrice(preset)}
                </button>
              ))}
            </div>
          </div>

          <Button
            type="submit"
            size="large"
            disabled={loading || invalid || !firestoreUser}
            className="w-full">
            {loading ? 'Starting checkout…' : 'Continue to payment'}
          </Button>

          {!firestoreUser && (
            <p className="text-tiny text-gray-600 text-center">
              You must be signed in to invest.
            </p>
          )}

          <p className="text-tiny text-gray-600 text-center">
            Applicable taxes and fees will be added to your total at the time of
            processing.
          </p>
        </form>
      </div>
    </main>
  );
};
