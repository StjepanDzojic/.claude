interface Project {
  id: string;
  //Content properties
  name: string;
  madeBySubtitle: string;
  description: string;
  images: string[];
  videos: string[];
  heroImage: string;
  releaseDate: number;
  moneyRaised: number;
  createdAt: number;
  fundraisingEndDate: number;

  //Overview
  overview: Overview;

  //Biography
  biography: string;

  //Beni Thoughts
  beniThoughts?: BeniThoughts;
  beniThoughtsTop?: BeniThoughts;

  //Video
  videoUrl?: string;

  //Pitch deck
  pitchDeckUrl?: string;

  //Financial documents
  financialDocuments?: FinancialDocument[];

  //Press
  pressLinks?: PressLink[];

  //Media links (social media)
  mediaLinks?: MediaLink[];

  //Team sections
  teamSections: TeamSection[];

  //Investment terms
  investmentTerms: InvestmentTerms;

  //Financials
  financials: Financials;

  //Timeline
  timeline: TimelineEvent[];

  //Monetization and distribution
  monetizationAndDistribution: MonetizationAndDistribution;

  //Research
  research: Research;

  //Updates
  updates: Update[];

  type: ProjectType;
  status: ProjectStatus;
  comparableProjectIds: string[];

  // TODO: populate per-project from the checkout provider (e.g. Stripe/itseasy).
  // Both required to create a payment link from the invest page.
  productId?: string;
  priceId?: string;
}

interface BeniThoughtsItem {
  subtitle: string;
  description: string;
}

interface BeniThoughts {
  items: BeniThoughtsItem[];
}

interface Overview {
  description: string;
  categories: string[];
}

interface TeamSection {
  sectionGroupName: string;
  isIncludedInOverview: boolean;
  subsections: TeamSubsection[];
}

interface TeamSubsection {
  subsectionGroupName?: string;
  members: TeamMember[];
}

interface TeamMember {
  name: string;
  role: string;
  bio: string;
  actAs?: string;
  image?: string;
}

interface InvestmentTerms {
  additionalData: {
    label: string;
    items: string[] | string;
  }[];
}

interface Financials {
  minInvestment: number;
  targetInvestment: number;
  totalBudget: number;
  projectedAudience?: number;
  projectedRevenue?: number;
  projectedReturn?: number;
  description?: string;
  budgetBreakdown?: BudgetBreakdown[];
  budgetBreakdownDescription?: string;
  weeklyBudgetBreakdown?: BudgetBreakdown[];
  weeklyBudgetBreakdownDescription?: string;
  perks: Perk[];
  additionalData: {
    label: string;
    items: string | string[];
  }[];
  financialCategories?: FinancialCategory[];
  weeksToRecoupment?: WeeksToRecoupmentData[];
  weeksToRecoupmentDescription?: string;
}

interface FinancialCategory {
  id: string;
  categoryName: string;
  description: string;
  amount: number;
  percentage: number;
}

interface WeeksToRecoupmentData {
  id: string;
  capacityPercentage: number;
  weeklyProfit: number;
  weeksToRecoup: number;
}

interface Perk {
  tier: 'Tier 1' | 'Tier 2' | 'Tier 3' | 'Tier 4' | 'Tier 5';
  title?: string;
  description?: string;
  options: string[];
}

interface BudgetBreakdown {
  label: string;
  amount: number;
}

interface TimelineEvent {
  date: string;
  title: string;
  description: string;
}

interface MonetizationAndDistribution {
  additionalData: {
    label: string;
    items: string | string[];
  }[];
}

interface Research {
  additionalData: {
    label: string;
    items: string | string[];
  }[];
}

interface Update {
  title?: string;
  description: string;
  date: number;
}

interface FinancialDocument {
  name: string;
  url: string;
}

interface PressLink {
  url: string;
  headline: string;
  source: string;
  imageUrl?: string;
}

interface MediaLink {
  url: string;
  platform: 'instagram' | 'twitter' | 'facebook' | 'tiktok' | 'youtube' | 'other';
  caption: string;
  imageUrl?: string;
  date?: number;
}

type ProjectType = 'theatre' | 'film' | 'tv' | 'music';

type ProjectStatus =
  | 'closed'
  | 'in-production'
  | 'fundraising'
  | 'active'
  | 'fully-funded';
