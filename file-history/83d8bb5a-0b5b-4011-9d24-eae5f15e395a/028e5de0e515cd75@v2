/**
 * Types for our own Route Handler at `/api/payment-link`.
 *
 * These describe the INTERNAL contract between the browser and our backend,
 * not the external 3rd-party payment-link API (see `services/` for that).
 *
 * Kept in a plain `.ts` file so Zod schemas can be derived from the same
 * source of truth; the sibling `.d.ts` re-declares each inferred type as
 * a global name so consumers never need to `import` them.
 */

import * as z from 'zod';

const MAX_AMOUNT = 10_000_000;

export const CreatePaymentLinkRequestSchema = z.object({
  projectId: z.string().min(1),
  amount: z.number().int().positive().max(MAX_AMOUNT),
  /**
   * Stable per-attempt key the client can send so retries don't create duplicate
   * links. Optional — if omitted, the server generates a fresh UUID and
   * retries are NOT idempotent.
   */
  idempotencyKey: z.string().min(1).max(255).optional(),
});

export const CreatePaymentLinkDataSchema = z.object({
  id: z.string(),
  url: z.string(),
  amount_cents: z.number().int().nonnegative(),
  currency: z.string(),
  status: z.string(),
  created_at: z.string(),
});

export const CreatePaymentLinkResponseSchema = z.object({
  success: z.literal(true),
  timestamp: z.string(),
  message: z.string().optional(),
  data: CreatePaymentLinkDataSchema,
});

export const CreatePaymentLinkErrorSchema = z.object({
  error: z.object({
    code: z.string(),
    message: z.string(),
    details: z.unknown().optional(),
  }),
});

export type CreatePaymentLinkRequest = z.infer<
  typeof CreatePaymentLinkRequestSchema
>;
export type CreatePaymentLinkData = z.infer<typeof CreatePaymentLinkDataSchema>;
export type CreatePaymentLinkResponse = z.infer<
  typeof CreatePaymentLinkResponseSchema
>;
export type CreatePaymentLinkErrorResponse = z.infer<
  typeof CreatePaymentLinkErrorSchema
>;

export const PAYMENT_LINK_MAX_AMOUNT = MAX_AMOUNT;
