import { z } from 'zod';
import { envelope, http } from '../../shared/services/http-client';

export const PaymentLinkAmountTypeSchema = z.enum(['FIXED', 'CUSTOMER_CHOICE']);

export const PaymentLinkProductPriceSchema = z.object({
  id: z.string(),
  quantity: z.number().int().positive(),
  adjustable: z.boolean().optional(),
});

export const PaymentLinkProductSchema = z.object({
  id: z.string(),
  product_prices: z.array(PaymentLinkProductPriceSchema).min(1),
});

export const PaymentLinkPaymentMethodSchema = z.enum(['PAYMENT_CARD', 'CRYPTO']);

export const PaymentLinkBuyerDetailsSchema = z.enum(['email', 'full', 'none']);

export const PaymentLinkAdditionalDetailsSchema = z.object({
  terms_of_service_url: z.url().optional(),
});

export const CreatePaymentLinkBodySchema = z.object({
  nickname: z.string().optional(),
  amount_type: PaymentLinkAmountTypeSchema,
  products: z.array(PaymentLinkProductSchema).min(1),
  allowed_payment_methods: z
    .array(PaymentLinkPaymentMethodSchema)
    .min(1)
    .optional(),
  collect_buyer_details: PaymentLinkBuyerDetailsSchema.optional(),
  additional_details: PaymentLinkAdditionalDetailsSchema.optional(),
});

export const PaymentLinkSchema = z.object({
  id: z.string(),
  url: z.string(),
  amount_cents: z.number().int().nonnegative(),
  currency: z.string(),
  status: z.string(),
  created_at: z.string(),
});

export type PaymentLinkAmountType = z.infer<typeof PaymentLinkAmountTypeSchema>;
export type PaymentLinkProductPrice = z.infer<
  typeof PaymentLinkProductPriceSchema
>;
export type PaymentLinkProduct = z.infer<typeof PaymentLinkProductSchema>;
export type PaymentLinkPaymentMethod = z.infer<
  typeof PaymentLinkPaymentMethodSchema
>;
export type PaymentLinkBuyerDetails = z.infer<
  typeof PaymentLinkBuyerDetailsSchema
>;
export type PaymentLinkAdditionalDetails = z.infer<
  typeof PaymentLinkAdditionalDetailsSchema
>;
export type CreatePaymentLinkBody = z.infer<typeof CreatePaymentLinkBodySchema>;
export type PaymentLink = z.infer<typeof PaymentLinkSchema>;

export const paymentLinkService = {
  /** POST /v1/api/payment-link — Create a hosted payment link. */
  create: async (
    body: CreatePaymentLinkBody,
    opts: { idempotencyKey?: string } = {},
  ) => {
    const res = await http.post(envelope(PaymentLinkSchema), {
      path: '/v1/api/payment-link',
      body: CreatePaymentLinkBodySchema.parse(body),
      idempotencyKey: opts.idempotencyKey,
    });

    return res.data;
  },
};
