import { isIpad } from "shared/utils/is-ipad";

type TextSize = {
  xtiny: [number, number];
  tiny: [number, number];
  small: [number, number];
  base: [number, number];
  medium: [number, number];
  large: [number, number];
  xlarge: [number, number];
};

export const TextSize: TextSize = {
  xtiny: isIpad() ? [14, 20] : [8, 12],
  tiny: isIpad() ? [16, 24] : [12, 16],
  small: isIpad() ? [20, 28] : [14, 20],
  base: isIpad() ? [24, 32] : [16, 24],
  medium: isIpad() ? [32, 40] : [20, 28],
  large: isIpad() ? [40, 48] : [24, 32],
  xlarge: isIpad() ? [48, 56] : [32, 40],
};
