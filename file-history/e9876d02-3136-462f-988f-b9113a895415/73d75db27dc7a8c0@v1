import { Block, Text } from "@prototyp/skeletor";
import type { RoomInterface } from "@unomed/react-native-matrix-sdk";
import { MatrixBaseURL } from "modules/matrix-client/const";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { fetchMedia } from "modules/matrix-client/utils";
import { type FC, useEffect, useState } from "react";
import { Image } from "react-native";
import { Colors, TextSize } from "shared/styles";
import {
  cacheImageWithKey,
  getCachedImagePathByURL,
  isCached,
} from "shared/utils/image-caching";
import { Button } from "../button";

interface Props {
  width: number;
  height: number;
  room: RoomInterface;
  borderRadius?: number;
  onPress?: (uri: string) => void;
}

export const RoomImage: FC<Props> = ({
  room,
  width,
  height,
  borderRadius = 48,
  onPress,
}) => {
  let mxcUrl = room.avatarUrl();
  const [uri, setUri] = useState<string | null>(null);

  const textSize = () => {
    if (height < 28) return TextSize.tiny;
    if (height < 32) return TextSize.small;
    if (height < 40) return TextSize.base;
    if (height < 48) return TextSize.medium;
    if (height < 56) return TextSize.large;

    return TextSize.xlarge;
  };

  useEffect(() => {
    const fetch = async () => {
      const isDirect = await room.isDirect();
      if (isDirect && room.heroes()[0]?.avatarUrl) {
        mxcUrl = room.heroes()[0].avatarUrl;
      }

      if (!mxcUrl) return;

      try {
        if (await isCached(mxcUrl)) {
          setUri(getCachedImagePathByURL(mxcUrl));
          return;
        }
        const url = await fetchMedia({
          url: mxcUrl,
          width,
          height,
          serverUrl:
            MatrixCore.instance?.session().homeserverUrl || MatrixBaseURL,
        });
        if (!url) return;
        await cacheImageWithKey(mxcUrl, url);
        setUri(getCachedImagePathByURL(mxcUrl));
      } catch (e) {
        console.log(e);
      }
    };

    fetch();
  }, [mxcUrl]);

  if (uri) {
    const image = (
      <Image
        source={{ uri }}
        width={width}
        height={height}
        style={{
          width,
          height,
          borderRadius,
          borderWidth: 2,
          borderColor: Colors.white20,
        }}
      />
    );

    if (onPress) {
      return (
        <Button.Wrapper onPress={() => onPress(uri)}>{image}</Button.Wrapper>
      );
    }

    return image;
  }

  return (
    <Block
      width={width}
      height={height}
      border={{
        borderRadius,
        borderWidth: 2,
        borderColor: Colors.white20,
      }}
      background={Colors.white20}
      align="center"
      justify="center"
    >
      <Text size={textSize()} color="white" textTransform="uppercase">
        {room.displayName()?.charAt(0)}
      </Text>
    </Block>
  );
};
