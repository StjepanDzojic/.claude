import { ImageZoom } from "@likashefqet/react-native-image-zoom";
import { Block, Text } from "@prototyp/skeletor";
import type { EventTimelineItem } from "@unomed/react-native-matrix-sdk";
import { type FC, useCallback, useEffect, useRef, useState } from "react";
import { Dimensions, StyleSheet, TouchableOpacity } from "react-native";
import { Colors, TextSize } from "shared/styles";
import { resolveEncryptedImage } from "shared/utils/encrypted-image-cache";
import { Loading } from "../loading";
import { getImageContent } from "./utils";

const { width: SCREEN_WIDTH, height: SCREEN_HEIGHT } = Dimensions.get("window");

interface Props {
  event: EventTimelineItem;
  onSingleTap: () => void;
  onLocalUriChange: (uri: string | null) => void;
}

export const MediaImagePage: FC<Props> = ({
  event,
  onSingleTap,
  onLocalUriChange,
}) => {
  const content = getImageContent(event);
  const mxcUrl = content?.source.url() ?? null;
  const mimeType = content?.info?.mimetype || "image/jpeg";
  const [localUri, setLocalUri] = useState<string | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [hasError, setHasError] = useState(false);

  // `content` re-references on every parent render (SDK returns fresh
  // EventTimelineItem objects as the timeline hydrates), but the mxc URL is a
  // stable string for the same event. We keep the latest content in a ref so
  // the effect can resolve against it without depending on its reference.
  const contentRef = useRef(content);
  contentRef.current = content;

  const load = useCallback(async () => {
    const c = contentRef.current;
    if (!c || !mxcUrl) {
      setHasError(true);
      setIsLoading(false);
      return null;
    }
    try {
      const resolved = await resolveEncryptedImage({
        cacheKey: mxcUrl,
        mediaSource: c.source,
        mimeType,
      });
      return resolved ?? null;
    } catch {
      return null;
    }
  }, [mxcUrl, mimeType]);

  useEffect(() => {
    if (!mxcUrl) {
      setLocalUri(null);
      setIsLoading(false);
      setHasError(true);
      return;
    }
    let cancelled = false;
    setLocalUri(null);
    setIsLoading(true);
    setHasError(false);

    load().then((uri) => {
      if (cancelled) return;
      if (uri) {
        setLocalUri(uri);
      } else {
        setHasError(true);
        setIsLoading(false);
      }
    });

    return () => {
      cancelled = true;
    };
  }, [mxcUrl, load]);

  useEffect(() => {
    onLocalUriChange(localUri);
  }, [localUri, onLocalUriChange]);

  const handleImageLoad = useCallback(() => {
    setIsLoading(false);
    setHasError(false);
  }, []);

  const handleImageError = useCallback(() => {
    setIsLoading(false);
    setHasError(true);
  }, []);

  const handleRetry = useCallback(async () => {
    setLocalUri(null);
    setIsLoading(true);
    setHasError(false);
    const uri = await load();
    if (uri) {
      setLocalUri(uri);
    } else {
      setHasError(true);
      setIsLoading(false);
    }
  }, [load]);

  return (
    <Block width={SCREEN_WIDTH} height={SCREEN_HEIGHT}>
      {isLoading && !hasError && (
        <Block
          absolute
          width={SCREEN_WIDTH}
          height={SCREEN_HEIGHT}
          align="center"
          justify="center"
          zIndex={5}
          background={Colors.white10}
        >
          <Loading isFullScreen={false} />
        </Block>
      )}
      {hasError ? (
        <Block
          width={SCREEN_WIDTH}
          height={SCREEN_HEIGHT}
          align="center"
          justify="center"
        >
          <Text color={Colors.white}>Failed to load image</Text>
          <TouchableOpacity onPress={handleRetry} style={styles.retryButton}>
            <Text size={TextSize.small} color={Colors.white}>
              Tap to retry
            </Text>
          </TouchableOpacity>
        </Block>
      ) : localUri ? (
        <ImageZoom
          key={localUri}
          uri={localUri}
          minScale={1}
          maxScale={5}
          maxPanPointers={2}
          isPanEnabled
          isPinchEnabled
          isDoubleTapEnabled
          isSingleTapEnabled
          style={styles.image}
          onLoad={handleImageLoad}
          onError={handleImageError}
          onSingleTap={onSingleTap}
        />
      ) : null}
    </Block>
  );
};

const styles = StyleSheet.create({
  image: {
    width: SCREEN_WIDTH,
    height: SCREEN_HEIGHT,
  },
  retryButton: {
    marginTop: 12,
    paddingVertical: 8,
    paddingHorizontal: 16,
  },
});
