import {
  BottomSheetModal,
  type BottomSheetModalProps,
} from "@gorhom/bottom-sheet";
import { animateSequence, Block } from "@prototyp/skeletor";
import {
  forwardRef,
  type ReactNode,
  useCallback,
  useEffect,
  useImperativeHandle,
  useRef,
} from "react";
import { Dimensions, Modal, Pressable, StyleSheet } from "react-native";
import { usePreventSwipeBack } from "shared/hooks";
import { Colors } from "shared/styles";
import { effectiveWindowWidth, isIpad } from "shared/utils";

const { height } = Dimensions.get("screen");

export interface AppBottomSheetRef {
  close: () => void;
}

interface Props {
  isOpen: boolean;
  children: ReactNode;
  maxContentSize?: number;
  enableContentPanningGesture?: boolean;
  keyboardBehavior?: BottomSheetModalProps["keyboardBehavior"];
  keyboardBlurBehavior?: BottomSheetModalProps["keyboardBlurBehavior"];
  android_keyboardInputMode?: BottomSheetModalProps["android_keyboardInputMode"];
  /** Skip the full-screen dim backdrop. Use when the host already provides
   *  its own dimmed background (e.g. sheet mounted inside an RN Modal). */
  hideBackdrop?: boolean;
  onClose: () => void;
}

export const AppBottomSheet = forwardRef<AppBottomSheetRef, Props>(
  (
    {
      isOpen,
      children,
      maxContentSize,
      enableContentPanningGesture,
      keyboardBehavior,
      keyboardBlurBehavior,
      android_keyboardInputMode,
      hideBackdrop,
      onClose,
    },
    ref,
  ) => {
    const sheetRef = useRef<BottomSheetModal>(null);
    const fadeIn = useRef(
      animateSequence({ opacity: [0, 1] }, { duration: 200 }),
    ).current;
    const isClosingRef = useRef(false);

    const handleDismiss = useCallback(() => {
      if (isClosingRef.current) return;
      isClosingRef.current = true;
      fadeIn.reverse(() => {
        isClosingRef.current = false;
        onClose();
      });
    }, [fadeIn, onClose]);

    useImperativeHandle(ref, () => ({
      close: () => {
        if (isIpad()) {
          onClose();
          return;
        }
        handleDismiss();
        sheetRef.current?.dismiss();
      },
    }));

    usePreventSwipeBack(isOpen);

    useEffect(() => {
      if (!isOpen || isIpad()) return;
      fadeIn.start();
      sheetRef.current?.present();
    }, [isOpen, fadeIn]);

    if (!isOpen) return null;

    if (isIpad()) {
      return (
        <Modal
          visible
          transparent
          animationType="fade"
          statusBarTranslucent
          presentationStyle="overFullScreen"
          onRequestClose={onClose}
        >
          <Pressable
            style={[
              styles.ipadBackdrop,
              hideBackdrop && styles.transparentBackdrop,
            ]}
            onPress={onClose}
          >
            <Block
              width={480}
              maxHeight={height * 0.8}
              background={Colors.blackMinus1}
              border={{ borderRadius: 24 }}
              overflow="hidden"
            >
              {children}
            </Block>
          </Pressable>
        </Modal>
      );
    }

    const sheet = (
      <BottomSheetModal
        ref={sheetRef}
        handleStyle={styles.handle}
        handleIndicatorStyle={styles.handleIndicator}
        backgroundStyle={styles.background}
        enablePanDownToClose
        enableDynamicSizing
        maxDynamicContentSize={maxContentSize ?? height - 200}
        onDismiss={handleDismiss}
        enableContentPanningGesture={enableContentPanningGesture}
        keyboardBehavior={keyboardBehavior}
        keyboardBlurBehavior={keyboardBlurBehavior}
        android_keyboardInputMode={android_keyboardInputMode}
      >
        {children}
      </BottomSheetModal>
    );

    if (hideBackdrop) return sheet;

    return (
      <Block
        absolute
        width={effectiveWindowWidth()}
        height="100%"
        offsets={{ left: 0, top: 0 }}
        animations={fadeIn.animations}
        zIndex={9999}
        background={Colors.black70}
      >
        {sheet}
      </Block>
    );
  },
);

const styles = StyleSheet.create({
  background: {
    backgroundColor: Colors.blackMinus1,
    borderTopLeftRadius: 24,
    borderTopRightRadius: 24,
  },
  handle: {
    borderWidth: 1,
    borderBottomWidth: 0,
    borderTopLeftRadius: 24,
    borderTopRightRadius: 24,
    paddingHorizontal: 12,
    paddingTop: 12,
    paddingBottom: 24,
  },
  ipadBackdrop: {
    flex: 1,
    backgroundColor: Colors.black70,
    justifyContent: "center",
    alignItems: "center",
  },
  transparentBackdrop: {
    backgroundColor: "transparent",
  },
  handleIndicator: {
    width: 84,
    height: 4,
    backgroundColor: Colors.white50,
  },
});
