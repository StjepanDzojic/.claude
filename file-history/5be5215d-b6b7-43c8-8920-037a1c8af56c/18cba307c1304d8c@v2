import { BottomSheetScrollView } from "@gorhom/bottom-sheet";
import { Block, Text } from "@prototyp/skeletor";
import type { UserProfile } from "@unomed/react-native-matrix-sdk";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import type { TimelineReaction } from "modules/timeline/service/TimelineService";
import { useEffect, useState } from "react";
import { AppBottomSheet } from "shared/components/bottom-sheet";
import { UserProfileImage } from "shared/components/user-profile-image";
import { Colors, TextSize } from "shared/styles";

interface ReactionUserRowProps {
  userId: string;
}

const ReactionUserRow: React.FC<ReactionUserRowProps> = ({ userId }) => {
  const [profile, setProfile] = useState<UserProfile | null>(null);
  const displayName =
    profile?.displayName ?? userId.replace("@", "").split(":")[0];

  useEffect(() => {
    MatrixCore.getClient().getProfile(userId).then(setProfile).catch();
  }, [userId]);

  return (
    <Block
      flexDirection="row"
      align="center"
      gap={12}
      paddings={{ paddingVertical: 10 }}
      border={{ borderBottomWidth: 1, borderColor: Colors.white5 }}
    >
      <UserProfileImage user={profile} width={32} height={32} />
      <Block flex={1} gap={2}>
        <Text color={Colors.white} font="InstrumentSans-Bold">
          {displayName}
        </Text>
        <Text
          size={TextSize.small}
          color={Colors.white50}
          font="InstrumentSans-Regular"
        >
          {userId}
        </Text>
      </Block>
    </Block>
  );
};

interface Props {
  isOpen: boolean;
  reactions: TimelineReaction[];
  onClose: () => void;
}

export const ReactionsBottomSheet: React.FC<Props> = ({
  isOpen,
  reactions,
  onClose,
}) => {
  return (
    <AppBottomSheet
      isOpen={isOpen}
      onClose={onClose}
      enableContentPanningGesture={false}
    >
      <BottomSheetScrollView>
        <Block paddings={{ paddingHorizontal: 20, paddingBottom: 56 }}>
          {reactions.map((reaction) => (
            <Block key={reaction.key} margins={{ marginBottom: 24 }}>
              <Block
                flexDirection="row"
                align="center"
                gap={8}
                margins={{ marginBottom: 8 }}
              >
                <Text size={TextSize.medium}>{reaction.displayKey}</Text>
                <Text
                  font="InstrumentSans-Bold"
                  color={Colors.white}
                  size={TextSize.medium}
                >
                  {reaction.count}
                </Text>
              </Block>
              {reaction.senderIds.map((userId) => (
                <ReactionUserRow key={userId} userId={userId} />
              ))}
            </Block>
          ))}
        </Block>
      </BottomSheetScrollView>
    </AppBottomSheet>
  );
};
