import { BottomSheetScrollView } from "@gorhom/bottom-sheet";
import { Block, Text } from "@prototyp/skeletor";
import type { TimelineReaction } from "modules/timeline/service/TimelineService";
import { useEffect, useState } from "react";
import { ScrollView } from "react-native";
import { AppBottomSheet } from "shared/components/bottom-sheet";
import { Colors, TextSize } from "shared/styles";
import { ReactionUserRow } from "./fragments";

interface Props {
  isOpen: boolean;
  reactions: TimelineReaction[];
  onClose: () => void;
}

export const ReactionsBottomSheet: React.FC<Props> = ({
  isOpen,
  reactions,
  onClose,
}) => {
  const [activeKey, setActiveKey] = useState<string>("");

  useEffect(() => {
    if (!reactions.length) return;
    setActiveKey(reactions[0].key);
  }, [reactions]);

  const activeReaction =
    reactions.find((r) => r.key === activeKey) ?? reactions[0];

  return (
    <AppBottomSheet
      isOpen={isOpen}
      onClose={onClose}
      enableContentPanningGesture={false}
    >
      <BottomSheetScrollView stickyHeaderIndices={[0]}>
        <Block
          paddings={{ paddingHorizontal: 20, paddingTop: 4, paddingBottom: 8 }}
          background={Colors.black}
        >
          <ScrollView
            horizontal
            showsHorizontalScrollIndicator={false}
            contentContainerStyle={{ gap: 8 }}
          >
            {reactions.map((reaction) => {
              const isActive = reaction.key === activeKey;
              return (
                <Block
                  key={reaction.key}
                  onTouchEnd={() => setActiveKey(reaction.key)}
                  background={isActive ? Colors.primary : Colors.white10}
                  border={{ borderRadius: 20 }}
                  paddings={{ paddingHorizontal: 12, paddingVertical: 6 }}
                  flexDirection="row"
                  align="center"
                  gap={4}
                >
                  <Text size={TextSize.small}>{reaction.displayKey}</Text>
                  <Text
                    size={TextSize.small}
                    color={isActive ? Colors.white : Colors.white50}
                    font="InstrumentSans-Bold"
                  >
                    {reaction.count}
                  </Text>
                </Block>
              );
            })}
          </ScrollView>
        </Block>

        <Block paddings={{ paddingHorizontal: 20, paddingBottom: 56 }}>
          {activeReaction?.senderIds?.map((userId) => (
            <ReactionUserRow
              key={userId}
              userId={userId}
              timestamp={activeReaction.latestTimestamp}
            />
          ))}
        </Block>
      </BottomSheetScrollView>
    </AppBottomSheet>
  );
};
