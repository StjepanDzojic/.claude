import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { useScreenLockInput } from "modules/screen-lock/hooks";
import { Image, StyleSheet, TextInput } from "react-native";
import { GoBackHeader, Loading, ScreenLayout } from "shared/components";
import { Colors, TextSize } from "shared/styles";

export const VerifyPin: React.FC<
  NativeStackScreenProps<Routes, "verifyPin">
> = ({ navigation }) => {
  const {
    pin,
    inputRefs,
    attemptsRemaining,
    hasWrongAttempts,
    isLoggingOut,
    handlePinChange,
    handleKeyPress,
  } = useScreenLockInput({
    onSuccess: () => {
      navigation.replace("screenLockSettings");
    },
    onLogoutComplete: () => {
      navigation.reset({
        index: 1,
        routes: [{ name: "welcome" }, { name: "login" }],
      });
    },
  });

  return (
    <ScreenLayout type="modal">
      {isLoggingOut && <Loading text="Logging out..." />}
      <Block flex={1} align="center" gap={40}>
        <GoBackHeader margins={0} />
        <Image
          height={100}
          width={100}
          source={require("assets/images/key.png")}
        />
        <Block gap={8}>
          <Text size={TextSize.large} textAlign="center">
            Enter your PIN
          </Text>
          <Text
            color={hasWrongAttempts ? Colors.warning : Colors.white80}
            textAlign="center"
          >
            {`You have ${attemptsRemaining} attempts to enter the correct PIN.`}
          </Text>
          {hasWrongAttempts && (
            <Text color={Colors.warning} textAlign="center">
              If you forget this PIN, you will be logged out out of the app
            </Text>
          )}
        </Block>

        <Block flexDirection="row" gap={12} pointerEvents="none">
          {pin.map((digit, index) => (
            <TextInput
              key={index}
              ref={(ref) => {
                inputRefs.current[index] = ref;
              }}
              style={styles.input}
              value={digit}
              onChangeText={(text) => handlePinChange(text, index)}
              onKeyPress={(e) => handleKeyPress(e, index)}
              keyboardType="number-pad"
              maxLength={1}
              selectTextOnFocus={false}
              autoFocus={index === 0}
            />
          ))}
        </Block>
      </Block>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  input: {
    width: 60,
    height: 60,
    borderWidth: 1,
    borderColor: Colors.white50,
    borderRadius: 12,
    fontSize: 24,
    textAlign: "center",
    color: Colors.white,
    backgroundColor: "transparent",
  },
});
