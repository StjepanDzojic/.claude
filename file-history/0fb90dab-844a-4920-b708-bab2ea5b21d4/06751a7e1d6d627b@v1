import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { useAtom, useAtomValue } from "jotai";
import { AuthService } from "modules/auth/service/AuthService";
import { StorageAtoms } from "modules/storage/jotai/atoms";
import { useRef, useState } from "react";
import {
  Image,
  StyleSheet,
  TextInput,
  type TextInputKeyPressEvent,
} from "react-native";
import { GoBackHeader, Loading, ScreenLayout } from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

export const VerifyPin: React.FC<
  NativeStackScreenProps<Routes, "verifyPin">
> = ({ navigation, route }) => {
  const [pin, setPin] = useState<string[]>(["", "", "", ""]);
  const inputRefs = useRef<(TextInput | null)[]>([]);
  const screenLockPin = useAtomValue(StorageAtoms.screenLockPin);
  const [screenLockAttempts, setScreenLockAttempts] = useAtom(
    StorageAtoms.screenLockAttempts,
  );
  const hasWrongAttempts = Number(screenLockAttempts) > 0;
  const isSettingsScreen = !!route.params?.isSettingsScreen;
  const [isLoggingOut, setIsLoggingOut] = useState(false);

  const handlePinChange = async (text: string, index: number) => {
    if (text && !/^\d$/.test(text)) return;

    const newPin = [...pin];
    newPin[index] = text;
    setPin(newPin);

    // When 4th digit is entered, check if the PIN is correct
    if (index === 3) {
      const newPinString = newPin.join("");
      if (newPinString === screenLockPin) {
        setScreenLockAttempts("0");
        navigation.replace(isSettingsScreen ? "screenLockSettings" : "home");
        return;
      }

      // If the user misses the last attempt, logout the user
      if (Number(screenLockAttempts) === 2) {
        try {
          setIsLoggingOut(true);
          offlineToastHelper("You have missed the last attempt.");
          await AuthService.logout();
          navigation.reset({
            index: 1,
            routes: [{ name: "welcome" }, { name: "login" }],
          });
        } catch (error) {
          console.error("Failed to logout: ", error);
          offlineToastHelper("Failed to logout");
        } finally {
          setIsLoggingOut(false);
        }
        return;
      }

      setScreenLockAttempts(String(Number(screenLockAttempts) + 1));
      offlineToastHelper("PIN is incorrect. Please try again.");
      setPin(["", "", "", ""]);
      inputRefs.current[0]?.focus();
      return;
    }

    // Move to next input if a digit was entered
    inputRefs.current[index + 1]?.focus();
  };

  // Move to previous input on backspace
  const handleKeyPress = (e: TextInputKeyPressEvent, index: number) => {
    if (e.nativeEvent.key !== "Backspace" || pin[index] || index === 0) {
      return;
    }

    const newPin = [...pin];
    newPin[index - 1] = "";
    setPin(newPin);
    inputRefs.current[index - 1]?.focus();
  };

  return (
    <ScreenLayout type="modal">
      {isLoggingOut && <Loading text="Logging out..." />}
      <Block flex={1} align="center" gap={40}>
        {isSettingsScreen && <GoBackHeader margins={0} />}
        <Image
          height={100}
          width={100}
          source={require("assets/images/key.png")}
        />
        <Block gap={8}>
          <Text size={TextSize.large} textAlign="center">
            Enter your PIN
          </Text>
          <Text
            color={hasWrongAttempts ? Colors.warning : Colors.white80}
            textAlign="center"
          >
            {`You have ${3 - Number(screenLockAttempts)} attempts to enter the correct PIN.`}
          </Text>
          {hasWrongAttempts && (
            <Text color={Colors.warning} textAlign="center">
              If you forget this PIN, you will be logged out out of the app
            </Text>
          )}
        </Block>

        <Block flexDirection="row" gap={12} pointerEvents="none">
          {pin.map((digit, index) => (
            <TextInput
              key={index}
              ref={(ref) => {
                inputRefs.current[index] = ref;
              }}
              style={styles.input}
              value={digit}
              onChangeText={(text) => handlePinChange(text, index)}
              onKeyPress={(e) => handleKeyPress(e, index)}
              keyboardType="number-pad"
              maxLength={1}
              selectTextOnFocus={false}
              autoFocus={index === 0}
            />
          ))}
        </Block>
      </Block>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  input: {
    width: 60,
    height: 60,
    borderWidth: 1,
    borderColor: Colors.white50,
    borderRadius: 12,
    fontSize: 24,
    textAlign: "center",
    color: Colors.white,
    backgroundColor: "transparent",
  },
});
