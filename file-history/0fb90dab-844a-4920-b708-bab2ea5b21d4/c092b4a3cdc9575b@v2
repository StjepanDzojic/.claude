import { Block, Text } from "@prototyp/skeletor";
import { useAtomValue, useSetAtom } from "jotai";
import { useScreenLockInput } from "modules/screen-lock/hooks";
import { ScreenLockAtoms } from "modules/screen-lock/jotai";
import { StorageAtoms } from "modules/storage/jotai/atoms";
import { Image, StyleSheet, TextInput } from "react-native";
import { useSafeAreaInsets } from "react-native-safe-area-context";
import { Loading } from "shared/components";
import { Colors, TextSize } from "shared/styles";

export const ScreenLockOverlay: React.FC = () => {
  const isLocked = useAtomValue(ScreenLockAtoms.isLocked);
  const screenLockPin = useAtomValue(StorageAtoms.screenLockPin);
  const insets = useSafeAreaInsets();
  const setIsLocked = useSetAtom(ScreenLockAtoms.isLocked);

  const {
    pin,
    inputRefs,
    attemptsRemaining,
    hasWrongAttempts,
    isLoggingOut,
    handlePinChange,
    handleKeyPress,
  } = useScreenLockInput({
    onSuccess: () => setIsLocked(false),
  });

  if (!isLocked || !screenLockPin) return null;

  return (
    <Block
      absolute
      offsets={[0, 0, 0, 0]}
      background={Colors.black}
      zIndex={9999}
      paddings={{ paddingTop: insets.top + 24, paddingHorizontal: 20 }}
    >
      {isLoggingOut && <Loading text="Logging out..." />}
      <Block align="center" gap={40}>
        <Image
          height={100}
          width={100}
          source={require("assets/images/key.png")}
        />
        <Block gap={8}>
          <Text size={TextSize.large} textAlign="center">
            Enter your PIN
          </Text>
          <Text
            color={hasWrongAttempts ? Colors.warning : Colors.white80}
            textAlign="center"
          >
            {`You have ${attemptsRemaining} attempts to enter the correct PIN.`}
          </Text>
          {hasWrongAttempts && (
            <Text color={Colors.warning} textAlign="center">
              If you forget this PIN, you will be logged out out of the app
            </Text>
          )}
        </Block>

        <Block flexDirection="row" gap={12} pointerEvents="none">
          {pin.map((digit, index) => (
            <TextInput
              key={index}
              ref={(ref) => {
                inputRefs.current[index] = ref;
              }}
              style={styles.input}
              value={digit}
              onChangeText={(text) => handlePinChange(text, index)}
              onKeyPress={(e) => handleKeyPress(e, index)}
              keyboardType="number-pad"
              maxLength={1}
              selectTextOnFocus={false}
              autoFocus={index === 0}
            />
          ))}
        </Block>
      </Block>
    </Block>
  );
};

const styles = StyleSheet.create({
  input: {
    width: 60,
    height: 60,
    borderWidth: 1,
    borderColor: Colors.white50,
    borderRadius: 12,
    fontSize: 24,
    textAlign: "center",
    color: Colors.white,
    backgroundColor: "transparent",
  },
});
