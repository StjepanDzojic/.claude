import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import type { RoomPowerLevelChanges } from "@unomed/react-native-matrix-sdk";
import { RoomService } from "modules/room/service/RoomService";
import { useEffect, useMemo, useState } from "react";
import { Image, StyleSheet } from "react-native";
import { Button, GoBackHeader, Loading, ScreenLayout } from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { getLevelLabel } from "shared/utils";
import { PermissionValueModal, ResetConfirmModal } from "./fragments";

type PermissionKey =
  | "invite"
  | "kick"
  | "ban"
  | "roomName"
  | "roomAvatar"
  | "roomTopic"
  | "eventsDefault"
  | "redact";

type SectionItem = {
  key: PermissionKey;
  label: string;
  defaultLevel: number;
};

type Section = {
  title: string;
  items: SectionItem[];
};

const SECTIONS: Section[] = [
  {
    title: "Manage members",
    items: [
      { key: "invite", label: "Invite people", defaultLevel: 0 },
      { key: "kick", label: "Remove people", defaultLevel: 50 },
      { key: "ban", label: "Ban people", defaultLevel: 50 },
    ],
  },
  {
    title: "Edit details",
    items: [
      { key: "roomName", label: "Change name", defaultLevel: 50 },
      { key: "roomAvatar", label: "Change avatar", defaultLevel: 50 },
      { key: "roomTopic", label: "Change topic", defaultLevel: 50 },
    ],
  },
  {
    title: "Messages and content",
    items: [
      { key: "eventsDefault", label: "Send messages", defaultLevel: 0 },
      { key: "redact", label: "Remove messages", defaultLevel: 50 },
    ],
  },
];

export const RoomPermissions: React.FC<
  NativeStackScreenProps<Routes, "roomPermissions">
> = ({ navigation, route }) => {
  const { room, userPowerLevel } = route.params;

  const [currentValues, setCurrentValues] = useState<
    Partial<Record<PermissionKey, number>>
  >({});
  const [pendingValues, setPendingValues] = useState<
    Partial<Record<PermissionKey, number>>
  >({});
  const [activeKey, setActiveKey] = useState<PermissionKey | null>(null);
  const [showValueModal, setShowValueModal] = useState(false);
  const [showResetConfirm, setShowResetConfirm] = useState(false);
  const [isLoading, setIsLoading] = useState(true);
  const [isSaving, setIsSaving] = useState(false);
  const [isResetting, setIsResetting] = useState(false);

  const hasChanges = Object.keys(pendingValues).length > 0;

  const getDefaultLevel = (key: PermissionKey): number => {
    for (const section of SECTIONS) {
      for (const item of section.items) {
        if (item.key === key) return item.defaultLevel;
      }
    }
    return 0;
  };

  const getDisplayLevel = (key: PermissionKey) => {
    if (key in pendingValues) return pendingValues[key]!;
    if (key in currentValues) return currentValues[key]!;
    return getDefaultLevel(key);
  };

  const handleSave = async () => {
    setIsSaving(true);
    try {
      const changes: RoomPowerLevelChanges = {
        ban: undefined,
        invite: undefined,
        kick: undefined,
        redact: undefined,
        eventsDefault: undefined,
        stateDefault: undefined,
        usersDefault: undefined,
        roomName: undefined,
        roomAvatar: undefined,
        roomTopic: undefined,
        spaceChild: undefined,
      };
      for (const [key, value] of Object.entries(pendingValues)) {
        (changes as Record<string, bigint | undefined>)[key] = BigInt(
          value as number,
        );
      }
      await RoomService.applyRoomPowerLevelChanges(room.id(), changes);
      navigation.goBack();
    } catch (error) {
      console.error("Failed to apply permission changes:", error);
    } finally {
      setIsSaving(false);
    }
  };

  const handleReset = async () => {
    setIsResetting(true);
    try {
      await RoomService.resetRoomPowerLevels(room.id());
      setShowResetConfirm(false);
      navigation.goBack();
    } catch (error) {
      console.error("Failed to reset permissions:", error);
    } finally {
      setIsResetting(false);
    }
  };

  const handleSelectLevel = (level: number) => {
    if (!activeKey) return;
    setPendingValues((prev) => ({ ...prev, [activeKey]: level }));
    setShowValueModal(false);
  };

  useEffect(() => {
    RoomService.getRoomPowerLevels(room.id())
      .then((pl) => {
        if (!pl) return;
        const vals = pl.values();
        setCurrentValues({
          invite: Number(vals.invite),
          kick: Number(vals.kick),
          ban: Number(vals.ban),
          roomName: Number(vals.roomName),
          roomAvatar: Number(vals.roomAvatar),
          roomTopic: Number(vals.roomTopic),
          eventsDefault: Number(vals.eventsDefault),
          redact: Number(vals.redact),
        });
      })
      .catch(console.error)
      .finally(() => setIsLoading(false));
  }, [room]);

  const availableLevels = useMemo(() => {
    const levels = [0, 50];
    if (userPowerLevel >= 100) levels.push(100);
    return levels;
  }, [userPowerLevel]);

  if (isLoading) return <Loading />;

  return (
    <ScreenLayout>
      {(isSaving || isResetting) && (
        <Loading text={isSaving ? "Saving..." : "Resetting..."} />
      )}
      <Block flex={1} scrollable>
        <GoBackHeader
          title="Permissions"
          margins={{ marginBottom: 24 }}
          rightComp={
            hasChanges && (
              <Button.Wrapper onPress={handleSave} disabled={isSaving}>
                <Text>Save</Text>
              </Button.Wrapper>
            )
          }
        />

        {SECTIONS.map((section) => (
          <Block key={section.title} margins={{ marginBottom: 20 }}>
            <Text
              size={TextSize.small}
              color={Colors.white50}
              margins={{ marginBottom: 8, marginLeft: 4 }}
            >
              {section.title}
            </Text>
            <Block
              border={{ borderRadius: 16 }}
              width="100%"
              background={Colors.white5}
            >
              {section.items.map((item, index) => {
                const isLast = index === section.items.length - 1;
                const displayLevel = getDisplayLevel(item.key);
                const isItemDisabled =
                  userPowerLevel < 100 && displayLevel >= 100;

                return (
                  <Button.Wrapper
                    key={item.key}
                    disabled={isItemDisabled}
                    onPress={() => {
                      setActiveKey(item.key);
                      setShowValueModal(true);
                    }}
                  >
                    <Block
                      paddings={[0, 12]}
                      opacity={isItemDisabled ? 0.5 : 1}
                    >
                      <Block
                        flexDirection="row"
                        align="center"
                        gap={12}
                        paddings={[20, 0]}
                        border={
                          !isLast
                            ? {
                                borderBottomWidth: 1,
                                borderColor: Colors.white5,
                              }
                            : undefined
                        }
                      >
                        <Text flex={1}>{item.label}</Text>
                        <Text color={Colors.white50}>
                          {getLevelLabel(displayLevel)}
                        </Text>
                        <Image
                          source={require("assets/icons/caret-left.png")}
                          style={styles.caret}
                          tintColor={Colors.white50}
                        />
                      </Block>
                    </Block>
                  </Button.Wrapper>
                );
              })}
            </Block>
          </Block>
        ))}

        <Block paddings={[0, 52]}>
          <Button.Warning
            onPress={() => setShowResetConfirm(true)}
            width="100%"
            disabled={isSaving || isResetting}
          >
            Reset permissions
          </Button.Warning>
        </Block>
      </Block>

      <PermissionValueModal
        visible={showValueModal}
        selectedLevel={activeKey !== null ? getDisplayLevel(activeKey) : 0}
        availableLevels={availableLevels}
        onSelect={handleSelectLevel}
        onClose={() => setShowValueModal(false)}
      />

      <ResetConfirmModal
        visible={showResetConfirm}
        isResetting={isResetting}
        onConfirm={handleReset}
        onClose={() => setShowResetConfirm(false)}
      />
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  caret: {
    transform: [{ rotate: "180deg" }],
    width: 24,
    height: 24,
  },
});
