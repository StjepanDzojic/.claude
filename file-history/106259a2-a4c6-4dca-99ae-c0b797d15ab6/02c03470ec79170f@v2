import { Block, Text } from "@prototyp/skeletor";
import { useIsFocused } from "@react-navigation/native";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { RoomNotificationMode } from "@unomed/react-native-matrix-sdk";
import { useAtom, useAtomValue } from "jotai";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { PushNotificationsAtoms } from "modules/push-notifications/jotai";
import { PushRulesService } from "modules/push-notifications/service";
import { useCallback, useEffect, useState } from "react";
import { Image, Linking, StyleSheet } from "react-native";
import {
  Button,
  GoBackHeader,
  IpadScreenWrapper,
  Loading,
  RadioButton,
  ScreenLayout,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

function formatMode(mode: RoomNotificationMode): string {
  switch (mode) {
    case RoomNotificationMode.AllMessages:
      return "All";
    case RoomNotificationMode.MentionsAndKeywordsOnly:
      return "Mentions";
    default:
      return "All";
  }
}

export const Notifications: React.FC<
  NativeStackScreenProps<Routes, "notifications">
> = ({ navigation }) => {
  const isPermitted = useAtomValue(PushNotificationsAtoms.isPermitted);
  const [enableMentions, setEnableMentions] = useState(true);
  const [enableInvitations, setEnableInvitations] = useState(true);
  const [groupChatMode, setGroupChatMode] = useState<RoomNotificationMode>(
    RoomNotificationMode.AllMessages,
  );
  const [directChatMode, setDirectChatMode] = useState<RoomNotificationMode>(
    RoomNotificationMode.AllMessages,
  );
  const [isInconsistent, setIsInconsistent] = useState(false);
  const [loading, setLoading] = useState(true);
  const isFocused = useIsFocused();
  const [hasAllowedNotificationsIntro, setHasAllowedNotificationsIntro] =
    useAtom(PushNotificationsAtoms.hasAllowedNotificationsIntro);

  const loadSettings = useCallback(async () => {
    try {
      setLoading(true);

      const client = MatrixCore.getClient();
      const notificationSettings = await client.getNotificationSettings();

      const [
        groupEncrypted,
        groupUnencrypted,
        directEncrypted,
        directUnencrypted,
      ] = await Promise.all([
        notificationSettings.getDefaultRoomNotificationMode(false, false),
        notificationSettings.getDefaultRoomNotificationMode(true, false),
        notificationSettings.getDefaultRoomNotificationMode(false, true),
        notificationSettings.getDefaultRoomNotificationMode(true, true),
      ]);

      const groupInconsistent = groupEncrypted !== groupUnencrypted;
      const directInconsistent = directEncrypted !== directUnencrypted;

      if (groupInconsistent || directInconsistent) {
        setIsInconsistent(true);
      } else {
        setIsInconsistent(false);
        setGroupChatMode(groupEncrypted);
        setDirectChatMode(directEncrypted);
      }

      const pushSettings = await PushRulesService.getNotificationSettings();
      if (!pushSettings) return;

      setEnableMentions(pushSettings.mentions);
      setEnableInvitations(pushSettings.invitations);
    } catch (error) {
      console.error("Failed to load notification settings:", error);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    if (!isFocused) return;
    loadSettings();
  }, [isFocused, loadSettings]);

  const handleResetInconsistentSettings = async () => {
    try {
      setLoading(true);
      const client = MatrixCore.getClient();
      const notificationSettings = await client.getNotificationSettings();
      await Promise.all([
        notificationSettings.setDefaultRoomNotificationMode(
          false,
          false,
          RoomNotificationMode.AllMessages,
        ),
        notificationSettings.setDefaultRoomNotificationMode(
          true,
          false,
          RoomNotificationMode.AllMessages,
        ),
        notificationSettings.setDefaultRoomNotificationMode(
          false,
          true,
          RoomNotificationMode.AllMessages,
        ),
        notificationSettings.setDefaultRoomNotificationMode(
          true,
          true,
          RoomNotificationMode.AllMessages,
        ),
      ]);
      setGroupChatMode(RoomNotificationMode.AllMessages);
      setDirectChatMode(RoomNotificationMode.AllMessages);
      setIsInconsistent(false);
    } catch (error) {
      console.error("Failed to reset notification settings:", error);
      offlineToastHelper("Failed to reset notification settings");
    } finally {
      setLoading(false);
    }
  };

  const handleMentionsToggle = async () => {
    const newValue = !enableMentions;
    setEnableMentions(newValue);
    try {
      await PushRulesService.setMentionsEnabled(newValue);
    } catch (error) {
      console.error("Failed to update mentions setting:", error);
      setEnableMentions(!newValue);
      offlineToastHelper("Failed to update mentions setting");
    }
  };

  const handleInvitationsToggle = async () => {
    const newValue = !enableInvitations;
    setEnableInvitations(newValue);
    try {
      await PushRulesService.setInvitationsEnabled(newValue);
    } catch (error) {
      console.error("Failed to update invitations setting:", error);
      setEnableInvitations(!newValue);
      offlineToastHelper("Failed to update invitations setting");
    }
  };

  const handleEnableNotifications = () => {
    if (!hasAllowedNotificationsIntro && !isPermitted) {
      setHasAllowedNotificationsIntro(true);
      return;
    }
    Linking.openSettings();
  };

  return (
    <ScreenLayout>
      {loading && <Loading />}
      <GoBackHeader title="Notifications" margins={0} />
      <IpadScreenWrapper flex={1} align="center" gap={40}>
        <RadioButton
          checked={!!isPermitted}
          onToggle={handleEnableNotifications}
          label="Enable notifications"
        />
        {isPermitted && (
          <>
            {isInconsistent && (
              <Block
                width="100%"
                gap={12}
                paddings={16}
                background={Colors.white5}
                border={{ borderRadius: 16 }}
              >
                <Text size={TextSize.small} color={Colors.white50}>
                  Your notification settings are inconsistent. Tap below to
                  reset them to the default.
                </Text>
                <Button.Wrapper onPress={handleResetInconsistentSettings}>
                  <Text size={TextSize.small} color={Colors.white}>
                    Reset to defaults
                  </Text>
                </Button.Wrapper>
              </Block>
            )}
            {!isInconsistent && (
              <Block gap={8} width="100%">
                <Text
                  size={TextSize.tiny}
                  color={Colors.white50}
                  paddings={[0, 12]}
                >
                  Notification Type
                </Text>
                <Block
                  border={{ borderRadius: 16 }}
                  width="100%"
                  background={Colors.white5}
                >
                  <Button.Wrapper
                    onPress={() =>
                      navigation.navigate("notificationsType", {
                        type: "group",
                        notificationsType: groupChatMode,
                      })
                    }
                  >
                    <Block paddings={[0, 12]}>
                      <Block
                        flexDirection="row"
                        align="center"
                        justify="space-between"
                        gap={12}
                        paddings={[20, 0]}
                        border={{
                          borderBottomWidth: 1,
                          borderColor: Colors.white5,
                        }}
                      >
                        <Text size={TextSize.base}>Group chats</Text>
                        <Block flexDirection="row" align="center" gap={8}>
                          <Text size={TextSize.base} color={Colors.white50}>
                            {formatMode(groupChatMode)}
                          </Text>
                          <Image
                            source={require("assets/icons/caret-left.png")}
                            style={styles.caret}
                            tintColor={Colors.white50}
                          />
                        </Block>
                      </Block>
                    </Block>
                  </Button.Wrapper>
                  <Button.Wrapper
                    onPress={() =>
                      navigation.navigate("notificationsType", {
                        type: "direct",
                        notificationsType: directChatMode,
                      })
                    }
                  >
                    <Block paddings={[0, 12]}>
                      <Block
                        flexDirection="row"
                        align="center"
                        justify="space-between"
                        gap={12}
                        paddings={[20, 0]}
                      >
                        <Text size={TextSize.base}>Direct chats</Text>
                        <Block flexDirection="row" align="center" gap={8}>
                          <Text size={TextSize.base} color={Colors.white50}>
                            {formatMode(directChatMode)}
                          </Text>
                          <Image
                            source={require("assets/icons/caret-left.png")}
                            style={styles.caret}
                            tintColor={Colors.white50}
                          />
                        </Block>
                      </Block>
                    </Block>
                  </Button.Wrapper>
                </Block>
              </Block>
            )}
            <Block gap={8} width="100%">
              <Text
                size={TextSize.tiny}
                color={Colors.white50}
                paddings={[0, 12]}
              >
                Mentions
              </Text>
              <RadioButton
                checked={enableMentions}
                onToggle={handleMentionsToggle}
                label="Enable mentions"
              />
            </Block>
            <Block gap={8} width="100%">
              <Text
                size={TextSize.tiny}
                color={Colors.white50}
                paddings={[0, 12]}
              >
                Additional
              </Text>
              <RadioButton
                checked={enableInvitations}
                onToggle={handleInvitationsToggle}
                label="Invitations"
              />
            </Block>
          </>
        )}
      </IpadScreenWrapper>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  caret: {
    transform: [{ rotate: "180deg" }],
    width: 24,
    height: 24,
    marginLeft: "auto",
  },
});
