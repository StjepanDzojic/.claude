import { Block } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { DebugHelpers } from "modules/matrix-client/helpers";
import { useState } from "react";
import { ScreenLayout } from "shared/components";
import { Colors } from "shared/styles";
import { isIpad } from "shared/utils";
import {
  Filters,
  Header,
  IpadRoomPane,
  NewChatButton,
  NoRoomWrapper,
  ProtectAccountMessage,
  Rooms,
  Search,
  SecurityFilter,
} from "./fragments";

export const Home: React.FC<NativeStackScreenProps<Routes, "home">> = () => {
  const [search, setSearch] = useState<string>("");

  const list = (
    <>
      <Header />
      <DebugHelpers />
      <ProtectAccountMessage />
      <NoRoomWrapper>
        <Filters />
        <Search search={search} setSearch={setSearch} />
        <SecurityFilter />
        <NewChatButton />
      </NoRoomWrapper>
      <Rooms search={search} />
    </>
  );

  if (isIpad()) {
    return (
      <ScreenLayout paddings={{ paddingHorizontal: 0 }}>
        <Block flex={1} flexDirection="row">
          <Block flex={1} maxWidth={440}>
            {list}
          </Block>
          <Block width={1} background={Colors.white10} />
          <Block flex={1}>
            <IpadRoomPane />
          </Block>
        </Block>
      </ScreenLayout>
    );
  }

  return (
    <ScreenLayout paddings={{ paddingHorizontal: 0 }}>
      <Block flex={1}>{list}</Block>
    </ScreenLayout>
  );
};
