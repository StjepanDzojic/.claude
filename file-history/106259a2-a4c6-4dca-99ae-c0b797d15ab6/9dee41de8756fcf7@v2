import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import {
  EncryptionState,
  JoinRule_Tags,
  RoomHistoryVisibility_Tags,
} from "@unomed/react-native-matrix-sdk";
import { RoomService } from "modules/room/service/RoomService";
import { useEffect, useMemo, useState } from "react";
import { Image, StyleSheet } from "react-native";
import {
  Button,
  GoBackHeader,
  IpadScreenWrapper,
  Loading,
  RadioButton,
  ScreenLayout,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";

type AccessOption = "public" | "invite";
type HistoryOption = "joined" | "invited";

export const RoomSecurity: React.FC<
  NativeStackScreenProps<Routes, "roomSecurity">
> = ({ navigation, route }) => {
  const { room } = route.params;

  const [isLoading, setIsLoading] = useState(true);
  const [isSaving, setIsSaving] = useState(false);

  const [currentAccess, setCurrentAccess] = useState<AccessOption>("invite");
  const [currentHistory, setCurrentHistory] =
    useState<HistoryOption>("invited");
  const [isEncrypted, setIsEncrypted] = useState(false);

  const [selectedAccess, setSelectedAccess] = useState<AccessOption>("invite");
  const [selectedHistory, setSelectedHistory] =
    useState<HistoryOption>("invited");
  const [pendingEncryption, setPendingEncryption] = useState(false);

  const hasChanges = useMemo(
    () =>
      selectedAccess !== currentAccess ||
      selectedHistory !== currentHistory ||
      pendingEncryption,
    [
      selectedAccess,
      currentAccess,
      selectedHistory,
      currentHistory,
      pendingEncryption,
    ],
  );

  useEffect(() => {
    room
      .roomInfo()
      .then((info) => {
        const access: AccessOption =
          info.joinRule?.tag === JoinRule_Tags.Public ? "public" : "invite";
        setCurrentAccess(access);
        setSelectedAccess(access);

        const history: HistoryOption =
          info.historyVisibility?.tag === RoomHistoryVisibility_Tags.Joined
            ? "joined"
            : "invited";
        setCurrentHistory(history);
        setSelectedHistory(history);

        setIsEncrypted(info.encryptionState === EncryptionState.Encrypted);
      })
      .catch(console.error)
      .finally(() => setIsLoading(false));
  }, [room]);

  const handleSave = async () => {
    setIsSaving(true);
    try {
      if (selectedAccess !== currentAccess) {
        await RoomService.updateRoomJoinRule(
          room.id(),
          selectedAccess === "public",
        );
      }

      if (selectedHistory !== currentHistory) {
        await RoomService.updateRoomHistoryVisibility(
          room.id(),
          selectedHistory,
        );
      }

      if (pendingEncryption) {
        await RoomService.enableRoomEncryption(room.id());
      }

      navigation.goBack();
    } catch (error) {
      console.error("Failed to save security settings:", error);
    } finally {
      setIsSaving(false);
    }
  };

  if (isLoading) return <Loading />;

  return (
    <ScreenLayout>
      {isSaving && <Loading text="Saving..." />}
      <Block flex={1} scrollable>
        <GoBackHeader
          title="Security & Privacy"
          rightComp={
            hasChanges && (
              <Button.Wrapper onPress={handleSave} disabled={isSaving}>
                <Text>Save</Text>
              </Button.Wrapper>
            )
          }
        />

        <Block gap={20}>
          <Block>
            <Text
              size={TextSize.small}
              color={Colors.white50}
              margins={{ marginBottom: 8, marginLeft: 4 }}
            >
              Access
            </Text>
            <Block border={{ borderRadius: 16 }} background={Colors.white5}>
              <Button.Wrapper onPress={() => setSelectedAccess("public")}>
                <Block paddings={[0, 12]}>
                  <Block
                    flexDirection="row"
                    align="center"
                    gap={12}
                    paddings={[20, 0]}
                    border={{
                      borderBottomWidth: 1,
                      borderColor: Colors.white5,
                    }}
                  >
                    <Block flex={1} flexDirection="row" align="center" gap={12}>
                      <Image source={require("assets/icons/globe.png")} />
                      <Block>
                        <Text>Anyone</Text>
                        <Text size={TextSize.tiny} color={Colors.white50}>
                          Anyone can join.
                        </Text>
                      </Block>
                    </Block>
                    {selectedAccess === "public" && (
                      <Image
                        source={require("assets/icons/check.png")}
                        style={styles.checkIcon}
                        tintColor={Colors.success}
                      />
                    )}
                  </Block>
                </Block>
              </Button.Wrapper>
              <Button.Wrapper onPress={() => setSelectedAccess("invite")}>
                <Block paddings={[0, 12]}>
                  <Block
                    flexDirection="row"
                    align="center"
                    gap={12}
                    paddings={[20, 0]}
                  >
                    <Block flex={1} flexDirection="row" align="center" gap={12}>
                      <Image source={require("assets/icons/lock-simple.png")} />
                      <Block>
                        <Text>Invite only</Text>
                        <Text size={TextSize.tiny} color={Colors.white50}>
                          Only invited people can join.
                        </Text>
                      </Block>
                    </Block>
                    {selectedAccess === "invite" && (
                      <Image
                        source={require("assets/icons/check.png")}
                        style={styles.checkIcon}
                        tintColor={Colors.success}
                      />
                    )}
                  </Block>
                </Block>
              </Button.Wrapper>
            </Block>
          </Block>

          <Block>
            <Text
              size={TextSize.small}
              color={Colors.white50}
              margins={{ marginBottom: 8, marginLeft: 4 }}
            >
              Encryption
            </Text>
            <RadioButton
              checked={isEncrypted || pendingEncryption}
              disabled={isEncrypted}
              label="Enable end-to-end encryption"
              onToggle={() => {
                setPendingEncryption(true);
              }}
            />
            <Block
              flexDirection="row"
              gap={4}
              margins={{ marginTop: 8 }}
              paddings={[0, 12]}
            >
              <Image
                style={styles.infoIcon}
                source={require("assets/icons/info.png")}
                tintColor={Colors.white50}
              />
              <Text size={TextSize.tiny} color={Colors.white50} flex={1}>
                Once enabled, encryption cannot be disabled.
              </Text>
            </Block>
          </Block>

          <Block>
            <Text
              size={TextSize.small}
              color={Colors.white50}
              margins={{ marginBottom: 8, marginLeft: 4 }}
            >
              Who can read history
            </Text>
            <Block border={{ borderRadius: 16 }} background={Colors.white5}>
              <Button.Wrapper onPress={() => setSelectedHistory("joined")}>
                <Block paddings={[0, 12]}>
                  <Block
                    flexDirection="row"
                    align="center"
                    gap={12}
                    paddings={[20, 0]}
                    border={{
                      borderBottomWidth: 1,
                      borderColor: Colors.white5,
                    }}
                  >
                    <Text flex={1}>Members (full history)</Text>
                    {selectedHistory === "joined" && (
                      <Image
                        source={require("assets/icons/check.png")}
                        style={styles.checkIcon}
                        tintColor={Colors.success}
                      />
                    )}
                  </Block>
                </Block>
              </Button.Wrapper>
              <Button.Wrapper onPress={() => setSelectedHistory("invited")}>
                <Block paddings={[0, 12]}>
                  <Block
                    flexDirection="row"
                    align="center"
                    gap={12}
                    paddings={[20, 0]}
                  >
                    <Text flex={1}>Members only since they were invited</Text>
                    {selectedHistory === "invited" && (
                      <Image
                        source={require("assets/icons/check.png")}
                        style={styles.checkIcon}
                        tintColor={Colors.success}
                      />
                    )}
                  </Block>
                </Block>
              </Button.Wrapper>
            </Block>
          </Block>
        </Block>
      </Block>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  checkIcon: {
    width: 20,
    height: 20,
  },
  infoIcon: {
    width: 16,
    height: 16,
  },
});
