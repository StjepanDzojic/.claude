import { Block, Text } from "@prototyp/skeletor";
import { useIsFocused } from "@react-navigation/native";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { FlashList } from "@shopify/flash-list";
import {
  MembershipState_Tags,
  PowerLevel_Tags,
  type RoomMember,
} from "@unomed/react-native-matrix-sdk";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { NavigationContainerRef } from "modules/navigation/const";
import { useRoomMembers } from "modules/room/hooks";
import { RoomService } from "modules/room/service/RoomService";
import { useCallback, useEffect, useMemo, useState } from "react";
import { Image, StyleSheet } from "react-native";
import { Button, Loading, MemberDetailsBottomSheet } from "shared/components";
import { GoBackHeader } from "shared/components/go-back-header/GoBackHeader";
import { ScreenLayout } from "shared/components/screen-layout/ScreenLayout";
import { UserImage } from "shared/components/user-image/UserImage";
import { useMemberDetails } from "shared/hooks";
import { Colors, TextSize } from "shared/styles";
import { getLevelLabel } from "shared/utils";

type SectionHeader = { type: "header"; title: string };
type SectionItem = { type: "member"; member: RoomMember };
type ListItem = SectionHeader | SectionItem;

const getRolePriority = (member: RoomMember) => {
  if (member.powerLevel.tag !== PowerLevel_Tags.Value) return 2;

  const levelLabel = getLevelLabel(Number(member.powerLevel.inner.value));
  if (levelLabel === "Admin") return 0;
  if (levelLabel === "Moderator") return 1;
  return 2;
};

const sortMembers = (a: RoomMember, b: RoomMember) => {
  const priorityDiff = getRolePriority(a) - getRolePriority(b);
  if (priorityDiff !== 0) return priorityDiff;

  const aName = (a.displayName ?? a.userId).trim();
  const bName = (b.displayName ?? b.userId).trim();
  return aName.localeCompare(bName, undefined, { sensitivity: "base" });
};

export const RoomMembers: React.FC<
  NativeStackScreenProps<Routes, "roomMembers">
> = ({ route }) => {
  const { roomId } = route.params;
  const room = useMemo(() => RoomService.getRoomInfo(roomId), [roomId]);
  const { members, isLoading, fetchMembers } = useRoomMembers(
    room ?? undefined,
  );
  const [canInvite, setCanInvite] = useState(false);
  const isFocused = useIsFocused();
  const {
    selectedMember,
    isBottomSheetOpen,
    openMemberDetails,
    closeMemberDetails,
  } = useMemberDetails();

  const pendingMembers = useMemo(
    () =>
      members.filter(
        (member) => member.membership?.tag === MembershipState_Tags.Invite,
      ),
    [members],
  );
  const acceptedMembers = useMemo(
    () =>
      members
        .filter(
          (member) => member.membership?.tag === MembershipState_Tags.Join,
        )
        .sort(sortMembers),
    [members],
  );
  const bannedMembers = useMemo(
    () =>
      members.filter(
        (member) => member.membership?.tag === MembershipState_Tags.Ban,
      ),
    [members],
  );

  const listData = useMemo<ListItem[]>(() => {
    const items: ListItem[] = [];

    if (pendingMembers.length) {
      items.push({ type: "header", title: "Pending" });
      pendingMembers.forEach((member) =>
        items.push({ type: "member", member }),
      );
    }

    if (acceptedMembers.length) {
      items.push({
        type: "header",
        title: `${acceptedMembers.length} ${acceptedMembers.length === 1 ? "member" : "members"}`,
      });
      acceptedMembers.forEach((member) =>
        items.push({ type: "member", member }),
      );
    }

    if (bannedMembers.length) {
      items.push({ type: "header", title: "Banned" });
      bannedMembers.forEach((member) => items.push({ type: "member", member }));
    }

    return items;
  }, [pendingMembers, acceptedMembers, bannedMembers]);

  const handleMemberAction = useCallback(
    (_userId: string, _action: "remove" | "ban" | "unban") => {
      setTimeout(fetchMembers, 2000);
    },
    [fetchMembers],
  );

  const handleMemberPress = useCallback(
    (member: RoomMember) => {
      openMemberDetails({
        userId: member.userId,
        displayName: member.displayName ?? "Unknown",
        avatarUrl: member.avatarUrl ?? null,
        membershipTag: member.membership?.tag,
      });
    },
    [openMemberDetails],
  );

  useEffect(() => {
    if (!isFocused) return;
    fetchMembers();
  }, [isFocused, fetchMembers]);

  useEffect(() => {
    const checkInvitePermission = async () => {
      const myUserId = MatrixCore.instance?.userId();
      if (!myUserId) return;

      const powerLevels = await RoomService.getRoomPowerLevels(roomId);
      if (!powerLevels) return;

      const inviteLevel = Number(powerLevels.values().invite);
      const myLevel = Number(powerLevels.userPowerLevels().get(myUserId) ?? 0);
      setCanInvite(myLevel >= inviteLevel);
    };

    checkInvitePermission().catch(console.error);
  }, [roomId]);

  return (
    <ScreenLayout>
      {isLoading && <Loading text="Loading members..." />}
      <Block align="center" width="100%" flex={1}>
        <GoBackHeader
          title="Members"
          margins={0}
          rightComp={
            canInvite && (
              <Button.Wrapper
                onPress={() =>
                  NavigationContainerRef.navigate("invitePeople", {
                    roomId,
                    members,
                  })
                }
              >
                <Image
                  source={require("assets/icons/plus.png")}
                  tintColor={Colors.white}
                  width={24}
                  height={24}
                />
              </Button.Wrapper>
            )
          }
        />
        <FlashList
          data={listData}
          style={styles.container}
          contentContainerStyle={styles.contentContainer}
          getItemType={(item) => item.type}
          keyExtractor={(item) =>
            item.type === "header" ? `header-${item.title}` : item.member.userId
          }
          renderItem={({ item }) => {
            if (item.type === "header") {
              return (
                <Block margins={{ marginBottom: 8 }}>
                  <Text size={TextSize.tiny} color={Colors.white80}>
                    {item.title}
                  </Text>
                </Block>
              );
            }

            const { member } = item;
            return (
              <Button.Wrapper onPress={() => handleMemberPress(member)}>
                <Block
                  width="100%"
                  flexDirection="row"
                  align="center"
                  justify="space-between"
                  gap={12}
                  margins={{ marginBottom: 12 }}
                >
                  <Block flexDirection="row" align="center" gap={12} flex={1}>
                    <UserImage
                      avatarUrl={member.avatarUrl}
                      displayName={member.displayName}
                      width={40}
                      height={40}
                    />
                    <Block flex={1}>
                      <Text numberOfLines={1}>{member.displayName}</Text>
                      <Text
                        numberOfLines={1}
                        size={TextSize.tiny}
                        color={Colors.white50}
                      >
                        {member.userId}
                      </Text>
                    </Block>
                  </Block>
                  {member.powerLevel.tag === PowerLevel_Tags.Value &&
                    getLevelLabel(Number(member.powerLevel.inner.value)) !==
                      "Member" && (
                      <Block>
                        <Text color={Colors.white50}>
                          {getLevelLabel(Number(member.powerLevel.inner.value))}
                        </Text>
                      </Block>
                    )}
                </Block>
              </Button.Wrapper>
            );
          }}
        />
      </Block>
      <MemberDetailsBottomSheet
        isBottomSheetOpen={isBottomSheetOpen}
        selectedMember={selectedMember}
        roomId={roomId}
        onClose={closeMemberDetails}
        onMemberAction={handleMemberAction}
      />
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  container: {
    width: "100%",
    gap: 12,
    marginTop: 36,
    padding: 0,
  },
  contentContainer: {
    width: "100%",
    gap: 12,
  },
});
