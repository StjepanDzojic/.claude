import { Block, Text } from "@prototyp/skeletor";
import { useIsFocused } from "@react-navigation/native";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import type { UserProfile } from "@unomed/react-native-matrix-sdk";
import { useSetAtom } from "jotai";
import { NavigationContainerRef } from "modules/navigation/const";
import { TimelineAtoms } from "modules/timeline/jotai/atoms";
import { UserService } from "modules/user/service/UserService";
import { VerificationService } from "modules/verification/service/VerificationService";
import { useEffect, useState } from "react";
import { Image, StyleSheet } from "react-native";
import Toast from "react-native-toast-message";
import {
  Button,
  GoBackHeader,
  IpadScreenWrapper,
  Loading,
  ScreenLayout,
  UserImage,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";
import { ActionButtons, BlockUserModal } from "./fragments";

export const Profile: React.FC<NativeStackScreenProps<Routes, "profile">> = ({
  route,
  navigation,
}) => {
  const { userId, initialProfile } = route.params;
  const isFocused = useIsFocused();
  const [loading, setLoading] = useState(!initialProfile);
  const [userProfile, setUserProfile] = useState<UserProfile | undefined>(
    initialProfile
      ? {
          userId,
          displayName: initialProfile.displayName,
          avatarUrl: initialProfile.avatarUrl,
        }
      : undefined,
  );
  const [isVerified, setIsVerified] = useState<boolean>(false);
  const [checkingVerification, setCheckingVerification] = useState(true);
  const [isLoading, setIsLoading] = useState(false);
  const [isBlockUserModalOpen, setIsBlockUserModalOpen] = useState(false);
  const [isUserBlocked, setIsUserBlocked] = useState(false);
  const setImageViewerPayload = useSetAtom(TimelineAtoms.imageViewerPayload);

  const handleBlockUser = async () => {
    try {
      setIsLoading(true);

      if (isUserBlocked) await UserService.unblockUser(userId);
      else await UserService.blockUser(userId);

      Toast.show({
        type: "success",
        text1: isUserBlocked
          ? "User unblocked successfully"
          : "User blocked successfully",
      });

      navigation.goBack();
    } catch (error) {
      console.error(error);
      offlineToastHelper("Failed to block user");
    } finally {
      setIsLoading(false);
    }
  };

  const handleConfirmBlockUser = () => {
    setIsBlockUserModalOpen(false);
    handleBlockUser();
  };

  useEffect(() => {
    if (!isFocused) return;

    UserService.getUserProfile(userId)
      .then(setUserProfile)
      .catch(console.error)
      .finally(() => setLoading(false));

    VerificationService.isUserVerified(userId)
      .then(setIsVerified)
      .catch(console.error)
      .finally(() => setCheckingVerification(false));

    UserService.isUserBlocked(userId)
      .then(setIsUserBlocked)
      .catch(console.error);
  }, [userId, isFocused]);

  if (loading || !userProfile) return <Loading />;

  return (
    <ScreenLayout>
      {isLoading && (
        <Loading
          text={isUserBlocked ? "Unblocking user..." : "Blocking user..."}
        />
      )}
      <GoBackHeader margins={{ marginBottom: 40 }} />
      <IpadScreenWrapper flex={1} gap={40} scrollable>
        <Block align="center" gap={12}>
          <UserImage
            avatarUrl={userProfile?.avatarUrl}
            displayName={userProfile?.displayName}
            width={120}
            height={120}
            borderRadius={999}
            onPress={(uri) => setImageViewerPayload({ uri })}
          />
          <Block flexDirection="row" align="center" gap={8}>
            <Text size={TextSize.large} font="InstrumentSans-Bold">
              {userProfile?.displayName}
            </Text>
          </Block>
          <Text color={Colors.white50}>{userProfile?.userId}</Text>
          {!checkingVerification && isVerified && (
            <Block
              flexDirection="row"
              gap={4}
              align="center"
              justify="center"
              paddings={[6, 8]}
              border={{
                borderRadius: 8,
                borderWidth: 1,
                borderColor: Colors.primary,
              }}
            >
              <Image
                source={require("assets/icons/shield-check.png")}
                tintColor={Colors.primary}
                width={16}
                height={16}
                style={styles.verifiedIcon}
              />
              <Text size={TextSize.small} color={Colors.primary}>
                Verified by you
              </Text>
            </Block>
          )}
        </Block>
        <ActionButtons userProfile={userProfile} />
        <Block background={Colors.white5} border={{ borderRadius: 16 }}>
          {!isVerified && (
            <Button.Wrapper
              onPress={() => {
                NavigationContainerRef.navigate("verifyUser", { userId });
              }}
            >
              <Block paddings={[0, 12]}>
                <Block
                  flexDirection="row"
                  align="center"
                  gap={12}
                  paddings={[20, 0]}
                >
                  <Image
                    source={require("assets/icons/lock.png")}
                    tintColor={Colors.white50}
                    width={24}
                    height={24}
                    style={styles.icon}
                  />

                  <Text color={Colors.white}>Verify user</Text>
                </Block>
              </Block>
            </Button.Wrapper>
          )}
          <Button.Wrapper onPress={() => setIsBlockUserModalOpen(true)}>
            <Block paddings={[0, 12]}>
              <Block
                flexDirection="row"
                align="center"
                gap={12}
                paddings={[20, 0]}
              >
                <Image
                  source={require("assets/icons/ban.png")}
                  tintColor={Colors.white50}
                  width={24}
                  height={24}
                  style={styles.icon}
                />

                <Text color={Colors.white}>
                  {isUserBlocked ? "Unblock user" : "Block user"}
                </Text>
              </Block>
            </Block>
          </Button.Wrapper>
        </Block>
        <BlockUserModal
          visible={isBlockUserModalOpen}
          onCancel={() => setIsBlockUserModalOpen(false)}
          onConfirm={handleConfirmBlockUser}
          isLoading={isLoading}
          isUserBlocked={isUserBlocked}
        />
      </IpadScreenWrapper>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  icon: {
    width: 24,
    height: 24,
  },
  verifiedIcon: {
    width: 16,
    height: 16,
  },
});
