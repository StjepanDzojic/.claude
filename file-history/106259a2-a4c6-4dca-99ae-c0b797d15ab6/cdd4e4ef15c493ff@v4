import { Block, useAnimateParallel } from "@prototyp/skeletor";
import { DebugHelpers } from "modules/matrix-client/helpers";
import { useEffect, useState } from "react";
import { Easing, StyleSheet } from "react-native";
import { useSafeAreaInsets } from "react-native-safe-area-context";
import { Colors } from "shared/styles";
import {
  Filters,
  Header,
  NewChatButton,
  NoRoomWrapper,
  ProtectAccountMessage,
  Rooms,
  Search,
  SecurityFilter,
} from "../index";

const SIDEBAR_WIDTH = 440;

export const IpadSidebar: React.FC = () => {
  const [search, setSearch] = useState<string>("");
  const insets = useSafeAreaInsets();

  const transition = useAnimateParallel(
    { translateX: [-SIDEBAR_WIDTH, 0], opacity: [0, 1] },
    { duration: 350, easing: Easing.out(Easing.cubic) },
  );

  useEffect(() => {
    setTimeout(() => {
      transition.start();
    }, 200);
  }, []);

  return (
    <Block
      absolute
      offsets={{ top: 0, left: 0, bottom: 0 }}
      paddings={{ paddingTop: insets.top, paddingBottom: insets.bottom }}
      width={SIDEBAR_WIDTH}
      background={Colors.black}
      border={{
        borderRightWidth: StyleSheet.hairlineWidth,
        borderRightColor: Colors.white10,
      }}
      animations={transition.animations}
    >
      <Header />
      <DebugHelpers />
      <ProtectAccountMessage />
      <NoRoomWrapper>
        <Filters />
        <Search search={search} setSearch={setSearch} />
        <SecurityFilter />
        <NewChatButton />
      </NoRoomWrapper>
      <Rooms search={search} />
    </Block>
  );
};
