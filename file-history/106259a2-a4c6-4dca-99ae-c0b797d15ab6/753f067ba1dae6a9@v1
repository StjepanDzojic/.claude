import {
  AuthData,
  AuthDataPasswordDetails,
  BackupDownloadStrategy,
  ClientBuilder,
  type Session,
  SlidingSyncVersion,
  SlidingSyncVersionBuilder,
} from "@unomed/react-native-matrix-sdk";
import { StorageAtoms } from "modules/storage/jotai/atoms";
import { deleteJotaiStorageAdapter } from "modules/storage/utils";
import RNFS from "react-native-fs";
import { clearEncryptedImageCache } from "shared/utils/encrypted-image-cache";
import { clearEncryptedVideoCache } from "shared/utils/encrypted-video-cache";
import { clearImageCache } from "shared/utils/image-caching";
import { clearMediaEncryptionKey } from "shared/utils/media-encryption";
import { MatrixStorage } from "../../matrix-client/const";
import { MatrixJotaiStore } from "../../matrix-client/const/matrx-jotai-store";
import { MatrixAtoms, resetMatrixAtoms } from "../../matrix-client/jotai";
import { MatrixCore } from "../../matrix-client/services/MatrixCore";
import { PushNotificationsAtoms } from "../../push-notifications/jotai";
import { MatrixNotificationService } from "../../push-notifications/service/MatrixNotificationService";

type LoginWithUsernameAndPasswordData = {
  username: string;
  password: string;
};

const dataPath = `${RNFS.DocumentDirectoryPath}/matrix/data`;
const cachePath = `${RNFS.CachesDirectoryPath}/matrix/cache`;

export class AuthService {
  private static async clearCryptoStore() {
    try {
      const dataExists = await RNFS.exists(dataPath);
      const cacheExists = await RNFS.exists(cachePath);

      if (dataExists) {
        await RNFS.unlink(dataPath);
        console.log("Cleared crypto data store");
      }

      if (cacheExists) {
        await RNFS.unlink(cachePath);
        console.log("Cleared crypto cache store");
      }
    } catch (error) {
      console.warn("Failed to clear crypto store:", error);
    }
  }

  /** Full init for first login — does server discovery (requires network). */
  public static initialize = async (serverUrl: string) => {
    MatrixCore.instance = await new ClientBuilder()
      .serverNameOrHomeserverUrl(serverUrl)
      .sessionPaths(dataPath, cachePath)
      .autoEnableCrossSigning(true)
      .autoEnableBackups(false)
      .backupDownloadStrategy(BackupDownloadStrategy.AfterDecryptionFailure)
      .build();
  };

  /**
   * Offline-capable init for session restore.
   * Uses the exact homeserver URL + known username so no server discovery is needed.
   */
  private static initializeForRestore = async (
    homeserverUrl: string,
    userId: string,
  ) => {
    MatrixCore.instance = await new ClientBuilder()
      .homeserverUrl(homeserverUrl)
      .username(userId)
      .slidingSyncVersionBuilder(SlidingSyncVersionBuilder.Native)
      .sessionPaths(dataPath, cachePath)
      .autoEnableCrossSigning(true)
      .autoEnableBackups(false)
      .backupDownloadStrategy(BackupDownloadStrategy.AfterDecryptionFailure)
      .build();
  };

  public static hasStoredCredentials = (): boolean => {
    return MatrixStorage.hasStoredCredentials();
  };

  public static getServerName = () => MatrixCore.getServerName();

  public static getUser = () => {
    if (!MatrixCore.instance) return null;
    const userId = MatrixCore.instance.userId();
    return userId ? MatrixCore.instance.getProfile(userId) : null;
  };

  public static restoreSessionForBackground = async (): Promise<boolean> => {
    try {
      if (
        MatrixCore.instance &&
        MatrixNotificationService.getNotificationClient()
      )
        return true;

      const credentials = MatrixStorage.getLoginCredentials();
      if (!credentials) return false;

      // Use the same offline-safe init as foreground so the client is compatible
      // if the foreground reuses this instance (same file paths, same sync config).
      await this.initializeForRestore(credentials.baseUrl, credentials.userId);

      const client = MatrixCore.getClient();

      await client.restoreSession({
        accessToken: credentials.accessToken,
        refreshToken: credentials.refreshToken,
        userId: credentials.userId,
        deviceId: credentials.deviceId,
        homeserverUrl: credentials.baseUrl,
        oidcData: undefined,
        slidingSyncVersion: SlidingSyncVersion.Native,
      });

      await client.encryption().waitForE2eeInitializationTasks();

      await MatrixNotificationService.ensureNotificationClient();

      return true;
    } catch (error) {
      console.error("[Background] Failed to restore session:", error);
      return false;
    }
  };

  public static restoreSession = async (): Promise<boolean> => {
    try {
      const credentials = MatrixStorage.getLoginCredentials();
      if (!credentials) return false;

      // If the background handler already initialized and restored the client,
      // reuse it — creating a second client on the same file paths would
      // conflict with the existing native SDK file locks and cause a hang.
      if (!MatrixCore.instance) {
        // Use offline-capable init: direct homeserver URL + known username,
        // no server discovery needed.
        await this.initializeForRestore(
          credentials.baseUrl,
          credentials.userId,
        );

        const client = MatrixCore.getClient();

        await client.restoreSession({
          accessToken: credentials.accessToken,
          refreshToken: credentials.refreshToken,
          userId: credentials.userId,
          deviceId: credentials.deviceId,
          homeserverUrl: credentials.baseUrl,
          oidcData: undefined,
          slidingSyncVersion: SlidingSyncVersion.Native,
        });
      }

      const client = MatrixCore.getClient();

      // Profile fetch may fail when offline — don't block session restore on it.
      try {
        const profile = await client.getProfile(credentials.userId);
        MatrixJotaiStore.set(StorageAtoms.cachedProfile, profile);
      } catch {}

      // withOfflineMode() serves cached rooms immediately without waiting for network.
      MatrixCore.syncService = await client
        .syncService()
        .withOfflineMode()
        .finish();

      if (!MatrixCore.syncService) {
        throw new Error("Failed to initialize sync service");
      }

      MatrixJotaiStore.set(MatrixAtoms.matrixClient, MatrixCore.instance);
      MatrixJotaiStore.set(MatrixAtoms.syncService, MatrixCore.syncService);

      return true;
    } catch (error) {
      console.warn("Failed to restore session:", error);

      MatrixCore.instance = null;
      MatrixCore.syncService = null;

      MatrixJotaiStore.set(MatrixAtoms.matrixClient, null);
      MatrixJotaiStore.set(MatrixAtoms.syncService, null);

      return false;
    }
  };

  /** Start (or resume) the Matrix sync loop. No-op if the sync service is not ready. */
  public static startSync = async (): Promise<void> => {
    if (!MatrixCore.syncService) return;
    try {
      await MatrixCore.syncService.start();
    } catch (error) {
      console.warn("Failed to start sync:", error);
    }
  };

  /** Stop the Matrix sync loop. No-op if the sync service is not ready. */
  public static stopSync = async (): Promise<void> => {
    if (!MatrixCore.syncService) return;
    try {
      await MatrixCore.syncService.stop();
    } catch (error) {
      console.warn("Failed to stop sync:", error);
    }
  };

  public static setup = async (params: Session) => {
    await this.clearCryptoStore();

    if (MatrixCore.syncService) await MatrixCore.syncService.stop();
    MatrixCore.instance = null;
    MatrixCore.syncService = null;

    MatrixStorage.saveLoginCredentials({
      accessToken: params.accessToken,
      refreshToken: params.refreshToken,
      userId: params.userId,
      deviceId: params.deviceId,
      baseUrl: params.homeserverUrl,
    });

    await this.initialize(params.homeserverUrl);

    const client = MatrixCore.getClient();

    await client.restoreSession({
      accessToken: params.accessToken,
      refreshToken: params.refreshToken,
      userId: params.userId,
      deviceId: params.deviceId,
      homeserverUrl: params.homeserverUrl,
      oidcData: undefined,
      slidingSyncVersion: SlidingSyncVersion.Native,
    });

    try {
      const profile = await client.getProfile(params.userId);
      MatrixJotaiStore.set(StorageAtoms.cachedProfile, profile);
    } catch (error) {
      console.warn("Session validation failed:", error);
    }

    MatrixCore.syncService = await client.syncService().finish();

    if (!MatrixCore.syncService) {
      throw new Error("Failed to initialize sync service");
    }

    await MatrixCore.syncService.start();
    await client.encryption().waitForE2eeInitializationTasks();

    MatrixJotaiStore.set(MatrixAtoms.matrixClient, MatrixCore.instance);
    MatrixJotaiStore.set(MatrixAtoms.syncService, MatrixCore.syncService);
  };

  public static login = async ({
    username,
    password,
  }: LoginWithUsernameAndPasswordData) => {
    const client = MatrixCore.getClient();
    await client.login(username, password, undefined, undefined);
    const session = client.session();

    MatrixCore.instance = null;

    return session;
  };

  public static logout = async () => {
    // Remove pusher before clearing the session — needs an active Matrix client.
    // Ignore errors (user may be offline or permissions already revoked).
    const fcmToken = MatrixJotaiStore.get(PushNotificationsAtoms.token);
    if (fcmToken) {
      try {
        await MatrixNotificationService.removePusher(fcmToken);
      } catch {}
    }

    MatrixStorage.clearLoginCredentials();
    deleteJotaiStorageAdapter();
    await this.clearCryptoStore();
    await clearImageCache();
    await clearEncryptedImageCache();
    await clearEncryptedVideoCache();
    await clearMediaEncryptionKey();

    //Ignore both errors if it happens, the logout will still happen. These errors can happen if the user is offline.
    if (MatrixCore.syncService) {
      try {
        await MatrixCore.syncService.stop();
      } catch {}
    }
    if (MatrixCore.instance) {
      try {
        await MatrixCore.instance.logout();
      } catch {}
    }

    MatrixCore.instance = null;
    MatrixCore.syncService = null;

    resetMatrixAtoms();
  };

  public static canDeactivateAccount = (): boolean => {
    if (!MatrixCore.instance) return false;
    return MatrixCore.instance.canDeactivateAccount();
  };

  public static deactivateAccount = async (
    password: string,
    eraseData: boolean,
  ) => {
    const client = MatrixCore.getClient();

    // Step 1: attempt with no auth data. SSO / servers that don't require UIA
    // will succeed here. Return immediately — password is not needed.
    try {
      await client.deactivateAccount(undefined, eraseData);
      await this.logout();
      return;
    } catch {
      // Password-based server rejected the unauthenticated attempt. Fall through.
    }

    // Step 2: authenticate with the user-entered password.
    const userId = client.userId();
    if (!userId) throw new Error("User ID not found");

    const authData = new AuthData.Password({
      passwordDetails: AuthDataPasswordDetails.create({
        identifier: userId,
        password,
      }),
    });

    await client.deactivateAccount(authData, eraseData);
    await this.logout();
  };
}
