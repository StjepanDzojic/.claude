import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { RoomService } from "modules/room/service/RoomService";
import { useState } from "react";
import { SettingsListItem } from "screens/settings/fragments";
import { GoBackHeader, Loading, ScreenLayout } from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { ChangeMyRoleModal } from "./fragments/change-my-role-modal/ChangeMyRoleModal";

export const RoomRoles: React.FC<
  NativeStackScreenProps<Routes, "roomRoles">
> = ({ navigation, route }) => {
  const { room, userPowerLevel } = route.params;
  const [changeRoleVisible, setChangeRoleVisible] = useState(false);
  const [isDemoting, setIsDemoting] = useState(false);

  const handleDemoteMyRole = async (targetLevel: 0 | 50) => {
    setIsDemoting(true);
    setChangeRoleVisible(false);
    try {
      const myUserId = MatrixCore.instance?.userId();
      if (!myUserId) return;
      await RoomService.updateUserPowerLevels(room.id(), [
        { userId: myUserId, powerLevel: BigInt(targetLevel) },
      ]);
      navigation.pop(2); // go back to RoomTimeline
    } catch (error) {
      console.error("Failed to demote role:", error);
    } finally {
      setIsDemoting(false);
    }
  };

  return (
    <ScreenLayout>
      {isDemoting && <Loading text="Updating role..." />}
      <Block flex={1} scrollable>
        <GoBackHeader
          title="Roles & Permissions"
          margins={{ marginBottom: 40 }}
        />

        <Text
          size={TextSize.small}
          color={Colors.white50}
          margins={{ marginBottom: 8, marginLeft: 4 }}
        >
          Roles
        </Text>
        <Block
          border={{ borderRadius: 16 }}
          width="100%"
          background={Colors.white5}
          margins={{ marginBottom: 20 }}
        >
          <SettingsListItem
            title="Admins"
            icon={require("assets/icons/users.png")}
            showSeparator
            onPress={() =>
              navigation.navigate("manageRole", { room, targetLevel: 100 })
            }
          />
          <SettingsListItem
            title="Moderators"
            icon={require("assets/icons/users.png")}
            showSeparator
            onPress={() =>
              navigation.navigate("manageRole", { room, targetLevel: 50 })
            }
          />
          <SettingsListItem
            title="Change my role"
            icon={require("assets/icons/user.png")}
            showSeparator={false}
            onPress={() => setChangeRoleVisible(true)}
          />
        </Block>

        <Text
          size={TextSize.small}
          color={Colors.white50}
          margins={{ marginBottom: 8, marginLeft: 4 }}
        >
          Permissions
        </Text>
        <Block
          border={{ borderRadius: 16 }}
          width="100%"
          background={Colors.white5}
          margins={{ marginBottom: 20 }}
        >
          <SettingsListItem
            title="Permissions"
            icon={require("assets/icons/lock-key.png")}
            showSeparator={false}
            onPress={() =>
              navigation.navigate("roomPermissions", {
                room,
                userPowerLevel,
              })
            }
          />
        </Block>
      </Block>

      <ChangeMyRoleModal
        visible={changeRoleVisible}
        userPowerLevel={userPowerLevel}
        isLoading={isDemoting}
        onClose={() => setChangeRoleVisible(false)}
        onDemote={handleDemoteMyRole}
      />
    </ScreenLayout>
  );
};
