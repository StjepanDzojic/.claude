import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { RoomNotificationMode } from "@unomed/react-native-matrix-sdk";
import { useSetAtom } from "jotai";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { RoomAtoms } from "modules/room/jotai";
import { useEffect, useState } from "react";
import { Image, StyleSheet } from "react-native";
import { CheckButton, Loading, RadioButton } from "shared/components";
import { GoBackHeader } from "shared/components/go-back-header/GoBackHeader";
import { ScreenLayout } from "shared/components/screen-layout/ScreenLayout";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

export const RoomNotifications: React.FC<
  NativeStackScreenProps<Routes, "roomNotifications">
> = ({ route }) => {
  const { roomId } = route.params;
  const [notifications, setNotifications] = useState(false);
  const [notificationType, setNotificationType] = useState<
    "all" | "mentions" | "mute"
  >("all");
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const setRoomNotificationMode = useSetAtom(RoomAtoms.roomNotificationMode);

  useEffect(() => {
    const load = async () => {
      try {
        const client = MatrixCore.getClient();
        const notificationSettings = await client.getNotificationSettings();
        const mode =
          await notificationSettings.getUserDefinedRoomNotificationMode(roomId);

        if (mode === RoomNotificationMode.MentionsAndKeywordsOnly) {
          setNotifications(true);
          setNotificationType("mentions");
        } else if (mode === RoomNotificationMode.AllMessages) {
          setNotifications(true);
          setNotificationType("all");
        } else if (mode === RoomNotificationMode.Mute) {
          setNotifications(true);
          setNotificationType("mute");
        } else {
          setNotifications(false);
        }
      } catch (error) {
        console.error("Failed to load room notification mode:", error);
      } finally {
        setLoading(false);
      }
    };

    load();
  }, [roomId]);

  const handleNotificationsToggle = async () => {
    const newValue = !notifications;
    setNotifications(newValue);
    setSaving(true);

    try {
      const client = MatrixCore.getClient();
      const notificationSettings = await client.getNotificationSettings();

      if (newValue) {
        const mode =
          notificationType === "mentions"
            ? RoomNotificationMode.MentionsAndKeywordsOnly
            : notificationType === "mute"
              ? RoomNotificationMode.Mute
              : RoomNotificationMode.AllMessages;
        await notificationSettings.setRoomNotificationMode(roomId, mode);
        setRoomNotificationMode(mode);
      } else {
        await notificationSettings.restoreDefaultRoomNotificationMode(roomId);
        setRoomNotificationMode(null);
      }
    } catch (error) {
      console.error("Failed to toggle room notifications:", error);
      offlineToastHelper("Failed to toggle room notifications");
      setNotifications(!newValue);
    } finally {
      setSaving(false);
    }
  };

  const handleTypeChange = async (type: "all" | "mentions" | "mute") => {
    setNotificationType(type);
    setSaving(true);

    try {
      const client = MatrixCore.getClient();
      const notificationSettings = await client.getNotificationSettings();
      const mode =
        type === "mentions"
          ? RoomNotificationMode.MentionsAndKeywordsOnly
          : type === "mute"
            ? RoomNotificationMode.Mute
            : RoomNotificationMode.AllMessages;
      await notificationSettings.setRoomNotificationMode(roomId, mode);
      setRoomNotificationMode(mode);
    } catch (error) {
      console.error("Failed to update room notification type:", error);
      offlineToastHelper("Failed to update room notification type");
      setNotificationType(notificationType);
    } finally {
      setSaving(false);
    }
  };

  if (loading) return <Loading />;

  return (
    <ScreenLayout>
      <Block flex={1} align="center">
        <GoBackHeader title="Notifications" margins={{ marginBottom: 40 }} />
        <Block width="100%" margins={{ marginBottom: 20 }} gap={20}>
          <RadioButton
            checked={notifications}
            onToggle={handleNotificationsToggle}
            label="Allow custom settings"
            disabled={saving}
          />
          <Block flexDirection="row" gap={8} align="center">
            <Image
              source={require("assets/icons/info.png")}
              width={16}
              height={16}
              tintColor={Colors.white50}
              style={styles.infoIcon}
            />
            <Text size={TextSize.tiny} color={Colors.white50}>
              Enabling this option you can override your default settings
            </Text>
          </Block>
        </Block>
        {notifications ? (
          <Block width="100%" gap={8}>
            <Text
              size={TextSize.tiny}
              color={Colors.white50}
              paddings={[0, 12]}
            >
              Notify me for this chat
            </Text>
            <Block>
              <CheckButton
                checked={notificationType === "all"}
                onToggle={() => handleTypeChange("all")}
                label="All Messages"
                disabled={saving}
              />
              <CheckButton
                checked={notificationType === "mentions"}
                onToggle={() => handleTypeChange("mentions")}
                label="Mentions"
                disabled={saving}
              />
              <CheckButton
                checked={notificationType === "mute"}
                onToggle={() => handleTypeChange("mute")}
                label="Mute"
                disabled={saving}
              />
            </Block>
          </Block>
        ) : (
          <Block width="100%" gap={8}>
            <Text
              margins={{ marginLeft: 12 }}
              size={TextSize.tiny}
              color={Colors.white50}
            >
              Default settings
            </Text>
            <Block
              flexDirection="row"
              align="center"
              justify="space-between"
              gap={12}
              border={{
                borderRadius: 16,
              }}
              paddings={12}
              background={Colors.white5}
              width="100%"
            >
              <Text>All messages</Text>
            </Block>
          </Block>
        )}
      </Block>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  infoIcon: {
    width: 16,
    height: 16,
  },
});
