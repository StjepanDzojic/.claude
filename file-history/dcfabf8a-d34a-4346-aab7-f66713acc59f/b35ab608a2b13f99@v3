import { Block, Text } from "@prototyp/skeletor";
import type { FC } from "react";
import { Colors } from "shared/styles";

interface Props {
  label: string;
  value: string;
  isLast?: boolean;
}

export const InfoRow: FC<Props> = ({ label, value, isLast }) => (
  <Block
    flexDirection="row"
    gap={12}
    align="flex-start"
    paddings={{ paddingTop: 12, paddingBottom: isLast ? 0 : 12 }}
    border={{ borderBottomWidth: isLast ? 0 : 1, borderColor: Colors.white5 }}
  >
    <Block width={60}>
      <Text color={Colors.white50}>{label}</Text>
    </Block>
    <Text color={Colors.white} flex={1} numberOfLines={3}>
      {value}
    </Text>
  </Block>
);
