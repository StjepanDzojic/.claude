import { useNavigation } from "@react-navigation/native";
import { useEffect } from "react";

export const usePreventSwipeBack = (isOpen: boolean) => {
  const navigation = useNavigation();

  useEffect(() => {
    try {
      if (isOpen) navigation.setOptions({ gestureEnabled: false });
      else navigation.setOptions({ gestureEnabled: true });
    } catch {
      // Consumer is not rendered within a screen (e.g. a modal mounted at
      // the navigation container root) — nothing to guard.
    }
  }, [isOpen, navigation]);
};
