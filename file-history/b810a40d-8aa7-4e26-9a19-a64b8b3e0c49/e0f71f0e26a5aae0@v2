import { Block, Text } from "@prototyp/skeletor";
import { EncryptionService } from "modules/encryption/service/EncryptionService";
import { SecureStoreKeys } from "modules/matrix-client/models";
import { type FC, useState } from "react";
import { Image, Modal, StyleSheet } from "react-native";
import { useMMKVBoolean } from "react-native-mmkv";
import Toast from "react-native-toast-message";
import { Button, Loading } from "shared/components";
import { MAX_MODAL_WIDTH } from "shared/const/max-modal-width";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

interface Props {
  visible: boolean;
  onClose: () => void;
}

export const DisableKeyStorageModal: FC<Props> = ({ visible, onClose }) => {
  const [isLoading, setIsLoading] = useState(false);
  const [_, setHasSeenProtectAccountMessage] = useMMKVBoolean(
    SecureStoreKeys.HAS_SEEN_PROTECT_ACCOUNT_MESSAGE,
  );

  const handleDeleteKeyStorage = async () => {
    try {
      setIsLoading(true);
      await EncryptionService.disableRecovery();
      // We want the user to see the protect account message again if they deleted the key storage
      setHasSeenProtectAccountMessage(false);
      Toast.show({
        text1: "Key storage deleted successfully",
        type: "success",
      });
    } catch (error) {
      console.error("Failed to delete key storage:", error);
      offlineToastHelper("Failed to delete key storage");
    } finally {
      setIsLoading(false);
      onClose();
    }
  };

  return (
    <Modal
      visible={visible}
      animationType="fade"
      statusBarTranslucent
      transparent
      presentationStyle="overFullScreen"
      onRequestClose={onClose}
    >
      {isLoading && <Loading text="Deleting key storage..." />}
      <Block
        width="100%"
        height="100%"
        justify="center"
        align="center"
        background={Colors.black70}
        paddings={[40, 20]}
      >
        <Block
          width="100%"
          background={Colors.blackMinus2}
          paddings={20}
          border={{ borderRadius: 36 }}
          gap={12}
          maxWidth={MAX_MODAL_WIDTH}
        >
          <Text size={TextSize.large} font="InstrumentSans-Bold">
            Are you sure you want to turn off key storage and delete it?
          </Text>

          <Text size={TextSize.small} color={Colors.white50}>
            Deleting key storage will remove your cryptographic identity and
            message keys from the server and turn off the following security
            features:
          </Text>

          <Block
            overflow="hidden"
            border={{ borderRadius: 16 }}
            margins={{ marginBottom: 20 }}
          >
            <Block
              gap={8}
              background={Colors.white5}
              paddings={12}
              border={{
                borderBottomWidth: 1,
                borderColor: Colors.white20,
              }}
              flexDirection="row"
            >
              <Image
                source={require("assets/icons/close.png")}
                style={styles.icon}
              />
              <Text flex={1} size={TextSize.small}>
                You will not have encrypted message history on new devices
              </Text>
            </Block>
            <Block
              flexDirection="row"
              gap={8}
              background={Colors.white5}
              paddings={12}
            >
              <Image
                source={require("assets/icons/close.png")}
                style={styles.icon}
              />
              <Text flex={1} size={TextSize.small}>
                You will lose access to your encrypted messages if you are
                signed out of Cloak everywhere
              </Text>
            </Block>
          </Block>

          <Block gap={8} flexDirection="row" width="100%">
            <Block flex={1}>
              <Button.Ghost disabled={isLoading} onPress={onClose} width="100%">
                Cancel
              </Button.Ghost>
            </Block>
            <Block flex={1}>
              <Button.Warning
                disabled={isLoading}
                onPress={handleDeleteKeyStorage}
                width="100%"
              >
                Delete key storage
              </Button.Warning>
            </Block>
          </Block>
        </Block>
      </Block>
    </Modal>
  );
};

const styles = StyleSheet.create({
  icon: {
    width: 16,
    height: 16,
  },
});
