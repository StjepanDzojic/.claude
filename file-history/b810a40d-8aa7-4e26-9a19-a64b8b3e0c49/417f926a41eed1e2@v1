import { Block, Text } from "@prototyp/skeletor";
import type { FC } from "react";
import { Modal } from "react-native";
import { Button } from "shared/components";
import { Colors, TextSize } from "shared/styles";

interface Props {
  visible: boolean;
  isLoading?: boolean;
  isUserBlocked?: boolean;
  onCancel: () => void;
  onConfirm: () => void;
}

export const BlockUserModal: FC<Props> = ({
  visible,
  isLoading = false,
  isUserBlocked = false,
  onCancel,
  onConfirm,
}) => {
  return (
    <Modal
      visible={visible}
      transparent
      presentationStyle="overFullScreen"
      animationType="fade"
    >
      <Block
        width="100%"
        height="100%"
        justify="center"
        align="center"
        background={Colors.black70}
        paddings={[40, 20]}
      >
        <Block
          width="100%"
          background={Colors.blackMinus2}
          paddings={20}
          border={{ borderRadius: 36 }}
          gap={12}
          maxWidth={600}
        >
          <Text size={TextSize.large}>
            {isUserBlocked ? "Unblock user" : "Block user"}
          </Text>
          <Text size={TextSize.small} color={Colors.white50}>
            {isUserBlocked
              ? "Unblocked users will be able to send you messages and all their messages will be shown."
              : "Blocked users won’t be able to send you messages and all their messages will be hidden. You can unblock them anytime."}
          </Text>

          <Block gap={8} flexDirection="row" width="100%">
            <Block flex={1}>
              <Button.Ghost
                onPress={onCancel}
                disabled={isLoading}
                width="100%"
              >
                Cancel
              </Button.Ghost>
            </Block>
            <Block flex={1}>
              <Button.Primary
                onPress={onConfirm}
                disabled={isLoading}
                width="100%"
              >
                {isUserBlocked ? "Unblock" : "Block"}
              </Button.Primary>
            </Block>
          </Block>
        </Block>
      </Block>
    </Modal>
  );
};
