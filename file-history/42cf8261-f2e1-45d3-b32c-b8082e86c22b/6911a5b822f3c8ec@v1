import {
  MessageLikeEventContent_Tags,
  type MessageType,
  MessageType_Tags,
  NotificationEvent_Tags,
  type NotificationItem,
  TimelineEventType_Tags,
} from "@unomed/react-native-matrix-sdk";
import { cleanMentions } from "modules/matrix-client/utils";
import { MatrixNotificationService } from "modules/push-notifications/service/MatrixNotificationService";

type FormattedNotification = {
  title: string;
  message: string;
  room_id: string;
};

/** Get the decrypted content of an encrypted event*/
export const getDecryptedEventContent = async (
  roomId: string,
  eventId: string,
): Promise<string | null> => {
  try {
    const notificationClient =
      MatrixNotificationService.getNotificationClient() ||
      (await MatrixNotificationService.ensureNotificationClient());
    if (!notificationClient) return null;

    const item = await MatrixNotificationService.getNotificationContent(
      roomId,
      eventId,
    );
    if (!item) return null;

    return getNotificationItemContent(item);
  } catch (error) {
    console.warn("Failed to get decrypted event content:", error);
    return null;
  }
};

const formatMessageType = (messageType: MessageType): string | null => {
  if (!messageType) return null;

  switch (messageType.tag) {
    case MessageType_Tags.Text:
    case MessageType_Tags.Emote:
    case MessageType_Tags.Notice:
      return cleanMentions(messageType.inner.content.body || "") || "Message";
    case MessageType_Tags.Image:
      return "📷 Image";
    case MessageType_Tags.Video:
      return "🎥 Video";
    case MessageType_Tags.Audio:
      return "🎵 Audio";
    case MessageType_Tags.File:
      return "📎 File";
    case MessageType_Tags.Location:
      return "📍 Location";
    case MessageType_Tags.Gallery:
      return "📷 Gallery";
    default:
      return null;
  }
};

const getNotificationItemContent = (item: NotificationItem): string | null => {
  if (item.event.tag !== NotificationEvent_Tags.Timeline) return null;

  const eventType = item.event.inner.event.eventType();
  if (eventType.tag !== TimelineEventType_Tags.MessageLike) return null;

  const content = eventType.inner.content;

  switch (content.tag) {
    case MessageLikeEventContent_Tags.RoomMessage:
      return formatMessageType(content.inner.messageType) || "Message";
    case MessageLikeEventContent_Tags.RoomEncrypted:
      return null;
    case MessageLikeEventContent_Tags.Sticker:
      return "🧩 Sticker";
    case MessageLikeEventContent_Tags.Poll:
      return "📊 Poll";
    case MessageLikeEventContent_Tags.ReactionContent:
      return "Reacted to a message";
    case MessageLikeEventContent_Tags.RoomRedaction:
      return "Message deleted";
    case MessageLikeEventContent_Tags.CallInvite:
    case MessageLikeEventContent_Tags.RtcNotification:
      return "Incoming call";
    case MessageLikeEventContent_Tags.CallHangup:
      return "Call ended";
    case MessageLikeEventContent_Tags.KeyVerificationReady:
    case MessageLikeEventContent_Tags.KeyVerificationCancel:
    case MessageLikeEventContent_Tags.KeyVerificationDone:
    case MessageLikeEventContent_Tags.KeyVerificationStart:
    case MessageLikeEventContent_Tags.KeyVerificationAccept:
    case MessageLikeEventContent_Tags.KeyVerificationKey:
    case MessageLikeEventContent_Tags.KeyVerificationMac:
      return null;
    default:
      return null;
  }
};

/** Check if a decrypted notification item is a verification protocol step (not the initial request) */
const isNotificationItemVerificationStep = (
  item: NotificationItem,
): boolean => {
  if (item.event.tag !== NotificationEvent_Tags.Timeline) return false;

  const eventType = item.event.inner.event.eventType();
  if (eventType.tag !== TimelineEventType_Tags.MessageLike) return false;

  const { tag } = eventType.inner.content;
  return (
    tag === MessageLikeEventContent_Tags.KeyVerificationReady ||
    tag === MessageLikeEventContent_Tags.KeyVerificationStart ||
    tag === MessageLikeEventContent_Tags.KeyVerificationAccept ||
    tag === MessageLikeEventContent_Tags.KeyVerificationKey ||
    tag === MessageLikeEventContent_Tags.KeyVerificationMac ||
    tag === MessageLikeEventContent_Tags.KeyVerificationCancel ||
    tag === MessageLikeEventContent_Tags.KeyVerificationDone ||
    tag === MessageLikeEventContent_Tags.ReactionContent
  );
};

/** Check if an encrypted event is a verification protocol step (should be suppressed) */
export const isDecryptedEventVerificationStep = async (
  roomId: string,
  eventId: string,
): Promise<boolean> => {
  try {
    const notificationClient =
      MatrixNotificationService.getNotificationClient() ||
      (await MatrixNotificationService.ensureNotificationClient());
    if (!notificationClient) return false;

    const item = await MatrixNotificationService.getNotificationContent(
      roomId,
      eventId,
    );
    if (!item) return false;

    return isNotificationItemVerificationStep(item);
  } catch (error) {
    console.warn(
      "Failed to check if decrypted event is verification step:",
      error,
    );
    return false;
  }
};

/** Check if a decrypted notification item should trigger CallKit (CallInvite or RtcNotification) */
const isNotificationItemCallInvite = (item: NotificationItem): boolean => {
  if (item.event.tag !== NotificationEvent_Tags.Timeline) return false;

  const eventType = item.event.inner.event.eventType();
  if (eventType.tag !== TimelineEventType_Tags.MessageLike) return false;

  const content = eventType.inner.content;

  if (MatrixNotificationService.isNotificationExpiredCall(item)) return false;

  return (
    content.tag === MessageLikeEventContent_Tags.CallInvite ||
    content.tag === MessageLikeEventContent_Tags.RtcNotification
  );
};

/** Check if a decrypted notification item is any call-related event (should be suppressed) */
const isNotificationItemAnyCallEvent = (item: NotificationItem): boolean => {
  if (item.event.tag !== NotificationEvent_Tags.Timeline) return false;

  const eventType = item.event.inner.event.eventType();
  if (eventType.tag !== TimelineEventType_Tags.MessageLike) return false;

  const { tag } = eventType.inner.content;

  return (
    tag === MessageLikeEventContent_Tags.CallInvite ||
    tag === MessageLikeEventContent_Tags.CallAnswer ||
    tag === MessageLikeEventContent_Tags.CallHangup ||
    tag === MessageLikeEventContent_Tags.CallCandidates ||
    tag === MessageLikeEventContent_Tags.RtcNotification
  );
};

const getNotificationItem = async (roomId: string, eventId: string) => {
  const notificationClient =
    MatrixNotificationService.getNotificationClient() ||
    (await MatrixNotificationService.ensureNotificationClient());
  if (!notificationClient) return null;
  return MatrixNotificationService.getNotificationContent(roomId, eventId);
};

/** Check if an encrypted event should trigger CallKit (CallInvite or RtcNotification only) */
export const isDecryptedEventCall = async (
  roomId: string,
  eventId: string,
): Promise<boolean> => {
  try {
    const item = await getNotificationItem(roomId, eventId);
    if (!item) return false;
    return isNotificationItemCallInvite(item);
  } catch (error) {
    console.warn("Failed to check if decrypted event is call:", error);
    return false;
  }
};

/** Check if an encrypted event is any call-related type (should be suppressed, not shown as notification) */
export const isDecryptedEventAnyCallEvent = async (
  roomId: string,
  eventId: string,
): Promise<boolean> => {
  try {
    const item = await getNotificationItem(roomId, eventId);
    if (!item) return false;
    return isNotificationItemAnyCallEvent(item);
  } catch (error) {
    console.warn("Failed to check if decrypted event is a call event:", error);
    return false;
  }
};

/** Format notification message content based on message type */
const formatMessageContent = (data: NotificationData): string => {
  const senderName = data.sender_display_name || data.sender || "Someone";
  const msgType = data.content_msgtype;

  switch (msgType) {
    case "m.text":
      return `${senderName}: ${cleanMentions(data.content_body || "") || "Message"}`;
    case "m.image":
      return `${senderName}: 📷 Image`;
    case "m.video":
      return `${senderName}: 🎥 Video`;
    case "m.audio":
      return `${senderName}: 🎵 Audio`;
    case "m.file":
      return `${senderName}: 📎 File`;
    case "m.location":
      return `${senderName}: 📍 Location`;
    case "m.emote":
      return `${senderName}: ${cleanMentions(data.content_body || "") || "Emote"}`;
    case "m.notice":
      return `${senderName}: ${cleanMentions(data.content_body || "") || "Notice"}`;
    default:
      return `${senderName}: ${cleanMentions(data.content_body || "") || "Message"}`;
  }
};

export const formatLocalPushNotificationMessage = (
  data: NotificationData | undefined,
): FormattedNotification | undefined => {
  if (!data) return;

  const senderName = data.sender_display_name || data.sender || "Unknown";
  const roomTitle = data.room_name || data.room_id || "Unknown Room";

  const make = (message: string): FormattedNotification => ({
    title: roomTitle,
    message,
    room_id: data.room_id,
  });

  // --- Message events ---

  if (data.type === "m.room.message") {
    return make(formatMessageContent(data));
  }

  if (data.type === "m.room.encrypted") {
    // Fallback — will be overridden if decryption succeeds
    return make(`${senderName}: 🔒 Encrypted message`);
  }

  if (data.type === "m.sticker") {
    return make(`${senderName}: 🧩 Sticker`);
  }
  if (data.type === "m.reaction") {
    return make(`${senderName} reacted to a message`);
  }
  if (data.type === "m.room.redaction") {
    return make(`${senderName} deleted a message`);
  }

  if (
    data.type === "m.poll.start" ||
    data.type === "org.matrix.msc3381.poll.start"
  ) {
    return make(`${senderName}: 📊 Poll`);
  }

  if (
    data.type === "m.poll.end" ||
    data.type === "org.matrix.msc3381.poll.end"
  ) {
    return make(`${senderName} ended a poll`);
  }

  // --- Membership events ---

  if (data.type === "m.room.member") {
    switch (data.membership) {
      case "invite":
        return {
          title: senderName,
          message: `${senderName} invited you to a room`,
          room_id: data.room_id || "",
        };
      case "join":
        return make(`${senderName} joined the room`);
      case "leave":
        return make(`${senderName} left the room`);
      case "ban":
        return make(`${senderName} was banned from the room`);
      case "kick":
        return make(`${senderName} was kicked from the room`);
      default:
        // Profile change — display name or avatar update, membership unchanged
        return make(`${senderName} changed their profile`);
    }
  }

  // --- Call events (suppress all — handled by CallKit / in-app call UI) ---
  if (
    data.type === "m.call.invite" ||
    data.type === "m.call.answer" ||
    data.type === "m.call.hangup" ||
    data.type === "m.call.candidates" ||
    data.type === "m.rtc.notification"
  ) {
    return;
  }

  return;
};
