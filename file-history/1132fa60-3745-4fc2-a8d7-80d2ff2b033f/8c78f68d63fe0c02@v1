import { FlashList } from "@shopify/flash-list";
import {
  MembershipState_Tags,
  type RoomMember,
  type UserProfile,
} from "@unomed/react-native-matrix-sdk";
import { UserService } from "modules/user/service/UserService";
import { type FC, useEffect, useMemo, useState } from "react";
import { Image, StyleSheet } from "react-native";
import { Input, Loading } from "shared/components";
import { Colors } from "shared/styles";
import { offlineToastHelper } from "shared/utils";
import { ListItemPerson } from "../list-item-person";

interface Props {
  members: RoomMember[];
  invitedPeople: UserProfile[];
  setInvitedPeople: (invitedPeople: UserProfile[]) => void;
}

const shouldIgnoreUser = (tag: MembershipState_Tags) =>
  tag === MembershipState_Tags.Join ||
  tag === MembershipState_Tags.Invite ||
  tag === MembershipState_Tags.Ban;

export const PeopleSearch: FC<Props> = ({
  members,
  invitedPeople,
  setInvitedPeople,
}) => {
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(false);
  const [allPeople, setAllPeople] = useState<UserProfile[]>([]);
  const listedPeople = useMemo(() => {
    return [
      ...invitedPeople,
      ...allPeople.filter(
        (p) =>
          !invitedPeople.some((i) => i.userId === p.userId) &&
          !members.some(
            (m) => m.userId === p.userId && shouldIgnoreUser(m.membership.tag),
          ),
      ),
    ];
  }, [invitedPeople, allPeople]);

  useEffect(() => {
    if (!search) {
      setAllPeople([]);
      return;
    }

    const timeoutId = setTimeout(async () => {
      try {
        setLoading(true);
        const people = await UserService.searchUsers(search);
        setAllPeople(people.results);
      } catch (error) {
        console.error(error);
        offlineToastHelper("Failed to search for people");
      } finally {
        setLoading(false);
      }
    }, 350);

    return () => clearTimeout(timeoutId);
  }, [search]);

  const handleInvitePerson = (p: UserProfile) => {
    if (!invitedPeople.some((i) => i.userId === p.userId)) {
      setInvitedPeople([...invitedPeople, p]);
    } else {
      setInvitedPeople(
        invitedPeople.filter(
          (invitedPerson) => invitedPerson.userId !== p.userId,
        ),
      );
    }
  };

  return (
    <>
      <Input
        placeholder="Search for someone"
        value={search}
        onChangeText={setSearch}
        background={Colors.white10}
        icon={
          <Image
            source={require("assets/icons/search.png")}
            width={12}
            height={12}
            style={styles.icon}
          />
        }
      />
      <FlashList
        contentContainerStyle={styles.list}
        ListFooterComponent={() => {
          if (loading) {
            return <Loading text="Searching..." isFullScreen={false} />;
          }

          return null;
        }}
        data={listedPeople}
        renderItem={({ item }) => (
          <ListItemPerson
            person={item}
            isSelected={invitedPeople.some(
              ({ userId }) => userId === item.userId,
            )}
            onPress={() => handleInvitePerson(item)}
          />
        )}
      />
    </>
  );
};

const styles = StyleSheet.create({
  icon: {
    width: 12,
    height: 12,
  },
  list: {
    marginTop: 40,
    gap: 12,
    paddingBottom: 100,
  },
});
