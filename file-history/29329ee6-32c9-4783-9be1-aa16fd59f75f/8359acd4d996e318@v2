import { Text } from "@prototyp/skeletor";
import type { FC, ReactNode } from "react";
import { Linking } from "react-native";
import { Colors, TextSize } from "shared/styles";
import { tokenizeLinks } from "shared/utils";

interface Props {
  body: string;
  mentionMap: Map<string, string>;
  onMentionPress?: (member: MemberDetailsPayload) => void;
}

const handleLinkPress = (url: string) => {
  Linking.openURL(url).catch(() => {});
};

const renderLinkified = (text: string, keyPrefix: string): ReactNode[] => {
  return tokenizeLinks(text).map((token, i) => {
    if (token.type === "link") {
      return (
        <Text
          key={`${keyPrefix}-${i}`}
          size={TextSize.small}
          font="InstrumentSans-Semibold"
          color={Colors.link}
          onPress={() => handleLinkPress(token.value)}
        >
          {token.value}
        </Text>
      );
    }
    return token.value;
  });
};

export const MentionText: FC<Props> = ({
  body,
  mentionMap,
  onMentionPress,
}) => {
  const escapedNames = Array.from(mentionMap.keys())
    .sort((a, b) => b.length - a.length)
    .map((name) => name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));

  const pattern = new RegExp(`@(${escapedNames.join("|")})`, "gi");
  const parts = body.split(pattern);

  return (
    <Text size={TextSize.small} color={Colors.white}>
      {parts.map((part, i) => {
        if (i % 2 === 1) {
          const userId = mentionMap.get(part.toLowerCase());
          if (userId) {
            return (
              <Text
                key={i}
                size={TextSize.small}
                font="InstrumentSans-Semibold"
                color={Colors.link}
                onPress={() =>
                  onMentionPress?.({
                    userId,
                    displayName: part,
                    avatarUrl: null,
                  })
                }
              >
                {`@${part}`}
              </Text>
            );
          }
        }
        return renderLinkified(part, `p${i}`);
      })}
    </Text>
  );
};
