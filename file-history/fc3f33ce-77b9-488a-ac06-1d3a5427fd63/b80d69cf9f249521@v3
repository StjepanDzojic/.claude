import { Block, Text } from "@prototyp/skeletor";
import {
  type EventTimelineItem,
  type ImageMessageContent,
  MessageType_Tags,
  MsgLikeKind_Tags,
  type RoomInterface,
  TimelineItemContent_Tags,
  type VideoMessageContent,
} from "@unomed/react-native-matrix-sdk";
import { useSetAtom } from "jotai";
import { getEventId } from "modules/matrix-client/utils";
import { TimelineAtoms } from "modules/timeline/jotai";
import { type FC, useMemo, useState } from "react";
import { StyleSheet } from "react-native";
import { useMediaTimeline } from "screens/room-media/hooks";
import { Button } from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { FilesList } from "../files-list";
import { MediaList } from "../media-list";

interface Props {
  room: RoomInterface;
}

type Tab = "media" | "files";

function isMediaItem(event: EventTimelineItem): boolean {
  if (event.content.tag === TimelineItemContent_Tags.MsgLike) {
    const kind = event.content.inner.content.kind;
    if (kind?.tag === MsgLikeKind_Tags.Message) {
      const tag = kind.inner.content.msgType?.tag;
      return tag === MessageType_Tags.Image || tag === MessageType_Tags.Video;
    }
  }
  return false;
}

function isFileItem(event: EventTimelineItem): boolean {
  if (event.content.tag === TimelineItemContent_Tags.MsgLike) {
    const kind = event.content.inner.content.kind;
    if (kind?.tag === MsgLikeKind_Tags.Message) {
      const tag = kind.inner.content.msgType?.tag;
      return tag === MessageType_Tags.File || tag === MessageType_Tags.Audio;
    }
  }
  return false;
}

export const MediaGallery: FC<Props> = ({ room }) => {
  const { mediaItems: allItems, loading, loadMore } = useMediaTimeline({
    room,
    roomId: room.id(),
  });
  const [activeTab, setActiveTab] = useState<Tab>("media");
  const mediaItems = useMemo(() => allItems.filter(isMediaItem), [allItems]);
  const fileItems = useMemo(() => allItems.filter(isFileItem), [allItems]);
  const isMediaEmpty = !mediaItems.length;
  const isFileEmpty = !fileItems.length;
  const setMediaViewerPayload = useSetAtom(TimelineAtoms.mediaViewerPayload);

  const handleSetActiveImageUri = (
    _uri: string | null,
    type?: "image" | "video",
    _content?: ImageMessageContent | VideoMessageContent,
    event?: EventTimelineItem,
  ) => {
    if (!type || !event) return;
    const eventId = getEventId(event);
    if (!eventId) return;
    setMediaViewerPayload({
      roomId: room.id(),
      initialEventId: eventId,
      initialEvent: event,
    });
  };

  return (
    <Block flex={1}>
      <Block flexDirection="row" margins={{ marginBottom: 16 }}>
        {(["media", "files"] as Tab[]).map((tab) => (
          <Button.Wrapper
            key={tab}
            onPress={() => setActiveTab(tab)}
            style={styles.tab}
          >
            <Block
              align="center"
              paddings={[10, 0]}
              border={{
                borderBottomWidth: 2,
                borderBottomColor:
                  activeTab === tab ? Colors.primary : Colors.white20,
              }}
            >
              <Text
                size={TextSize.small}
                color={activeTab === tab ? Colors.white : Colors.white50}
                textTransform="capitalize"
              >
                {tab}
              </Text>
            </Block>
          </Button.Wrapper>
        ))}
      </Block>

      {activeTab === "media" ? (
        <Block flex={1}>
          <MediaList
            items={mediaItems}
            loading={loading}
            isEmpty={isMediaEmpty}
            onPressItem={handleSetActiveImageUri}
            onEndReached={loadMore}
          />
        </Block>
      ) : (
        <FilesList
          items={fileItems}
          loading={loading}
          isEmpty={isFileEmpty}
          onEndReached={loadMore}
        />
      )}
    </Block>
  );
};

const styles = StyleSheet.create({
  tab: {
    flex: 1,
  },
});
