import { atom } from "jotai";

/** One atom; two sheets subscribe. isFailedEcho(payload.event) routes between
MessageContentBottomSheet (normal) and FailedEchoBottomSheet (send failed).  */
const longPressPayload = atom<TimelineLongPressPayload | null>(null);
const replyPayload = atom<TimelineReplyPayload | null>(null);
const editPayload = atom<TimelineEditPayload | null>(null);
const forwardPayload = atom<TimelineLongPressPayload | null>(null);
const reportPayload = atom<TimelineReportPayload | null>(null);
const scrollToEventId = atom<string | null>(null);
const seenByUsers = atom<TimelineSeenByUser[] | null>(null);
const reactionsPayload = atom<TimelineReaction[] | null>(null);
const imageViewerPayload = atom<ImageViewerPayload | null>(null);
const imageInfoPayload = atom<ImageInfoPayload | null>(null);
const videoViewerPayload = atom<VideoViewerPayload | null>(null);
const videoInfoPayload = atom<VideoInfoPayload | null>(null);
const pinnedEventIds = atom<string[]>([]);
const shieldPayload = atom<TimelineShieldPayload | null>(null);

export const TimelineAtoms = {
  longPressPayload,
  replyPayload,
  editPayload,
  forwardPayload,
  reportPayload,
  scrollToEventId,
  seenByUsers,
  reactionsPayload,
  imageViewerPayload,
  imageInfoPayload,
  videoViewerPayload,
  videoInfoPayload,
  pinnedEventIds,
  shieldPayload,
};
