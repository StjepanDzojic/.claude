import { useAtomValue } from "jotai";
import { TimelineAtoms } from "modules/timeline/jotai";
import type { FC } from "react";
import { MediaViewerModalContent } from "./MediaViewerModalContent";

export const MediaViewerModal: FC = () => {
  const payload = useAtomValue(TimelineAtoms.mediaViewerPayload);
  if (!payload) return null;
  return <MediaViewerModalContent key={payload.initialEventId} payload={payload} />;
};
