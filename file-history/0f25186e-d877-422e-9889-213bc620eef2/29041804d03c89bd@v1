'use client';

import { useTranslations, useLocale } from 'next-intl';
import { useParams } from 'next/navigation';
import { Link, usePathname, useRouter } from 'modules/i18n/utils/navigation';
import Image from 'next/image';
import { cn } from 'lib/utils';

const NAV_ITEMS = [
  { href: '/' as const, key: 'home' },
  { href: '/services' as const, key: 'services' },
  { href: '/projects' as const, key: 'projects' },
  { href: '/team' as const, key: 'team' },
  { href: '/about' as const, key: 'about' },
  { href: '/contact' as const, key: 'contact' },
] satisfies Array<{
  href: '/' | '/services' | '/projects' | '/team' | '/about' | '/contact';
  key: string;
}>;

export function Nav() {
  const t = useTranslations('Nav');
  const locale = useLocale();
  const pathname = usePathname();
  const params = useParams();
  const router = useRouter();

  function switchLocale(next: string) {
    const href = (
      params && Object.keys(params).length > 0 ? { pathname, params } : pathname
    ) as any;
    router.replace(href, { locale: next });
  }

  function isActive(href: string) {
    if (href === '/') return pathname === '/';
    return pathname.startsWith(href);
  }

  return (
    <header className="sticky top-0 z-50 border-b border-rule bg-paper/85 backdrop-blur-[8px] backdrop-saturate-[140%]">
      <div className="max-w-[1440px] mx-auto px-[clamp(20px,4vw,64px)] py-[18px] flex items-center justify-between gap-8">
        <Link href="/" className="flex items-center gap-[10px]" aria-label="Hidroing">
          <Image
            src="/images/hidroing.png"
            alt="Hidroing"
            width={100}
            height={100}
          />
        </Link>

        <nav className="hidden md:flex items-center gap-8 text-[14px] font-medium tracking-[-0.01em]" aria-label="Primary">
          {NAV_ITEMS.map((item) => (
            <Link
              key={item.key}
              href={item.href}
              className={cn(
                'relative py-[6px] text-ink-2 transition-colors duration-150 hover:text-ink',
                isActive(item.href) && 'text-ink after:absolute after:left-0 after:right-0 after:bottom-[-2px] after:h-px after:bg-green'
              )}>
              {t(item.key)}
            </Link>
          ))}
        </nav>

        <div className="flex items-center gap-[18px]">
          <div
            className="inline-flex items-center border border-rule rounded-full p-[3px] bg-white font-mono text-[11px] tracking-[0.08em]"
            role="group"
            aria-label="Language">
            <button
              onClick={() => switchLocale('hr')}
              className={cn(
                'px-[10px] py-[5px] rounded-full cursor-pointer border-0 font-mono text-[11px] tracking-[0.08em] transition-none',
                locale === 'hr' ? 'bg-ink text-paper' : 'bg-transparent text-ink-3'
              )}>
              HR
            </button>
            <button
              onClick={() => switchLocale('en')}
              className={cn(
                'px-[10px] py-[5px] rounded-full cursor-pointer border-0 font-mono text-[11px] tracking-[0.08em] transition-none',
                locale === 'en' ? 'bg-ink text-paper' : 'bg-transparent text-ink-3'
              )}>
              EN
            </button>
          </div>
        </div>
      </div>
    </header>
  );
}
