import { Block, Text } from "@prototyp/skeletor";
import { MatrixBaseURL } from "modules/matrix-client/const";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { fetchMedia } from "modules/matrix-client/utils";
import { type FC, useCallback, useEffect, useRef, useState } from "react";
import { AppState, Image } from "react-native";
import { Colors, TextSize } from "shared/styles";
import {
  cacheImageWithKey,
  getCachedImagePathByURL,
  isCached,
} from "shared/utils/image-caching";
import { Button } from "../button";

interface Props {
  avatarUrl: string | null | undefined;
  displayName: string | undefined;
  height?: number;
  width?: number;
  borderRadius?: number;
  onPress?: (uri: string) => void;
}

//TODO: Add downloadWidth and downloadHeight for large images like profile in modal view
export const UserImage: FC<Props> = ({
  avatarUrl,
  displayName,
  height = 32,
  width = 32,
  borderRadius = 48,
  onPress,
}) => {
  const [uri, setUri] = useState<string | null>(null);
  const uriRef = useRef<string | null>(null);
  const textSize = () => {
    if (height < 20) return TextSize.xtiny;
    if (height < 28) return TextSize.tiny;
    if (height < 32) return TextSize.small;
    if (height < 40) return TextSize.base;
    if (height < 48) return TextSize.medium;
    if (height < 56) return TextSize.large;

    return TextSize.xlarge;
  };

  const resolveAvatar = useCallback(async () => {
    if (!avatarUrl) return;

    try {
      if (await isCached(avatarUrl)) {
        const cached = getCachedImagePathByURL(avatarUrl);
        uriRef.current = cached;
        setUri(cached);
        return;
      }
      const url = await fetchMedia({
        url: avatarUrl,
        width,
        height,
        serverUrl:
          MatrixCore.instance?.session().homeserverUrl || MatrixBaseURL,
      });
      if (!url) return;
      await cacheImageWithKey(avatarUrl, url);
      if (await isCached(avatarUrl)) {
        const cached = getCachedImagePathByURL(avatarUrl);
        uriRef.current = cached;
        setUri(cached);
      }
    } catch (e) {
      console.log(e);
    }
  }, [avatarUrl, width, height]);

  useEffect(() => {
    uriRef.current = null;
    setUri(null);
    resolveAvatar();
  }, [resolveAvatar]);

  // Retry on foreground if the initial fetch failed
  useEffect(() => {
    const subscription = AppState.addEventListener("change", (state) => {
      if (state === "active" && !uriRef.current && avatarUrl) {
        resolveAvatar();
      }
    });
    return () => subscription.remove();
  }, [avatarUrl, resolveAvatar]);

  if (uri) {
    const image = (
      <Image
        source={{ uri }}
        width={width}
        height={height}
        style={{
          width,
          height,
          borderRadius,
          borderWidth: 2,
          borderColor: Colors.white20,
        }}
      />
    );

    if (onPress) {
      return (
        <Button.Wrapper onPress={() => onPress(uri)}>{image}</Button.Wrapper>
      );
    }

    return image;
  }

  return (
    <Block
      width={width}
      height={height}
      border={{
        borderWidth: 1,
        borderColor: Colors.white20,
        borderRadius,
      }}
      background={Colors.white20}
      align="center"
      justify="center"
    >
      <Text size={textSize()} color={Colors.white50}>
        {displayName?.charAt(0).toUpperCase()}
      </Text>
    </Block>
  );
};
