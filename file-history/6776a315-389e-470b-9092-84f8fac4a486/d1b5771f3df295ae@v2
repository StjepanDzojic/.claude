import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { FlashList } from "@shopify/flash-list";
import type {
  EventTimelineItem,
  TaskHandleInterface,
  TimelineInterface,
} from "@unomed/react-native-matrix-sdk";
import {
  DateDividerMode,
  TimelineDiff_Tags,
  TimelineFilter,
  TimelineFocus,
  TimelineReadReceiptTracking,
} from "@unomed/react-native-matrix-sdk";
import { getEventId } from "modules/matrix-client/utils";
import { type FC, useCallback, useEffect, useRef, useState } from "react";
import { StyleSheet } from "react-native";
import { SingleMessageType } from "screens/room/fragments";
import { GoBackHeader, Loading } from "shared/components";
import { ScreenLayout } from "shared/components/screen-layout/ScreenLayout";
import { Colors, TextSize } from "shared/styles";

const keyExtractor = (item: EventTimelineItem) => {
  const eventId = item.eventOrTransactionId;
  if (eventId?.tag === "EventId") {
    return eventId.inner.eventId;
  }
  if (eventId?.tag === "TransactionId") {
    return eventId.inner.transactionId;
  }
  return String(item.timestamp);
};

export const PinnedEvents: FC<
  NativeStackScreenProps<Routes, "pinnedEvents">
> = ({ route }) => {
  const { room } = route.params;
  const [events, setEvents] = useState<EventTimelineItem[]>([]);
  const [loading, setLoading] = useState(true);
  const eventIdsRef = useRef<Set<string>>(new Set());
  const timelineRef = useRef<TimelineInterface | null>(null);

  const upsertEvents = useCallback((incoming: EventTimelineItem[]) => {
    setEvents((prev) => {
      const next = [...prev];
      for (const event of incoming) {
        const id = getEventId(event);
        if (!id || eventIdsRef.current.has(id)) continue;
        eventIdsRef.current.add(id);
        next.push(event);
      }
      return next.sort((a, b) => Number(b.timestamp) - Number(a.timestamp));
    });
  }, []);

  useEffect(() => {
    if (!room) return;

    setLoading(true);
    setEvents([]);
    eventIdsRef.current.clear();

    let listenerHandle: TaskHandleInterface | null = null;

    const initPinnedTimeline = async () => {
      try {
        const timeline = await room.timelineWithConfiguration({
          focus: new TimelineFocus.PinnedEvents({
            maxEventsToLoad: 100,
            maxConcurrentRequests: 10,
          }),
          filter: new TimelineFilter.All(),
          internalIdPrefix: "pinned_",
          dateDividerMode: DateDividerMode.Daily,
          trackReadReceipts: TimelineReadReceiptTracking.Disabled,
          reportUtds: false,
        });

        timelineRef.current = timeline;

        listenerHandle = await timeline.addListener({
          onUpdate: (diffs) => {
            diffs.forEach((diff) => {
              switch (diff.tag) {
                case TimelineDiff_Tags.Append: {
                  const items = diff.inner.values
                    .map((i) => i.asEvent())
                    .filter((i): i is EventTimelineItem => !!i);
                  if (items.length > 0) upsertEvents(items);
                  break;
                }
                case TimelineDiff_Tags.Insert:
                case TimelineDiff_Tags.PushFront:
                case TimelineDiff_Tags.PushBack: {
                  const ev = diff.inner.value.asEvent();
                  if (ev) upsertEvents([ev]);
                  break;
                }
                case TimelineDiff_Tags.Set: {
                  const ev = diff.inner.value.asEvent();
                  if (ev) {
                    const id = getEventId(ev);
                    if (!id) break;
                    setEvents((prev) => {
                      const idx = prev.findIndex(
                        (item) => getEventId(item) === id,
                      );
                      if (idx >= 0) {
                        const next = [...prev];
                        next[idx] = ev;
                        return next;
                      }
                      return prev;
                    });
                  }
                  break;
                }
                case TimelineDiff_Tags.Remove: {
                  const { index: removeIndex } = diff.inner;
                  setEvents((prev) => {
                    const removed = prev[removeIndex];
                    if (removed) {
                      const id = getEventId(removed);
                      if (id) eventIdsRef.current.delete(id);
                    }
                    return prev.filter((_, idx) => idx !== removeIndex);
                  });
                  break;
                }
                case TimelineDiff_Tags.Reset: {
                  const items = diff.inner.values
                    .map((i) => i.asEvent())
                    .filter((i): i is EventTimelineItem => !!i);
                  const seenIds = new Set<string>();
                  const newEvents: EventTimelineItem[] = [];
                  for (const event of items) {
                    const id = getEventId(event);
                    if (id && !seenIds.has(id)) {
                      seenIds.add(id);
                      newEvents.push(event);
                    }
                  }
                  eventIdsRef.current = seenIds;
                  setEvents(
                    newEvents.sort(
                      (a, b) => Number(b.timestamp) - Number(a.timestamp),
                    ),
                  );
                  break;
                }
                case TimelineDiff_Tags.Clear: {
                  eventIdsRef.current.clear();
                  setEvents([]);
                  break;
                }
                default:
                  break;
              }
            });
          },
        });

        setLoading(false);
      } catch (error) {
        console.error("Failed to initialize pinned events timeline:", error);
        setLoading(false);
      }
    };

    initPinnedTimeline();

    return () => {
      listenerHandle?.cancel?.();
      timelineRef.current = null;
    };
  }, [room, upsertEvents]);

  return (
    <ScreenLayout type="modal">
      <GoBackHeader title="Pinned Events" margins={{ marginBottom: 20 }} />
      <FlashList
        data={events}
        renderItem={({ item }) => {
          return (
            <Block paddings={{ paddingHorizontal: 16 }}>
              <SingleMessageType event={item} isPreviousSameSender={false} />
            </Block>
          );
        }}
        keyExtractor={keyExtractor}
        contentContainerStyle={styles.listContent}
        ListEmptyComponent={
          <Block align="center" justify="center" flex={1} paddings={40}>
            {loading ? (
              <Loading isFullScreen={false} />
            ) : (
              <Text size={TextSize.medium} color={Colors.white50}>
                No pinned events
              </Text>
            )}
          </Block>
        }
        showsVerticalScrollIndicator={false}
      />
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  listContent: {
    flexGrow: 1,
    paddingBottom: 20,
  },
});
