  blue: 'linear-gradient(180deg, oklch(0.78 0.05 235), oklch(0.52 0.11 235))',
  green: 'linear-gradient(180deg, oklch(0.78 0.07 155), oklch(0.5 0.12 155))',
  dark: 'linear-gradient(180deg, #2B2F2D, #14171A)',
};

const cornerColor: Record<PortraitVariant, string> = {
  default: 'text-ink/60',
  blue: 'text-white/80',
  green: 'text-white/80',
  dark: 'text-white/80',
};

function PersonCard({
  idx,
  name,
  role,
  bio,
  variant = 'default',
}: {
  idx: string;
  name: string;
  role: string;
  bio: string;
  variant?: PortraitVariant;
}) {
  return (
    <div className="grid gap-3.5">
      <div
        className="aspect-3/4 relative overflow-hidden rounded-sm before:content-[''] before:absolute before:inset-0 before:bg-[repeating-linear-gradient(135deg,rgba(0,0,0,0.03)_0_1px,transparent_1px_9px)] after:content-[''] after:absolute after:inset-[auto_20%_0_20%] after:h-[55%] after:bg-[linear-gradient(180deg,rgba(13,15,14,0.1),rgba(13,15,14,0.4))] after:rounded-[50%_50%_0_0/40%_40%_0_0]"
        style={{ background: portraitBg[variant] }}>
        <span
          className={cn(
            'absolute top-3.5 left-3.5 font-mono text-[10px] tracking-[0.08em]',
            cornerColor[variant],
          )}>
          {idx} / 08
