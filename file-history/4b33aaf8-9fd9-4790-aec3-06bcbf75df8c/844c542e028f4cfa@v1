import { Metadata } from 'next';
import { getTranslations } from 'next-intl/server';
import { useTranslations } from 'next-intl';
import { Link } from 'modules/i18n/utils/navigation';
import { Placeholder } from '@modules/shared/components/Placeholder';
import { SectionHeader } from '@modules/shared/components/SectionHeader';

interface Props {
  params: Promise<{ lang: string }>;
}

export async function generateMetadata(props: Props): Promise<Metadata> {
  const { lang } = await props.params;
  const t = await getTranslations({ locale: lang, namespace: 'Services' });
  return { title: t('seoTitle'), description: t('seoDescription') };
}

function Phase({
  idx,
  title,
  desc,
}: {
  idx: string;
  title: string;
  desc: string;
}) {
  return (
    <div className="grid grid-cols-[36px_1fr] gap-4 py-3.5 border-b border-rule-2 last:border-b-0 items-baseline">
      <div className="font-mono text-[11px] text-ink-4 tracking-[0.05em]">
        {idx}
      </div>
      <div>
        <div className="font-medium text-[15px] tracking-[-0.005em]">
          {title}
        </div>
        <div className="text-ink-3 text-[13px] mt-0.5 leading-normal">
          {desc}
        </div>
      </div>
    </div>
  );
}

