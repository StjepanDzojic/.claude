import { Block, Text } from "@prototyp/skeletor";
import Clipboard from "@react-native-clipboard/clipboard";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { RecoveryState } from "@unomed/react-native-matrix-sdk";
import { EncryptionService } from "modules/encryption/service/EncryptionService";
import { SecureStoreKeys } from "modules/matrix-client/models";
import { useEffect, useState } from "react";
import { Alert, Image, StyleSheet } from "react-native";
import { useMMKVBoolean } from "react-native-mmkv";
import Toast from "react-native-toast-message";
import {
  Button,
  IpadScreenWrapper,
  Loading,
  ScreenLayout,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

export const SetUpRecoveryKey: React.FC<
  NativeStackScreenProps<Routes, "setUpRecoveryKey">
> = ({ navigation, route }) => {
  const [recoveryKey, setRecoveryKey] = useState<string | null>(
    route.params?.initialKey ?? null,
  );
  const [isGeneratingRecoveryKey, setIsGeneratingRecoveryKey] = useState(false);
  const [isLoading, setIsLoading] = useState(true);
  const [recoveryState, setRecoveryState] = useState<RecoveryState>(
    RecoveryState.Unknown,
  );
  const [hasSeenProtectAccountMessage, setHasSeenProtectAccountMessage] =
    useMMKVBoolean(SecureStoreKeys.HAS_SEEN_PROTECT_ACCOUNT_MESSAGE);

  const recoveryKeyExists = recoveryState === RecoveryState.Enabled;

  const title = () => {
    if (recoveryKey) return "Recovery key";
    if (recoveryState === RecoveryState.Enabled) return "Change recovery key";
    if (recoveryState === RecoveryState.Disabled) {
      return "Set up a recovery key";
    }
    if (recoveryState === RecoveryState.Incomplete) {
      return "Enter existing recovery key and validate your device.";
    }
    return "Set up a recovery key";
  };

  const buttonText = () => {
    if (recoveryState === RecoveryState.Enabled) return "Change recovery key";
    if (recoveryState === RecoveryState.Incomplete) return "Enter existing key";
    if (recoveryState === RecoveryState.Disabled) {
      return "Set up a recovery key";
    }

    return "Set up a recovery key";
  };

  const handleGenerateRecoveryKey = async () => {
    try {
      setIsGeneratingRecoveryKey(true);

      let key: string;

      // Backup exists (whether Enabled or Incomplete)
      if (recoveryState === RecoveryState.Incomplete) {
        navigation.navigate("enterRecoveryKey");
        return;
      }

      if (recoveryKeyExists) key = await EncryptionService.resetRecoveryKey();
      else key = await EncryptionService.enableRecovery();

      setRecoveryKey(key);
      if (hasSeenProtectAccountMessage) return;
      setHasSeenProtectAccountMessage(true);
    } catch (error) {
      console.error(error);
      offlineToastHelper("Failed to generate recovery key");
    } finally {
      setIsGeneratingRecoveryKey(false);
    }
  };

  const handleCopyRecoveryKey = () => {
    if (!recoveryKey) return;
    Clipboard.setString(recoveryKey);
    Toast.show({
      text1: "Recovery key copied to clipboard",
      type: "success",
    });
  };

  const handleGoBack = () => {
    if (!recoveryKey) {
      navigation.goBack();
      return;
    }

    Alert.alert(
      "Have you saved the recovery key?",
      "You will not be able to access your new recovery key after this step.",
      [
        { text: "Cancel", style: "cancel" },
        { text: "Continue", onPress: () => navigation.goBack() },
      ],
    );
  };

  useEffect(() => {
    const taskHandle = EncryptionService.subscribeToRecoveryState((state) => {
      setRecoveryState(state);
      setIsLoading(false);
    });

    return () => {
      taskHandle.cancel();
    };
  }, []);

  return (
    <ScreenLayout type="modal">
      {isLoading && <Loading />}
      <IpadScreenWrapper align="center">
        <Image style={styles.image} source={require("assets/images/key.png")} />
        <Text
          textAlign="center"
          size={TextSize.large}
          margins={{ marginBottom: 8 }}
        >
          {title()}
        </Text>
        <Text
          textAlign="center"
          size={TextSize.small}
          color={Colors.white50}
          margins={{ marginBottom: 32 }}
        >
          Set up a recovery key so you can restore your encrypted messages if
          you lose access to this and other devices.
        </Text>
        {recoveryKey ? (
          <Block gap={20} width="100%">
            <Block flexDirection="row" align="center" justify="space-between">
              <Text flex={1} textAlign="left" size={TextSize.medium}>
                {recoveryKey}
              </Text>
              <Button.Wrapper onPress={handleCopyRecoveryKey}>
                <Image source={require("assets/icons/copy.png")} />
              </Button.Wrapper>
            </Block>
            <Text size={TextSize.tiny} color={Colors.white50}>
              Tap to copy recovery key
            </Text>
          </Block>
        ) : (
          <Block>
            {isGeneratingRecoveryKey ? (
              <Block>
                <Loading
                  text="Generating recovery key..."
                  isFullScreen={false}
                />
              </Block>
            ) : (
              <Button.Outline onPress={handleGenerateRecoveryKey}>
                {buttonText()}
              </Button.Outline>
            )}
          </Block>
        )}
        <Block
          margins={{ marginTop: "auto" }}
          width="100%"
          paddings={[0, 52]}
          gap={12}
        >
          {recoveryKey && (
            <Button.Outline
              size="medium"
              width="100%"
              onPress={handleCopyRecoveryKey}
            >
              <Image source={require("assets/icons/download.png")} />
              <Text size={TextSize.small}>Save Recovery Key</Text>
            </Button.Outline>
          )}
          <Button.Primary size="medium" width="100%" onPress={handleGoBack}>
            Done
          </Button.Primary>
        </Block>
      </IpadScreenWrapper>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  image: {
    marginBottom: 40,
  },
});
