import { Block, Text, useForm } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { RoomService } from "modules/room/service/RoomService";
import { useState } from "react";
import type { Asset } from "react-native-image-picker";
import {
  Button,
  GoBackHeader,
  Input,
  IpadScreenWrapper,
  Loading,
  ScreenLayout,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";
import { RoomTypeButton, UploadPhoto } from "./fragments";

type FormState = {
  imageUri: string | null;
  name: string;
  topic: string;
  type: "private" | "public";
};

export const CreateRoom: React.FC<
  NativeStackScreenProps<Routes, "createRoom">
> = ({ navigation }) => {
  const [loading, setLoading] = useState(false);
  const [selectedImage, setSelectedImage] = useState<Asset | null>(null);
  const form = useForm<FormState>(
    {
      imageUri: null,
      name: "",
      topic: "",
      type: "private",
    },
    {
      optional: ["topic", "imageUri"],
    },
  );

  const createRoom = async () => {
    const roomId = await RoomService.createRoom(
      form.state.name,
      form.state.type,
      selectedImage,
      form.state.topic,
    );

    return roomId;
  };

  const handleNext = async () => {
    if (!form.validateForm()) return;

    try {
      setLoading(true);
      const roomId = await createRoom();

      navigation.navigate("invitePeople", {
        roomId,
        members: [],
        isCreateRoom: true,
      });
    } catch (error) {
      console.error(error);
      offlineToastHelper("Failed to create room");
    } finally {
      setLoading(false);
    }
  };

  return (
    <ScreenLayout background={Colors.blackMinus1} type="modal">
      {loading && <Loading text="Creating room..." />}
      <GoBackHeader title="Create a room" margins={{ marginBottom: 40 }} />
      <IpadScreenWrapper>
        <Block gap={40} flex={1} scrollable>
          <UploadPhoto onImageSelected={setSelectedImage} />
          <Block gap={8}>
            <Text
              size={TextSize.tiny}
              color={Colors.white50}
              paddings={[0, 16]}
            >
              Room name
            </Text>
            <Input
              placeholder="Your chat name"
              value={form.state.name}
              autoCapitalize="none"
              onBlur={() => form.validate("name")}
              onChangeText={(value) => form.update("name", value)}
            />
            <Text
              color="red"
              opacity={form.validation.name === false ? 1 : 0}
              size={TextSize.tiny}
              paddings={[0, 16]}
              absolute
              offsets={{ bottom: -20 }}
            >
              Please enter a valid room name.
            </Text>
          </Block>
          <Block gap={8}>
            <Block
              flexDirection="row"
              align="center"
              justify="space-between"
              paddings={[0, 16]}
            >
              <Text size={TextSize.tiny} color={Colors.white50}>
                Topic
              </Text>
              <Text size={TextSize.tiny} color={Colors.white50}>
                Optional
              </Text>
            </Block>
            <Input
              placeholder="What is this room about?"
              value={form.state.topic}
              autoCapitalize="none"
              onBlur={() => form.validate("topic")}
              onChangeText={(value) => form.update("topic", value)}
            />
          </Block>
          <Block gap={10}>
            <Text
              paddings={[0, 16]}
              size={TextSize.tiny}
              color={Colors.white50}
            >
              Room visibility
            </Text>
            <Block gap={12}>
              <RoomTypeButton
                type="private"
                isSelected={form.state.type === "private"}
                onPress={() => form.update("type", "private")}
              />
              <RoomTypeButton
                type="public"
                isSelected={form.state.type === "public"}
                onPress={() => form.update("type", "public")}
              />
            </Block>
          </Block>
        </Block>
        <Block paddings={[40, 40, 0]}>
          <Button.Primary onPress={handleNext}>Next</Button.Primary>
        </Block>
      </IpadScreenWrapper>
    </ScreenLayout>
  );
};
