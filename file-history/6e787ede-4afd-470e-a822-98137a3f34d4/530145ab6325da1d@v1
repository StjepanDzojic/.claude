import { Block, Text } from "@prototyp/skeletor";
import { useIsFocused } from "@react-navigation/native";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import {
  MembershipState_Tags,
  StateEventType,
} from "@unomed/react-native-matrix-sdk";
import { useAtomValue, useSetAtom } from "jotai";
import { MatrixCore } from "modules/matrix-client/services/MatrixCore";
import { NetworkAtoms } from "modules/network/jotai";
import { useRoomInfo, useRoomMembers } from "modules/room/hooks";
import { RoomAtoms } from "modules/room/jotai";
import { RoomService } from "modules/room/service/RoomService";
import { TimelineAtoms } from "modules/timeline/jotai";
import { useCallback, useEffect, useMemo, useState } from "react";
import { Image, StyleSheet, Switch } from "react-native";
import { SettingsListItem } from "screens/settings/fragments";
import {
  Button,
  GoBackHeader,
  IpadScreenWrapper,
  Loading,
  RoomImage,
  ScreenLayout,
} from "shared/components";
import { useLeaveRoom } from "shared/hooks";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";
import { ActionButtons, EncryptionStatus, Topic } from "./fragments";
import { LeaveRoom } from "./leave-room/LeaveRoom";

export const RoomDetails: React.FC<
  NativeStackScreenProps<Routes, "roomDetails">
> = ({ navigation, route }) => {
  const { room } = route.params;
  const roomInfo = useRoomInfo(room);
  const isFocused = useIsFocused();
  const isOffline = useAtomValue(NetworkAtoms.isOffline);
  const isDirect = roomInfo?.isDirect;
  const hasPowerLevelToCall =
    roomInfo?.powerLevels?.canOwnUserSendState(StateEventType.CallMember) ??
    false;
  const { members, fetchMembers } = useRoomMembers(room);
  const { isLeavingRoom, leaveRoom } = useLeaveRoom(room, members, {
    onSuccess: () => {
      navigation.reset({
        index: 0,
        routes: [{ name: "home" }],
      });
    },
  });
  const [isFavorite, setIsFavorite] = useState(false);
  const [isFavoriteLoading, setIsFavoriteLoading] = useState(false);
  const [userPowerLevel, setUserPowerLevel] = useState<number | null>(null);
  const [nameLevel, setNameLevel] = useState(50);
  const [avatarLevel, setAvatarLevel] = useState(50);
  const [topicLevel, setTopicLevel] = useState(50);
  const [inviteLevel, setInviteLevel] = useState<number>(50);
  const setRoomNotificationMode = useSetAtom(RoomAtoms.roomNotificationMode);
  const setImageViewerPayload = useSetAtom(TimelineAtoms.imageViewerPayload);

  const canSeeRoles = useMemo(
    () => !!userPowerLevel && userPowerLevel >= 50,
    [userPowerLevel],
  );
  const canEditName = useMemo(
    () => (userPowerLevel ?? 0) >= nameLevel,
    [userPowerLevel, nameLevel],
  );
  const canEditAvatar = useMemo(
    () => (userPowerLevel ?? 0) >= avatarLevel,
    [userPowerLevel, avatarLevel],
  );
  const canEditTopic = useMemo(
    () => (userPowerLevel ?? 0) >= topicLevel,
    [userPowerLevel, topicLevel],
  );
  const canEditRoom = useMemo(
    () => !isDirect && (canEditName || canEditAvatar || canEditTopic),
    [isDirect, canEditName, canEditAvatar, canEditTopic],
  );
  const canInvite = useMemo(
    () => !isDirect && userPowerLevel !== null && userPowerLevel >= inviteLevel,
    [userPowerLevel, inviteLevel],
  );
  const pinnedEventIds = useAtomValue(TimelineAtoms.pinnedEventIds);
  const otherDirectMember = useMemo(() => {
    return members.filter(
      (member) => member.userId !== MatrixCore.instance?.userId(),
    )[0];
  }, [members]);
  const otherDirectMembersId = otherDirectMember?.userId;

  // Sync isFavourite from live roomInfo
  useEffect(() => {
    if (!roomInfo) return;
    setIsFavorite(roomInfo.isFavourite ?? false);
  }, [roomInfo?.isFavourite]);

  useEffect(() => {
    if (!isFocused) return;

    RoomService.getUserPowerLevel(room.id())
      .then(setUserPowerLevel)
      .catch(console.error);

    RoomService.getRoomPowerLevels(room.id())
      .then((pl) => {
        if (!pl) return;
        const vals = pl.values();
        setNameLevel(Number(vals.roomName));
        setAvatarLevel(Number(vals.roomAvatar));
        setTopicLevel(Number(vals.roomTopic));
        setInviteLevel(Number(vals.invite));
      })
      .catch(console.error);

    MatrixCore.getClient()
      .getNotificationSettings()
      .then((ns) => ns.getUserDefinedRoomNotificationMode(room.id()))
      .then((mode) => setRoomNotificationMode(mode ?? null))
      .catch(console.error);
  }, [isFocused]);

  useEffect(() => {
    if (!isFocused) return;
    fetchMembers();
  }, [isFocused, fetchMembers]);

  const handleToggleFavourite = useCallback(async () => {
    if (isOffline) {
      offlineToastHelper("No internet connection");
      return;
    }

    if (isFavoriteLoading) return;
    setIsFavoriteLoading(true);
    setIsFavorite(!isFavorite);
    try {
      await room.setIsFavourite(!isFavorite, undefined);
    } catch (error) {
      setIsFavorite(isFavorite);
      console.error(error);
      offlineToastHelper(
        isFavorite
          ? "Failed to remove from favorites"
          : "Failed to add to favorites",
      );
    } finally {
      setIsFavoriteLoading(false);
    }
  }, [isFavorite, isOffline, isFavoriteLoading, room]);

  if (!roomInfo) return <Loading />;

  return (
    <ScreenLayout>
      {isLeavingRoom && <Loading text="Leaving room..." />}
      <GoBackHeader
        margins={{ marginBottom: 40 }}
        rightComp={
          canEditRoom && (
            <Button.Wrapper
              onPress={() =>
                navigation.navigate("editRoom", {
                  room,
                })
              }
            >
              <Text>Edit</Text>
            </Button.Wrapper>
          )
        }
      />
      <IpadScreenWrapper width="100%" scrollable>
        <Block align="center" gap={12}>
          <RoomImage
            onPress={(uri) => setImageViewerPayload({ uri })}
            room={room}
            width={80}
            height={80}
          />
          <Text size={TextSize.medium} font="InstrumentSans-Bold">
            {room.displayName()}
          </Text>
          {isDirect && roomInfo?.heroes[0]?.userId && (
            <Text color={Colors.white50}>{roomInfo?.heroes[0]?.userId}</Text>
          )}
          <EncryptionStatus roomInfo={roomInfo} />
        </Block>
        <ActionButtons
          room={room}
          members={members}
          hasPowerLevelToCall={hasPowerLevelToCall}
          canInvite={canInvite}
        />
        <Topic room={room} topic={roomInfo?.topic} canEdit={canEditTopic} />
        <Block
          border={{ borderRadius: 16 }}
          width="100%"
          background={Colors.white5}
          margins={{ marginBottom: 20 }}
        >
          <SettingsListItem
            title="Notifications"
            icon={require("assets/icons/bell.png")}
            showSeparator
            onPress={() =>
              navigation.navigate("roomNotifications", { roomId: room.id() })
            }
          />
          <SettingsListItem
            title="Favorite"
            icon={require("assets/icons/star.png")}
            showSeparator
            onPress={handleToggleFavourite}
            rightComp={
              <Block paddings={{ paddingRight: 12 }}>
                <Switch
                  value={isFavorite}
                  disabled={isFavoriteLoading}
                  trackColor={{ false: Colors.white20, true: Colors.success }}
                  thumbColor={Colors.white}
                  onValueChange={handleToggleFavourite}
                />
              </Block>
            }
          />
          {isDirect ? (
            <Button.Wrapper
              onPress={() =>
                navigation.navigate("profile", {
                  userId: otherDirectMembersId,
                  initialProfile: otherDirectMember
                    ? {
                        userId: otherDirectMember.userId,
                        displayName: otherDirectMember.displayName,
                        avatarUrl: otherDirectMember.avatarUrl,
                      }
                    : undefined,
                })
              }
            >
              <Block paddings={[0, 12]}>
                <Block
                  flexDirection="row"
                  align="center"
                  gap={12}
                  paddings={[20, 0]}
                  border={{ borderBottomWidth: 1, borderColor: Colors.white5 }}
                >
                  <Image
                    source={require("assets/icons/user.png")}
                    tintColor={Colors.white50}
                    width={24}
                    height={24}
                  />
                  <Text>View profile</Text>
                  <Block
                    margins={{ marginLeft: "auto" }}
                    flexDirection="row"
                    align="center"
                    gap={8}
                  >
                    <Image
                      source={require("assets/icons/caret-left.png")}
                      style={styles.caret}
                      tintColor={Colors.white50}
                    />
                  </Block>
                </Block>
              </Block>
            </Button.Wrapper>
          ) : (
            <Button.Wrapper
              onPress={() =>
                navigation.navigate("roomMembers", {
                  roomId: room.id(),
                })
              }
            >
              <Block paddings={[0, 12]}>
                <Block
                  flexDirection="row"
                  align="center"
                  gap={12}
                  paddings={[20, 0]}
                  border={{ borderBottomWidth: 1, borderColor: Colors.white5 }}
                >
                  <Image
                    source={require("assets/icons/users.png")}
                    tintColor={Colors.white50}
                    width={24}
                    height={24}
                  />
                  <Text>Members</Text>
                  <Block
                    margins={{ marginLeft: "auto" }}
                    flexDirection="row"
                    align="center"
                    gap={8}
                  >
                    <Text color={Colors.white50}>
                      (
                      {
                        members.filter(
                          (m) =>
                            m.membership?.tag === MembershipState_Tags.Join,
                        ).length
                      }
                      )
                    </Text>
                    <Image
                      source={require("assets/icons/caret-left.png")}
                      style={styles.caret}
                      tintColor={Colors.white50}
                    />
                  </Block>
                </Block>
              </Block>
            </Button.Wrapper>
          )}
          {!isDirect && canSeeRoles && (
            <SettingsListItem
              title="Security & Privacy"
              icon={require("assets/icons/shield.png")}
              showSeparator
              onPress={() => navigation.navigate("roomSecurity", { room })}
            />
          )}
          {!isDirect && canSeeRoles && (
            <SettingsListItem
              title="Roles & Permissions"
              icon={require("assets/icons/user.png")}
              showSeparator
              onPress={() =>
                navigation.navigate("roomRoles", {
                  room,
                  userPowerLevel: userPowerLevel ?? 0,
                })
              }
            />
          )}
          <SettingsListItem
            title="Media and Files"
            icon={require("assets/icons/image.png")}
            onPress={() => navigation.navigate("roomMedia", { room })}
            showSeparator={!!pinnedEventIds.length}
          />
          {!!pinnedEventIds.length && (
            <SettingsListItem
              title="Pinned events"
              icon={require("assets/icons/pin.png")}
              onPress={() => navigation.navigate("pinnedEvents", { room })}
            />
          )}
        </Block>
        <LeaveRoom onPress={leaveRoom} />
      </IpadScreenWrapper>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  caret: {
    transform: [{ rotate: "180deg" }],
    width: 24,
    height: 24,
    marginLeft: "auto",
  },
});
