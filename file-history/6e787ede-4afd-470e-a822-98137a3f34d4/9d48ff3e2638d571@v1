import { Block, InputFocusScrollView, Text, useForm } from "@prototyp/skeletor";
import { useIsFocused } from "@react-navigation/native";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { AuthService } from "modules/auth/service/AuthService";
import { MatrixBaseURL } from "modules/matrix-client/const";
import { useMemo, useState } from "react";
import { Image, StyleSheet } from "react-native";
import {
  Button,
  GoBackHeader,
  Input,
  IpadScreenWrapper,
  Loading,
  ScreenLayout,
} from "shared/components";
import { Colors, TextSize } from "shared/styles";
import { offlineToastHelper } from "shared/utils";

export const ServerSelect: React.FC<
  NativeStackScreenProps<Routes, "serverSelect">
> = ({ navigation }) => {
  const focused = useIsFocused();
  const serverName = useMemo(() => AuthService.getServerName(), [focused]);
  const form = useForm<{ domain: string }>({
    domain: serverName ?? MatrixBaseURL,
  });
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const validateDomain = async () => {
    setError(null);
    if (!form.validateForm()) return;
    setLoading(true);
    try {
      await AuthService.initialize(form.state.domain);
      navigation.goBack();
    } catch (error) {
      console.error("Invalid domain address", error);
      setError(
        "We couldn't reach this homeserver. Please check that you have entered the homeserver URL correctly. If the URL is correct, contact your homeserver administrator for further help.",
      );
      offlineToastHelper("Failed to validate domain");
    } finally {
      setLoading(false);
    }
  };

  return (
    <ScreenLayout type="modal">
      {loading && <Loading text="Loading" />}
      <GoBackHeader margins={0} />
      <InputFocusScrollView>
        {(focus) => (
          <IpadScreenWrapper justify="space-between">
            <Block gap={8} align="center">
              <Image
                source={require("assets/icons/server.png")}
                width={100}
                height={100}
                style={styles.image}
              />
              <Text size={TextSize.large} textAlign="center">
                Select your server
              </Text>

              <Text
                textAlign="center"
                font="InstrumentSans-Regular"
                color={Colors.white80}
              >
                What is the address of your server?
              </Text>
              <Block
                gap={8}
                width="100%"
                margins={{ marginTop: 32 }}
                paddings={[0, 32]}
              >
                <Text
                  size={TextSize.tiny}
                  color={Colors.white50}
                  paddings={[0, 16]}
                >
                  Homerserver URL
                </Text>
                <Input
                  placeholder="Enter domain address"
                  onBlur={() => form.validate("domain")}
                  onFocus={focus}
                  value={form.state.domain}
                  onChangeText={(value) => form.update("domain", value)}
                />
                {(form.validation.domain === false || error) && (
                  <Text color="red" size={TextSize.tiny} paddings={[0, 16]}>
                    {error
                      ? "We couldn't reach this homeserver. Please check that you have entered the homeserver URL correctly. If the URL is correct, contact your homeserver administrator for further help."
                      : "Please enter a valid domain address."}
                  </Text>
                )}
              </Block>
            </Block>
            <Block paddings={[0, 52]} gap={12}>
              <Button.Primary onPress={validateDomain} disabled={loading}>
                Continue
              </Button.Primary>
            </Block>
          </IpadScreenWrapper>
        )}
      </InputFocusScrollView>
    </ScreenLayout>
  );
};

const styles = StyleSheet.create({
  image: {
    width: 100,
    height: 100,
  },
});
