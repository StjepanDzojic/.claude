import { Metadata } from 'next';
import { getTranslations } from 'next-intl/server';
import { useTranslations } from 'next-intl';
import { Link } from 'modules/i18n/utils/navigation';

interface Props {
  params: Promise<{ lang: string }>;
}

export async function generateMetadata(props: Props): Promise<Metadata> {
  const { lang } = await props.params;
  const t = await getTranslations({ locale: lang, namespace: 'Team' });
  return { title: t('seoTitle'), description: t('seoDescription') };
}

type PortraitVariant = 'default' | 'blue' | 'green' | 'dark';

function PersonCard({ idx, name, role, bio, variant = 'default' }: {
  idx: string; name: string; role: string; bio: string; variant?: PortraitVariant;
}) {
  const variantClass: Record<PortraitVariant, string> = {
    default: 'person',
    blue: 'person blue',
    green: 'person green',
    dark: 'person dark',
  };

  return (
    <div className={variantClass[variant]}>
      <div className="portrait"><span className="corner">{idx} / 08</span></div>
      <div>
        <div className="n">{name}</div>
        <div className="r">{role}</div>
      </div>
      <div className="bio">{bio}</div>
    </div>
  );
}

