import { BottomSheetModalProvider } from "@gorhom/bottom-sheet";
import { Block, Text } from "@prototyp/skeletor";
import type { NativeStackScreenProps } from "@react-navigation/native-stack";
import { FlashList } from "@shopify/flash-list";
import type { UserProfile } from "@unomed/react-native-matrix-sdk";
import { resetToRoom } from "modules/navigation/utils";
import { RoomService } from "modules/room/service/RoomService";
import { UserService } from "modules/user/service/UserService";
import { useEffect, useState } from "react";
import {
  Image,
  type ImageSourcePropType,
  Share,
  StyleSheet,
} from "react-native";
import { JoinRoom } from "screens/join-room/JoinRoom";
import {
  Button,
  IpadScreenWrapper,
  Loading,
  ScreenLayout,
} from "shared/components";
import { Colors } from "shared/styles";
import { Header, SearchHeader, SendInviteBottomSheet } from "./fragments";

type Option = {
  id: string;
  label: string;
  image: ImageSourcePropType;
  type: keyof Routes;
};

const OPTIONS: Option[] = [
  {
    id: "1",
    label: "Create room",
    image: require("assets/icons/create-room.png"),
    type: "createRoom",
  },
  {
    id: "2",
    label: "Invite people",
    image: require("assets/icons/invite-people.png"),
    type: "invitePeople",
  },
  {
    id: "3",
    label: "Join room by address",
    image: require("assets/icons/create-room.png"),
    type: "joinRoom",
  },
];

export const StartChat: React.FC<
  NativeStackScreenProps<Routes, "startChat">
> = ({ navigation }) => {
  const [isJoinRoomBottomSheetOpen, setIsJoinRoomBottomSheetOpen] =
    useState(false);
  const [isInviteBottomSheetOpen, setIsInviteBottomSheetOpen] = useState(false);
  const [search, setSearch] = useState("");
  const [searchResults, setSearchResults] = useState<UserProfile[]>([]);
  const [isSearching, setIsSearching] = useState(false);
  const [selectedUser, setSelectedUser] = useState<UserProfile | null>(null);
  const [isCreatingChat, setIsCreatingChat] = useState(false);

  useEffect(() => {
    if (!search) {
      setSearchResults([]);
      return;
    }

    const timeoutId = setTimeout(async () => {
      try {
        setIsSearching(true);
        const people = await UserService.searchUsers(search);
        setSearchResults(people.results);
      } catch (error) {
        console.error(error);
      } finally {
        setIsSearching(false);
      }
    }, 350);

    return () => clearTimeout(timeoutId);
  }, [search]);

  const onPress = async (item: Option) => {
    if (item.type === "invitePeople") {
      Share.share({
        message:
          "Hey, I'm using Cloak and Dagger! Download it now: https://cloak.app",
      });
      return;
    }

    if (item.type === "createRoom") navigation.navigate("createRoom");

    if (item.type === "joinRoom") setIsJoinRoomBottomSheetOpen(true);
  };

  const handleUserPress = async (user: UserProfile) => {
    try {
      setIsSearching(true);
      const existingRoomId = await RoomService.getExistingDirectRoom(
        user.userId,
      );

      if (existingRoomId) {
        resetToRoom(existingRoomId);
        return;
      }

      setSelectedUser(user);
      setIsInviteBottomSheetOpen(true);
    } catch (error) {
      console.error(error);
    } finally {
      setIsSearching(false);
    }
  };

  const handleSendInvite = async () => {
    if (!selectedUser) return;

    try {
      setIsCreatingChat(true);
      const roomId = await RoomService.getOrCreateDirectRoom(
        selectedUser.userId,
      );
      setIsInviteBottomSheetOpen(false);
      resetToRoom(roomId);
    } catch (error) {
      console.error(error);
    } finally {
      setIsCreatingChat(false);
    }
  };

  return (
    <BottomSheetModalProvider>
      <ScreenLayout background={Colors.blackMinus1} type="modal">
        {(isSearching || isCreatingChat) && <Loading />}
        <Header />
        <IpadScreenWrapper>
          <FlashList
            contentContainerStyle={styles.wrapper}
            data={search ? [] : OPTIONS}
            ListHeaderComponent={
              <SearchHeader
                search={search}
                searchResults={searchResults}
                setSearch={setSearch}
                onUserPress={handleUserPress}
              />
            }
            renderItem={({ item }) => (
              <Button.Wrapper onPress={() => onPress(item)}>
                <Block
                  paddings={[20, 16]}
                  background={Colors.white5}
                  border={{ borderRadius: 12 }}
                  flexDirection="row"
                  align="center"
                  justify="space-between"
                >
                  <Block flexDirection="row" align="center" gap={8}>
                    <Image source={item.image} style={styles.image} />
                    <Text font="InstrumentSans-Bold">{item.label}</Text>
                  </Block>
                  <Image
                    source={require("assets/icons/caret-left.png")}
                    width={24}
                    height={24}
                    style={styles.caret}
                    tintColor={Colors.white50}
                  />
                </Block>
              </Button.Wrapper>
            )}
          />
        </IpadScreenWrapper>
        <JoinRoom
          isBottomSheetOpen={isJoinRoomBottomSheetOpen}
          setIsBottomSheetOpen={setIsJoinRoomBottomSheetOpen}
        />
        <SendInviteBottomSheet
          isBottomSheetOpen={isInviteBottomSheetOpen}
          selectedUser={selectedUser}
          isLoading={isCreatingChat}
          setIsBottomSheetOpen={() => setIsInviteBottomSheetOpen(false)}
          onSendInvite={handleSendInvite}
        />
      </ScreenLayout>
    </BottomSheetModalProvider>
  );
};

const styles = StyleSheet.create({
  wrapper: {
    gap: 12,
  },
  image: {
    width: 24,
    height: 24,
  },
  caret: {
    width: 24,
    height: 24,
    transform: [{ rotate: "180deg" }],
  },
});
