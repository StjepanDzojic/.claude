import { easyApi } from './server';

export type EasyApiProduct = {
  id: string;
  name: string;
  description: string;
  active: boolean;
  metadata: Record<string, unknown>;
  image_url: string;
  default_price_id?: string;
  statement_descriptor?: string;
  unit_label?: string;
};

export type EasyApiProductPrice = {
  id: string;
  product_id: string;
  currency: string;
  unit_amount: number;
  recurring: boolean;
  interval?: 'day' | 'week' | 'month' | 'year';
  interval_count?: number;
  pricing_model?:
    | 'per_unit'
    | 'tiered_volume'
    | 'tiered_graduated'
    | 'package'
    | 'metered'
    | 'flat_rate';
  trial_period_days?: number;
  metadata?: Record<string, unknown>;
  active?: boolean;
  tax_behavior?: 'inclusive' | 'exclusive';
  description?: string;
};

type CreateProductBody = {
  name: string;
  description: string;
  active: boolean;
  metadata: Record<string, unknown>;
  image_url: string;
  default_price_id?: string;
  statement_descriptor?: string;
  unit_label?: string;
};

type CreateProductPriceBody = {
  product_id: string;
  currency?: string;
  unit_amount?: number;
  recurring?: boolean;
  interval?: 'day' | 'week' | 'month' | 'year';
  interval_count?: number;
  pricing_model?: EasyApiProductPrice['pricing_model'];
  trial_period_days?: number;
  metadata?: Record<string, unknown>;
  active?: boolean;
  tax_behavior?: 'inclusive' | 'exclusive';
  description?: string;
};

export const createProduct = (body: CreateProductBody) =>
  easyApi.post<EasyApiProduct>('/v1/api/products/', { body });

export const createProductPrice = (body: CreateProductPriceBody) =>
  easyApi.post<EasyApiProductPrice>('/v1/api/product-prices/', { body });
