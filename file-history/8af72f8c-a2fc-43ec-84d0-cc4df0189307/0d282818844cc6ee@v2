import { useDoorDesign, usePanelColor } from '@modules/door-model/store';
import { useGLTF } from '@react-three/drei';
import { FC, useDeferredValue } from 'react';
import { Color, Mesh, MeshStandardMaterial } from 'three';
import { GLTF } from 'three-stdlib';

type GLTFResult = GLTF & {
  nodes: {
    Body1: Mesh;
  };
  materials: {
    ['01 Boja vrata RAL 9006']: MeshStandardMaterial;
  };
};

export const PanelOuter: FC = () => {
  const model = useDoorDesign();
  const panelColor = usePanelColor();
  const deferredSrc = useDeferredValue(model.modelSrc || '');
  const { nodes } = useGLTF(deferredSrc) as unknown as GLTFResult;
  const material = new MeshStandardMaterial({
    color: new Color(panelColor.modelSrc || '#ffffff'),
  });

  if (!nodes) return null;

  return (
    <group dispose={null}>
      <group scale={0.001}>
        <group position={[-463.163, -580.081, 0.001]}>
          <mesh
            geometry={nodes.Body1.geometry}
            material={material}
            scale={10}
          />
        </group>
      </group>
    </group>
  );
};
