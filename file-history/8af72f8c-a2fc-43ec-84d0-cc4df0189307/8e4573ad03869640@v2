'use client';
import { Canvas } from '@react-three/fiber';
import * as THREE from 'three';
import clsx from 'clsx';
import dynamic from 'next/dynamic';
import { FC, Suspense, useCallback, useEffect, useState } from 'react';
import { LoadingSpinner } from 'shared/LoadingSpinner';
import {
  useIsFrontSide,
  useIsWholeModelShown,
  useSceneLightingMode,
  useSetIsFrontSide,
  useSetIsWholeModelShown,
  useSetSceneLightingMode,
} from '../store';
import { Door } from './Door';
import { DoorMobileNavigation } from './DoorMobileNavigation';
import { DoorNavigation } from './DoorNavigation';

const Show = dynamic<{ className?: string }>(
  () => import('public/assets/icons/show.svg'),
);

const Hide = dynamic<{ className?: string }>(
  () => import('public/assets/icons/hide.svg'),
);

const Rotate = dynamic<{ className?: string }>(
  () => import('public/assets/icons/rotate.svg'),
);

interface Props {
  proposal?: Proposal;
}

export const DoorModel: FC<Props> = ({ proposal }) => {
  const isWholeModelShown = useIsWholeModelShown();
  const isFront = useIsFrontSide();
  const lightingMode = useSceneLightingMode();
  const setIsWholeModelShown = useSetIsWholeModelShown();
  const setIsFront = useSetIsFrontSide();
  const setLightingMode = useSetSceneLightingMode();
  const isNightMode = lightingMode.id === 'night';
  const [isModelLoading, setIsModelLoading] = useState(false);
  const handleLoadingChange = useCallback((loading: boolean) => {
    setIsModelLoading(loading);
  }, []);

  useEffect(() => {
    if (!window) return;
    window.scrollTo({ top: 0, behavior: 'instant' });
  }, [isWholeModelShown]);

  useEffect(() => {
    if (proposal?.sceneLightingMode) {
      setLightingMode(proposal.sceneLightingMode);
    }
  }, [proposal, setLightingMode]);

  return (
    <div
      className={clsx(
        'sticky top-0 bg-background-7 md:relative h-[372px] md:h-full w-full z-10 md:z-0',
        isWholeModelShown ? 'col-[2_/_48]' : 'col-[1_/_49]  md:col-[2_/_29] ',
      )}
    >
      <div className="h-full md:h-screen w-full md:sticky md:top-0 md:pt-32">
        {!proposal && <DoorMobileNavigation />}
        {!proposal && <DoorNavigation />}
        <div
          className={clsx(
            'cursor-move relative mt-16',
            proposal
              ? 'h-[calc(100%-32px)]'
              : 'h-[calc(100%-100px)] md:h-[calc(100%-92px)]',
          )}
        >
          <Suspense
            fallback={
              <div className="absolute top-0 left-0 w-full h-full z-10 bg-black opacity-50 flex items-center justify-center transition-opacity duration-75 ease-out">
                <LoadingSpinner />
              </div>
            }
          >
            <Canvas
              dpr={[1, 2]}
              frameloop="demand"
              camera={{ position: [-4, 3, 6], fov: 45, near: 0.1, far: 200 }}
              shadows
              onCreated={({ gl }) => {
                gl.localClippingEnabled = true;
                gl.shadowMap.type = THREE.PCFSoftShadowMap;
              }}
            >
              <Door proposal={proposal} onLoadingChange={handleLoadingChange} />
            </Canvas>
          </Suspense>
          {isModelLoading && (
            <div className="absolute top-0 left-0 w-full h-full z-10 bg-black/30 flex items-center justify-center transition-opacity duration-150 ease-out pointer-events-none">
              <LoadingSpinner />
            </div>
          )}
          <div className="absolute bottom-20 left-20 flex items-center gap-12">
            <button
              onClick={() => setIsFront(!isFront)}
              className="rounded-full bg-white w-44 h-44 flex justify-center items-center"
            >
              <Rotate />
            </button>
            <div className="flex items-center gap-10 rounded-full bg-white/95 h-44 px-14 shadow-[0_10px_28px_rgba(15,23,42,0.12)] backdrop-blur">
              <span
                className={clsx(
                  'text-xs font-medium transition-colors duration-300',
                  isNightMode ? 'text-text-3' : 'text-basic-black',
                )}
              >
                Day
              </span>
              <button
                onClick={() =>
                  setLightingMode({
                    ...lightingMode,
                    id: isNightMode ? 'day' : 'night',
                    name: isNightMode ? 'Day' : 'Night',
                  })
                }
                className={clsx(
                  'relative h-24 w-44 rounded-full transition-colors duration-300',
                  isNightMode ? 'bg-global-primary-1' : 'bg-border-5',
                )}
                aria-label="Toggle scene lighting"
                aria-pressed={isNightMode}
              >
                <span
                  className={clsx(
                    'absolute top-2 left-2 h-20 w-20 rounded-full bg-white transition-transform duration-300',
                    isNightMode && 'translate-x-[20px]',
                  )}
                />
              </button>
              <span
                className={clsx(
                  'text-xs font-medium transition-colors duration-300',
                  isNightMode ? 'text-basic-black' : 'text-text-3',
                )}
              >
                Night
              </span>
            </div>
          </div>
          <button
            onClick={() => setIsWholeModelShown(!isWholeModelShown)}
            className="hidden absolute bottom-20 right-20 rounded-full bg-white w-44 h-44 md:flex justify-center items-center"
          >
            {isWholeModelShown ? <Hide /> : <Show />}
          </button>
        </div>
      </div>
    </div>
  );
};
