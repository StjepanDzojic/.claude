import { BottomSheetScrollView } from "@gorhom/bottom-sheet";
import { Block } from "@prototyp/skeletor";
import type { FC, ReactNode } from "react";
import type { ScrollViewProps } from "react-native";
import { isIpad } from "shared/utils";

interface Props extends ScrollViewProps {
  children?: ReactNode;
}

export const AppBottomSheetScrollView: FC<Props> = ({ children, ...props }) => {
  if (isIpad()) {
    return (
      <Block scrollable {...props}>
        {children}
      </Block>
    );
  }
  return <BottomSheetScrollView {...props}>{children}</BottomSheetScrollView>;
};
