import { BottomSheetView } from "@gorhom/bottom-sheet";
import {
  Block,
  Text,
  useAndroidBackHandler,
} from "@prototyp/skeletor";
import type { UserProfile } from "@unomed/react-native-matrix-sdk";
import { useCallback, useRef } from "react";
import { Button } from "shared/components";
import { AppBottomSheet, type AppBottomSheetRef } from "shared/components/bottom-sheet";
import { UserProfileImage } from "shared/components/user-profile-image";
import { usePreventSwipeBack } from "shared/hooks";
import { Colors, TextSize } from "shared/styles";

interface Props {
  isBottomSheetOpen: boolean;
  selectedUser: UserProfile | null;
  isLoading: boolean;
  setIsBottomSheetOpen: () => void;
  onSendInvite: () => void;
}

export const SendInviteBottomSheet: React.FC<Props> = ({
  isBottomSheetOpen,
  selectedUser,
  isLoading,
  setIsBottomSheetOpen,
  onSendInvite,
}) => {
  const sheetRef = useRef<AppBottomSheetRef>(null);

  const handleClose = useCallback(() => {
    sheetRef.current?.close();
  }, []);

  useAndroidBackHandler({
    handlePress: handleClose,
    enabled: isBottomSheetOpen,
    disableDefault: isBottomSheetOpen,
  });

  usePreventSwipeBack(isBottomSheetOpen);

  if (!selectedUser) return null;

  return (
    <AppBottomSheet
      ref={sheetRef}
      isOpen={isBottomSheetOpen}
      onClose={setIsBottomSheetOpen}
      enableContentPanningGesture={false}
    >
      <BottomSheetView>
        <Block
          justify="space-between"
          flexDirection="column"
          flex={1}
          width="100%"
          gap={16}
          paddings={{
            paddingHorizontal: 20,
            paddingBottom: 56,
          }}
        >
          <Block align="center" gap={16} margins={{ marginBottom: 24 }}>
            <UserProfileImage
              borderRadius={999}
              user={selectedUser}
              width={120}
              height={120}
            />
            <Block align="center" gap={4}>
              <Text
                size={TextSize.large}
                color={Colors.white}
                font="InstrumentSans-Bold"
              >
                {selectedUser.displayName}
              </Text>
              <Text color={Colors.white50} font="InstrumentSans-Regular">
                {selectedUser.userId}
              </Text>
            </Block>
          </Block>
          <Block gap={12}>
            <Button.Primary
              onPress={onSendInvite}
              disabled={isLoading}
              width="100%"
            >
              {isLoading ? "Creating chat..." : "Send invite"}
            </Button.Primary>
            <Button.Ghost
              onPress={handleClose}
              disabled={isLoading}
              width="100%"
            >
              Cancel
            </Button.Ghost>
          </Block>
        </Block>
      </BottomSheetView>
    </AppBottomSheet>
  );
};
