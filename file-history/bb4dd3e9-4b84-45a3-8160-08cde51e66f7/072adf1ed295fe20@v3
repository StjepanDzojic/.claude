  // Reactions

  public static toggleReaction = async (
    roomId: string,
    event: EventTimelineItem,
    emoji: string,
  ) => {
    const room = MatrixCore.getRoom(roomId);
    const timeline = await room.timeline();
    if (!timeline) throw new Error("Timeline not found");

    if (!event.eventOrTransactionId) {
      throw new Error("Event is missing event or transaction id");
    }

    return timeline.toggleReaction(event.eventOrTransactionId, emoji);
  };

  public static getTopReactions = (
    event: EventTimelineItem,
    limit = 3,
  ): TimelineReaction[] => {
    const normalized = this.getNormalizedReactions(event);
    return normalized
      .sort(
        (a, b) => b.count - a.count || b.latestTimestamp - a.latestTimestamp,
      )
      .slice(0, limit);
  };

  private static getNormalizedReactions = (
    event: EventTimelineItem,
  ): TimelineReaction[] => {
    const reactionCandidates: unknown[] = [
      this.readValue(event, ["reactions"]),
      this.readValue(event, ["properties", "reactions"]),
      this.readValue(event, ["content", "inner", "reactions"]),
      this.readValue(event, ["content", "inner", "content", "reactions"]),
      this.readValue(event, [
        "content",
        "inner",
        "content",
        "kind",
        "inner",
        "content",
        "reactions",
      ]),
    ].filter(Boolean);

    for (const candidate of reactionCandidates) {
      const parsed = this.parseReactionsCandidate(candidate);
      if (parsed.length) return parsed;
    }

    return [];
  };

  private static parseReactionsCandidate = (
    candidate: unknown,
  ): TimelineReaction[] => {
    if (!candidate) return [];

    if (Array.isArray(candidate)) {
      return candidate
        .map((reaction) => this.parseSingleReaction(reaction))
        .filter((reaction): reaction is TimelineReaction => Boolean(reaction));
    }

    if (candidate instanceof Map) {
      return Array.from(candidate.entries())
        .map(([key, value]) => this.parseEntryReaction(key, value))
        .filter((reaction): reaction is TimelineReaction => Boolean(reaction));
    }

    if (typeof candidate === "object") {
      return Object.entries(candidate as Record<string, unknown>)
        .map(([key, value]) => this.parseEntryReaction(key, value))
        .filter((reaction): reaction is TimelineReaction => Boolean(reaction));
    }

    return [];
  };

  private static parseEntryReaction = (
    key: string,
    rawValue: unknown,
  ): TimelineReaction | null => {
    const currentUserId = MatrixCore.instance?.userId() ?? "";
    const normalizedKey = this.normalizeReactionKey(key);
    if (!normalizedKey) return null;

    const detailedReaction = this.parseSingleReaction(rawValue);
    if (detailedReaction) {
      return {
        ...detailedReaction,
        key: normalizedKey,
        displayKey: String(detailedReaction.displayKey || normalizedKey).slice(
          0,
          16,
        ),
      };
    }

    const senders = this.toSenders(rawValue, currentUserId);
    return {
      key: normalizedKey,
      displayKey: normalizedKey.slice(0, 16),
      count: senders.count,
      latestTimestamp: senders.latestTimestamp,
      isHighlighted: senders.isHighlighted,
      senders: senders.senders,
    };
  };

  private static parseSingleReaction = (
    rawReaction: unknown,
  ): TimelineReaction | null => {
    if (!rawReaction || typeof rawReaction !== "object") return null;
    const currentUserId = MatrixCore.instance?.userId() ?? "";

    const reaction = rawReaction as Record<string, unknown>;
    const normalizedKey = this.normalizeReactionKey(
      reaction.key ??
        reaction.displayKey ??
        reaction.emoji ??
        reaction.reaction,
    );
    if (!normalizedKey) return null;

    const senders = this.toSenders(reaction.senders, currentUserId);
    const rawCount = Number(reaction.count);
    const count =
      Number.isFinite(rawCount) && rawCount > 0 ? rawCount : senders.count;

    return {
      key: normalizedKey,
      displayKey: String(reaction.displayKey ?? normalizedKey).slice(0, 16),
      count,
      latestTimestamp: senders.latestTimestamp,
      isHighlighted:
        Boolean(reaction.isHighlighted) ||
        Boolean(reaction.highlighted) ||
        senders.isHighlighted,
      senders: senders.senders,
    };
  };

  private static toSenders = (
    rawSenders: unknown,
    currentUserId: string,
  ): {
    count: number;
    latestTimestamp: number;
    isHighlighted: boolean;
    senders: TimelineReactionSender[];
  } => {
    if (!rawSenders)
      return {
        count: 1,
        latestTimestamp: 0,
        isHighlighted: false,
        senders: [],
      };

    if (Array.isArray(rawSenders)) {
      const senders: TimelineReactionSender[] = rawSenders
        .map((sender) => ({
          userId: this.extractSenderUserId(sender),
          timestamp: this.extractTimestamp(sender),
        }))
        .filter((s) => s.userId);
      const latestTimestamp = senders.reduce(
        (max, s) => Math.max(max, s.timestamp),
        0,
      );
      const isHighlighted = senders.some((s) => s.userId === currentUserId);
      return {
        count: rawSenders.length || 1,
        latestTimestamp,
        isHighlighted,
        senders,
      };
    }

    if (rawSenders instanceof Map) {
      const entries = Array.from(rawSenders.entries());
      const senders: TimelineReactionSender[] = entries
        .map(([senderId, sender]) => ({
          userId:
            typeof senderId === "string" && senderId
              ? senderId
              : this.extractSenderUserId(sender),
          timestamp: this.extractTimestamp(sender),
        }))
        .filter((s) => s.userId);
      const latestTimestamp = senders.reduce(
        (max, s) => Math.max(max, s.timestamp),
        0,
      );
      const isHighlighted = senders.some((s) => s.userId === currentUserId);
      return {
        count: entries.length || 1,
        latestTimestamp,
        isHighlighted,
        senders,
      };
    }

    if (typeof rawSenders === "object") {
      const entries = Object.entries(rawSenders as Record<string, unknown>);
      const senders: TimelineReactionSender[] = entries
        .map(([senderId, sender]) => ({
          userId: senderId || this.extractSenderUserId(sender),
          timestamp: this.extractTimestamp(sender),
        }))
        .filter((s) => s.userId);
      const latestTimestamp = senders.reduce(
        (max, s) => Math.max(max, s.timestamp),
        0,
      );
      const isHighlighted = senders.some((s) => s.userId === currentUserId);
      return {
        count: entries.length || 1,
        latestTimestamp,
        isHighlighted,
        senders,
      };
    }

    return { count: 1, latestTimestamp: 0, isHighlighted: false, senders: [] };
  };

  private static extractTimestamp = (sender: unknown): number => {
    if (!sender || typeof sender !== "object") return 0;
    const record = sender as Record<string, unknown>;
    const rawTimestamp =
      record.timestamp ??
      record.ts ??
      this.readValue(record, ["inner", "timestamp"]);
    const timestamp = Number(rawTimestamp);
    return Number.isFinite(timestamp) ? timestamp : 0;
  };

  private static extractSenderUserId = (sender: unknown): string => {
    if (!sender || typeof sender !== "object") return "";
    const record = sender as Record<string, unknown>;
    const rawUserId =
      record.userId ??
      record.senderId ??
      record.id ??
      this.readValue(record, ["inner", "userId"]);
    return typeof rawUserId === "string" ? rawUserId : "";
  };

  private static normalizeReactionKey = (rawKey: unknown): string => {
    if (typeof rawKey !== "string") return "";
    return rawKey.trim();
  };

  private static readValue = (source: unknown, path: string[]): unknown => {
    if (!source || typeof source !== "object") return undefined;
    let current: unknown = source;
    for (const segment of path) {
      if (!current || typeof current !== "object") return undefined;
      current = (current as Record<string, unknown>)[segment];
    }
    if (typeof current === "function") {
      try {
        return (current as () => unknown)();
      } catch {
        return undefined;
      }
    }
    return current;
  };
}
