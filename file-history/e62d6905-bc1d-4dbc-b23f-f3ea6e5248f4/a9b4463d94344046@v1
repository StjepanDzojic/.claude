import { useAtomValue, useSetAtom } from 'jotai';
import { CallAtoms } from 'modules/call/jotai';
import { CallKitService } from 'modules/call/service/CallKitService';
import { CallOverlayService } from 'modules/call/service/CallOverlayService';
import { ElementCallService } from 'modules/call/service/ElementCallService';
import { PictureInPictureService } from 'modules/call/service/PictureInPictureService';
import { MatrixAtoms } from 'modules/matrix-client/jotai';
import { MatrixCore } from 'modules/matrix-client/services/MatrixCore';
import { RoomService } from 'modules/room/service/RoomService';
import { useEffect, useRef } from 'react';
import { Platform } from 'react-native';

/** Provider that initializes CallKit on iOS and monitors rooms for incoming calls via sync. */
export const CallKitProvider = () => {
  const roomList = useAtomValue(MatrixAtoms.roomList);
  const setHasActiveCall = useSetAtom(CallAtoms.hasActiveCall);
  const prevActiveCallRoomIds = useRef<Set<string>>(new Set());

  // Initialize CallKit
  useEffect(() => {
    if (Platform.OS !== 'ios') return;

    CallKitService.setup();
  }, []);

  // Monitor room list for active calls (foreground detection without push)
  useEffect(() => {
    if (Platform.OS !== 'ios' || roomList.length === 0) return;

    const currentActiveCallRoomIds = new Set<string>();

    for (const room of roomList) {
      if (!room.hasActiveRoomCall()) return;
      currentActiveCallRoomIds.add(room.id());
    }

    // Detect newly active calls (rooms that weren't active before)
    for (const roomId of currentActiveCallRoomIds) {
      if (prevActiveCallRoomIds.current.has(roomId)) continue;

      // Don't show CallKit if we initiated the call ourselves
      if (ElementCallService.getActiveCallRoomId() === roomId) continue;

      // Don't show if already ringing for this room (e.g. from push)
      if (CallKitService.isRingingForRoom(roomId)) continue;

      // Get room info for display
      const roomInfo = RoomService.getRoomInfo(roomId);
      const roomName = roomInfo?.displayName() ?? 'Unknown Room';
      const currentUserId = MatrixCore.instance?.userId();

      // Don't ring for own calls
      if (!currentUserId) continue;

      CallKitService.displayIncomingCall({
        roomId,
        roomName,
        senderDisplayName: roomName,
      });
    }

    prevActiveCallRoomIds.current = currentActiveCallRoomIds;
  }, [roomList]);

  // Keep a single global call state in sync for UI consumers.
  useEffect(() => {
    const syncGlobalActiveCall = () => {
      setHasActiveCall(
        !!CallOverlayService.getActiveCall() ||
          ElementCallService.hasActiveCall(),
      );
    };

    syncGlobalActiveCall();

    const removeOverlayListener = CallOverlayService.subscribe(() => {
      syncGlobalActiveCall();
    });
    const removeElementCallListener =
      ElementCallService.subscribeToActiveCallState(() => {
        syncGlobalActiveCall();
      });

    return () => {
      removeOverlayListener();
      removeElementCallListener();
    };
  }, [setHasActiveCall]);

  // Handle in-app PiP restore and stop events
  useEffect(() => {
    if (Platform.OS !== 'ios') return;

    const removeRestoreListener =
      PictureInPictureService.subscribeRestoreRequested(() => {
        console.log('[PiP] restoreRequested event received');
        const call = PictureInPictureService.getActivePiPCall();
        console.log('[PiP] activePiPCall:', call);

        if (call) {
          console.log('[PiP] restoring active call overlay');
          CallOverlayService.openCall(call.roomId, call.roomName);
          PictureInPictureService.clearActivePiPCall();
        } else {
          CallOverlayService.showActiveCall();
        }

        // Always notify native that UI restore is complete
        PictureInPictureService.notifyRestoreComplete();
      });

    const removeStopListener = PictureInPictureService.subscribeDidStop(
      payload => {
        console.log('[PiP] didStop event received:', payload);
        const call = PictureInPictureService.getActivePiPCall();

        if (payload.isRestoring) {
          // Fallback: if restoreRequested didn't navigate, do it here
          if (call) {
            console.log(
              '[PiP] didStop fallback: restoring active call overlay',
            );
            CallOverlayService.openCall(call.roomId, call.roomName);
            PictureInPictureService.clearActivePiPCall();
          } else {
            CallOverlayService.showActiveCall();
          }
          return;
        }

        if (!call) {
          const activeOverlayCall = CallOverlayService.getActiveCall();
          if (!activeOverlayCall) return;
          console.log('[PiP] PiP closed, cleaning up active overlay call');
          ElementCallService.cleanupDriver(activeOverlayCall.roomId);
          PictureInPictureService.setEnabled(false);
          CallOverlayService.clearActiveCall();
          return;
        }

        // PiP closed without restore — clean up the call
        console.log('[PiP] PiP closed, cleaning up call');
        ElementCallService.cleanupDriver(call.roomId);
        PictureInPictureService.clearActivePiPCall();
        PictureInPictureService.setEnabled(false);
        CallOverlayService.clearActiveCall();
      },
    );

    return () => {
      removeRestoreListener();
      removeStopListener();
    };
  }, []);

  return <></>;
};
